# Variant condition; only explicit false flips _ok. `status` distinguishes a
# real FAIL from a donor-truth EXPECTED_PRE_FIX_FAILURE or an UNVERIFIED probe.
func check(name: String, cond, detail: String = "", status: String = "") -> void:
	var st := status
	if st == "":
		st = "PASS" if cond == true else ("FAIL" if cond == false else "SKIPPED")
	_checks.append({"name": name, "passed": cond, "status": st, "detail": detail})
	if cond == false:
		_ok = false
	print("T_TERRAIN_SHORE %s %s - %s" % [st, name, detail])


func _fail_remaining(from_index: int, tag: String, reason: String) -> void:
	for i in range(from_index, CHECK_NAMES.size()):
		var n := CHECK_NAMES[i]
		var st := "UNVERIFIED" if CAPTURE_CHECK_NAMES.has(n) else "FAIL"
		check(n, false, tag + ": " + reason, st)


func _verdict() -> String:
	var has_hard := false
	var has_unverified := false
	var has_expected := false
	for c in _checks:
		if c.get("passed") != false:
			continue
		var st := str(c.get("status", "FAIL"))
		if st == "UNVERIFIED" or st == "SKIPPED":
			has_unverified = true
		elif st == "EXPECTED_PRE_FIX_FAILURE":
			has_expected = true
		else:
			has_hard = true
	if has_hard:
		return "FAIL"
	if has_unverified:
		return "UNVERIFIED"
	if has_expected:
		return "EXPECTED_PRE_FIX_FAILURE"
	return "PASS"


func finish() -> void:
	if _finished:
		return
	_finished = true
