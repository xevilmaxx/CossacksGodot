func _find_named(root: Node, wanted: String) -> Array[Node]:
	var found: Array[Node] = []
	var stack: Array[Node] = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		if n.name == wanted:
			found.append(n)
		for c in n.get_children():
			stack.append(c)
	return found


func _find_terrain_mesh(root: Node) -> MeshInstance3D:
	var best: MeshInstance3D = null
	var best_verts := -1
	var stack: Array[Node] = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		if n is MeshInstance3D:
			var mi := n as MeshInstance3D
			var m: Mesh = mi.mesh
			if m is ArrayMesh and m.get_surface_count() > 0:
				var arr: Array = m.surface_get_arrays(0)
				var vs: Variant = arr[Mesh.ARRAY_VERTEX] if arr.size() > Mesh.ARRAY_VERTEX else null
				var count: int = (vs as PackedVector3Array).size() if vs is PackedVector3Array else 0
				if count > best_verts:
					best_verts = count
					best = mi
		for c in n.get_children():
			stack.append(c)
	return best


func _uniform_float(mat: Material, key: String) -> Variant:
	if mat is ShaderMaterial:
		return (mat as ShaderMaterial).get_shader_parameter(key)
	return null


func _float_eq(a: Variant, expected: float) -> bool:
	if a is float:
		return absf(float(a) - expected) <= 1e-6
	if a is int:
		return absf(float(int(a)) - expected) <= 1e-6
	return false


# ---------------------------------------------------------------------------
# Project a cell centre (world X/Z, terrain Y) into the capture SubViewport.
# Mirrors world3d_terrain.gd:685-688 and camera3d.gd:258-260, but uses the
# actual cell height rather than the Y=0 projection helper.
# ---------------------------------------------------------------------------
func _cell_px(i: int) -> Vector2:
	var x := i % GRID_W
	var z := i / GRID_W
	var wx := (float(x) + 0.5 - float(GRID_W) * 0.5) * TILE_M
	var wz := (float(z) + 0.5 - float(GRID_H) * 0.5) * TILE_M
	if _camera == null:
		return Vector2(-1.0, -1.0)
	# Water pixels live on the flat plane (water3d.gd:181-204), not on the
	# submerged bed; project water cells at the plane height so the sampled
	# pixel actually contains the water shader fragment.
	var y := WATER_LEVEL if _heights[i] < WATER_LEVEL else _heights[i]
	return _camera.unproject_position(Vector3(wx, y, wz))


func _collect_samples() -> void:
	_sample_water = []
	_sample_land = []
	var w := WINDOW_SIZE.x
	var h := WINDOW_SIZE.y
	for z in range(GRID_H):
		var cx := float(GRID_W) * 0.5 - 0.5
		var cz := float(GRID_H) * 0.5 - 0.5
		for x in range(GRID_W):
			var i := z * GRID_W + x
			var dx := float(x) - cx
			var dz := float(z) - cz
			var r: float = sqrt(dx * dx + dz * dz)
			if r > 5.2:
				continue
			var p := _cell_px(i)
			if p.x < 8.0 or p.y < 8.0 or p.x > float(w - 8) or p.y > float(h - 8):
				continue
			if r < 2.4:
				_sample_water.append(i)
			elif r >= 3.8 and _heights[i] > SHORE_HEIGHT:
				_sample_land.append(i)
	_m["water_sample_cells"] = _sample_water.size()
	_m["land_sample_cells"] = _sample_land.size()


func _rgb_at(img: Image, p: Vector2) -> Vector3:
	var x := int(round(p.x))
	var y := int(round(p.y))
	if x < 0 or y < 0 or x >= img.get_width() or y >= img.get_height():
		return Vector3(-1.0, -1.0, -1.0)
	var c := img.get_pixel(x, y)
	return Vector3(c.r * 255.0, c.g * 255.0, c.b * 255.0)


func _delta_above(a: Vector3, b: Vector3, eps: float) -> bool:
	if a.x < 0.0 or b.x < 0.0:
		return false
	return absf(a.x - b.x) > eps or absf(a.y - b.y) > eps or absf(a.z - b.z) > eps


func _image_metrics(img: Image) -> Dictionary:
	var w := img.get_width()
	var h := img.get_height()
	var non_black := 0
	var dark_rows := 0
	var luma_sum := 0.0
	for y in range(h):
		var row_dark := 0
		for x in range(w):
			var c := img.get_pixel(x, y)
			var r := c.r * 255.0
			var g := c.g * 255.0
			var b := c.b * 255.0
			if r > 8.0 or g > 8.0 or b > 8.0:
				non_black += 1
			var l := 0.2126 * r + 0.7152 * g + 0.0722 * b
			luma_sum += l
			if l < 20.0:
				row_dark += 1
		if float(row_dark) / float(maxi(w, 1)) > 0.90:
			dark_rows += 1
	var n := float(maxi(w * h, 1))
	return {
		"width": w,
		"height": h,
		"non_black_fraction": float(non_black) / n,
		"mean_luma": luma_sum / n,
		"full_width_dark_rows": dark_rows,
	}


func _save_png(img: Image, path: String) -> int:
	var abs_png := path
	if not abs_png.is_absolute_path() and not abs_png.begins_with("user://"):
		abs_png = ProjectSettings.globalize_path("res://").get_base_dir().path_join(abs_png)
	var dir := abs_png.get_base_dir()
	if dir != "" and not DirAccess.dir_exists_absolute(dir):
		DirAccess.make_dir_recursive_absolute(dir)
	return img.save_png(abs_png)


func _wait_seconds(sec: float) -> void:
	var timer := Timer.new()
	timer.wait_time = sec
	timer.one_shot = true
	root.add_child(timer)
	timer.start()
	await timer.timeout
	timer.queue_free()


func _read_capture() -> Image:
	if _view == null:
		return null
	_view.render_target_update_mode = SubViewport.UPDATE_ONCE
	await RenderingServer.frame_post_draw
	if _finished:
		return null
	var tex := _view.get_texture()
	var img: Image = tex.get_image() if tex != null else null
	if img == null or img.is_empty():
		return null
	return img


# ---------------------------------------------------------------------------
# Async windowed capture: A at t0 (water on), B at t0+1 s (water on),
# C with the single WaterPlane hidden. A/C isolates water alpha coverage;
# A/B measures the water-only animation delta with a fixed camera.
# ---------------------------------------------------------------------------
func _capture_sequence() -> void:
	_capturing = true
	_collect_samples()
	_img_a = await _read_capture()
	if _img_a == null:
		check("capture_image", false,
			"blank SubViewport texture — no CPU fallback (main.gd:1846-1853)", "FAIL")
		finish()
		return
	check("capture_image", true,
		"water-on SubViewport texture %dx%d" % [_img_a.get_width(), _img_a.get_height()])

	await _wait_seconds(ANIMATION_SECONDS)
	if _finished:
		return
	_img_b = await _read_capture()
	if _img_b == null:
		check("water_animation_delta", false, "second frame blank at t+1 s", "UNVERIFIED")
		finish()
		return

	if _water_plane != null and is_instance_valid(_water_plane):
		_water_plane.visible = false
	elif _water_node != null and is_instance_valid(_water_node):
		_water_node.visible = false
	_img_c = await _read_capture()
	if _img_c == null:
		check("water_alpha_confined_to_cells", false,
			"water-off comparison frame blank", "UNVERIFIED")
		finish()
		return

	var err_a := _save_png(_img_a, _png_path)
	var err_b := _save_png(_img_b, _png_t1_path)
	check("capture_saved", err_a == OK,
		"save_png A err=%d B err=%d paths=%s | %s" % [err_a, err_b, _png_path, _png_t1_path])

	var ms := _image_metrics(_img_a)
	ms["capture_source"] = "stub-owned SubViewport, windowed GPU (no CPU fallback)"
	ms["png_bytes"] = FileAccess.get_file_as_bytes(_png_path).size() if err_a == OK else -1
	_m["png_metrics"] = ms
	check("png_full_width_dark_rows", int(ms["full_width_dark_rows"]) == 0,
		"full_width_dark_rows=%d (expected 0; smallmap_capture.py:27-28)" % int(ms["full_width_dark_rows"]))

	var samples_ok := _sample_water.size() > 0 and _sample_land.size() > 0
	check("sample_coverage", samples_ok,
		"visible water=%d land=%d cell centres (fixed camera3d.gd framing)" % [
			_sample_water.size(), _sample_land.size()],
		"PASS" if samples_ok else "UNVERIFIED")

	var land_changed := 0
	var water_changed := 0
	for i in _sample_land:
		if _delta_above(_rgb_at(_img_a, _cell_px(i)), _rgb_at(_img_c, _cell_px(i)), PIXEL_EPS):
			land_changed += 1
	for i in _sample_water:
		if _delta_above(_rgb_at(_img_a, _cell_px(i)), _rgb_at(_img_c, _cell_px(i)), PIXEL_EPS):
			water_changed += 1
	_m["water_on_off_diff"] = {
		"land_samples_changed": land_changed,
		"water_samples_changed": water_changed,
		"pixel_epsilon_0_255": PIXEL_EPS,
	}
	check("water_alpha_confined_to_cells", samples_ok and land_changed == 0 and water_changed > 0,
		"land changed=%d/%d (need 0), water changed=%d/%d (need >0); "
			+ "water.dev.frag:176-183 discard, DTRN-03 M6" % [
				land_changed, _sample_land.size(), water_changed, _sample_water.size()],
		"PASS" if samples_ok and water_changed > 0 else "UNVERIFIED")

	var animated := 0
	var max_delta := 0.0
	for i in _sample_water:
		var ca := _rgb_at(_img_a, _cell_px(i))
		var cb := _rgb_at(_img_b, _cell_px(i))
		if ca.x < 0.0 or cb.x < 0.0:
			continue
		var d := maxf(absf(ca.x - cb.x), maxf(absf(ca.y - cb.y), absf(ca.z - cb.z)))
		max_delta = maxf(max_delta, d)
		if d > PIXEL_EPS:
			animated += 1
	_m["animation_diff"] = {
		"seconds": ANIMATION_SECONDS,
		"water_samples_changed": animated,
		"max_channel_delta_0_255": max_delta,
		"pixel_epsilon_0_255": PIXEL_EPS,
	}
	# No measurable 1 s delta is NOT faked into a PASS: it is an UNVERIFIED
	# animation probe (sub-threshold motion / sub-pixel framing), per the task.
	check("water_animation_delta", samples_ok and animated > 0,
		"t0 vs t+1 s: changed water samples=%d/%d max_delta=%s; water3d.gd:95-99"
			% [animated, _sample_water.size(), str(max_delta)],
		"PASS" if samples_ok and animated > 0 else "UNVERIFIED")
	finish()


func _initialize() -> void:
	if _finished:
		return
	call_deferred("_failsafe")

	_headless = DisplayServer.get_name() == "headless"
	var png := _arg_value("--png")
	if png == "":
		png = _arg_value("--screenshot")
	if png != "":
		_png_path = png
	var png_t1 := _arg_value("--png-t1")
	if png_t1 != "":
		_png_t1_path = png_t1
	_m["headless"] = _headless
	_m["requested_png"] = _png_path

	_make_grid()
	_game = _make_stub_game()
	_m["harness_source"] = _harness_source
	var shape_ok: bool = (_game != null and is_instance_valid(_game)
		and int(_game.get("MAP_W")) == GRID_W and int(_game.get("MAP_H")) == GRID_H
		and (_game.get("height") is PackedFloat32Array)
		and (_game.get("tileblock") is PackedByteArray)
		and (_game.get("res_nodes") is Array))
	check("harness_stub_shape", shape_ok,
		"source=%s MAP=%dx%d height/tileblock/res_nodes present=%s" % [
			_harness_source,
			str(_game.get("MAP_W")) if _game != null else "<none>",
			str(_game.get("MAP_H")) if _game != null else "<none>", str(shape_ok)])
	if not shape_ok:
		_fail_remaining(1, "STUB_SHAPE", "harness stub does not expose the expected shape")
		_setup_done = true
		finish()
		return

	# Windowed-only GPU target; headless never attempts a 3D readback
	# (main.gd:1156-1158,1790-1800; t_forest_bake_render.gd:36-41).
	if not _headless:
		get_root().size = WINDOW_SIZE
		_view = SubViewport.new()
		_view.name = "TerrainShoreViewport"
		_view.world_3d = World3D.new()
		_view.size = WINDOW_SIZE
		_view.render_target_update_mode = SubViewport.UPDATE_ONCE
		get_root().add_child(_view)
	var parent: Node = _view if _view != null else get_root()

	var terrain_script := load(TERRAIN_PATH) as Script
	var terrain_api := terrain_script != null and terrain_script.can_instantiate()
	var terrain_missing: Array[String] = []
	if terrain_api:
		var probe: Object = terrain_script.new()
		for meth in ["bind", "build", "invalidate", "has_chunk_or_fallback", "height_at_world"]:
			if not probe.has_method(meth):
				terrain_missing.append(meth)
		probe.free()
	terrain_api = terrain_api and terrain_missing.is_empty()
	check("terrain_module_api", terrain_api,
		"script=%s missing=%s" % [TERRAIN_PATH, str(terrain_missing)])
	var camera_script := load(CAMERA_PATH) as Script
	var camera_api := camera_script != null and camera_script.can_instantiate()
	var camera_missing: Array[String] = []
	if camera_api:
		var probe2: Object = camera_script.new()
		for meth in ["bind", "world_to_px", "screen_to_world"]:
			if not probe2.has_method(meth):
				camera_missing.append(meth)
		probe2.free()
	camera_api = camera_api and camera_missing.is_empty()
	check("camera_module_api", camera_api,
		"script=%s missing=%s" % [CAMERA_PATH, str(camera_missing)])
	if not terrain_api or not camera_api:
		_fail_remaining(3, "MODULE_MISSING", "terrain/camera script or API unavailable")
		_setup_done = true
		finish()
		return

	# Bind only terrain + camera; no entities/FX/picking, no main.tscn boot.
	_terrain = terrain_script.new() as Node
	_terrain.name = "HeightmapTerrainModule"
	parent.add_child(_terrain)
	_terrain.call("bind", _game)
	var built := bool(_terrain.call("build"))
	check("build_ok", built, "world3d_terrain.build() returned " + str(built))
	if not built:
		_fail_remaining(4, "SETUP_FAILED", "build() returned false")
		_setup_done = true
		finish()
		return

	var planes := _find_named(_terrain, "WaterPlane")
	var water_nodes := _find_named(_terrain, "Water3D")
	_water_plane = planes[0] if planes.size() == 1 else null
	_water_node = water_nodes[0] if water_nodes.size() == 1 else null
	_m["water_plane_count"] = planes.size()
	_m["water_3d_node_count"] = water_nodes.size()
	check("exactly_one_water_plane", planes.size() == 1 and water_nodes.size() == 1,
		"WaterPlane=%d Water3D=%d (one plane, no constant-quad fallback stack; "
			+ "world3d_terrain.gd:762-764, DTRN-03 S1)" % [planes.size(), water_nodes.size()])

	var water_stats: Dictionary = {}
	if _water_node != null and is_instance_valid(_water_node):
		var ws: Variant = _water_node.get("stats")
		water_stats = ws if ws is Dictionary else {}
	var height_aware := bool(water_stats.get("height_aware", false))
	var ts: Variant = _terrain.get("stats")
	var terrain_stats: Dictionary = ts if ts is Dictionary else {}
	var stats_water: Variant = terrain_stats.get("water", {})
	var stats_water_d: Dictionary = stats_water if stats_water is Dictionary else {}
	height_aware = height_aware and bool(stats_water_d.get("height_aware", false))
	_m["height_aware"] = height_aware
	_m["water_stats"] = water_stats
	check("height_aware_true", height_aware,
		"water3d.stats.height_aware and terrain.stats.water.height_aware both true "
			+ "(water3d.gd:248-264, DTRN-03 S1)")

	var below := 0
	for i in range(CELLS):
		if _heights[i] < WATER_LEVEL:
			below += 1
	_m["cells_below_water_level"] = below
	check("water_cell_count", below > 0 and below * 10 < CELLS,
		"cells < %.2f m: %d / %d (need >0 and <10%%)" % [WATER_LEVEL, below, CELLS])

	var camera := camera_script.new() as Camera3D
	_camera = camera
	_camera.name = "DonorCamera"
	parent.add_child(_camera)
	_camera.call("bind", _game)
	# Freeze framing: camera3d._process() edge-scrolls on mouse position
	# (camera3d.gd:484-581); a fixed capture must not pan mid-run.
	_camera.set_process(false)
	_camera.make_current()

	var mi := _terrain.get_node_or_null("HeightmapTerrain") as MeshInstance3D
	var mesh: Mesh = mi.mesh if mi != null else null
	var surfaces := mesh.get_surface_count() if mesh != null else -1
	var arrays: Array = mesh.surface_get_arrays(0) if surfaces > 0 else []
	var vv: Variant = arrays[Mesh.ARRAY_VERTEX] if arrays.size() > Mesh.ARRAY_VERTEX else null
	var iv: Variant = arrays[Mesh.ARRAY_INDEX] if arrays.size() > Mesh.ARRAY_INDEX else null
	var uv2v: Variant = arrays[Mesh.ARRAY_TEX_UV2] if arrays.size() > Mesh.ARRAY_TEX_UV2 else null
	var vertices: int = (vv as PackedVector3Array).size() if vv is PackedVector3Array else -1
	var triangles: int = ((iv as PackedInt32Array).size() / 3) if iv is PackedInt32Array else -1
	var uv2_count: int = (uv2v as PackedVector2Array).size() if uv2v is PackedVector2Array else -1
	_m["mesh_surfaces"] = surfaces
	_m["mesh_vertices"] = vertices
	_m["mesh_triangles"] = triangles
	_m["uv2_count"] = uv2_count
	check("mesh_surface_count", surfaces == 1, "surfaces=%d (expected 1)" % surfaces)
	check("mesh_vertex_count", vertices == CELLS,
		"vertices=%d expected=%d" % [vertices, CELLS])
	check("mesh_triangle_count", triangles == (GRID_W - 1) * (GRID_H - 1) * 2,
		"triangles=%d expected=%d" % [triangles, (GRID_W - 1) * (GRID_H - 1) * 2])
	check("uv2_count", uv2_count == CELLS, "UV2 entries=%d expected=%d" % [uv2_count, CELLS])

	# UV2.x = donor tile id (world3d_terrain.gd:691-708); sandsea1/5/6 and
	# sandrock/rock ids must be reachable in the collar (DTRN-03 S5/M8).
	var hist := {}
	if uv2v is PackedVector2Array:
		var uv2: PackedVector2Array = uv2v
		for i in range(uv2.size()):
			var key := str(int(uv2[i].x))
			hist[key] = int(hist.get(key, 0)) + 1
	_m["uv2_x_hist"] = hist
	var has_sandsea := false
	for tid in SANDSEA_IDS:
		if hist.has(str(tid)):
			has_sandsea = true
	var has_sandrock_or_rock := false
	for tid in SANDROCK_IDS + ROCK_IDS:
		if hist.has(str(tid)):
			has_sandrock_or_rock = true
	check("shore_ids_in_uv2_histogram", has_sandsea and has_sandrock_or_rock,
		"sandsea1/5/6 present=%s sandrock*/rock* present=%s hist=%s" % [
			str(has_sandsea), str(has_sandrock_or_rock), str(hist)])
	var grass_count := int(_m.get("grass_cells", 0))
	var zero_excess := int(hist.get("0", 0)) - grass_count
	_m["tile0_excess_over_grass"] = zero_excess
	check("no_water_cell_tile0_clamp", zero_excess == 0,
		"UV2.x=0 count=%d minus grass cells=%d => %d; BLK_WATER clamps to grass1 "
			+ "(world3d_terrain.gd:697-702) — DTRN-03 W2/F2, expected pre-fix failure"
			% [int(hist.get("0", 0)), grass_count, zero_excess],
		"EXPECTED_PRE_FIX_FAILURE")

	# Donor literals read back from the live water material, with the stats
	# dictionary as a fallback (DTRN-03 S2; water3d.gd:147-168,214-222).
	var wmat: Material = null
	if _water_plane is MeshInstance3D:
		wmat = (_water_plane as MeshInstance3D).material_override
	_m["water_material"] = wmat.get_class() if wmat != null else "<none>"
	var literals := {
		"water_level": _uniform_float(wmat, "water_level"),
		"shore_height": _uniform_float(wmat, "shore_height"),
		"max_height": _uniform_float(wmat, "max_height"),
		"coast_fade_depth": _uniform_float(wmat, "coast_fade_depth"),
		"deep_fade_depth": _uniform_float(wmat, "deep_fade_depth"),
		"tex_scale_s": _uniform_float(wmat, "tex_scale_s"),
		"tex_scale_t": _uniform_float(wmat, "tex_scale_t"),
	}
	var expected := {
		"water_level": -0.25, "shore_height": -0.1, "max_height": 2.96,
		"coast_fade_depth": 0.57, "deep_fade_depth": 1.07,
		"tex_scale_s": 0.1, "tex_scale_t": 0.01,
	}
	for k in expected.keys():
		if literals[k] == null and water_stats.has("donor_literals"):
			var dl: Variant = water_stats.get("donor_literals")
			if dl is Dictionary and (dl as Dictionary).has(k):
				literals[k] = (dl as Dictionary)[k]
	_m["donor_literals_readback"] = literals
	var literals_ok := true
	for k in expected.keys():
		if not _float_eq(literals[k], float(expected[k])):
			literals_ok = false
	check("donor_literals_exact", literals_ok,
		"-0.25 / -0.1 / 2.96 / 0.57 / 1.07 / 0.1 / 0.01 from material or stats: %s"
			% str(literals))

	var wave_path := str(water_stats.get("wave_tex_path", ""))
	_m["wave_tex_path"] = wave_path
	check("wave_texture_diffusewaves0", wave_path.ends_with("diffusewaves0.png"),
		"wave_noise=%s (water3d.gd:77-81; DTRN-03 S3)" % wave_path)

	var particle := _uniform_float(wmat, "particle_amount")
	if particle == null:
		particle = 30.0
	_m["particle_amount"] = particle
	check("foam_not_added_by_test", _float_eq(particle, 30.0),
		"particle_amount=%s unchanged (this atom writes no shader parameter; "
			+ "DTRN-03 C22/F3 forbids inventing foam)" % str(particle))

	var rn: Array = _game.get("res_nodes") as Array if _game.get("res_nodes") is Array else []
	var entities: Array = _game.get("entities") as Array if _game.get("entities") is Array else []
	_m["res_nodes_count"] = rn.size()
	_m["entities_count"] = entities.size()
	check("no_trees_no_mines", rn.is_empty() and entities.is_empty(),
		"res_nodes=%d entities=%d (isolated shore row: no trees/mines/units)"
			% [rn.size(), entities.size()])

	# DTRN-03 C28/W1/F1: surface Y is the -0.25 classification literal, so
	# waveheight = clamp(-0.25*3-1.5,0,1) = 0 and the donor coarse swell is absent.
	var waveheight: Variant = water_stats.get("waveheight_from_donor_literal", null)
	if waveheight == null:
		waveheight = clampf(WATER_LEVEL * 3.0 - 1.5, 0.0, 1.0)
	_m["waveheight_from_donor_literal"] = waveheight
	check("donor_coarse_swell_present", not _float_eq(waveheight, 0.0),
		"waveheight=%s with surface Y=-0.25 (DTRN-03 W1/F1, water3d.gd:19,231, "
			+ "water3d.gdshader:156) — expected pre-fix failure" % str(waveheight),
		"EXPECTED_PRE_FIX_FAILURE")

	# DTRN-03 C29/W3/F3: shore_prox is labelled PORT ART in the shipped shader.
	var shader_abs := ProjectSettings.globalize_path(WATER_SHADER_PATH)
	var shader_text := ""
	if FileAccess.file_exists(shader_abs):
		shader_text = FileAccess.get_file_as_string(shader_abs)
	var has_shore_prox := shader_text.contains("shore_prox")
	_m["shader_has_shore_prox"] = has_shore_prox
	check("no_port_art_shore_prox", not has_shore_prox,
		"water3d.gdshader:209-217 shore_prox=%s (PORT ART multiplier absent in donor "
			+ "water.dev.frag:227) — expected pre-fix failure" % str(has_shore_prox),
		"EXPECTED_PRE_FIX_FAILURE")

	_setup_done = true
	if _headless:
		check("windowed_capture_available", false,
			"DisplayServer.get_name()==headless: no 3D PNG (main.gd:1157-1158,1790-1800)",
			"UNVERIFIED")
		for n in ["capture_image", "capture_saved", "png_full_width_dark_rows",
				"sample_coverage", "water_alpha_confined_to_cells", "water_animation_delta"]:
			check(n, false, "headless: windowed GPU readback not attempted", "UNVERIFIED")
		finish()
		return
	check("windowed_capture_available", true,
		"SubViewport %dx%d, fixed camera, no headless CPU fallback" % [
			WINDOW_SIZE.x, WINDOW_SIZE.y])
	_capture_stage = 1


func _process(_delta: float) -> bool:
	if _finished or _capture_stage != 1 or _capturing:
		return false
	_frame += 1
	if _frame >= CAPTURE_FRAMES:
		_capture_stage = 2
		_capture_sequence()
	return false
