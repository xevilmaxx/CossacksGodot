# ---------------------------------------------------------------------------
# Deterministic basin: water r<3.0 cells (~28 cells, well under 10% of 4096),
# wet sandsea band 3.0..3.8, sandrock collar 3.8..4.7, one rock sector
# 4.7..5.4, otherwise dry grass at ~0.55 m. Relief steps are << cDiff1=0.5
# (world3d_terrain.gd:117-118) so face promotion is not a confounding factor.
# ---------------------------------------------------------------------------
func _sector(dx: float, dz: float) -> int:
	var ang: float = atan2(dz, dx)
	return int(floor((ang + PI) / (PI / 4.0))) % 8


func _make_grid() -> void:
	_heights.resize(CELLS)
	_tileblock.resize(CELLS)
	var cx := float(GRID_W) * 0.5 - 0.5
	var cz := float(GRID_H) * 0.5 - 0.5
	var water := 0
	var grass := 0
	for z in range(GRID_H):
		for x in range(GRID_W):
			var i := z * GRID_W + x
			var dx := float(x) - cx
			var dz := float(z) - cz
			var r: float = sqrt(dx * dx + dz * dz)
			var s := _sector(dx, dz)
			var h: float
			var tid: int
			if r < 3.0:
				h = -0.55                       # below WATER_LEVEL (-0.25)
				tid = BLK_WATER                 # game.gd:52
				water += 1
			elif r < 3.8:
				h = -0.18                       # wet shore [-0.25, -0.1)
				tid = int(SANDSEA_BY_SECTOR[s])
			elif r < 4.7:
				h = 0.02                        # dry land above the shore
				tid = int(SANDROCK_IDS[s % SANDROCK_IDS.size()])
			elif r < 5.4 and s == 0:
				h = 0.08
				tid = int(ROCK_IDS[0])          # rock4 cliff face sector
			else:
				h = 0.55 + 0.02 * sin(float(x) * 0.13) + 0.01 * cos(float(z) * 0.11)
				tid = 0                         # grass1
				grass += 1
			_heights[i] = h
			_tileblock[i] = tid
	_m["water_cells"] = water
	_m["grass_cells"] = grass
	_m["water_cell_fraction"] = float(water) / float(CELLS)


