func _build_viewport() -> void:
	get_root().size = Vector2i(VIEW_W, VIEW_H)
	_vp = SubViewport.new()
	_vp.name = "P3_CaptureViewport"
	_vp.size = Vector2i(VIEW_W, VIEW_H)
	_vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	_vp.transparent_bg = false
	get_root().add_child(_vp)
	_vp.add_child(_terrain)
	_vp.add_child(_entities)

	_camera = Camera3D.new()
	_camera.name = "P3_FixedCamera"
	_camera.projection = Camera3D.PROJECTION_PERSPECTIVE
	var sensor_h: float = SENSOR_W_MM * float(VIEW_H) / float(VIEW_W)
	_camera.fov = rad_to_deg(2.0 * atan(sensor_h / (2.0 * FOCAL_LEN)))
	_camera.near = 0.1
	_camera.far = 600.0
	var tilt := deg_to_rad(TILT_DEG)
	_camera.position = Vector3(0.0, CAM_HEIGHT_M, CAM_HEIGHT_M / tan(tilt))
	_camera.rotation = Vector3(-tilt, 0.0, 0.0)
	_vp.add_child(_camera)
	_camera.make_current()


func _grab_image() -> Image:
	if _vp == null:
		return null
	var tex: Texture2D = _vp.get_texture()
	if tex == null:
		return null
	var img: Image = tex.get_image()
	if img == null or img.is_empty():
		return null
	return img


func _mine_screen_rect(cam: Camera3D) -> Rect2:
	if cam == null or _mine_world_positions.is_empty():
		return Rect2()
	var minx := INF
	var miny := INF
	var maxx := -INF
	var maxy := -INF
	for wp in _mine_world_positions:
		var sp: Vector2 = cam.unproject_position(wp)
		minx = minf(minx, sp.x)
		miny = minf(miny, sp.y)
		maxx = maxf(maxx, sp.x)
		maxy = maxf(maxy, sp.y)
	if minx == INF:
		return Rect2()
	return Rect2(minx - MINE_PX_MARGIN, miny - MINE_PX_MARGIN,
		(maxx - minx) + 2.0 * MINE_PX_MARGIN,
		(maxy - miny) + 2.0 * MINE_PX_MARGIN)


func _ground_stats(img: Image, mask: Rect2) -> Dictionary:
	if img == null or img.is_empty():
		return {}
	var im: Image = img.duplicate() as Image
	if im == null:
		return {}
	im.convert(Image.FORMAT_RGBA8)
	var w := im.get_width()
	var h := im.get_height()
	var n := 0
	var sum := 0.0
	var sumsq := 0.0
	for y in range(0, h, SAMPLE_STEP):
		for x in range(0, w, SAMPLE_STEP):
			if mask.has_point(Vector2(float(x), float(y))):
				continue
			var c: Color = im.get_pixel(x, y)
			var l: float = 0.299 * c.r * 255.0 + 0.587 * c.g * 255.0 + 0.114 * c.b * 255.0
			sum += l
			sumsq += l * l
			n += 1
	if n == 0:
		return {}
	var mean: float = sum / float(n)
	var variance: float = maxf(0.0, sumsq / float(n) - mean * mean)
	return {"samples": n, "mean_luma": mean, "variance": variance}


func _nonblack_fraction(img: Image) -> float:
	if img == null or img.is_empty():
		return 0.0
	var im: Image = img.duplicate() as Image
	if im == null:
		return 0.0
	im.convert(Image.FORMAT_RGBA8)
	var w := im.get_width()
	var h := im.get_height()
	var n := 0
	var bright := 0
	for y in range(0, h, SAMPLE_STEP):
		for x in range(0, w, SAMPLE_STEP):
			var c: Color = im.get_pixel(x, y)
			var l: float = 0.299 * c.r * 255.0 + 0.587 * c.g * 255.0 + 0.114 * c.b * 255.0
			n += 1
			if l > 8.0:
				bright += 1
	return float(bright) / float(maxi(n, 1))


func _capture_async() -> void:
	if _entities != null:
		_entities.visible = false
	await RenderingServer.frame_post_draw
	var base: Image = _grab_image()

	if _entities != null:
		_entities.visible = true
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var shot: Image = _grab_image()

	var nb := _nonblack_fraction(shot)
	var png_ok := false
	if shot != null and not shot.is_empty():
		_png_size = [shot.get_width(), shot.get_height()]
		var dir := _png_path.get_base_dir()
		if dir != "":
			DirAccess.make_dir_recursive_absolute(dir)
		png_ok = shot.save_png(_png_path) == OK
	_png_written = png_ok
	check("png_capture_windowed", png_ok and nb > 0.9,
		"png=" + _png_path + " written=" + str(png_ok)
		+ " nonblack_fraction=" + ("%.4f" % nb) + " (threshold >0.9)")

	var mask := _mine_screen_rect(_camera)
	var bs := _ground_stats(base, mask)
	var as_: Dictionary = _ground_stats(shot, mask)
	if bs.is_empty() or as_.is_empty() or mask.size.x <= 0.0 or mask.size.y <= 0.0:
		check("ground_luma_variance_outside_mine_bbox", true,
			"UNVERIFIED: two-frame readback or mine screen bbox unavailable; no numeric claim",
			"UNVERIFIED")
	else:
		var dmean: float = absf(float(as_.get("mean_luma", 0.0)) - float(bs.get("mean_luma", 0.0)))
		var dvar: float = absf(float(as_.get("variance", 0.0)) - float(bs.get("variance", 0.0)))
		check("ground_luma_variance_outside_mine_bbox",
			dmean <= LUMA_TOL and dvar <= VAR_TOL,
			"mask=" + str(mask) + " baseline=" + str(bs) + " with_mines=" + str(as_)
			+ " d_mean=%.4f d_var=%.4f tol=(%.1f,%.1f)" % [dmean, dvar, LUMA_TOL, VAR_TOL],
			"MEASURED")

	check("no_z_fighting_seam_visual", true,
		"VISUAL REVIEW REQUIRED: inspect " + _png_path
		+ " for mine/ground contact, z-fighting and seams; NO numeric proxy asserted",
		"UNVERIFIED__VISUAL_REVIEW_REQUIRED")
	finish()


func _process(_delta: float) -> void:
	if _finished or _headless or _capture_started:
		return
	_frame += 1
	if _frame >= CAPTURE_FRAME:
		_capture_started = true
		_capture_async()


# ------------------------------------------------------------------- setup
func _initialize() -> void:
	if _finished:
		return
	call_deferred("_failsafe")
	_headless = DisplayServer.get_name() == "headless"
	_png_path = _resolve_png_path()

	# Shared harness helper (single owner, TEST-00) via dynamic load. The helper
	# LANDED during authoring; its static factories are used below. If it is
	# missing/unloadable, the embedded minimal stub is used and labelled as such.
	_load_harness()

	var ts: Script = _load_script(TERRAIN_PATH)
	var es: Script = _load_script(ENTITIES_PATH)
	var modules_ok: bool = ts != null and es != null
	var module_detail := "both modules loaded dynamically via load() (no class_name)"
	if not modules_ok:
		module_detail = "MODULE_MISSING terrain=" + TERRAIN_PATH + " entities=" + ENTITIES_PATH
	check("module_load_and_api", modules_ok, module_detail)
	if not modules_ok:
		for n in ["p0_mesh_invariants", "no_water_cells", "ore_instance_counts",
			"category_purity", "mine_sid_resolution", "mine_y_matches_terrain",
			"env_scale_mine_from_code", "atom_completed"]:
			check(n, false, "MODULE_MISSING: cannot run assertion")
		finish()
		return

	_terrain = ts.new() as Node3D
	_entities = es.new() as Node3D
	if _terrain == null or _entities == null:
		check("module_load_and_api", false, "script.new() returned null")
		finish()
		return

	_make_heights()
	var res_nodes := _make_res_nodes()
	if _helper != null:
		var ccv: Variant = _helper.call("count_categories", res_nodes)
		if ccv is Dictionary:
			_helper_category_counts = ccv
	_game = _make_stub_game(res_nodes)
	get_root().add_child(_game)
	if _headless:
		get_root().add_child(_terrain)
		get_root().add_child(_entities)
	else:
		_build_viewport()

	_terrain.call("bind", _game)
	var built: bool = bool(_terrain.call("build"))
	check("build_ok", built, "world3d_terrain.build() -> " + str(built))
	if not built:
		for n in ["p0_mesh_invariants", "no_water_cells", "ore_instance_counts",
			"category_purity", "mine_sid_resolution", "mine_y_matches_terrain",
			"env_scale_mine_from_code", "atom_completed"]:
			check(n, false, "BUILD_FAILED: cannot run assertion")
		finish()
		return

	_entities.call("bind", _game)
	for item in _game.get("res_nodes"):
		_entities.call("add_resource", item)

	# ---- assertion 1: P0 mesh invariants (world3d_terrain.gd:785-826, :664-747)
	var tstats: Dictionary = _dict(_terrain.get("stats"))
	var ti: Dictionary = _dict(tstats.get("tile_index", null))
	var hist: Dictionary = _dict(tstats.get("tile_index_hist", null))
	var face: Dictionary = _dict(ti.get("face_hist", null))
	var atlas: Dictionary = _dict(tstats.get("atlas", null))
	var grid = atlas.get("grid", null)
	var grid_ok: bool = grid is Array and (grid as Array).size() == 2 \
		and int((grid as Array)[0]) == 16 and int((grid as Array)[1]) == 8
	var mesh_mi := _find_terrain_mesh(_terrain)
	var uv2_count := -1
	var uv2_bad := 0
	if mesh_mi != null and mesh_mi.mesh != null:
		var arr: Array = mesh_mi.mesh.surface_get_arrays(0)
		var uv2 = arr[Mesh.ARRAY_TEX_UV2]
		if uv2 != null:
			uv2_count = (uv2 as Array).size()
			for v in (uv2 as Array):
				var uv: Vector2 = v
				if absf(uv.x) > 1e-4 or absf(uv.y) > 1e-4:
					uv2_bad += 1
	var shadow_value := -1.0
	if mesh_mi != null and mesh_mi.mesh != null:
		var mat = mesh_mi.mesh.surface_get_material(0)
		if mat is ShaderMaterial:
			var sv = (mat as ShaderMaterial).get_shader_parameter("shadow_enabled")
			if sv != null:
				shadow_value = float(sv)
	var sun_shadow_nodes := 0
	var stack: Array[Node] = [_terrain]
	while not stack.is_empty():
		var nn: Node = stack.pop_back()
		if nn is DirectionalLight3D and (nn as DirectionalLight3D).shadow_enabled:
			sun_shadow_nodes += 1
		for c in nn.get_children():
			stack.append(c)
	var mesh_ok: bool = _int(tstats.get("mesh_surfaces", -1), -1) == 1 \
		and _int(tstats.get("mesh_vertices", -1), -1) == GRID_W * GRID_H \
		and _int(tstats.get("mesh_triangles", -1), -1) == (GRID_W - 1) * (GRID_H - 1) * 2 \
		and _int(tstats.get("tile_index_cells", -1), -1) == GRID_W * GRID_H \
		and uv2_count == GRID_W * GRID_H and uv2_bad == 0 \
		and hist.size() == 1 and _int(hist.get("0", -1), -1) == GRID_W * GRID_H \
		and face.size() == 1 and _int(face.get("0", -1), -1) == GRID_W * GRID_H \
		and grid_ok and shadow_value == 0.0 and sun_shadow_nodes == 0 \
		and mesh_mi != null and mesh_mi.cast_shadow == GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	check("p0_mesh_invariants", mesh_ok,
		"surfaces=%d verts=%d tris=%d uv2=%d uv2_bad=%d tile_hist=%s face_hist=%s "
		% [_int(tstats.get("mesh_surfaces", -1), -1),
			_int(tstats.get("mesh_vertices", -1), -1),
			_int(tstats.get("mesh_triangles", -1), -1),
			uv2_count, uv2_bad, str(hist), str(face)]
		+ "atlas_grid=%s shader_shadow=%s sun_shadows=%d"
		% [str(grid), str(shadow_value), sun_shadow_nodes])

	# ---- assertion 2: no water cells (all-grass, positive heights)
	var min_h: float = _float(tstats.get("height_min_m", -999.0), -999.0)
	var no_water: bool = min_h > WATER_LEVEL and not hist.has("255")
	check("no_water_cells", no_water,
		"height_min_m=%.4f water_level_m=%.4f BLK_WATER_cells=%d"
		% [min_h, WATER_LEVEL, _int(hist.get("255", 0), 0)])

	# ---- assertion 3: exact ore counts per type + category purity
	_counts = _resource_counts()
	var counts_ok: bool = _int(_counts.get("gold", -1), -1) == N_PER_TYPE \
		and _int(_counts.get("iron", -1), -1) == N_PER_TYPE \
		and _int(_counts.get("coal", -1), -1) == N_PER_TYPE
	check("ore_instance_counts", counts_ok,
		"expected %d per type; measured gold=%d iron=%d coal=%d total=%d"
		% [N_PER_TYPE, _int(_counts.get("gold", -1), -1),
			_int(_counts.get("iron", -1), -1), _int(_counts.get("coal", -1), -1),
			(int(_counts.get("gold", 0)) + int(_counts.get("iron", 0))
				+ int(_counts.get("coal", 0)))])
	var purity_ok: bool = _int(_counts.get("wood", -1), -1) == 0 \
		and _int(_counts.get("stone", -1), -1) == 0 \
		and _int(_counts.get("food", -1), -1) == 0
	var src_wood: int = _int(_helper_category_counts.get("wood", 0), 0)
	var src_stone: int = _int(_helper_category_counts.get("stone", 0), 0)
	var src_food: int = _int(_helper_category_counts.get("food", 0), 0)
	check("category_purity", purity_ok and src_wood == 0 and src_stone == 0 and src_food == 0,
		"rendered wood=%d stone=%d food=%d other=%d; source(helper) wood=%d stone=%d food=%d"
		% [_int(_counts.get("wood", -1), -1), _int(_counts.get("stone", -1), -1),
			_int(_counts.get("food", -1), -1), _int(_counts.get("other", -1), -1),
			src_wood, src_stone, src_food]
		+ " (tree*/rock*/stone/field sids forbidden)")

	# ---- assertion 4: mine sid resolution (game.gd:2685-2702, entities :1269-1283)
	var sid_ok := true
	var sid_detail: Array[String] = []
	for spec in MINE_SPECS:
		var pos := Vector2(float(spec[2]), float(spec[3]))
		var ty: String = str(spec[1])
		var want: String = "mine_" + ty
		var got_game: String = str(_game.call("resolve_mine_sid", "mine", pos))
		var got_ent: String = str(_entities.call("_resource_sid", ty, pos))
		var ok_one: bool = got_game == want and got_ent == want and not got_game.is_empty()
		if not ok_one:
			sid_ok = false
		sid_detail.append("%s@%s game=%s ent=%s want=%s %s"
			% [ty, str(pos), got_game, got_ent, want, "ok" if ok_one else "MISMATCH"])
	var unchanged: bool = str(_game.call("resolve_mine_sid", "hou", Vector2.ZERO)) == "hou"
	check("mine_sid_resolution", sid_ok and unchanged,
		"non-empty expected sids; unrelated sid unchanged=" + str(unchanged)
		+ " | " + " | ".join(sid_detail))

	# ---- assertion 5: mine Y == terrain.height_at_world() at its world XZ
	var slots = _dict(_entities.get("_slot"))
	var batches = _dict(_entities.get("_batches"))
	var y_ok := true
	_mine_y_detail.clear()
	for spec in MINE_SPECS:
		var eid: int = int(spec[0]) + 1
		var sl = slots.get(eid, null)
		var err := -1.0
		if sl is Dictionary:
			var key: String = str((sl as Dictionary).get("key", ""))
			var ix: int = int((sl as Dictionary).get("index", -1))
			var b = batches.get(key, null)
			if b is Dictionary:
				var xforms = (b as Dictionary).get("xforms", [])
				if xforms is Array and ix >= 0 and ix < (xforms as Array).size():
					var xf: Transform3D = (xforms as Array)[ix]
					var o: Vector3 = xf.origin
					var h: float = float(_terrain.call("height_at_world", Vector2(o.x, o.z)))
					err = absf(o.y - h)
					_mine_world_positions.append(o)
					if err > 1e-3:
						y_ok = false
					_mine_y_detail.append("%s id=%d y=%.6f terrain=%.6f err=%.6f"
						% [str(spec[1]), eid, o.y, h, err])
		else:
			y_ok = false
			_mine_y_detail.append("id=%d missing slot" % eid)
	check("mine_y_matches_terrain", y_ok and _mine_world_positions.size() == MINE_SPECS.size(),
		"eps=1e-3 m | " + " | ".join(_mine_y_detail))

	# ---- assertion 6: donor-grounded scale constant read from code, no parity claim
	var scale_read := -1.0
	if es.has_method("get_script_constant_map"):
		var cm = es.call("get_script_constant_map")
		if cm is Dictionary:
			var env: Dictionary = _dict((cm as Dictionary).get("ENV_SCALE", null))
			scale_read = _float(env.get("mine", -1.0), -1.0)
	if scale_read < 0.0:
		# Source-text fallback (still a code read, not a donor claim).
		var src := FileAccess.get_file_as_string(ProjectSettings.globalize_path(ENTITIES_PATH))
		if src.contains("\"mine\": 0.3152"):
			scale_read = ENV_SCALE_MINE_EXPECTED
	_env_scale_read = scale_read
	var scale_detail := "ENV_SCALE.mine read=%.6f expected=%.6f (world3d_entities.gd:113; " % [scale_read, ENV_SCALE_MINE_EXPECTED]
	scale_detail += "donor envscales.cfg:25-28 via mines_display.md:36-45); "
	scale_detail += "donor parity / jitter NOT verified in this atom"
	check("env_scale_mine_from_code",
		absf(scale_read - ENV_SCALE_MINE_EXPECTED) < 1e-9, scale_detail)

	check("atom_completed", true, "structural assertions completed; capture stage pending")
	if _headless:
		check("png_capture_windowed", true,
			"headless guard: 3D PNG readback skipped (no GPU canvas)",
			"HEADLESS_SKIP__PNG_UNVERIFIED")
		check("ground_luma_variance_outside_mine_bbox", true,
			"headless guard: no two-frame A/B available", "UNVERIFIED")
		check("no_z_fighting_seam_visual", true,
			"headless guard: no PNG for second-agent visual review",
			"UNVERIFIED__VISUAL_REVIEW_REQUIRED")
		finish()
		return
	# capture continues in _process(); finish() is called from _capture_async()
