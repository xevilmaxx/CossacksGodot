class StubGame extends Node:
	const TILE_M := 2.0
	const MINE_SITE_RADIUS := 4.0

	var MAP_W: int = 64
	var MAP_H: int = 64
	var height := PackedFloat32Array()
	var tileblock := PackedByteArray()
	var res_nodes: Array = []
	var res_dirty: int = 0
	var cmd_calls: Dictionary = {}

	func _bump(m: String) -> void:
		cmd_calls[m] = int(cmd_calls.get(m, 0)) + 1

	func total_cmd_calls() -> int:
		var n := 0
		for v in cmd_calls.values():
			n += int(v)
		return n

	func cmd_move(_a = null, _b = null, _c = null) -> void:
		_bump("cmd_move")

	func cmd_attack(_a = null, _b = null, _c = null) -> void:
		_bump("cmd_attack")

	func cmd_sow(_a = null, _b = null, _c = null) -> int:
		_bump("cmd_sow")
		return 0

	# Same recipe as world3d_terrain.height_at_world() (:887-903) for the world
	# point that world3d_entities._world_pos() produces (:1060-1079):
	#   world_x = p.x - MAP_W*TILE_M/2 -> fx = world_x/TILE_M + w/2 - 0.5 = p.x/TILE_M - 0.5
	func height_at(p: Vector2) -> float:
		if height.size() < MAP_W * MAP_H or MAP_W <= 0 or MAP_H <= 0:
			return 0.0
		var fx: float = clampf(p.x / TILE_M - 0.5, 0.0, float(MAP_W - 1))
		var fz: float = clampf(p.y / TILE_M - 0.5, 0.0, float(MAP_H - 1))
		var x0: int = int(fx)
		var z0: int = int(fz)
		var x1: int = mini(x0 + 1, MAP_W - 1)
		var z1: int = mini(z0 + 1, MAP_H - 1)
		var tx: float = fx - float(x0)
		var tz: float = fz - float(z0)
		var h00: float = height[z0 * MAP_W + x0]
		var h10: float = height[z0 * MAP_W + x1]
		var h01: float = height[z1 * MAP_W + x0]
		var h11: float = height[z1 * MAP_W + x1]
		return h00 + (h10 - h00) * tx + (h01 - h00) * tz \
			+ (h00 - h10 - h01 + h11) * tx * tz

	# Verbatim logic of game.gd:2685-2702 with its MINE_SITE_RADIUS (:19).
	func resolve_mine_sid(sid: String, pos: Vector2) -> String:
		if sid != "mine":
			return sid
		var best_type := ""
		var best_d := MINE_SITE_RADIUS
		for item in res_nodes:
			if not (item is Dictionary):
				continue
			var nd: Dictionary = item
			if int(nd.get("max_hits", 0)) != 0:
				continue
			var t: String = str(nd.get("type", ""))
			if t != "gold" and t != "iron" and t != "coal":
				continue
			var np: Vector2 = nd.get("pos", Vector2.ZERO)
			var d: float = np.distance_to(pos)
			if d < best_d:
				best_d = d
				best_type = t
		return "mine_" + best_type if best_type != "" else "mine_gold"


# ---------------------------------------------------------------- utilities
func check(name: String, cond: bool, detail: String = "", status: String = "") -> void:
	var rec: Dictionary = {"name": name, "passed": cond, "detail": detail}
	if status != "":
		rec["status"] = status
	_checks.append(rec)
	print("T_TERRAIN_MINES %s %s - %s%s" % [
		"PASS" if cond else "FAIL", name, detail,
		(" [" + status + "]") if status != "" else ""])
	if not cond:
		_ok = false


func _dict(v) -> Dictionary:
	if v is Dictionary:
		return v
	return {}


func _int(v, d: int) -> int:
	if v == null:
		return d
	return int(v)


func _float(v, d: float) -> float:
	if v == null:
		return d
	return float(v)


func _analytic_height(x: int, z: int) -> float:
	# Mild field: max per-cell delta ~0.013 << cDiff1=0.5 (world3d_terrain.gd:117),
	# min height 0.55 > WATER_LEVEL=-0.25 -> zero water cells by construction.
	return 1.0 + 0.25 * sin(float(x) * 0.05) + 0.20 * cos(float(z) * 0.04)


