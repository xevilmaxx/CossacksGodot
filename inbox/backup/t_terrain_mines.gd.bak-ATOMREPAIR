func _find_terrain_mesh(root: Node) -> MeshInstance3D:
	# Same selection rule as t_terrain3d.gd:130-151: the resident full-grid mesh
	# is the largest indexed surface (mine MultiMeshes are far smaller).
	var best: MeshInstance3D = null
	var best_verts := -1
	var stack: Array[Node] = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		if n is MeshInstance3D:
			var mi := n as MeshInstance3D
			var m: Mesh = mi.mesh
			if m is ArrayMesh and m.get_surface_count() > 0:
				var arr: Array = m.surface_get_arrays(0)
				var vs = arr[Mesh.ARRAY_VERTEX]
				var count: int = vs.size() if vs != null else 0
				if count > best_verts:
					best_verts = count
					best = mi
		for c in n.get_children():
			stack.append(c)
	return best


func _category_of_sid(sid: String) -> String:
	if sid.begins_with("tree"):
		return "wood"
	if sid.begins_with("rock") or sid == "stone":
		return "stone"
	if sid == "field":
		return "food"
	if sid.begins_with("mine_"):
		return sid.substr(5)
	return "other"


func _resource_counts() -> Dictionary:
	var out := {"gold": 0, "iron": 0, "coal": 0, "wood": 0,
		"stone": 0, "food": 0, "other": 0}
	if _entities == null:
		return out
	var batches = _entities.get("_batches")
	if not (batches is Dictionary):
		return out
	for k in (batches as Dictionary).keys():
		var key: String = str(k)
		if not key.begins_with("res|"):
			continue
		var b = (batches as Dictionary)[k]
		var n := 0
		if b is Dictionary:
			var ids = (b as Dictionary).get("ids", [])
			if ids is Array:
				n = (ids as Array).size()
		var cat := _category_of_sid(key.substr(4))
		out[cat] = int(out.get(cat, 0)) + n
	return out


func _resolve_png_path() -> String:
	var args := PackedStringArray(OS.get_cmdline_user_args())
	for i in range(args.size()):
		var a: String = args[i]
		if a.begins_with("--png="):
			return _abs_path(a.substr(6))
		if a == "--png" and i + 1 < args.size():
			return _abs_path(args[i + 1])
	return ProjectSettings.globalize_path(OUT_DIR + "/" + ID + ".png")


func _abs_path(p: String) -> String:
	if p.begins_with("res://"):
		return ProjectSettings.globalize_path(p)
	if not p.is_absolute_path():
		return ProjectSettings.globalize_path("res://").path_join(p)
	return p


func _result_path() -> String:
	return ProjectSettings.globalize_path(OUT_DIR + "/" + ID + ".json")


func finish() -> void:
	if _finished:
		return
	_finished = true
	var passes := 0
	for c in _checks:
		if bool(c.get("passed", false)):
			passes += 1
	var status := "WINDOWED_CAPTURE"
	if _headless:
		status = "HEADLESS_STRUCTURAL_ONLY__PNG_UNVERIFIED"
	elif not _png_written:
		status = "CAPTURE_FAILED__PNG_UNVERIFIED"
	var result := {
		"id": _id,
		"passed": _ok,
		"passes": passes,
		"total": _checks.size(),
		"checks": _checks,
		"status": status,
		"headless": _headless,
		"grid": {"w": GRID_W, "h": GRID_H, "cells": GRID_W * GRID_H},
		"harness_helper": {
			"path": HELPER_PATH,
			"status": _harness_status,
			"used": _helper != null,
			"note": ("shared helper static factories used; embedded stub kept as fallback"
				if _helper != null else
				"shared helper absent/unloadable -> minimal stub embedded in this atom"),
			"source_category_counts": _helper_category_counts,
		},
		"resources": {
			"per_type_expected": N_PER_TYPE,
			"counts": _counts,
			"mine_specs": MINE_SPECS,
			"mine_y_errors_m": _mine_y_detail,
		},
		"png": {
			"path": _png_path,
			"written": _png_written,
			"size": _png_size,
		},
		"donor_grounding": {
			"env_scale_mine_read_from_code": _env_scale_read,
			"donor_parity_claimed": false,
			"note": "ENV_SCALE.mine from world3d_entities.gd:113; donor envscales.cfg:25-28 cited via mines_display.md:36-45; jitter/visual parity NOT verified here",
		},
		"unix_ms": Time.get_unix_time_from_system() * 1000.0,
	}
	var abs_path := _result_path()
	DirAccess.make_dir_recursive_absolute(abs_path.get_base_dir())
	var f := FileAccess.open(abs_path, FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(result, "\t"))
		f.close()
	else:
		push_error(ID + ": cannot write result: " + abs_path)
	print("T_TERRAIN_MINES RESULT: %s %d/%d (%s)" % [
		"PASS" if _ok else "FAIL", passes, _checks.size(), status])
	call_deferred("quit", 0 if _ok else 1)


func _failsafe() -> void:
	if _finished:
		return
	check("atom_completed", false, "aborted before completion", "ABORTED")
	finish()


