func _load_harness() -> void:
	if not ResourceLoader.exists(HELPER_PATH):
		_harness_status = "ABSENT__EMBEDDED_MINIMAL_STUB"
		return
	var hs: Object = load(HELPER_PATH)
	if hs != null and hs.has_method("make_stub_game") and hs.has_method("count_categories"):
		_helper = hs
		_harness_status = "SHARED_HELPER_DYNAMIC_LOAD_USED: " + HELPER_PATH
	else:
		_harness_status = "LOAD_FAILED__EMBEDDED_MINIMAL_STUB"


func _make_heights() -> void:
	# Shared helper's static factory when present; local loop otherwise.
	if _helper != null and _helper.has_method("make_height"):
		var hv: Variant = _helper.call("make_height", GRID_W, GRID_H,
			Callable(self, "_analytic_height"))
		if hv is PackedFloat32Array:
			_heights = hv
			return
	_heights.resize(GRID_W * GRID_H)
	for z in range(GRID_H):
		for x in range(GRID_W):
			_heights[z * GRID_W + x] = _analytic_height(x, z)


func _make_res_nodes() -> Array:
	var nodes: Array = []
	for spec in MINE_SPECS:
		nodes.append({
			"id": int(spec[0]) + 1,
			"kind": "res",
			"type": str(spec[1]),
			"pos": Vector2(float(spec[2]), float(spec[3])),
			"hits": 0,
			"max_hits": 0,   # permanent ore deposit (world3d_entities.gd:1085-1090)
			"dead": false,
			"hidden": false,
		})
	return nodes


func _make_tileblock() -> void:
	_tileblock.resize(GRID_W * GRID_H)
	if _helper != null and _helper.has_method("make_tileblock"):
		var tv: Variant = _helper.call("make_tileblock", GRID_W, GRID_H, 0)
		if tv is PackedByteArray:
			_tileblock = tv
			return
	_tileblock.fill(0)   # donor tile 0 = grass1 (presets_summer.json:2)


func _make_stub_game(res_nodes: Array) -> Node:
	_make_tileblock()
	if _helper != null:
		var gv: Variant = _helper.call("make_stub_game", GRID_W, GRID_H,
			_heights, res_nodes, _tileblock)
		if gv is Object and is_instance_valid(gv):
			return gv
	# Fallback: same shape, embedded locally (noted in result JSON + report).
	var g := StubGame.new()
	g.MAP_W = GRID_W
	g.MAP_H = GRID_H
	g.height = _heights
	g.tileblock = _tileblock
	g.res_nodes = res_nodes
	g.dump = {
		"map_w": GRID_W, "map_h": GRID_H,
		"height": Marshalls.raw_to_base64(_heights.to_byte_array()),
		"tileblock": Marshalls.raw_to_base64(_tileblock),
	}
	g.res_dirty = 1
	return g


