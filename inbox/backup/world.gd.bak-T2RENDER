# World rendering: terrain, resources, units, buildings, fog, effects.
# Terrain uses the original grass/dirt/rock PNGs (app/assets/terrain, copied
# from data/terrain/tiles/textures/*.dds) at full detail: each map tile shows
# a random crop of the real texture, so fields look like the original instead
# of flat blocks. Buildings are drawn as top-down RTS shapes with a dirt
# ground-decal (like data/terrain/decals/buildings/*.dds), walls, roofs and
# player trim - not UI icons. Trees/rocks/corn are clustered props in the
# original palette roles.
extends Node2D
class_name C3World

const Data = preload("res://scripts/data.gd")

var game: C3Game
var hud: CanvasLayer
var view_scale := 16.0  # screen px per meter
var terrain_sprite: Sprite2D
var fog_sprite: Sprite2D
var fog_img: Image
var fog_tex: ImageTexture
var fog_explored: PackedByteArray = PackedByteArray()
var fog_vis: PackedByteArray = PackedByteArray()
var fog_counts: PackedInt32Array
var fog_timer := 0.0
const CHUNK_T := 32          # tiles per chunk side
var terrain_chunks: Dictionary = {}   # Vector2i -> Sprite2D
var terrain_order: Array = []         # LRU keys
# QA-1 / N-07: one-shot per-bake timing over the first 120 bakes. The runner
# harness only accepts an explicit BAKE_BENCH line; nothing here changes draw
# output or the 2-chunk/frame + LRU-24 amortisation below.
var bake_bench_count := 0
var bake_bench_total_us := 0
var bake_bench_max_us := 0
var bake_bench_done := false
var terrain_px := 16
var res_dirty := 0
var bld_dirty := 0
var dbg_res := 0
var dbg_bld := 0
var dbg_unit := 0
var dbg_fx := 0
var last_view_pos := Vector2.INF
var last_view_end := Vector2.INF
var terrain_hlv: Array = []
# Legacy slot: main.gd still assigns _build_masks()'s return here on quality
# changes, but no draw code reads it. The operative anti-seam path is
# _alpha_mask() inside _build_chunk(); _build_masks() now returns [].
var terrain_masks: Array = []
# ---- continuous terrain texturing (no per-tile crops: those checker) ----
# Each type owns one large mirror-tileable source (2048px, built once from the
# donor PNGs). Every chunk samples strictly wrap-continuous regions, so
# meadows flow across chunk borders with zero repetition seams. Type
# transitions share one feather mask; mottling uses a world-coherent mask.
const BLK_CACHE := 32
# TB-B1a/B1b + QA-P1: cap distinct block textures composited per chunk. 6/4
# was cold-cache dominated (645 ms bake); 3/2 still shows >=3 donor families
# plus the textured shore/cliff passes, but halves the blend/grid work.
const BLOCKS_PER_CHUNK := 3
const BLOCKS_PER_ROLE := 2
var blk_cache := {}
var blk_order: Array = []
var ter_water: Image         # diffusewaves2 (512²), mirror-normalised
# TB-B1c / W-6: two more distinct donor sheets, mirror-normalised through the
# same _mirror_tileable path (the 256² sources need upscaling to the 1024 grid).
var ter_wave0: Image         # diffusewaves0 (256²)
var ter_wave1: Image         # diffusewaves1 (256²)
var ter_blue: Image
var ter_blueA: Image
# One full-map canvas_item overlay: time advances every frame in sync(), so a
# stationary camera still shows moving water (TDR-4 W-1).
var water_overlay: Sprite2D = null
var water_mat: ShaderMaterial = null
const WATER_LEVEL := -0.25   # mapgen.gd WATER_DEEP: h below this is water
var ter_src := {}
var ter_white: Image
var ter_black: Image
var unit_layer: Node2D
var unit_anim_layer: Node2D   # baked unit sheets only: alpha-solid shader lives here
var pending_unit_sprites: Array = []
var bld_layer: Node2D
var res_layer: Node2D
var fx_layer: Node2D
var variants: Array = []  # per terrain type: Array of Image (16x16)
var fx_items: Array = []  # transient visual effects
var view_rect := Rect2(0, 0, 1, 1)
var sel_rect := Rect2(0, 0, 0, 0)
var sel_active := false
var anim_t := 0.0  # ambient animation clock (flags, water, idle bob)
# Original-model sprites (assets/models/sprites, rendered from the game's own
# .obj + .png by tools/render_models.py). Missing entries fall back to the
# procedural shapes below, so the game never draws blank.
var sprites: Dictionary = {}
# Animated original-model sheets (tools/bake_sprites.py): key -> {cell, actions}.
var anim_index := {}
var anim_tex := {}
# PORT-SIM P-10: yacht crew + static hull live in a separate naval index/sheet
# folder, like the nation-unique sheets. data.gd's EXTRA_ANIM_INDEX only loads
# sco_units.json, so world.gd reads the naval index itself (read-only).
var naval_index := {}

func _emit_bake_bench() -> void:
	# One line per process, ever. QA-1's harness parses this exact prefix;
	# chunks=120 is the bench contract, max/mean are the observed per-bake ms.
	if bake_bench_done or bake_bench_count == 0:
		return
	bake_bench_done = true
	print("BAKE_BENCH preset=low px=8 chunks=120 max_ms=%.2f mean_ms=%.2f" % [
		float(bake_bench_max_us) / 1000.0,
		float(bake_bench_total_us) / float(bake_bench_count) / 1000.0])

func _notification(what: int) -> void:
	# Static-camera captures bake far fewer than 120 chunks; flush whatever was
	# measured on exit so the harness still gets a numeric verdict instead of
	# UNVERIFIED. Same guard => at most one line, no per-frame prints.
	if what == NOTIFICATION_EXIT_TREE:
		_emit_bake_bench()

func _naval_info(key: String) -> Dictionary:
	if naval_index.is_empty():
		var path := "res://assets/models/anim/naval/index.json"
		if _res_exists(path):
			var parsed = JSON.parse_string(FileAccess.get_file_as_string(path))
			if parsed is Dictionary:
				naval_index = parsed
	return naval_index.get(key, {})
# Windmill sails are a separate moving object, exactly like the peasants'
# attach tools: tools/bake_mill_rotor.py lifts the donor's eurmilanim.oss rotor
# out of the tower sheet.  It spins over the finished mill every frame.
var mill_rotor_tex: Texture2D = null
const MILL_HUB := Vector2(0.525, 0.21)  # axle centre in the baked tower cell
const MILL_SPIN := 0.75                 # radians / second
# mill_rotor.json: the sail cell is 320 px at ortho 6.352 m.  The tower cell is
# also 320 px but at ortho 6.627 m (buildings.json) and is drawn at ortho*view_scale,
# so the rotor's true on-screen span is 6.352/6.627 of the tower cell, NOT half.
const MILL_ROTOR_ORTHO := 6.352
var ov_shadow: Texture2D
var ov_ring: Array = []
var ov_sel: Texture2D
const SPRITE_ALIAS := {"musk18": "serdiuk", "grenadier": "roundshier",
	"officer18": "officer", "drummer": "officer", "priest": "officer",
	"howitzer": "cannon", "mortar": "cannon"}
const SPRITE_TINT := {"priest": Color(0.25, 0.25, 0.3), "drummer": Color(1, 1, 1)}
# Donor data/game/var/envscales.cfg (DB fnd_26, evidence ev_2c4d3cf4…):
# minegold/mineiron/minecoal scale 0.3152, stones 0.329, fir 0.5; every entry
# carries minscale 0.85 / maxscale 1.15. The port's baked sprites are already
# authored at donor on-screen size, so the donor scale is the per-resource
# identity and its jitter band is applied deterministically (hash of world
# position) to the sprite height. Sim radii / collision are untouched.
const ENV_SCALE := {"mine": 0.3152, "stone": 0.329, "tree": 0.5}
const ENV_JITTER_MIN := 0.85
const ENV_JITTER_MAX := 1.15

func _env_sprite_h(base: float, kind: String, pos: Vector2) -> float:
	# `base` is the tuned height at jitter=1; native*scale reconstructs it,
	# then the donor's 0.85-1.15 jitter varies each object without flicker.
	var scale: float = float(ENV_SCALE.get(kind, 1.0))
	var native: float = base / scale
	return native * scale * lerpf(ENV_JITTER_MIN, ENV_JITTER_MAX, _hash(pos.x, pos.y))

func bind(g: C3Game, h: CanvasLayer = null) -> void:
	game = g
	hud = h
	view_scale = Data.PIXELS_PER_METER
	terrain_px = Data.TERRAIN_PX
	terrain_hlv = _prep_variants()
	# _build_masks() still builds the side-effect images _build_chunk() needs;
	# its returned array was dead and is no longer assigned here.
	_build_masks(_bake_px())
	# TB-B1c: build the per-tile water mask + the single animated overlay quad.
	_setup_water_overlay()
	# pre-warm the block LRU with the common meadow set so first paint
	# doesn't hitch on disk loads (one-time bind cost, not per-frame)
	for bn in ["grass1", "grass2", "ground1", "test7", "test8", "test9",
			"sand1", "rock1", "grass_ground1", "test2", "grass5", "rock9"]:
		_block_img(bn)
	# QA-P1: warm EVERY block family used by this map before the first chunk
	# bake. The cold path (1024² PNG decode + mirror-tile + adjust_bcs) is the
	# 640 ms hitch the N-07 harness measured; doing it once at bind keeps it
	# out of the 2-chunks/frame budget. Warm rare names first so the frequent
	# ones survive BLK_CACHE's LRU eviction.
	if game != null and game.tileblock.size() > 0:
		var warm_counts := {}
		for ti in game.tileblock.size():
			var bi: int = game.tileblock[ti]
			var bn: String = str(game.tbl_names[bi]) if bi < game.tbl_names.size() else "grass1"
			warm_counts[bn] = int(warm_counts.get(bn, 0)) + 1
		var warm_names: Array = warm_counts.keys()
		warm_names.sort_custom(func(a, b):
			return int(warm_counts[a]) < int(warm_counts[b]))
		for bn in warm_names:
			_block_img(str(bn))
	res_layer = Node2D.new()
	res_layer.z_index = 1
	add_child(res_layer)
	bld_layer = Node2D.new()
	bld_layer.z_index = 2
	add_child(bld_layer)
	unit_layer = Node2D.new()
	unit_layer.z_index = 3
	add_child(unit_layer)
	# Animated/static unit sprites go on their own child layer so the alpha
	# shader affects only the figures - contact shadows, rings, damage bars
	# and corpses stay on unit_layer with their intended transparency.
	unit_anim_layer = Node2D.new()
	unit_layer.add_child(unit_anim_layer)
	unit_anim_layer.draw.connect(_draw_unit_sprites)
	if Data.UNITS_OPAQUE:
		var sh := Shader.new()
		sh.code = """
shader_type canvas_item;
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	float a = smoothstep(0.12, 0.55, c.a);
	if (a <= 0.001) discard;
	vec3 rgb = c.rgb;
	float lum = dot(rgb, vec3(0.299, 0.587, 0.114));
	rgb = mix(vec3(lum), rgb, 1.18);      // a little more uniform colour
	rgb = min(rgb * 1.10, vec3(1.0));     // lift the donor's dark bake
	COLOR = vec4(rgb, a);
}
"""
		var mat := ShaderMaterial.new()
		mat.shader = sh
		unit_anim_layer.material = mat
	fx_layer = Node2D.new()
	fx_layer.z_index = 4
	add_child(fx_layer)
	res_layer.draw.connect(_draw_resources)
	bld_layer.draw.connect(_draw_buildings)
	unit_layer.draw.connect(_draw_units)
	fx_layer.draw.connect(_draw_fx)
	_load_sprites()
	ov_shadow = load("res://assets/ui/overlays/shadow.png")
	ov_ring = [load("res://assets/ui/overlays/ring_p0.png"), load("res://assets/ui/overlays/ring_p1.png")]
	ov_sel = load("res://assets/ui/overlays/ring_sel.png")
	var j := FileAccess.get_file_as_string(_anim_dir() + "/index.json")
	if j != "":
		var parsed = JSON.parse_string(j)
		if parsed is Dictionary:
			anim_index = parsed
	# P-41: nation-unique sheets (sco_highlandersword) live in a separate index,
	# loaded by game.gd setup. Call the idempotent loader here too so a world
	# bound standalone resolves the same sheets. The main 54-key index is untouched.
	Data.load_extra_anim_index()
	fog_explored.resize(game.MAP_W * game.MAP_H)
	fog_vis.resize(game.MAP_W * game.MAP_H)
	fog_counts.resize(game.MAP_W * game.MAP_H)
	fog_timer = Data.FOG_INTERVAL
	fog_img = Image.create(game.MAP_W, game.MAP_H, false, Image.FORMAT_RGBA8)
	fog_img.fill(Color(0, 0, 0, 0.78))
	fog_tex = ImageTexture.create_from_image(fog_img)
	fog_sprite = Sprite2D.new()
	fog_sprite.texture = fog_tex
	fog_sprite.centered = false
	fog_sprite.scale = Vector2(game.MAP_W * Data.TILE_M * view_scale / game.MAP_W, game.MAP_H * Data.TILE_M * view_scale / game.MAP_H)
	fog_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	fog_sprite.visible = Data.FOG_OF_WAR
	fog_sprite.z_index = 10
	add_child(fog_sprite)
	_update_fog()

func world_to_px(p: Vector2) -> Vector2:
	return p * view_scale

# Sprites rendered from the original models (see _load_sprites). Units face
# the camera of their movement direction; buildings/props use one view.
# TB-B1d: the 87 ASSET-2 env variants plus the 6 original env sids (93 total).
# Generated from explicit families so the whitelist stays in sync with the art.
func _env_sids() -> Array:
	var out := ["tree_fir", "tree_oak", "tree_pine", "rock", "stone", "field"]
	for base in ["tree_spruce", "tree_pinedry", "tree_pinesmall", "tree_firsmall", "tree_stump"]:
		for i in range(1, 5):
			out.append("%s%d" % [base, i])
	for group in [["rock_stones", 10], ["rock_smallstones", 6], ["rock_landstone", 4],
			["rock_sea", 6], ["rock_smallstonesea", 6], ["rock_stonessea", 10],
			["bush", 4], ["flower", 3], ["plantain", 3], ["reed", 3],
			["fern", 4], ["gift", 6]]:
		for i in range(1, int(group[1]) + 1):
			out.append("%s%d" % [group[0], i])
	out.append_array(["christmastree", "christmastreea"])
	return out

func _load_env_tex(path: String) -> Texture2D:
	# ASSET-2 ships .import files whose .ctex cache entries are absent from the
	# dev/headless import folder, so load() returns null for every new sprite.
	# Decode the source PNG directly when it is on disk; exported builds (no raw
	# PNG) keep the normal ResourceLoader path.
	if FileAccess.file_exists(path):
		var img := Image.load_from_file(ProjectSettings.globalize_path(path))
		if img != null and not img.is_empty():
			return ImageTexture.create_from_image(img)
	return load(path) as Texture2D

func _load_sprites() -> void:
	sprites.clear()
	var sids: Array = []
	for sid in Data.UNITS:
		sids.append(SPRITE_ALIAS.get(sid, sid))
	for sid in Data.BUILDINGS:
		if sid != "wal" and not sids.has(sid):
			sids.append(sid)
	for n in _env_sids():
		if not sids.has(n):
			sids.append(n)
	# NOTE: probe with _res_exists (ResourceLoader.exists for exported .pck
	# builds, FileAccess fallback for never-imported editor PNGs).
	for key in sids:
		var frames: Array = []
		var has_dir := false
		for d in 8:
			var p := "res://assets/models/sprites/%s_%03d.png" % [key, d * 45]
			if _res_exists(p):
				has_dir = true
				frames.append(load(p) as Texture2D)
			else:
				frames.append(null)
		if has_dir:
			sprites[key] = frames
		elif _res_exists("res://assets/models/sprites_hi/%s.png" % key):
			# 512 px CPU-Cycles rebake of the donor mesh (ASSET-2 env set).
			# Prefer hi-res for EVERY env sid, not just tree_*; the low-res
			# sprites/ copy stays as the fallback (rock/stone/field live there).
			sprites[key] = [_load_env_tex("res://assets/models/sprites_hi/%s.png" % key)]
		elif _res_exists("res://assets/models/sprites/%s.png" % key):
			sprites[key] = [_load_env_tex("res://assets/models/sprites/%s.png" % key)]
	# Loud, explicit report: a missing env sid must never be mistaken for a
	# successfully loaded prop (and never silently borrowed from another pool).
	var missing: Array = []
	for key in _env_sids():
		var fr: Array = sprites.get(key, [])
		if fr.is_empty() or fr[0] == null:
			missing.append(key)
	if not missing.is_empty():
		push_warning("world: env sprite sids did not resolve: %s" % str(missing))
	print("sprites: %d sets loaded (sids=%d)" % [sprites.size(), sids.size()])

func _unit_height(e: Dictionary) -> float:
	if e.def.get("artillery", false):
		return 1.5
	if e.def.get("cavalry", "") != "":
		return 2.3
	return 1.9

func _sprite_frames(sid: String) -> Array:
	# a baked animated sheet replaces the old static-sprite alias
	if not _anim_info(sid).is_empty():
		return sprites.get(sid, [])
	return sprites.get(SPRITE_ALIAS.get(sid, sid), [])

func _sprite_for(sid: String, face: float) -> Texture2D:
	var frames: Array = _sprite_frames(sid)
	if frames.is_empty():
		return null
	if frames.size() == 1:
		return frames[0]
	# camera azimuths run 0..315 every 45 deg; pick the view facing the unit
	var idx := int(fposmod(roundf(face / (PI / 4.0)), 8.0)) % 8
	return frames[idx]

# Single lookup for main (54-key) and nation-unique (sco_units.json) sheets.
# The extra index is a superset lookup only: it never overwrites anim_index.
func _anim_info(key: String) -> Dictionary:
	if anim_index.has(key):
		return anim_index[key]
	if Data.EXTRA_ANIM_INDEX.has(key):
		return Data.EXTRA_ANIM_INDEX[key]
	return _naval_info(key)

func _anim_key(sid: String, player: int) -> String:
	# nation-peasant visuals resolve first (ukr_peasant etc.), then the sid.
	# Consult both indexes so a nation-unique sheet (sco_highlandersword) is
	# found exactly like a main-index sheet; the extra index is checked last.
	var nat := ""
	if player >= 0 and player < Data.PLAYER_NATIONS.size():
		nat = str(Data.PLAYER_NATIONS[player])
	if nat != "":
		var nk := "%s_%s" % [nat, sid]
		if anim_index.has(nk) or Data.EXTRA_ANIM_INDEX.has(nk):
			return nk
	return sid

func _anim_action(e: Dictionary) -> String:
	if float(e.get("death_t", -1.0)) >= 0.0:
		return "death"
	var o: Dictionary = e.order
	var gt: float = game.time_s
	if o.type == "attack" and float(e.get("fire_t", -1.0)) >= 0.0 and gt - float(e.fire_t) < 0.9:
		return "attack"
	if not bool(e.get("moving", false)):
		# Donor AAF has separate work/construct clips (workwood 237-254 is the
		# axe chop, construct 186-198 the hammering). Loaded idles
		# (idlewood/idlefood/idlestone: sack/log on the back) show the load.
		if o.type == "gather":
			match str(o.get("res", "")):
				"wood": return "workwood"
				"food": return "workfood"
				"stone": return "workstone"
				_: return "workwood"
		if o.type == "build" or o.type == "repair":
			return "construct"
		var cy := str(e.get("carry_type", ""))
		if int(e.get("carry", 0)) > 0 and cy in ["wood", "food", "stone"]:
			return "idle" + cy
	if bool(e.get("moving", false)):
		var cy2 := str(e.get("carry_type", ""))
		if int(e.get("carry", 0)) > 0 and cy2 in ["wood", "food", "stone"]:
			return "walk" + cy2
		return "walk"
	return "idle"

func _anim_dir() -> String:
	if Data.SPRITE_CELL != 160:
		var d := "res://assets/models/anim%d" % Data.SPRITE_CELL
		if DirAccess.dir_exists_absolute(ProjectSettings.globalize_path(d)):
			return d
		if FileAccess.file_exists(d + "/index.json"):
			return d
	return "res://assets/models/anim"

# Sheet path for a resolved anim key. Nation-unique sheets in EXTRA_ANIM_INDEX
# ship at cell 160 in the main anim dir, so a quality preset that selects a
# smaller SPRITE_CELL still falls back there (mirrors the separate naval index).
func _anim_sheet(key: String, act: String) -> String:
	var path := "%s/%s_%s.png" % [_anim_dir(), key, act]
	if not _res_exists(path) and Data.EXTRA_ANIM_INDEX.has(key):
		return "res://assets/models/anim/%s_%s.png" % [key, act]
	if not _res_exists(path) and not _naval_info(key).is_empty():
		return "res://assets/models/anim/naval/%s_%s.png" % [key, act]
	return path

func _draw_anim(e: Dictionary, p: Vector2, tint: Color) -> bool:
	var key := _anim_key(e.sid, int(e.player))
	var info: Dictionary = _anim_info(key)
	if info.is_empty():
		return false
	var act := _anim_action(e)
	# Naval yachts ship only a walk clip (naval/index.json): a resting ship
	# still draws that sheet instead of falling through to an absent idle.
	if not info.actions.has(act) and info.actions.has("walk") and bool(e.get("def", {}).get("naval", false)):
		act = "walk"
	# Fallback chain for sheets a unit does not have: carry walks fall back
	# to plain walk, carry idles to plain idle, work/construct to the attack
	# clip and finally idle (old sheets without carry clips keep working).
	if not info.actions.has(act):
		if act in ["walkwood", "walkfood", "walkstone"]:
			act = "walk"
		elif act in ["idlewood", "idlefood", "idlestone"]:
			act = "idle"
	if not info.actions.has(act):
		act = "attack" if act in ["workwood", "workfood", "workstone", "construct"] else "idle"
	var a: Dictionary = info.actions.get(act, info.actions.get("idle", {}))
	if a.is_empty():
		return false
	var tk := key + "_" + act
	if not anim_tex.has(tk):
		var path := _anim_sheet(key, act)
		if not _res_exists(path):
			return false
		anim_tex[tk] = load(path)
	var tex: Texture2D = anim_tex[tk]
	if tex == null:
		anim_tex.erase(tk)
		return false
	var cell: int = int(info.cell)
	var n: int = int(a.frames)
	var gt: float = game.time_s
	var t0: float = float(e.get("death_t", -1.0)) if act == "death" else (float(e.get("fire_t", -1.0)) if act == "attack" and e.order.type == "attack" else -1.0)
	var fi: int
	# per-entity phase so armies don't march in lockstep (donor units are
	# desynced; the old global anim_t made whole lines lift legs together).
	var phase: float = fposmod(float(int(e.get("id", 0))) * 0.61803, 1.0) * maxf(0.05, float(a.get("duration", 1.0)))
	if t0 >= 0.0:
		fi = mini(n - 1, int((gt - t0) / maxf(0.05, float(a.duration)) * n))
	else:
		fi = int((anim_t + phase) / maxf(0.05, float(a.duration)) * n) % n
	var dir := posmod(int(fposmod(roundf(float(e.get("face", 0.0)) / (PI / 4.0)), 8.0)) + 4, 8)
	var src := Rect2(dir * cell, fi * cell, cell, cell)
	# True donor scale: each group (stand/death) shares one baked ortho (world
	# meters across one cell), so walk/idle/attack/work/construct keep one
	# body size and one ground anchor. The anchor is the projected world
	# origin (ax/ay in index.json), identical for every action/dir in the
	# group: feet never slide when the pose changes. The old ink-union
	# cx/foot moved with pikes and hammers, shifting soldiers off their tile
	# and shrinking peasants when they started building.
	var fig_h: float = float(a.get("fig_h", 1.0))
	var foot: float = float(a.get("ay", a.get("foot", 0.82)))
	var cx: float = float(a.get("ax", a.get("cx", 0.5)))
	var sc: float
	var o: float = float(a.get("ortho", info.get("ortho", 0.0)))
	if o > 0.0:
		sc = o * view_scale / maxf(8.0, float(cell))
	else:
		sc = _unit_height(e) * view_scale / maxf(8.0, float(cell) * fig_h)
	var sz := Vector2(cell, cell) * sc
	var tl := p - Vector2(sz.x * cx, sz.y * foot)
	# UNIT_SCALE keeps figures in step with the donor-scale buildings: the
	# ortho already gives true world size, this is a uniform visual multiplier
	# around the sprite's ground anchor (no feet sliding).
	sc *= Data.UNIT_SCALE
	sz = Vector2(cell, cell) * sc
	tl = p - Vector2(sz.x * cx, sz.y * foot)
	pending_unit_sprites.append({"tex": tex, "dst": Rect2(tl, sz), "src": src, "tint": tint})
	return true

func _bld_key(e: Dictionary) -> String:
	# nation sheet (assets/models/anim, lazy) wins, else the shared static one
	var nat := ""
	if int(e.player) >= 0 and int(e.player) < Data.PLAYER_NATIONS.size():
		nat = str(Data.PLAYER_NATIONS[int(e.player)])
	if nat != "":
		var nk := "%s_%s" % [nat, e.sid]
		if _res_exists("%s/%s.png" % [_anim_dir(), nk]):
			return nk
	return e.sid

func _mill_rotor() -> Texture2D:
	if mill_rotor_tex == null:
		var path := "%s/mill_rotor.png" % [_anim_dir()]
		if _res_exists(path):
			mill_rotor_tex = load(path) as Texture2D
	return mill_rotor_tex

# Draw the windmill's sail assembly as a separate spinning object (the donor
# keeps it as an attach, like the peasant tools).  A face-on bake is squashed
# by the caller's cell scale and rotated around the cap axle, so the four
# lattice blades sweep across the tower instead of sitting frozen in the art.
func _draw_mill_rotor(layer: Node2D, tl: Vector2, sz: Vector2, tint: Color) -> void:
	var tex := _mill_rotor()
	if tex == null:
		return
	# sz is the tower cell drawn at true donor scale (sz = tower_ortho * view_scale).
	# Both sheets are 320 px cells, so the sail cell must span rotor_ortho * view_scale
	# px.  The old sz*0.5 rect was ~half that: the reported undersized sail that
	# read as buried in the roof.  The texture's own alpha bbox (8,22,312,283) is
	# centred, so drawing the cell rect about the axle puts the blades on the hub.
	var span := MILL_ROTOR_ORTHO * view_scale
	var half := Vector2(span, span) * 0.5
	var hub := tl + Vector2(sz.x * MILL_HUB.x, sz.y * MILL_HUB.y)
	layer.draw_set_transform(hub, anim_t * MILL_SPIN, Vector2.ONE)
	layer.draw_texture_rect(tex, Rect2(-half.x, -half.y, half.x * 2.0, half.y * 2.0), false, tint)
	layer.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

func _bld_anim(key: String) -> Texture2D:
	# lazy nation-sheet loading (like unit anims): only drawn buildings cost
	if anim_tex.has(key):
		var t: Texture2D = anim_tex[key]
		if t == null:
			anim_tex.erase(key)
			return null
		return t
	var path := "%s/%s.png" % [_anim_dir(), key]
	if not _res_exists(path):
		return null
	anim_tex[key] = load(path)
	var t2: Texture2D = anim_tex[key]
	if t2 == null:
		anim_tex.erase(key)
		return null
	return t2

var bld_scale_idx := {}
func _bld_scale(key: String) -> Dictionary:
	# true-scale drawing data (tools/compute_buildings.py): ortho + ink box
	# of the baked sheet -> screen pixels per sheet pixel + anchor fractions.
	if bld_scale_idx.is_empty():
		var j := FileAccess.get_file_as_string(_anim_dir() + "/buildings.json")
		if j != "":
			var parsed = JSON.parse_string(j)
			if parsed is Dictionary:
				bld_scale_idx = parsed
	if not bld_scale_idx.has(key):
		return {}
	var e: Dictionary = bld_scale_idx[key]
	var cell: float = float(e.get("cell", 320.0))
	var ink: Array = e.get("ink", [0, 0, cell, cell])
	var sc: float = float(e.get("ortho", 10.0)) * view_scale / maxf(8.0, cell)
	return {"sc": sc, "cell": cell,
		"cx": float(e.get("cx", (float(ink[0]) + float(ink[2])) * 0.5 / cell)),
		"foot": float(ink[3]) / cell,
		"rm": float(e.get("rm", 0.0)),
		"w": (float(ink[2]) - float(ink[0])) * sc}

var decal_tex: Dictionary = {}
var gain_map: Image = null  # coarse meadow-gain tile, baked once and shared by all chunks

# Meadow gain in tile space (wavelength ~9 tiles like the original patches).
# Precomputed once into an 80x80 map so chunk bakes stay cheap: per-chunk
# noise would stall the 2-chunk/frame budget and cost startup FPS.
func _gain_at(tx: float, ty: float) -> float:
	if gain_map == null:
		gain_map = Image.create(80, 80, false, Image.FORMAT_R8)
		for y in 80:
			for x in 80:
				gain_map.set_pixel(x, y, Color(1.0 + 0.085 * _wnoise(float(x) * 0.44, float(y) * 0.44), 0, 0))
	var gx := clampi(int(tx / 4.0), 0, 79)
	var gy := clampi(int(ty / 4.0), 0, 79)
	return gain_map.get_pixel(gx, gy).r
var blob_tex: Texture2D = null

# Soft round blob (white with radial alpha): one shared texture for all
# ground shadows and dirt patches — a single blit each, no per-frame
# polygon loops (those cost milliseconds every frame over hundreds of trees).
func _blob() -> Texture2D:
	if blob_tex != null:
		return blob_tex
	var im := Image.create(64, 64, false, Image.FORMAT_RGBA8)
	for y in 64:
		for x in 64:
			var d := Vector2(float(x) - 31.5, float(y) - 31.5).length() / 32.0
			var a := clampf(1.0 - d, 0.0, 1.0)
			im.set_pixel(x, y, Color(1, 1, 1, a * a))
	blob_tex = ImageTexture.create_from_image(im)
	return blob_tex

func _blob_rect(layer: Node2D, p: Vector2, rx: float, ry: float, col: Color) -> void:
	var b := _blob()
	if b == null:
		return
	layer.draw_texture_rect(b, Rect2(p.x - rx, p.y - ry, rx * 2.0, ry * 2.0), false, col)

# Original dirt plates under buildings (data/terrain/decals/buildings), keyed
# {nation}{sid} like the source files (rushoud, ukrcend...). Mines use the ore
# name (eurgold). Converted to PNG by copy_assets; missing keys fall back to
# the procedural dirt ellipse. bar18 is baked from donor ba2, so it shares
# that plate.
const BLD_DECAL_ALIAS := {"bar18": "ba2"}
func _bld_decal(nat: String, sid: String) -> Texture2D:
	var key := "%s%s" % [nat, str(BLD_DECAL_ALIAS.get(sid, sid))]
	if decal_tex.has(key):
		return decal_tex[key] as Texture2D
	var path := "res://assets/terrain/decals_png/%s%sd.png" % [nat, sid]
	var tex: Texture2D = null
	if _res_exists(path):
		tex = load(path) as Texture2D
	decal_tex[key] = tex
	return tex

func _bld_tex(e: Dictionary) -> Texture2D:
	var bk := _bld_key(e)
	if not e.finished:
		# construction stages baked by tools/bake_sprites.py --buildings
		var si := clampi(int(float(e.progress) / maxf(1.0, float(e.def.build_time)) * 4.0), 0, 3) + 1
		var st := _bld_anim("%s_s%d" % [bk, si])
		if st != null:
			return st
	var s0 := _sprite_for(bk, -1)
	if s0 != null:
		return s0
	return _bld_anim(bk)

func _draw_sprite(layer: Node2D, tex: Texture2D, p: Vector2, world_h: float, tint := Color(1, 1, 1), shadow := true) -> void:
	# world_h: how tall the figure should stand, in meters. The texture is
	# scaled to that height (footprint-derived sizes stay proportional like
	# the original: hut < town hall < cathedral) and anchored with the foot
	# at the logical position, like the unit animator does.
	var px_h: float = world_h * view_scale
	var sc: float = px_h / maxf(1.0, float(tex.get_height()))
	var sz := Vector2(float(tex.get_width()), float(tex.get_height())) * sc
	var top_left := p - Vector2(sz.x * 0.5, sz.y * 0.82)
	if shadow and Data.QUALITY != "low" and Data.SHOW_CENTROIDS:
		layer.draw_circle(p + Vector2(1.0, 2.0), sz.x * 0.22, Color(0, 0, 0, 0.16))
	layer.draw_texture_rect(tex, Rect2(top_left, sz), false, tint)

# Ground-plane ellipse (filled or ring): the map reads as tilted 2:1 like
# the original, so footprints, dirt and ghost rings squash vertically.
func _ground_ellipse(layer: Node2D, p: Vector2, rx: float, ry: float, col: Color, width := -1.0) -> void:
	var pts := PackedVector2Array()
	for i in range(25):
		var a := TAU * float(i) / 24.0
		pts.append(p + Vector2(cos(a) * rx, sin(a) * ry))
	if width < 0.0:
		layer.draw_colored_polygon(pts, col)
	else:
		pts.append(pts[0])
		layer.draw_polyline(pts, col, width)

func _src(path: String) -> Image:
	var tex: Texture2D = load(path)
	if tex == null:
		return null
	var im: Image = tex.get_image()
	if im == null:
		return null
	if im.get_format() != Image.FORMAT_RGB8:
		im.convert(Image.FORMAT_RGB8)
	return im

func _crop_variant(base: Image, rng_seed: int) -> Image:
	# random crop of the real texture -> 16x16 tile (chunk tiles are 16px, so
	# no upscale blur), with gentle shade variation (kept tight so neighbours
	# do not checker like before)
	var r := RandomNumberGenerator.new()
	r.seed = rng_seed
	var bw := base.get_width()
	var bh := base.get_height()
	var cs := mini(192, mini(bw, bh) - 4)
	var ox := r.randi() % maxi(1, bw - cs)
	var oy := r.randi() % maxi(1, bh - cs)
	var im := base.get_region(Rect2i(ox, oy, cs, cs))
	im.resize(16, 16, Image.INTERPOLATE_BILINEAR)
	var shade := 0.99 + 0.02 * r.randf()
	im.adjust_bcs(shade, 1.0, 1.0)
	return im

func _tint(im: Image, mul: Color) -> Image:
	var c := im.duplicate() as Image
	for y in c.get_height():
		for x in c.get_width():
			var p := c.get_pixel(x, y)
			c.set_pixel(x, y, Color(p.r * mul.r, p.g * mul.g, p.b * mul.b))
	return c

func _mirror_tileable(src: Image, size: int) -> Image:
	# mirror-assembled seamless tile: right half = flipped X, bottom = flipped
	# Y, corner = both. Any wrapped crop of the result is seamless.
	var out := Image.create(size, size, false, Image.FORMAT_RGB8)
	var q := size / 2
	var a := src.duplicate() as Image
	if a.get_width() != q or a.get_height() != q:
		a.resize(q, q, Image.INTERPOLATE_BILINEAR)
	var fh := a.duplicate() as Image
	fh.flip_x()
	var fv := a.duplicate() as Image
	fv.flip_y()
	var fb := a.duplicate() as Image
	fb.flip_x()
	fb.flip_y()
	out.blit_rect(a, Rect2i(0, 0, q, q), Vector2i(0, 0))
	out.blit_rect(fh, Rect2i(0, 0, q, q), Vector2i(q, 0))
	out.blit_rect(fv, Rect2i(0, 0, q, q), Vector2i(0, q))
	out.blit_rect(fb, Rect2i(0, 0, q, q), Vector2i(q, q))
	return out

func _wrap_crop(src: Image, ox: int, oy: int, s: int) -> Image:
	# seamless crop: modular multi-blits over the tileable source
	var n := src.get_width()
	ox = posmod(ox, n)
	oy = posmod(oy, n)
	var out := Image.create(s, s, false, Image.FORMAT_RGB8)
	var x := 0
	while x < s:
		var sx: int = (ox + x) % n
		var w: int = mini(s - x, n - sx)
		var y := 0
		while y < s:
			var sy: int = (oy + y) % n
			var h: int = mini(s - y, n - sy)
			out.blit_rect(src, Rect2i(sx, sy, w, h), Vector2i(x, y))
			y += h
		x += w
	return out

func _load_image_tex(path: String) -> Image:
	# Export-safe: res:// PNGs ship as imported CompressedTexture2D, not raw
	# files. Image.load(path) warns ("Loaded resource as image file...") and
	# fails in exported builds; Texture2D.get_image() works in both.
	var tex: Texture2D = ResourceLoader.load(path) as Texture2D
	if tex == null:
		return null
	return tex.get_image()

func _res_exists(path: String) -> bool:
	# Export-safe existence probe for res:// imported assets.
	return ResourceLoader.exists(path) or FileAccess.file_exists(path)

# TB-B1c / W-6: load a donor wave sheet and normalise it through the same
# mirror-tile path the land blocks use, so the GPU shader can wrap it with
# fract() without a seam. The two 256² sheets are upscaled to the 1024 grid.
func _wave_sheet(path: String) -> Image:
	var im: Image = _load_image_tex(path)
	if im == null:
		return null
	if im.get_format() != Image.FORMAT_RGB8:
		im.convert(Image.FORMAT_RGB8)
	return _mirror_tileable(im, 1024)

func _prep_variants() -> Array:
	# water wave art only; land renders from TileBlock images (LRU).
	# Three distinct donor sheets now feed the GPU overlay (TDR-4 W-6):
	# diffusewaves0/1 (256², normalised here) and diffusewaves2 (512²).
	ter_water = _wave_sheet("res://assets/terrain/water_png/diffusewaves2.png")
	ter_wave0 = _wave_sheet("res://assets/terrain/water_png/diffusewaves0.png")
	ter_wave1 = _wave_sheet("res://assets/terrain/water_png/diffusewaves1.png")
	if ter_water == null:
		ter_water = Image.create(64, 64, false, Image.FORMAT_RGB8)
		ter_water.fill(Color(0.2, 0.35, 0.5))
	if ter_wave0 == null:
		ter_wave0 = ter_water
	if ter_wave1 == null:
		ter_wave1 = ter_water
	variants = [[], [], [], [], [], []]
	# Water is now animated per frame in shaders/water_overlay.gdshader; the old
	# terrain-3 four-crop "phase variant" set was never read by any draw path
	# and has been removed (TDR-4 §5/§7 W-1).
	terrain_hlv = []
	return []

# TB-B1c: one full-map canvas_item overlay quad. A single RGBA8 mask image
# (one pixel per tile) carries coverage + two depth proxies; the GPU shader
# adds moving waves, depth tint, glints and foam every frame. No chunk is
# re-baked per frame: the 2-chunk/frame cap and LRU 24 in
# _sync_terrain_chunks() stay untouched (N-07 perf gate).
func _setup_water_overlay() -> void:
	if water_overlay != null and is_instance_valid(water_overlay):
		water_overlay.queue_free()
	water_overlay = null
	water_mat = null
	if game == null:
		return
	var shader_path := "res://shaders/water_overlay.gdshader"
	if not _res_exists(shader_path):
		return
	var sh := load(shader_path) as Shader
	if sh == null:
		return
	water_mat = ShaderMaterial.new()
	water_mat.shader = sh
	# env/lights/light.cfg Position (-0.3447, 0.9387, 0) maps to the donor's
	# lightVector (-0.086, 0, 0.939): almost straight up, not from global y.
	water_mat.set_shader_parameter("sun_dir", Vector2(-0.3447 / 4.0, 0.9387))
	water_mat.set_shader_parameter("map_size", Vector2(float(game.MAP_W), float(game.MAP_H)))
	water_mat.set_shader_parameter("tile_m", Data.TILE_M)
	water_mat.set_shader_parameter("wave0", ImageTexture.create_from_image(ter_wave0))
	water_mat.set_shader_parameter("wave1", ImageTexture.create_from_image(ter_wave1))
	water_mat.set_shader_parameter("wave2", ImageTexture.create_from_image(ter_water))
	# T2-BUILD-WATER: donor nautic() foam reuses waveMap = diffusewaves0, not
	# the bright fine diffusewaves2 dither (43% clipped) that inflated glints.
	water_mat.set_shader_parameter("foam_tex", ImageTexture.create_from_image(ter_wave0))
	water_mat.set_shader_parameter("time", anim_t)

	# R = coverage (type-3 grid), G = depth/1.07, B = depth/0.57, A = 1.
	# T2-BUILD-WATER: bake depth at SUB-TILE resolution (4 samples/tile) so the
	# 0.57 m foam/alpha ramp spans ~8 px at 16 px/m instead of one 32-px tile
	# step. Coverage stays tile-granular but LINEAR filtering now feathers it
	# over a quarter tile (verdict_water G4/G6, WATER_DEEP D7/M9). This runs
	# once at setup; the 2-chunk/frame cap and LRU 24 are untouched (N-07).
	var sub := 4
	var mask := Image.create(game.MAP_W * sub, game.MAP_H * sub, false, Image.FORMAT_RGBA8)
	for y in game.MAP_H * sub:
		for x in game.MAP_W * sub:
			var tx: int = mini(int(floor(float(x) / float(sub))), game.MAP_W - 1)
			var ty: int = mini(int(floor(float(y) / float(sub))), game.MAP_H - 1)
			var i: int = game._t(tx, ty)
			var wet: float = 1.0 if int(game.terrain[i]) == 3 else 0.0
			var wp := Vector2(float(x) / float(sub) * Data.TILE_M, float(y) / float(sub) * Data.TILE_M)
			var dep: float = maxf(0.0, WATER_LEVEL - game.height_at(wp))
			mask.set_pixel(x, y, Color(wet, clampf(dep / 1.07, 0.0, 1.0), clampf(dep / 0.57, 0.0, 1.0), 1.0))
	var mask_tex := ImageTexture.create_from_image(mask)

	water_overlay = Sprite2D.new()
	water_overlay.texture = mask_tex
	water_overlay.centered = false
	water_overlay.position = Vector2.ZERO
	# Sub-tile mask has 4 samples per tile: each mask pixel spans 1/4 tile.
	water_overlay.scale = Vector2(Data.TILE_M * view_scale / float(sub), Data.TILE_M * view_scale / float(sub))
	water_overlay.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	water_overlay.material = water_mat
	water_overlay.z_index = -9   # above baked terrain (-10), below resources (1)
	add_child(water_overlay)

func _block_img(nm: String) -> Image:
	# TileBlock art, mirror-tiled to 1024 (seamless wrap sampling).
	var hit: Image = blk_cache.get(nm, null)
	if hit != null:
		blk_order.erase(nm)
		blk_order.append(nm)
		return hit
	var im: Image = _load_image_tex("res://assets/terrain/blocks/%s.png" % nm)
	if im == null:
		im = Image.create(64, 64, false, Image.FORMAT_RGB8)
		im.fill(Color(0.4, 0.45, 0.25))
	if im.get_format() != Image.FORMAT_RGB8:
		im.convert(Image.FORMAT_RGB8)
	im = _mirror_tileable(im, 1024)
	# donor tiles are deliberately low-contrast; lift the grain once per block
	# (cheap) instead of per cell (which would reintroduce tile borders).
	im.adjust_bcs(1.0, 1.12, 1.0)
	blk_cache[nm] = im
	blk_order.append(nm)
	while blk_order.size() > BLK_CACHE:
		var old: String = blk_order.pop_front()
		blk_cache.erase(old)
	return im

func _chunk_key(cx: int, cy: int) -> Vector2i:
	return Vector2i(cx, cy)

func _bake_px() -> int:
	# 64 px per 2 m cell keeps the donor's grass grain at game zoom; 32 px
	# made the meadow read as a blurry green wash instead of real terrain.
	return mini(terrain_px * 4, 64)

func _build_masks(px: int) -> Array:
	# The dmask ramp array this function used to return was assigned to
	# `terrain_masks` (world.gd bind / main.gd quality change) but no draw
	# code ever read it. The operative seam defence is _alpha_mask() in
	# _build_chunk: it writes coverage into the mask's ALPHA channel, which
	# is what Godot's blend_rect_mask actually samples (NOT the red channel).
	# Keep only the side-effect images _build_chunk still consumes and return
	# an empty legacy array so main.gd's assignment stays harmless.
	ter_white = Image.create(px, px, false, Image.FORMAT_RGB8)
	ter_white.fill(Color(1, 1, 1))
	ter_black = Image.create(px, px, false, Image.FORMAT_RGB8)
	ter_black.fill(Color(0, 0, 0))
	ter_blue = Image.create(px, px, false, Image.FORMAT_RGB8)
	ter_blue.fill(Color(0.16, 0.36, 0.44))
	# blend_rect_mask reads the mask's ALPHA channel: dither the uniform alpha
	# (bayer 60% density) so the downsample resolve reads it as a true 60%
	# blue glaze over the waves (resolved before the final chunk resize)
	ter_blueA = Image.create(px, px, false, Image.FORMAT_RGBA8)
	var bayer := [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5]
	for yy in px:
		for xx in px:
			var on: float = 1.0 if float(bayer[(yy % 4) * 4 + (xx % 4)]) / 16.0 < 0.6 else 0.0
			ter_blueA.set_pixel(xx, yy, Color(1, 1, 1, on))
	return []

# blend_rect_mask reads the MASK'S ALPHA channel. Build one at tile-grid size
# with the value in alpha, then upscale bilinearly: smooth, cheap, no noise.
func _alpha_mask(grid: Image, size: int) -> Image:
	var m := Image.create(grid.get_width(), grid.get_height(), false, Image.FORMAT_RGBA8)
	for y in grid.get_height():
		for x in grid.get_width():
			var v: float = grid.get_pixel(x, y).r
			m.set_pixel(x, y, Color(1, 1, 1, v))
	m.resize(size, size, Image.INTERPOLATE_BILINEAR)
	return m

# Season / relief response (RC_TERRAIN G2/G3, donor dogenerate.inc step 11:
# winter uses colour table index 6 / PHDR 1, desert index 7). PORT-SIM exposes
# exactly three statics read here: Data.BIOME ("summer"/"winter"/"desert"),
# Data.RELIEF ("plains"/"hills"/"mountains") and Data.terrain_tint(biome)
# (data.gd:175,180,192). A per-map "season"/"relief" key set by the sim on
# `game` takes precedence when present.
var _season_tint_key := ""
var _season_tint_img: Image = null

func _season_key() -> String:
	var dyn = game.get("season") if game != null else null
	if dyn != null and str(dyn) != "":
		return str(dyn)
	return str(Data.BIOME)

func _relief_key() -> String:
	var dyn = game.get("relief") if game != null else null
	if dyn != null and str(dyn) != "":
		return str(dyn)
	return str(Data.RELIEF)

func _season_tint() -> Color:
	var season := _season_key()
	if season == _season_tint_key and _season_tint_img != null:
		return _season_tint_img.get_pixel(0, 0)
	var tint := Data.terrain_tint(season)
	# terrain_tint is a multiplicative RGB tint with alpha 1; use its distance
	# from white as the glaze strength, so summer (1,1,1) is a no-op.
	var strength: float = 0.34 if (tint.r < 0.999 or tint.g < 0.999 or tint.b < 0.999) else 0.0
	var im := Image.create(2, 2, false, Image.FORMAT_RGBA8)
	im.fill(Color(tint.r, tint.g, tint.b, strength))
	_season_tint_key = season
	_season_tint_img = im
	return Color(tint.r, tint.g, tint.b, strength)

# TB-B1a/B1b helpers ---------------------------------------------------------
# Frequency-rank the distinct donor block names present in a chunk (name is a
# deterministic tie-break) and return at most `limit` of them.  This bounds the
# per-chunk bake: cells on rarer blocks stay on the grass base (B1a), and the
# shore/cliff role pass re-injects those via their own per-cell name masks (B1b).
func _rank_blocks(counts: Dictionary, limit: int) -> Array:
	var ranked: Array = counts.keys()
	ranked.sort_custom(func(a, b):
		var ca: int = int(counts[a])
		var cb: int = int(counts[b])
		if ca != cb:
			return ca > cb
		return str(a) < str(b))
	return ranked.slice(0, limit)

# TB-B1b: distinct oriented sand/rock block names among the cells of terrain
# role `role` in this chunk, minus names B1a already composited chunk-wide.
func _role_block_names(cx: int, cy: int, role: int, already: Array) -> Array:
	var counts := {}
	for ly in CHUNK_T:
		for lx in CHUNK_T:
			var x: int = cx * CHUNK_T + lx
			var y: int = cy * CHUNK_T + ly
			if x >= 0 and y >= 0 and x < game.MAP_W and y < game.MAP_H:
				var i: int = game._t(x, y)
				if int(game.terrain[i]) == role:
					var bi: int = game.tileblock[i]
					var bn: String = str(game.tbl_names[bi]) if bi < game.tbl_names.size() else "grass1"
					counts[bn] = int(counts.get(bn, 0)) + 1
	var out: Array = []
	for n in _rank_blocks(counts, BLOCKS_PER_ROLE + already.size()):
		if out.size() >= BLOCKS_PER_ROLE:
			break
		if already.has(n):
			continue  # already drawn by B1a with a full per-cell cross-fade
		out.append(n)
	return out

# Composite one cached, mirror-tiled crop per block name over `img`.  Each
# block's alpha grid holds the fraction of the 4 surrounding cells using that
# name, bilinearly upscaled to SxS (same smooth grid + blend_rect_mask path the
# old two-grass mix used).  role_filter >= 0 restricts both the name match and
# the coverage count to cells of that terrain role, giving sand/cliff bands a
# role-shaped mask.  Equal neighbours stay pixel-identical; differing ones
# cross-fade over one tile.
func _composite_blocks(img: Image, cx: int, cy: int, S: int, N: int, names: Array, role_filter: int,
		max_alpha := 1.0, falloff := 1.0) -> void:
	if names.is_empty():
		return
	var full := Rect2i(0, 0, S, S)
	var origin := Vector2i.ZERO
	# QA-P1: one pass over the 2x2 neighbourhood grid computes coverage for
	# EVERY block name at once. The old code rebuilt the same 33x33 grid once
	# per name (6/4/4 -> 14 times), which was pure GDScript loop overhead.
	var nn := names.size()
	var name_idx := {}
	for ni in nn:
		name_idx[str(names[ni])] = ni
	var grids: Array = []
	for ni in nn:
		grids.append(Image.create(N, N, false, Image.FORMAT_RGB8))
	var sums := PackedFloat32Array()
	sums.resize(nn)
	for gy in N:
		for gx in N:
			sums.fill(0.0)
			var cnt := 0
			for oy in [-1, 0]:
				for ox in [-1, 0]:
					var x: int = cx * CHUNK_T + gx + int(ox)
					var y: int = cy * CHUNK_T + gy + int(oy)
					if x >= 0 and y >= 0 and x < game.MAP_W and y < game.MAP_H:
						var i: int = game._t(x, y)
						if role_filter < 0 or int(game.terrain[i]) == role_filter:
							var bi: int = game.tileblock[i]
							var bn: String = str(game.tbl_names[bi]) if bi < game.tbl_names.size() else "grass1"
							var idx: int = int(name_idx.get(bn, -1))
							if idx >= 0:
								sums[idx] += 1.0
							cnt += 1
			for ni in nn:
				var v: float = sums[ni] / maxf(1.0, float(cnt))
				# TB-B1e: optional soft falloff (gamma >1 shrinks the visible
				# edge) and a lower alpha ceiling for the shore pass only.
				if falloff != 1.0:
					v = pow(v, falloff)
				v *= max_alpha
				grids[ni].set_pixel(gx, gy, Color(v, v, v))
	for ni in nn:
		var nm_s := str(names[ni])
		var mask := _alpha_mask(grids[ni], S)
		var coff: int = abs(hash(nm_s)) % 512
		var crop := _wrap_crop(_block_img(nm_s), cx * S + coff, cy * S + coff, S)
		img.blend_rect_mask(crop, mask, full, origin)

func _build_chunk(cx: int, cy: int) -> Sprite2D:
	var px := terrain_px
	var bpx := _bake_px()
	# QA-P1: LOW used to composite at bpx=32 (1024² per chunk) and then resize
	# down to px=8 (256²) at the end - 16x the pixels for a texture the GPU
	# displays at 8 px/cell anyway. Composite at final resolution there;
	# higher presets keep the supersampled bake for edge quality.
	var comp_px := bpx if px > 8 else px
	var S := CHUNK_T * comp_px
	var tile_rect := Rect2i(0, 0, comp_px, comp_px)
	# TB-B1a: start on the single continuous grass surface, then composite one
	# cached mirror-tiled crop per DISTINCT donor block present in the chunk
	# through the same smooth 33x33 alpha grid the old two-grass hash mix used.
	# The block name is no longer discarded as a scalar weight: sand / rock /
	# sandsea cells now draw their real art.  The distinct set is capped so the
	# per-chunk bake cost stays bounded.
	var img := _wrap_crop(_block_img("grass1"), cx * S, cy * S, S)
	var N := CHUNK_T + 1
	var full := Rect2i(0, 0, S, S)
	var origin := Vector2i.ZERO
	var block_at := func(x: int, y: int) -> String:
		var bi: int = game.tileblock[game._t(x, y)]
		return str(game.tbl_names[bi]) if bi < game.tbl_names.size() else "grass1"

	var counts := {}
	for ly in CHUNK_T:
		for lx in CHUNK_T:
			var x: int = cx * CHUNK_T + lx
			var y: int = cy * CHUNK_T + ly
			if x >= 0 and y >= 0 and x < game.MAP_W and y < game.MAP_H:
				var bn: String = block_at.call(x, y)
				counts[bn] = int(counts.get(bn, 0)) + 1
	var block_names: Array = _rank_blocks(counts, BLOCKS_PER_CHUNK)
	# TB-B1e: sandsea* is shore-only art. Painting it here chunk-wide at full
	# alpha (and again in the role pass) was the wide flat tan ring. Reserve it
	# for the softened role-4 pass below so its real grain shows through.
	var base_names: Array = []
	for bn in block_names:
		if not str(bn).begins_with("sandsea"):
			base_names.append(bn)
	_composite_blocks(img, cx, cy, S, N, base_names, -1)

	# terrain roles: dirt + forest keep one continuous donor crop each,
	# feathered by a smooth region mask built from the donor terrain grid.
	# Sand (4) and rock/cliff (5) instead use the per-cell oriented block names
	# (TB-B1b); water (3) keeps the scrolling wave sheet with its blue glaze.
	var role_block := {1: "ground1", 2: "grass_ground2"}
	for t in [1, 2, 4, 5, 3]:
		if t == 4 or t == 5:
			# game.tileblock already encodes sandsea1/5/6 and rock4/7/8
			# orientation (game.gd:1082-1161); feed those names into the atlas.
			if t == 4:
				# TB-B1e: per-cell sandsea names, gamma falloff + lower ceiling
				# -> textured shore with a narrow feather instead of a wash.
				_composite_blocks(img, cx, cy, S, N,
					_role_block_names(cx, cy, t, base_names), t, 0.55, 1.7)
			else:
				_composite_blocks(img, cx, cy, S, N,
					_role_block_names(cx, cy, t, base_names), t)
			continue
		var grid := Image.create(N, N, false, Image.FORMAT_RGB8)
		for gy in N:
			for gx in N:
				var sum := 0.0
				var cnt := 0
				for oy in [-1, 0]:
					for ox in [-1, 0]:
						var x: int = cx * CHUNK_T + gx + int(ox)
						var y: int = cy * CHUNK_T + gy + int(oy)
						if x >= 0 and y >= 0 and x < game.MAP_W and y < game.MAP_H:
							if int(game.terrain[game._t(x, y)]) == t:
								sum += 1.0
							cnt += 1
				var v: float = sum / maxf(1.0, float(cnt))
				grid.set_pixel(gx, gy, Color(v, v, v))
		var mask := _alpha_mask(grid, S)
		var overlay: Image
		if t == 3:
			# TB-B1c: wave animation moved to shaders/water_overlay.gdshader.
			# Bake only a calm deep-blue substrate so shallow-water translucency
			# never reveals the old harsh blue/white striped wave crop.
			overlay = ter_blue.duplicate() as Image
			overlay.resize(S, S, Image.INTERPOLATE_NEAREST)
		else:
			var nm: String = str(role_block.get(t, "ground1"))
			var coff: int = abs(hash(nm)) % 512
			overlay = _wrap_crop(_block_img(nm), cx * S + coff, cy * S + coff, S)
		img.blend_rect_mask(overlay, mask, full, origin)

	# Season tint + relief shading. Godot's blend_rect_mask is unreliable with
	# mixed image formats here (a 0.34-alpha mask blended at full strength),
	# so both layers are plain RGBA8 overlays alpha-blended with blend_rect
	# after a temporary in-place convert; no per-pixel GDScript loop.
	var season_col := _season_tint()
	var relief := _relief_key()
	var relief_on := relief != "" and relief != "plain" and relief != "plains" and game != null
	if season_col.a > 0.0 or relief_on:
		img.convert(Image.FORMAT_RGBA8)
		if season_col.a > 0.0:
			var tint := Image.create(2, 2, false, Image.FORMAT_RGBA8)
			tint.fill(Color(season_col.r, season_col.g, season_col.b, season_col.a))
			var tint_big := tint.duplicate() as Image
			tint_big.resize(S, S, Image.INTERPOLATE_NEAREST)
			img.blend_rect(tint_big, full, origin)
		if relief_on:
			var rscale := float(Data.RELIEF_SCALE.get(relief, 1.0))
			var hgrid := Image.create(N, N, false, Image.FORMAT_RGBA8)
			for gy in N:
				for gx in N:
					var wx := float(cx * CHUNK_T + gx) * Data.TILE_M
					var wy := float(cy * CHUNK_T + gy) * Data.TILE_M
					var hh := game.height_at(Vector2(wx, wy))
					# subtle: valleys ~8-20% darker, not a black wash
					var shade: float = clampf(0.10 - hh * 0.04 * rscale, 0.0, 0.20)
					hgrid.set_pixel(gx, gy, Color(0.05, 0.04, 0.03, shade))
			var shade_big := hgrid.duplicate() as Image
			shade_big.resize(S, S, Image.INTERPOLATE_BILINEAR)
			img.blend_rect(shade_big, full, origin)
		img.convert(Image.FORMAT_RGB8)
	# supersample resolve: hard organic edges become true soft gradients
	# (skipped on LOW, where comp_px == px and no downsample is needed)
	if comp_px != px:
		img.resize(CHUNK_T * px, CHUNK_T * px, Image.INTERPOLATE_BILINEAR)
	var tex := ImageTexture.create_from_image(img)
	var sp := Sprite2D.new()
	sp.texture = tex
	sp.centered = false
	sp.position = Vector2(cx * CHUNK_T * Data.TILE_M * view_scale, cy * CHUNK_T * Data.TILE_M * view_scale)
	sp.scale = Vector2(Data.TILE_M * view_scale / float(px), Data.TILE_M * view_scale / float(px))
	sp.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	sp.z_index = -10
	add_child(sp)
	return sp

func _sync_terrain_chunks() -> void:
	# view_rect is canvas pixels (meters x view_scale); tile_of wants meters
	var m0 := view_rect.position / view_scale
	var m1 := view_rect.end / view_scale
	var t0 := game.tile_of(m0)
	var t1 := game.tile_of(m1)
	var c0x := maxi(0, t0.x / CHUNK_T)
	var c0y := maxi(0, t0.y / CHUNK_T)
	var c1x := mini(int(ceil(float(game.MAP_W) / CHUNK_T)) - 1, t1.x / CHUNK_T)
	var c1y := mini(int(ceil(float(game.MAP_H) / CHUNK_T)) - 1, t1.y / CHUNK_T)
	var built := 0
	for cy in range(c0y, c1y + 1):
		for cx in range(c0x, c1x + 1):
			var k := _chunk_key(cx, cy)
			if not terrain_chunks.has(k):
				if built >= 2:
					return  # amortize: big GDScript bake, no multi-second hitch
				# QA-1: time the bake itself (not the whole sync). Accumulate
				# max + mean over the first 120 bakes, then emit exactly one
				# BAKE_BENCH line; guarded so it never prints per frame again.
				var bake_t0 := Time.get_ticks_usec()
				terrain_chunks[k] = _build_chunk(cx, cy)
				var bake_us := Time.get_ticks_usec() - bake_t0
				if not bake_bench_done:
					bake_bench_count += 1
					bake_bench_total_us += bake_us
					if bake_us > bake_bench_max_us:
						bake_bench_max_us = bake_us
					if bake_bench_count >= 120:
						_emit_bake_bench()
				terrain_order.append(k)
				built += 1
				while terrain_order.size() > 24:
					var old: Vector2i = terrain_order.pop_front()
					var sp2: Sprite2D = terrain_chunks.get(old, null)
					if sp2 != null:
						sp2.queue_free()
					terrain_chunks.erase(old)

func sync(dt: float) -> void:
	# visible WORLD rect (not screen pixels): cull in the same space the
	# entities are drawn in, otherwise big maps hide everything
	view_rect = get_viewport().get_canvas_transform().affine_inverse() * get_viewport_rect()
	_sync_terrain_chunks()
	anim_t += dt
	# TB-B1c: advance the GPU water clock EVERY frame (the old bake-time phase
	# only changed on chunk rebuild, so a stationary camera saw frozen water).
	if water_mat != null:
		water_mat.set_shader_parameter("time", anim_t)
	fog_timer -= dt
	if fog_timer <= 0.0:
		fog_timer = Data.FOG_INTERVAL
		_update_fog()
	var moved := last_view_pos == Vector2.INF or last_view_pos.distance_to(view_rect.position) > 4.0 or last_view_end.distance_to(view_rect.end) > 4.0
	last_view_pos = view_rect.position
	last_view_end = view_rect.end
	if moved or game.res_dirty != res_dirty:
		res_dirty = game.res_dirty
		res_layer.queue_redraw()
	# The rotor's angle comes from anim_t, which advances every frame; with a
	# rotor present the building layer must redraw even on an idle camera,
	# otherwise the sails freeze whenever bld_dirty and the view are static.
	if moved or game.bld_dirty != bld_dirty or mill_rotor_tex != null:
		bld_dirty = game.bld_dirty
		bld_layer.queue_redraw()
	unit_layer.queue_redraw()
	unit_anim_layer.queue_redraw()
	fx_layer.queue_redraw()
	for f in fx_items:
		f.t += dt
	fx_items = fx_items.filter(func(f): return f.t < f.life)

func _player_color(p: int) -> Color:
	return [Color(0.25, 0.5, 1.0), Color(1.0, 0.3, 0.25)][p]

func _update_fog() -> void:
	if game == null:
		return
	if not Data.FOG_OF_WAR:
		return
	for rq in game.reveal_requests:
		var c: Vector2 = rq.pos
		var rr: float = rq.r
		var t0 := game.tile_of(c - Vector2(rr, rr))
		var t1 := game.tile_of(c + Vector2(rr, rr))
		for ty in range(maxi(0, t0.y), mini(game.MAP_H, t1.y + 1)):
			for tx in range(maxi(0, t0.x), mini(game.MAP_W, t1.x + 1)):
				if Vector2(tx * 2 + 1, ty * 2 + 1).distance_to(c) <= rr:
					fog_explored[ty * game.MAP_W + tx] = 1
	game.reveal_requests.clear()
	fog_counts.fill(0)
	for e in game.entities:
		if e.dead or e.player != 0:
			continue
		var r: float = e.def.get("search", 24.0) if e.kind == "unit" else e.def.get("radius", 2.0) * 6.0
		var t0 := game.tile_of(e.pos - Vector2(r, r))
		var t1 := game.tile_of(e.pos + Vector2(r, r))
		for y in range(maxi(0, t0.y), mini(game.MAP_H, t1.y + 1)):
			for x in range(maxi(0, t0.x), mini(game.MAP_W, t1.x + 1)):
				var c := Vector2((x + 0.5) * Data.TILE_M, (y + 0.5) * Data.TILE_M)
				if c.distance_to(e.pos) <= r:
					fog_counts[y * game.MAP_W + x] += 1
	for i in game.MAP_W * game.MAP_H:
		var v: int = 1 if fog_counts[i] > 0 else 0
		if v == 1:
			fog_explored[i] = 1
		if fog_vis[i] == v:
			continue
		fog_vis[i] = v
		var x: int = i % game.MAP_W
		var y: int = i / game.MAP_W
		if v == 1:
			fog_img.set_pixel(x, y, Color(0, 0, 0, 0))
		elif fog_explored[i] == 1:
			fog_img.set_pixel(x, y, Color(0, 0, 0, 0.30))
		else:
			fog_img.set_pixel(x, y, Color(0, 0, 0, 0.78))
	fog_tex.update(fog_img)

func tile_visible(p: Vector2) -> bool:
	if not Data.FOG_OF_WAR:
		return true
	var t := game.tile_of(p)
	if t.x < 0 or t.y < 0 or t.x >= game.MAP_W or t.y >= game.MAP_H:
		return false
	return fog_vis[t.y * game.MAP_W + t.x] == 1

func tile_explored(p: Vector2) -> bool:
	if not Data.FOG_OF_WAR:
		return true
	var t := game.tile_of(p)
	if t.x < 0 or t.y < 0 or t.x >= game.MAP_W or t.y >= game.MAP_H:
		return false
	return fog_explored[t.y * game.MAP_W + t.x] == 1

# deterministic hash for prop variation
func _hash(x: float, y: float) -> float:
	var s := int(x * 12.9898 + y * 78.233) & 0x7fffffff
	s = (s ^ (s >> 13)) * 1274126177
	s = s ^ (s >> 16)
	return float(s & 1023) / 1023.0

func _wnoise(x: float, y: float) -> float:
	var xi := int(floor(x))
	var yi := int(floor(y))
	var xf: float = x - floor(x)
	var yf: float = y - floor(y)
	var h := func(ix: int, iy: int) -> float:
		var s := ix * 374761393 + iy * 668265263
		s = (s ^ (s >> 13)) * 1274126177
		s = s ^ (s >> 16)
		return float(s & 65535) / 65535.0 * 2.0 - 1.0
	var a: float = h.call(xi, yi)
	var b: float = h.call(xi + 1, yi)
	var c: float = h.call(xi, yi + 1)
	var d: float = h.call(xi + 1, yi + 1)
	var u: float = xf * xf * (3.0 - 2.0 * xf)
	var v: float = yf * yf * (3.0 - 2.0 * yf)
	return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v

# TB-B1d prop pools. A pool only ever contains one kind of prop: bush/stump
# pools never include rock/stone (TPA-4 D1), so a missing sprite falls through
# to the deterministic procedural shape instead of drawing a rock.
const TREE_TALL_POOL := ["tree_fir", "tree_fir", "tree_pine", "tree_oak",
	"tree_spruce1", "tree_spruce2", "tree_spruce3", "tree_spruce4",
	"tree_pinedry1", "tree_pinedry2", "tree_pinedry4"]
const TREE_SMALL_POOL := ["tree_pinesmall1", "tree_pinesmall2", "tree_pinesmall3",
	"tree_pinesmall4", "tree_firsmall1", "tree_firsmall2", "tree_firsmall3",
	"tree_firsmall4"]
const BUSH_POOL := ["bush1", "bush2", "bush3", "bush4"]
const STUMP_POOL := ["tree_stump1", "tree_stump2", "tree_stump3", "tree_stump4"]
const ROCK_POOL := ["rock", "stone", "rock_stones1", "rock_stones2", "rock_stones3",
	"rock_stones4", "rock_stones5", "rock_stones6", "rock_smallstones1",
	"rock_smallstones2", "rock_landstone1", "rock_landstone2"]
const TREE_SIZE_BUCKETS := [0.9, 1.0, 1.12]

# TB-B1g: donor texturemap.inc forest detail pass. Small trees are placed per
# terrain-2 cell (not by the pattern generator), so a forest reads as a clump
# of conifers + the odd broadleaf with a lighter understory, even where the sim
# spawned no wood resource nodes. Three crown families (dark conifer / dry
# pine / broadleaf oak) and three size buckets.
const FOREST_CONIFER_POOL := ["tree_spruce1", "tree_spruce2", "tree_spruce3",
	"tree_spruce4", "tree_pinesmall1", "tree_pinesmall2", "tree_pinesmall3",
	"tree_pinesmall4", "tree_firsmall1", "tree_firsmall2", "tree_firsmall3",
	"tree_firsmall4", "tree_pinedry1", "tree_pinedry2", "tree_pinedry3",
	"tree_pinedry4"]
const FOREST_BROAD_POOL := ["tree_oak"]
# Weighted: ferns/bushes/plantain dominate; flower1..3 are only 3 of 24 picks
# (~12%) so bright yellow blossoms stay scattered instead of forming a border.
const FOREST_UNDERSTORY_POOL := ["bush1", "bush2", "bush3", "bush4",
	"fern1", "fern2", "fern3", "fern4", "plantain1", "plantain2", "plantain3",
	"fern1", "fern2", "fern3", "fern4", "bush1", "bush2", "bush3", "bush4",
	"plantain1", "plantain2", "flower1", "flower2", "flower3"]
# Visible heights at 720p: small 15-30 px, medium 40-60 px, large 70-100 px.
const FOREST_TREE_H := [1.6, 4.0, 6.8]

func _prop_tex(names: Array, seed_pos: Vector2) -> Texture2D:
	# stable variant per spot (pine/oak/fir), like the original forest mix
	var h := _hash(seed_pos.x, seed_pos.y)
	var pick: String = names[int(h * float(names.size())) % names.size()]
	var frames: Array = sprites.get(pick, [])
	if frames.is_empty():
		return null
	return frames[0]

# TB-B1d: extra variant axes, all hashed from world position (no RNG state in
# game.gd) so a prop never flickers when chunks are rebuilt or the LRU turns.
func _prop_bucket(seed_pos: Vector2, salt: float, n: int) -> int:
	return int(_hash(seed_pos.x + salt, seed_pos.y - salt * 0.37) * float(n)) % n

func _draw_prop(layer: Node2D, tex: Texture2D, p: Vector2, world_h: float,
		tint: Color, yaw: float, flip: bool) -> void:
	# Foot-anchored yaw/mirror: draw in a local frame whose origin is the prop's
	# foot, so a small rotation reads as a natural lean, not a spin. Transform
	# is always reset before the next prop on this layer.
	layer.draw_set_transform(p, yaw, Vector2(-1.0 if flip else 1.0, 1.0))
	_draw_sprite(layer, tex, Vector2.ZERO, world_h, tint, false)
	layer.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)

# TB-B1g: one detail tree at fractional tile position `fp`. Everything is
# hashed from `fp` (no RNG, no per-frame state), so camera moves and chunk/LRU
# rebuilds never change a clump. `edge` singles are a little shorter so forest
# borders feather into the meadow instead of stopping at a hard tile edge.
func _draw_forest_tree(fp: Vector2, margin: Rect2, edge := false) -> void:
	var p := world_to_px(Vector2(fp.x * Data.TILE_M, fp.y * Data.TILE_M))
	if not margin.has_point(p):
		return
	var h := _hash(fp.x, fp.y)
	var pool: Array = FOREST_BROAD_POOL if h > 0.86 else FOREST_CONIFER_POOL
	var tex := _prop_tex(pool, fp)
	if tex == null:
		return
	var bucket := _prop_bucket(fp, 17.0, 10)
	var hh: float = FOREST_TREE_H[0]
	if bucket >= 9:
		hh = FOREST_TREE_H[2]
	elif bucket >= 7:
		hh = FOREST_TREE_H[1]
	if edge:
		hh *= 0.8
	var size_var := 0.88 + 0.24 * _hash(fp.x + 29.0, fp.y - 19.0)
	_blob_rect(res_layer, p + Vector2(0, 2), 7.0 + hh * 1.6,
		3.5 + hh * 0.8, Color(0, 0, 0, 0.14))
	_draw_prop(res_layer, tex, p, hh * size_var, Color(1.12, 1.2, 1.02),
		(_hash(fp.x - 31.0, fp.y + 13.0) - 0.5) * 0.26,
		_prop_bucket(fp, 7.0, 2) == 0)

func _draw_forest_understory(fp: Vector2, margin: Rect2) -> void:
	var p := world_to_px(Vector2(fp.x * Data.TILE_M, fp.y * Data.TILE_M))
	if not margin.has_point(p):
		return
	var pick_idx: int = int(_hash(fp.x, fp.y) * float(FOREST_UNDERSTORY_POOL.size())) \
		% FOREST_UNDERSTORY_POOL.size()
	var pick: String = str(FOREST_UNDERSTORY_POOL[pick_idx])
	var tex := _prop_tex(FOREST_UNDERSTORY_POOL, fp)
	if tex == null:
		return
	var h := _hash(fp.x, fp.y)
	# Size is an independent position hash (not the pick hash): no correlation
	# between neighbours that would make a row look stamped. Flowers are also
	# shrunk so their bright yellow reads as a speck, not a border.
	var size_var := 0.7 + 0.45 * _hash(fp.x + 61.0, fp.y - 47.0)
	var hh := 1.08 * size_var
	if pick.begins_with("flower"):
		hh *= 0.75
	_blob_rect(res_layer, p + Vector2(0, 1), 5.0 + h * 2.0,
		2.5 + h, Color(0, 0, 0, 0.12))
	_draw_prop(res_layer, tex, p, hh, Color(1, 1, 1),
		(_hash(fp.x + 41.0, fp.y - 23.0) - 0.5) * 0.3,
		_prop_bucket(fp, 37.0, 2) == 0)

# Donor-style per-cell detail: 1-3 trees inside every forest cell, ~1 understory
# per two cells, plus sparse singles on grass cells touching a forest cell.
func _draw_forest_detail() -> void:
	if game == null:
		return
	var m0 := view_rect.position / view_scale
	var m1 := view_rect.end / view_scale
	var t0 := game.tile_of(m0)
	var t1 := game.tile_of(m1)
	var x0 := maxi(0, t0.x - 1)
	var y0 := maxi(0, t0.y - 1)
	var x1 := mini(game.MAP_W - 1, t1.x + 1)
	var y1 := mini(game.MAP_H - 1, t1.y + 1)
	var margin := view_rect.grow(96)
	var edge_seen := {}
	for y in range(y0, y1 + 1):
		for x in range(x0, x1 + 1):
			if int(game.terrain[game._t(x, y)]) != 2:
				continue
			var count := 1 + _prop_bucket(Vector2(float(x), float(y)), 11.0, 3)
			for k in count:
				var fx := lerpf(0.12, 0.88, _hash(float(x) * 7.3 + float(k) * 13.7,
					float(y) * 3.1 + float(k) * 5.9))
				var fy := lerpf(0.12, 0.88, _hash(float(x) * 2.7 + float(k) * 17.3,
					float(y) * 11.9 + float(k) * 7.1))
				_draw_forest_tree(Vector2(float(x) + fx, float(y) + fy), margin)
			if _hash(float(x) + 53.0, float(y) - 31.0) > 0.5:
				# Cross-mix x into both offsets and widen the range: a row of
				# adjacent cells no longer lands at the same in-cell fraction.
				var ux := float(x) + lerpf(0.05, 0.95, _hash(
					float(x) * 7.7 + float(y) * 3.3, float(y) * 11.1 - float(x) * 5.9))
				var uy := float(y) + lerpf(0.05, 0.95, _hash(
					float(y) * 13.7 - float(x) * 2.1, float(x) * 9.3 + float(y) * 4.7))
				_draw_forest_understory(Vector2(ux, uy), margin)
			# edge clumps: one sparse single on each touching non-forest cell;
			# a local dict prevents duplicates where cells touch two forest cells.
			for oy in [-1, 0, 1]:
				for ox in [-1, 0, 1]:
					if ox == 0 and oy == 0:
						continue
					var nx: int = x + ox
					var ny: int = y + oy
					if nx < 0 or ny < 0 or nx >= game.MAP_W or ny >= game.MAP_H:
						continue
					if int(game.terrain[game._t(nx, ny)]) == 2:
						continue
					var ek := Vector2i(nx, ny)
					if edge_seen.has(ek):
						continue
					edge_seen[ek] = true
					if _hash(float(nx) + 71.0, float(ny) - 43.0) > 0.62:
						var ex := float(nx) + lerpf(0.2, 0.8, _hash(float(nx), float(ny)))
						var ey := float(ny) + lerpf(0.2, 0.8, _hash(float(ny), float(nx)))
						_draw_forest_tree(Vector2(ex, ey), margin, true)

# MICRO #15: field state is a visual read of the existing sim numbers. A
# depleted food node has hits==0 (no ripe wheat); a mill-sown full field
# regrows across the donor's ~60 s seed cycle, whose timer is game.sow_t
# (game.gd:79, 2769-2772). No crop-stage sprite exists in app/assets (only
# field.png, an unlit black sheaf), so the stages are drawn procedurally.
func _field_growth(n: Dictionary) -> float:
	var mh := maxf(1.0, float(n.get("max_hits", 50)))
	var ratio: float = clampf(float(n.get("hits", 0)) / mh, 0.0, 1.0)
	if ratio <= 0.0:
		return 0.0
	if ratio >= 1.0 and n.has("mill"):
		return clampf(float(game.sow_t) / 60.0, 0.05, 1.0)
	return ratio

func _draw_field(p: Vector2, h: float, g: float) -> void:
	res_layer.draw_circle(p + Vector2(0, 3), 7.0, Color(0, 0, 0, 0.15))
	if g <= 0.0:
		# harvested: worked soil + short cut stubble, never ripe wheat
		for k in 5:
			var a := h * 6.28 + float(k) * 1.256
			var tip := p + Vector2(cos(a), sin(a)) * (4.0 + h * 2.0) + Vector2(0, -3.0)
			res_layer.draw_line(p + Vector2(0, 3), tip, Color(0.44, 0.38, 0.23), 1.2)
		return
	var count: int = 5 + int(g * 4.0)
	var reach := 3.0 + g * 4.0
	var tall := 4.0 + g * 10.0
	var stalk := Color(0.42, 0.46, 0.2)
	var head_col := Color(0.88 + h * 0.08, 0.74, 0.28)
	var head_r := 1.0 + g * 1.6
	if g < 0.35:
		stalk = Color(0.36, 0.55, 0.26)
		head_col = Color(0.5, 0.66, 0.28)
		head_r = 0.9
	elif g < 0.7:
		stalk = Color(0.45, 0.52, 0.24)
		head_col = Color(0.72, 0.74, 0.3)
	for k in count:
		var a := h * 6.28 + float(k) * (6.28 / float(count))
		var tip := p + Vector2(cos(a), sin(a)) * (reach + h * 2.0) + Vector2(0, -tall - h * 3.0)
		res_layer.draw_line(p + Vector2(0, 3), tip, stalk, 1.8)
		res_layer.draw_circle(tip, head_r, head_col)
		if g >= 0.7:
			res_layer.draw_circle(tip + Vector2(0, -2), 1.4, Color(0.95, 0.85, 0.4))

func _draw_resources() -> void:
	dbg_res += 1
	# TB-B1g: donor per-cell forest detail first, so harvestable resource nodes
	# and buildings (higher layers) stay legible on top of the understory.
	_draw_forest_detail()
	for n in game.res_nodes:
		# Ore deposits are PERMANENT nodes: they are created with hits == 0 and
		# max_hits == 0 (game.gd:_add_res), so "hits <= 0" alone used to cull
		# them and no mine was ever drawn on the map. Only finite nodes that
		# were really used up (and stumps, which stay as decor) are skipped.
		if int(n.get("hits", 0)) <= 0 and int(n.get("max_hits", 0)) != 0 \
				and str(n.get("type", "")) != "stump" and str(n.get("type", "")) != "food":
			# MICRO #15: a depleted field stays visible as bare stubble;
			# only depleted wood/stone/ore nodes are culled.
			continue
		var p := world_to_px(n.pos)
		if not view_rect.grow(64).has_point(p):
			continue
		var h := _hash(n.pos.x, n.pos.y)
		if str(n.get("type", "")) == "stump":
			# TB-B1d: stumps only ever resolve to tree_stump*; no rock fallback.
			var stump_tex := _prop_tex(STUMP_POOL, n.pos)
			if stump_tex != null:
				_blob_rect(res_layer, p + Vector2(0, 2), 7.0 + h * 2.0,
						3.5 + h, Color(0, 0, 0, 0.16))
				_draw_prop(res_layer, stump_tex, p, 0.55 + h * 0.25,
					Color(0.55, 0.42, 0.28),
					(_hash(n.pos.x - 19.0, n.pos.y + 7.0) - 0.5) * 0.3,
					_prop_bucket(n.pos, 41.0, 2) == 0)
			else:
				res_layer.draw_circle(p, 4.0, Color(0.42, 0.32, 0.2))
				res_layer.draw_rect(Rect2(p.x - 1.5, p.y - 5, 3.0, 5), Color(0.35, 0.25, 0.14))
			continue
		if str(n.get("type", "")) == "bush":
			# TB-B1d: bush* only; the procedural silhouette stays deterministic.
			var bush_tex := _prop_tex(BUSH_POOL, n.pos)
			if bush_tex != null:
				_blob_rect(res_layer, p + Vector2(0, 2), 8.0 + h * 3.0,
						4.0 + h * 1.5, Color(0, 0, 0, 0.14))
				_draw_prop(res_layer, bush_tex, p, 0.9 + h * 0.25, Color(1, 1, 1),
					(_hash(n.pos.x - 23.0, n.pos.y + 11.0) - 0.5) * 0.24,
					_prop_bucket(n.pos, 29.0, 2) == 0)
			else:
				res_layer.draw_circle(p + Vector2(0, 1), 4.5, Color(0, 0, 0, 0.14))
				res_layer.draw_circle(p, 3.2, Color(0.25, 0.36, 0.18))
				res_layer.draw_circle(p + Vector2(-1.5, -2), 2.0, Color(0.32, 0.44, 0.22))
				res_layer.draw_circle(p + Vector2(1.5, -1), 1.5, Color(0.38, 0.5, 0.26))
			continue
		match n.type:
			"wood":
				# TB-B1d: wider canopy mix (fir/pine/oak + spruce/pinedry/
				# pinesmall/firsmall). Small variants get their own shorter
				# pool and base height, then a deterministic size bucket and
				# foot-anchored yaw/mirror variant per spot.
				var small := _hash(n.pos.x + 3.3, n.pos.y - 9.9) > 0.78
				var pool: Array = TREE_SMALL_POOL if small else TREE_TALL_POOL
				var tree := _prop_tex(pool, n.pos)
				if tree != null:
					# Cossacks pines tower over peasants and read ~11-14 m tall.
					# The donor-baked sheet is very dark olive, so lift it hard.
					var bucket := float(TREE_SIZE_BUCKETS[_prop_bucket(n.pos, 17.0, 3)])
					var base_h := 7.5 if small else 12.5
					_blob_rect(res_layer, p + Vector2(0, 4), 24.0 + h * 10.0,
						12.0 + h * 5.0, Color(0, 0, 0, 0.16))
					_draw_prop(res_layer, tree, p,
						_env_sprite_h(base_h, "tree", n.pos) * bucket,
						Color(1.18, 1.26, 1.06),
						(_hash(n.pos.x - 31.0, n.pos.y + 13.0) - 0.5) * 0.26,
						_prop_bucket(n.pos, 7.0, 2) == 0)
					continue
				# fallback below (no sprites): tall pines + broad oaks
				var pine := h > 0.42
				var tall := 30.0 + h * 12.0
				res_layer.draw_circle(p + Vector2(2, 3), 8.0, Color(0, 0, 0, 0.25))
				res_layer.draw_rect(Rect2(p.x - 1.6, p.y - 6, 3.2, 10), Color(0.3, 0.2, 0.11))
				res_layer.draw_rect(Rect2(p.x - 1.6, p.y - 6, 1.2, 10), Color(0.42, 0.3, 0.16))
				if pine:
					var c := Color(0.12 + h * 0.05, 0.32 + h * 0.05, 0.13)
					res_layer.draw_colored_polygon([p + Vector2(0, -tall), p + Vector2(-9, -tall * 0.45), p + Vector2(9, -tall * 0.45)], c.darkened(0.12))
					res_layer.draw_colored_polygon([p + Vector2(0, -tall * 0.78), p + Vector2(-7.5, -tall * 0.3), p + Vector2(7.5, -tall * 0.3)], c)
					res_layer.draw_colored_polygon([p + Vector2(0, -tall * 0.55), p + Vector2(-6, -8), p + Vector2(6, -8)], c.lightened(0.12))
					res_layer.draw_line(p + Vector2(-3, -tall * 0.6), p + Vector2(0, -tall + 2), c.lightened(0.3), 1.2)
				else:
					var c := Color(0.15 + h * 0.07, 0.38 + h * 0.05, 0.15)
					res_layer.draw_circle(p + Vector2(0, -tall * 0.45), 10.0, c.darkened(0.3))
					res_layer.draw_circle(p + Vector2(-4, -tall * 0.55), 7.5, c)
					res_layer.draw_circle(p + Vector2(3, -tall * 0.6), 5.5, c.lightened(0.16))
					res_layer.draw_circle(p + Vector2(-1, -tall * 0.62), 2.5, c.lightened(0.3))
			"stone":
				# TB-B1d: rock_* variants; >=4 distinct silhouettes, old rock/
				# stone kept in the pool so nothing can silently disappear.
				var rock := _prop_tex(ROCK_POOL, n.pos)
				if rock != null:
					_blob_rect(res_layer, p + Vector2(0, 2), 14.0 + h * 6.0, 7.0 + h * 3.0, Color(0, 0, 0, 0.2))
					_draw_sprite(res_layer, rock, p, _env_sprite_h(2.8, "stone", n.pos))
					continue
				res_layer.draw_circle(p + Vector2(0, 2), 7.0, Color(0, 0, 0, 0.2))
				res_layer.draw_circle(p, 5.5, Color(0.5, 0.5, 0.49))
				res_layer.draw_circle(p + Vector2(-2.5, -2.5), 3.2, Color(0.68, 0.68, 0.66))
				res_layer.draw_circle(p + Vector2(3, 1), 2.4, Color(0.6, 0.6, 0.58))
				res_layer.draw_circle(p + Vector2(0.5, -1), 1.2, Color(0.8, 0.8, 0.78))
			"food":
				# MICRO #15: depleted fields are bare, re-sown ones grow.
				_draw_field(p, h, _field_growth(n))
			"gold", "iron", "coal":
				# Ore deposit = permanent landmark (the spot where a mine can
				# be built). Draw a rock outcrop with vivid ore veins and a
				# faint colour halo so it reads as a mine at normal zoom.
				var col: Color = {"gold": Color(1.0, 0.82, 0.24),
					"iron": Color(0.9, 0.52, 0.32),
					"coal": Color(0.34, 0.35, 0.4)}[n.type]
				var outcrop := _prop_tex(["rock"], n.pos)
				_blob_rect(res_layer, p + Vector2(0, 2), 1.3 * view_scale,
					0.7 * view_scale, Color(0, 0, 0, 0.24))
				# faint tinted ring on the worked dirt apron under the deposit
				_ground_ellipse(res_layer, p, 0.95 * view_scale,
					0.48 * view_scale, Color(col.r, col.g, col.b, 0.18))
				if outcrop != null:
					_draw_sprite(res_layer, outcrop, p, _env_sprite_h(3.5, "mine", n.pos),
						Color(1.06, 1.02, 0.96), false)
				else:
					# jagged fallback rock (no baked sprite on weak-GPU setups)
					var rr := 0.42 * view_scale
					res_layer.draw_circle(p + Vector2(0, 2), rr, Color(0, 0, 0, 0.22))
					res_layer.draw_colored_polygon([
						p + Vector2(-rr, 0), p + Vector2(-rr * 0.55, -rr * 1.5),
						p + Vector2(rr * 0.35, -rr * 1.7), p + Vector2(rr, 0),
						p + Vector2(rr * 0.4, rr * 0.4)], Color(0.44, 0.42, 0.4))
					res_layer.draw_colored_polygon([
						p + Vector2(-rr * 0.55, -rr * 1.5),
						p + Vector2(rr * 0.35, -rr * 1.7),
						p + Vector2(0, -rr * 0.35)], Color(0.6, 0.58, 0.54))
				# ore veins on the rock face — the colour is the deposit type
				var vf := view_scale
				res_layer.draw_circle(p + Vector2(0.20 * vf, -0.34 * vf), 0.17 * vf, col)
				res_layer.draw_circle(p + Vector2(-0.16 * vf, -0.20 * vf), 0.12 * vf, col.lightened(0.18))
				res_layer.draw_circle(p + Vector2(0.05 * vf, -0.62 * vf), 0.09 * vf, col.lightened(0.3))

func _draw_buildings() -> void:
	dbg_bld += 1
	for e in game.entities:
		if e.dead or e.kind != "building":
			continue
		var p := world_to_px(e.pos)
		if not view_rect.grow(96).has_point(p):
			continue
		if e.player != 0 and not tile_explored(e.pos):
			continue
		var col := _player_color(e.player)
		var r: float = e.def.radius * view_scale
		var w := r * 2.0
		var hgt := r * 1.7
		if e.sid == "tow":
			hgt = r * 2.6
		elif e.sid == "aca" or e.sid == "cen":
			hgt = r * 2.0
		elif e.sid == "hou" or e.sid == "sto":
			hgt = r * 1.3
		if e.sid.begins_with("mine_"):
			_draw_mine(p, e, col)
		elif e.sid == "wal" or e.sid == "gat":
			_draw_wall(p, e)
		elif _bld_tex(e) != null:
			# original-model sprite (static or nation sheet); the selection
			# ring, damage smoke and capture flag below still draw on top
			var bspr := _bld_tex(e)
			var tint_b := Color(0.55, 0.55, 0.6) if not e.finished else Color(1, 1, 1)
			# cleared dirt under the footprint: original dirt plates per nation +
			# building when converted, procedural ellipse otherwise (buildings
			# sit on worked ground, not on raw grass)
			var bnat := ""
			if int(e.player) >= 0 and int(e.player) < Data.PLAYER_NATIONS.size():
				bnat = str(Data.PLAYER_NATIONS[int(e.player)])
			var dec := _bld_decal(bnat, str(e.sid))
			# True donor scale (buildings.json from tools/compute_buildings.py):
			# a 14 m town hall next to 2 m peasants, like the original — the
			# old _bld_height fudge (4.5-8 m) shrank big buildings ~40% and
			# left them floating in oversized dirt plates.
			var bsc := _bld_scale(_bld_key(e))
			var vwid: float = r * 2.0
			if bsc.has("w"):
				vwid = float(bsc.w)
			if dec != null:
				var dw := r * 2.0 * 2.8 if bsc.is_empty() else vwid * 1.25
				bld_layer.draw_texture_rect(dec, Rect2(p.x - dw / 2, p.y - dw * 0.25 + 3, dw, dw * 0.5), false)
			else:
				_blob_rect(bld_layer, p + Vector2(0, 3), vwid * 0.72, vwid * 0.36, Color(0.42, 0.33, 0.21, 0.9))
			if Data.SHOW_CENTROIDS:
				bld_layer.draw_circle(p + Vector2(0, 4), vwid * 0.75, Color(0, 0, 0, 0.22))
			if bsc.has("sc"):
				var cell2: float = float(bsc.get("cell", 320.0))
				var sz2 := Vector2(cell2, cell2) * float(bsc.sc)
				var tl2 := p - Vector2(sz2.x * float(bsc.cx), sz2.y * float(bsc.foot))
				bld_layer.draw_texture_rect(bspr, Rect2(tl2, sz2), false, tint_b)
				if e.sid == "mil" and e.finished:
					_draw_mill_rotor(bld_layer, tl2, sz2, tint_b)
			else:
				_draw_sprite(bld_layer, bspr, p, _bld_height(e), tint_b)
			var bw := vwid
			if not e.finished:
				var k: float = clampf(e.progress / maxf(1.0, e.def.build_time), 0.0, 1.0)
				bld_layer.draw_rect(Rect2(p.x - bw / 2, p.y + 6, bw * k, 5), Color(0.3, 0.8, 0.3))
				bld_layer.draw_rect(Rect2(p.x - bw / 2, p.y + 6, bw, 5), Color(0, 0, 0, 0.5), false, 1.0)
			elif e.hp < e.max_hp:
				var k2: float = clampf(float(e.hp) / e.max_hp, 0.0, 1.0)
				bld_layer.draw_rect(Rect2(p.x - bw / 2, p.y - 14, bw, 5), Color(0, 0, 0, 0.6))
				bld_layer.draw_rect(Rect2(p.x - bw / 2, p.y - 14, bw * k2, 5), Color(0.2, 0.9, 0.2))
		else:
			var hh := _hash(e.pos.x, e.pos.y)
			var dw := w * (0.72 + hh * 0.08)
			bld_layer.draw_circle(p + Vector2(0, hgt * 0.36), dw * 0.62, Color(0.30, 0.23, 0.14, 0.55))
			bld_layer.draw_circle(p + Vector2(0, hgt * 0.34), dw * 0.55, Color(0.42, 0.33, 0.20, 0.95))
			bld_layer.draw_circle(p + Vector2(-dw * 0.1, hgt * 0.30), dw * 0.38, Color(0.49, 0.40, 0.25, 0.95))
			bld_layer.draw_circle(p + Vector2(dw * 0.28, hgt * 0.22), dw * 0.5, Color(0, 0, 0, 0.16))
			var wall := Color(0.84, 0.78, 0.64)
			var trim := Color(0.55, 0.48, 0.38)
			if e.sid == "bar" or e.sid == "sta" or e.sid == "art":
				wall = Color(0.68, 0.57, 0.43)
				trim = Color(0.40, 0.33, 0.24)
			elif e.sid == "tow" or e.sid == "aca":
				wall = Color(0.62, 0.61, 0.59)
				trim = Color(0.38, 0.38, 0.40)
			elif e.sid == "mil" or e.sid == "hou" or e.sid == "sto":
				wall = Color(0.80, 0.70, 0.53)
			if not e.finished:
				wall = wall.darkened(0.28)
			var wall_top := p.y - hgt * 0.28
			var wall_bot := p.y + hgt * 0.5
			var wall_h := wall_bot - wall_top
			bld_layer.draw_rect(Rect2(p.x - w / 2 - 1, wall_top + 3, w + 2, wall_h - 2), Color(0.25, 0.20, 0.14))
			bld_layer.draw_rect(Rect2(p.x - w / 2, wall_top, w, wall_h), wall.darkened(0.18))
			bld_layer.draw_rect(Rect2(p.x - w / 2, wall_top, w * 0.72, wall_h), wall)
			bld_layer.draw_rect(Rect2(p.x - w / 2, wall_bot - 4, w, 3), Color(0.32, 0.26, 0.18))
			bld_layer.draw_line(Vector2(p.x - w / 2, wall_top), Vector2(p.x - w / 2, wall_bot), trim, 1.5)
			bld_layer.draw_line(Vector2(p.x + w / 2, wall_top), Vector2(p.x + w / 2, wall_bot), trim, 1.5)
			var rows := maxi(2, int(wall_h / 8.0))
			for ri in range(1, rows):
				var yy := wall_top + wall_h * float(ri) / float(rows)
				bld_layer.draw_line(Vector2(p.x - w / 2 + 1, yy), Vector2(p.x + w / 2 - 1, yy), trim.lightened(0.25), 1.0)
			if e.sid == "bar" or e.sid == "sta" or e.sid == "hou" or e.sid == "sto" or e.sid == "cen" or e.sid == "mil":
				bld_layer.draw_line(Vector2(p.x - w / 2, wall_top + 3), Vector2(p.x + w / 2, wall_top + 3), Color(0.32, 0.22, 0.13), 2.5)
				bld_layer.draw_line(Vector2(p.x - w / 2, wall_bot - 5), Vector2(p.x + w / 2, wall_bot - 5), Color(0.32, 0.22, 0.13), 2.0)
			var roof := Color(0.62, 0.26, 0.15)
			if e.sid == "bar" or e.sid == "aca" or e.sid == "art" or e.sid == "tow":
				roof = Color(0.42, 0.44, 0.48)
			elif e.sid == "hou" or e.sid == "sto" or e.sid == "mil" or e.sid == "mar":
				roof = Color(0.66, 0.42, 0.20)
			if not e.finished:
				roof = roof.darkened(0.3)
			var apex := Vector2(p.x, wall_top - hgt * 0.42 - 6.0)
			var eave_l := Vector2(p.x - w / 2 - 5, wall_top + 1)
			var eave_r := Vector2(p.x + w / 2 + 5, wall_top + 1)
			bld_layer.draw_colored_polygon([eave_l + Vector2(0, 2), apex + Vector2(0, 2), eave_r + Vector2(0, 2)], roof.darkened(0.45))
			bld_layer.draw_colored_polygon([eave_l, apex, eave_r], roof)
			bld_layer.draw_colored_polygon([Vector2(p.x, wall_top + 1), apex, eave_r], roof.lightened(0.12))
			bld_layer.draw_line(eave_l, apex, roof.darkened(0.4), 1.5)
			bld_layer.draw_line(apex, eave_r, roof.darkened(0.25), 1.5)
			bld_layer.draw_line(apex + Vector2(0, 1), Vector2(p.x, wall_top + 1), roof.lightened(0.30), 1.2)
			# sun highlight along the left wall edge (AAA top-light)
			bld_layer.draw_line(Vector2(p.x - w / 2 + 1, wall_top + 2), Vector2(p.x - w / 2 + 1, wall_bot - 6), Color(1, 1, 1, 0.22), 2.0)
			for ti in 2:
				var tt := 0.35 + 0.3 * float(ti)
				var ly := eave_l.lerp(apex, tt)
				var ry := eave_r.lerp(apex, tt)
				bld_layer.draw_line(ly, ry, roof.darkened(0.3), 1.0)
			# waving banner on hall, barracks and towers (player colour)
			if (e.sid == "cen" or e.sid == "bar" or e.sid == "tow") and e.finished:
				var wave := sin(anim_t * 4.0 + p.x * 0.2) * 2.5
				var pole_top := apex + Vector2(0, -2)
				bld_layer.draw_line(pole_top, pole_top + Vector2(0, -16), Color(0.25, 0.20, 0.14), 2.0)
				var flag := [pole_top + Vector2(0, -16), pole_top + Vector2(14 + wave, -13), pole_top + Vector2(0, -10)]
				bld_layer.draw_colored_polygon(flag, col)
				bld_layer.draw_colored_polygon([flag[0], flag[1], flag[1] + Vector2(0, 1.5)], col.lightened(0.25))
			if e.sid == "tow":
				for k in 4:
					var bx := p.x - w / 2 + k * (w / 3.0)
					bld_layer.draw_rect(Rect2(bx, wall_top - 12, w / 6.0, 8), wall.darkened(0.05))
					bld_layer.draw_rect(Rect2(bx, wall_top - 12, w / 6.0, 8), trim, false, 1.0)
				bld_layer.draw_circle(p + Vector2(0, wall_top + wall_h * 0.45), 3.5, Color(0.08, 0.08, 0.08))
				bld_layer.draw_circle(p + Vector2(0, wall_top + wall_h * 0.45), 3.5, Color(0.5, 0.5, 0.55), false, 1.0)
			elif e.sid == "cen":
				bld_layer.draw_circle(p + Vector2(0, wall_top + wall_h * 0.42), 6.0, Color(0.94, 0.92, 0.84))
				bld_layer.draw_circle(p + Vector2(0, wall_top + wall_h * 0.42), 6.0, Color(0.2, 0.2, 0.2), false, 1.2)
				bld_layer.draw_rect(Rect2(p.x - 5, wall_bot - 14, 10, 14), Color(0.22, 0.16, 0.11))
				bld_layer.draw_rect(Rect2(p.x - 5, wall_bot - 14, 10, 14), Color(0.45, 0.34, 0.2), false, 1.0)
			elif e.sid == "mil":
				var cx := p + Vector2(w / 2 + 6, wall_top - 4)
				bld_layer.draw_circle(cx, 2.5, Color(0.3, 0.22, 0.13))
				for b in 4:
					var a := PI / 4.0 + b * PI / 2.0 + hgt * 0.01
					bld_layer.draw_line(cx, cx + Vector2(cos(a), sin(a)) * 14.0, Color(0.75, 0.70, 0.60), 2.0)
				bld_layer.draw_rect(Rect2(p.x - 4, wall_bot - 12, 8, 12), Color(0.23, 0.16, 0.11))
			else:
				bld_layer.draw_rect(Rect2(p.x - 4, wall_bot - 12, 8, 12), Color(0.23, 0.16, 0.11))
				bld_layer.draw_rect(Rect2(p.x - 4, wall_bot - 12, 8, 12), Color(0.5, 0.4, 0.25), false, 1.0)
				bld_layer.draw_rect(Rect2(p.x - w / 4 - 4, wall_top + 7, 8, 8), Color(0.13, 0.18, 0.30))
				bld_layer.draw_rect(Rect2(p.x + w / 4 - 4, wall_top + 7, 8, 8), Color(0.13, 0.18, 0.30))
				bld_layer.draw_rect(Rect2(p.x - w / 4 - 4, wall_top + 7, 8, 8), Color(0.72, 0.70, 0.62), false, 1.0)
				bld_layer.draw_rect(Rect2(p.x + w / 4 - 4, wall_top + 7, 8, 8), Color(0.72, 0.70, 0.62), false, 1.0)
			bld_layer.draw_rect(Rect2(p.x - w / 2, wall_bot - 4, w, 3), col, true)
			if not e.finished:
				bld_layer.draw_rect(Rect2(p.x - w / 2 - 6, apex.y - 5, w + 12, wall_bot - apex.y + 13), Color(0.4, 0.28, 0.15, 0.85), false, 1.5)
				bld_layer.draw_line(Vector2(p.x - w / 2 - 6, apex.y + 9), Vector2(p.x + w / 2 + 6, apex.y + 9), Color(0.45, 0.32, 0.18, 0.9), 1.5)
				var k: float = clampf(e.progress / e.def.build_time, 0.0, 1.0)
				bld_layer.draw_rect(Rect2(p.x - w / 2, wall_bot + 7, w * k, 5), Color(0.3, 0.8, 0.3))
				bld_layer.draw_rect(Rect2(p.x - w / 2, wall_bot + 7, w, 5), Color(0, 0, 0, 0.5), false, 1.0)
			else:
				if e.hp < e.max_hp:
					var k2: float = clampf(float(e.hp) / e.max_hp, 0.0, 1.0)
					bld_layer.draw_rect(Rect2(p.x - w / 2, apex.y - 10, w, 5), Color(0, 0, 0, 0.6))
					bld_layer.draw_rect(Rect2(p.x - w / 2, apex.y - 10, w * k2, 5), Color(0.2, 0.9, 0.2))
		if e.get("selected", false):
			var rr: float = e.def.radius * view_scale + 9.0
			bld_layer.draw_arc(p, rr, 0, TAU, 32, Color(0.15, 0.12, 0.08, 0.7), 3.0)
			bld_layer.draw_arc(p, rr, 0, TAU, 32, Color(1, 1, 1, 0.95), 1.5)
			for k in 4:
				var a := k * PI / 2.0 + PI / 4.0
				var q := p + Vector2(cos(a), sin(a)) * rr
				bld_layer.draw_circle(q, 3.5, Color(0.2, 0.15, 0.08))
				bld_layer.draw_circle(q, 2.5, Color(1, 0.85, 0.3))
		# video pass: damaged buildings smoke and burn, contested ones fly white
		if e.finished and not e.sid.begins_with("mine_"):
			var frac: float = float(e.hp) / float(maxi(1, e.max_hp))
			if frac < 0.5:
				var fl := sin(anim_t * 9.0 + p.x * 0.3) * 2.0
				bld_layer.draw_circle(p + Vector2(-w * 0.2, -hgt * 0.5 + fl), 5.0, Color(1, 0.45, 0.12, 0.85))
				bld_layer.draw_circle(p + Vector2(w * 0.15, -hgt * 0.55 - fl), 3.5, Color(1, 0.8, 0.3, 0.85))
				bld_layer.draw_circle(p + Vector2(0, -hgt * 0.7), 6.0, Color(0.4, 0.4, 0.4, 0.35))
			elif frac < 0.8:
				bld_layer.draw_circle(p + Vector2(w * 0.2, -hgt * 0.6), 4.5, Color(0.5, 0.5, 0.5, 0.3))
			if float(e.get("capture_t", 0.0)) > 0.3:
				var pw := p + Vector2(0, -hgt * 0.6 - 18.0)
				bld_layer.draw_line(pw, pw + Vector2(0, -12), Color(0.3, 0.25, 0.2), 1.5)
				bld_layer.draw_colored_polygon([pw + Vector2(0, -12), pw + Vector2(10, -10), pw + Vector2(0, -8)], Color(1, 1, 1, 0.95))
	_draw_rubble()

func _bld_height(e: Dictionary) -> float:
	# sprite stand height in meters, matched to the original's proportions:
	# a hut stands ~2.4x a peasant, town hall and barracks class above that,
	# towers tallest. Footprint (radius) stays the sim's — art may overhang
	# it like the original's yards and fences do.
	match str(e.sid):
		"hou", "sto":
			return 4.5
		"bla":
			return 5.0
		"mar":
			return 5.5
		"mil":
			return 6.5
		"bar", "bar18", "sta", "aca", "art", "dip":
			return 6.5
		"cen":
			return 7.5
		"tow":
			return 8.0
		_:
			return clampf(e.def.radius * 2.0, 2.0, 7.0)

func _draw_wall(p: Vector2, e: Dictionary) -> void:
	var r: float = e.def.radius * view_scale
	if e.sid == "gat":
		bld_layer.draw_rect(Rect2(p.x - r, p.y - r * 0.6, r * 2, r * 1.2), Color(0.45, 0.36, 0.24))
		bld_layer.draw_rect(Rect2(p.x - r * 0.5, p.y - r * 0.4, r, r * 0.9), Color(0.2, 0.16, 0.1) if bool(e.get("closed", false)) else Color(0.1, 0.1, 0.1, 0.35))
		bld_layer.draw_rect(Rect2(p.x - r, p.y + r * 0.6 - 2, r * 2, 2), _player_color(e.player), true)
		return
	# stone wall segment (wallcustom.cfg BuilderPoints ±0.9 m): grey block
	# with crenellations and player-colour trim
	bld_layer.draw_rect(Rect2(p.x - r, p.y - r * 0.6, r * 2, r * 1.2), Color(0.55, 0.54, 0.52))
	bld_layer.draw_rect(Rect2(p.x - r, p.y - r * 0.6, r * 2, r * 0.35), Color(0.68, 0.67, 0.64))
	for k in 4:
		var bx := p.x - r + k * (r * 2.0 / 4.0)
		bld_layer.draw_rect(Rect2(bx, p.y - r * 0.6 - 4, r * 2.0 / 8.0, 5), Color(0.62, 0.61, 0.59))
	bld_layer.draw_rect(Rect2(p.x - r, p.y + r * 0.6 - 2, r * 2, 2), _player_color(e.player), true)
	if not e.finished:
		bld_layer.draw_rect(Rect2(p.x - r - 3, p.y - r - 3, r * 2 + 6, r * 2 + 6), Color(0.4, 0.28, 0.15, 0.7), false, 1.5)

func _draw_mine(p: Vector2, e: Dictionary, col: Color) -> void:
	var r: float = e.def.radius * view_scale
	var mspr := _sprite_for(e.sid, -1)
	if mspr != null:
		var tint_m := Color(0.55, 0.55, 0.6) if not e.finished else Color(1, 1, 1)
		_blob_rect(bld_layer, p + Vector2(0, 3), r * 2.2, r * 1.1, Color(0.4, 0.32, 0.22, 0.9))
		bld_layer.draw_circle(p + Vector2(0, 4), r * 1.5, Color(0, 0, 0, 0.22))
		_draw_sprite(bld_layer, mspr, p, _env_sprite_h(3.0, "mine", e.pos), tint_m)
		if not e.finished:
			bld_layer.draw_rect(Rect2(p.x - r - 3, p.y - r - 3, r * 2 + 6, r * 2 + 6), Color(0.4, 0.28, 0.15, 0.7), false, 1.5)
		elif e.hp < e.max_hp:
			var k: float = clampf(float(e.hp) / e.max_hp, 0.0, 1.0)
			bld_layer.draw_rect(Rect2(p.x - r, p.y - r - 8, r * 2, 4), Color(0, 0, 0, 0.6))
			bld_layer.draw_rect(Rect2(p.x - r, p.y - r - 8, r * 2 * k, 4), Color(0.2, 0.9, 0.2))
		return
	bld_layer.draw_circle(p + Vector2(0, 4), r * 1.6, Color(0, 0, 0, 0.22))
	bld_layer.draw_circle(p, r * 1.4, Color(0.42, 0.4, 0.37))
	bld_layer.draw_circle(p + Vector2(-r * 0.4, -r * 0.4), r * 0.8, Color(0.55, 0.53, 0.5))
	var ore: Color = {"mine_gold": Color(0.9, 0.75, 0.2), "mine_iron": Color(0.7, 0.45, 0.3), "mine_coal": Color(0.25, 0.25, 0.28)}.get(e.sid, Color(0.8, 0.7, 0.3))
	bld_layer.draw_circle(p + Vector2(r * 0.3, -r * 0.3), r * 0.45, ore)
	# timber entrance frame
	bld_layer.draw_rect(Rect2(p.x - 5, p.y - 2, 10, 12), Color(0.3, 0.2, 0.1))
	bld_layer.draw_rect(Rect2(p.x - 5, p.y - 2, 10, 12), Color(0.45, 0.32, 0.18), false, 1.5)
	bld_layer.draw_rect(Rect2(p.x - r, p.y + r * 0.6, r * 2, 3), col, false, 1.5)
	if not e.finished:
		bld_layer.draw_rect(Rect2(p.x - r - 3, p.y - r - 3, r * 2 + 6, r * 2 + 6), Color(0.4, 0.28, 0.15, 0.7), false, 1.5)
	elif e.hp < e.max_hp:
		var k: float = clampf(float(e.hp) / e.max_hp, 0.0, 1.0)
		bld_layer.draw_rect(Rect2(p.x - r, p.y - r - 8, r * 2, 4), Color(0, 0, 0, 0.6))
		bld_layer.draw_rect(Rect2(p.x - r, p.y - r - 8, r * 2 * k, 4), Color(0.2, 0.9, 0.2))

# Static unit sprite fallback: same anchoring as _draw_sprite, queued onto the
# alpha-solid layer instead of drawn directly (shaders are per CanvasItem).
func _queue_unit_sprite(tex: Texture2D, p: Vector2, world_h: float, tint: Color) -> void:
	var px_h: float = world_h * view_scale
	var sc: float = px_h / maxf(1.0, float(tex.get_height()))
	var sz := Vector2(float(tex.get_width()), float(tex.get_height())) * sc
	var tl := p - Vector2(sz.x * 0.5, sz.y * 0.82)
	pending_unit_sprites.append({"tex": tex, "dst": Rect2(tl, sz),
		"src": Rect2(0, 0, tex.get_width(), tex.get_height()), "tint": tint})

var _yacht_hull_tex: Texture2D = null
func _yacht_hull() -> Texture2D:
	if _yacht_hull_tex == null:
		var path := "res://assets/models/anim/naval/yacht_hull.png"
		if _res_exists(path):
			_yacht_hull_tex = load(path) as Texture2D
	return _yacht_hull_tex

# PORT-SIM P-10: yachts are naval entities (game._is_naval / Data.UNITS.yacht)
# whose baked crew sheet is drawn by _draw_anim. The static 8-facing hull goes
# underneath, drawn on unit_layer while the crew is queued onto unit_anim_layer
# (a child that draws after its parent). Deck anchor: the crew's logical point
# is p, and the hull cell is offset by its own ax/ay so the crew stands on the
# deck; the facing uses the exact same (face + 4) convention as _draw_anim.
func _draw_naval_hull(e: Dictionary, p: Vector2) -> void:
	var tex := _yacht_hull()
	if tex == null:
		return
	var info := _naval_info("yacht")
	if info.is_empty():
		return
	var hull: Dictionary = info.get("actions", {}).get("hull", {})
	if hull.is_empty():
		return
	var cell: float = maxf(8.0, float(info.get("cell", 160)))
	var sc: float = float(hull.get("ortho", 11.355)) * view_scale / cell
	var sz := Vector2(cell, cell) * sc
	var tl := p - Vector2(sz.x * float(hull.get("ax", 0.5)),
			sz.y * float(hull.get("ay", 0.93)))
	var dir := posmod(int(fposmod(roundf(float(e.get("face", 0.0)) / (PI / 4.0)), 8.0)) + 4, 8)
	unit_layer.draw_texture_rect_region(tex, Rect2(tl, sz),
			Rect2(dir * cell, 0, cell, cell), Color(1, 1, 1))

func _draw_unit_sprites() -> void:
	# Runs on unit_anim_layer (child of unit_layer) after all unit shapes are
	# queued, so the optional ShaderMaterial makes figures opaque and vivid
	# without touching shadows, selection rings or damage bars.
	for d in pending_unit_sprites:
		unit_anim_layer.draw_texture_rect_region(d.tex, d.dst, d.src, d.tint)

func _draw_units() -> void:
	dbg_unit += 1
	pending_unit_sprites.clear()
	_draw_corpses()
	for e in game.entities:
		if e.dead or e.kind != "unit":
			continue
		if bool(e.get("hidden", false)):
			continue
		var p := world_to_px(e.pos)
		if not view_rect.grow(64).has_point(p):
			continue
		if e.player != 0 and not tile_visible(e.pos):
			continue
		var col := _player_color(e.player)
		var coat := col.darkened(0.08)
		var coat_lt := col.lightened(0.22)
		var coat_dk := col.darkened(0.38)
		var r: float = e.def.radius * view_scale * Data.UNIT_SCALE
		var vr: float = r * 1.7 + 2.0
		# soft contact shadow (two alpha layers) + idle/march bob
		var bob := sin(anim_t * 5.0 + float(e.id) * 1.7) * (1.4 if e.moving else 0.5)
		var pb := p + Vector2(0, bob * 0.4)
		if ov_shadow != null and Data.QUALITY != "low":
			var shw := vr * 2.6
			unit_layer.draw_texture_rect(ov_shadow, Rect2(pb.x - shw / 2, pb.y - shw * 0.25 + 2, shw, shw * 0.5), false, Color(1, 1, 1, 0.8))
		if bool(e.get("selected", false)) and ov_ring.size() > int(e.player):
			var rw := vr * 2.9
			unit_layer.draw_texture_rect(ov_ring[int(e.player)], Rect2(p.x - rw / 2, p.y - rw * 0.25, rw, rw * 0.5), false)
		# PORT-SIM naval: static hull first (under the crew sheet, which
		# _draw_anim queues onto the later-drawn unit_anim_layer child).
		if game._is_naval(e):
			_draw_naval_hull(e, pb)
		# animated original-model sheets (tools/bake_sprites.py) first,
		# static sprite, procedural body below stays as the fallback
		var tint: Color = SPRITE_TINT.get(e.sid, Color(1, 1, 1))
		var anim_drawn := _draw_anim(e, pb, tint)
		var spr := _sprite_for(e.sid, float(e.get("face", 0.0)))
		match ("__anim__" if anim_drawn else ("__sprite__" if spr != null else e.sid)):
			"__anim__":
				pass
			"__sprite__":
				_queue_unit_sprite(spr, pb, _unit_height(e) * Data.UNIT_SCALE, tint)
			"cossack", "dragoon":
				var dir := Vector2(cos(e.face), sin(e.face))
				var side := Vector2(-dir.y, dir.x)
				var body := Color(0.40, 0.29, 0.17)
				var body_dk := Color(0.25, 0.17, 0.10)
				unit_layer.draw_circle(pb - dir * 2.0, vr * 1.05, body_dk)
				unit_layer.draw_circle(pb - dir * 2.0, vr * 0.8, body)
				unit_layer.draw_circle(pb - dir * 2.0 + Vector2(-1.5, -1.5), vr * 0.45, body.lightened(0.18))
				unit_layer.draw_circle(pb + dir * 5.0, vr * 0.55, body.lightened(0.12))
				unit_layer.draw_circle(pb + dir * 5.0 + Vector2(-1, -1), vr * 0.28, Color(0.55, 0.42, 0.26))
				var rp := pb + side * 2.5 - dir * 1.0 + Vector2(0, bob * 0.3)
				unit_layer.draw_circle(rp, vr * 0.62, coat_dk)
				unit_layer.draw_circle(rp, vr * 0.5, coat)
				unit_layer.draw_circle(rp + Vector2(-1, -1.2), vr * 0.28, coat_lt)
				unit_layer.draw_circle(rp + Vector2(0, -vr * 0.25), vr * 0.3, Color(0.91, 0.80, 0.63))
				unit_layer.draw_rect(Rect2(rp - dir * 2.6 + Vector2(-3, -1.2), Vector2(6, 2.4)), Color(0.12, 0.12, 0.12))
				unit_layer.draw_line(rp, rp + dir * (vr + 4.0), coat_lt, 1.5)
			"cannon":
				var dir := Vector2(cos(e.face), sin(e.face))
				var side := Vector2(-dir.y, dir.x)
				unit_layer.draw_circle(pb - side * 6.0, 5.5, Color(0.19, 0.14, 0.10))
				unit_layer.draw_circle(pb + side * 6.0, 5.5, Color(0.19, 0.14, 0.10))
				unit_layer.draw_circle(pb - side * 6.0 + Vector2(-1, -1), 2.4, Color(0.50, 0.42, 0.30))
				unit_layer.draw_circle(pb + side * 6.0 + Vector2(-1, -1), 2.4, Color(0.50, 0.42, 0.30))
				unit_layer.draw_line(pb - dir * 6.0, pb + dir * 11.0, Color(0.10, 0.10, 0.11), 5.0)
				unit_layer.draw_line(pb - dir * 6.0, pb + dir * 11.0, Color(0.42, 0.42, 0.44), 1.6)
				unit_layer.draw_line(pb - dir * 6.0, pb + dir * 11.0 + Vector2(0, -1), Color(0.62, 0.62, 0.64, 0.6), 1.0)
				unit_layer.draw_rect(Rect2(pb - dir * 7.0 + Vector2(-3.5, -2), Vector2(7, 4)), Color(0.48, 0.36, 0.21))
				unit_layer.draw_rect(Rect2(pb - dir * 7.0 + Vector2(-3.5, -2), Vector2(7, 1.2)), Color(0.62, 0.50, 0.32))
			"peasant":
				unit_layer.draw_circle(pb, vr, coat_dk)
				unit_layer.draw_circle(pb, vr * 0.85, Color(0.55, 0.42, 0.27))
				unit_layer.draw_circle(pb + Vector2(-1.2, -1.2), vr * 0.55, Color(0.62, 0.49, 0.32))
				unit_layer.draw_circle(pb + Vector2(0, -vr * 0.45), vr * 0.5, Color(0.89, 0.76, 0.57))
				unit_layer.draw_circle(pb + Vector2(-1, -vr * 0.45 - 1), vr * 0.22, Color(0.95, 0.84, 0.66))
				unit_layer.draw_arc(pb + Vector2(0, -vr * 0.45), vr * 0.72, 0, TAU, 14, Color(0.74, 0.62, 0.33), 2.2)
				unit_layer.draw_arc(pb, vr * 0.85, PI * 1.15, PI * 1.85, 12, coat_lt, 1.5)
			"officer", "officer18":
				unit_layer.draw_circle(pb, vr, coat_dk)
				unit_layer.draw_circle(pb, vr * 0.85, coat)
				unit_layer.draw_circle(pb + Vector2(-1.2, -1.2), vr * 0.5, coat_lt)
				unit_layer.draw_circle(pb + Vector2(0, -vr * 0.4), vr * 0.48, Color(0.91, 0.80, 0.63))
				unit_layer.draw_circle(pb + Vector2(-1, -vr * 0.4 - 1), vr * 0.2, Color(0.97, 0.88, 0.72))
				unit_layer.draw_rect(Rect2(pb + Vector2(-vr * 0.55, -vr * 1.25), Vector2(vr * 1.1, vr * 0.4)), Color(0.12, 0.12, 0.14))
				unit_layer.draw_rect(Rect2(pb + Vector2(-vr * 0.55, -vr * 1.25), Vector2(vr * 1.1, vr * 0.4)), coat_lt, false, 1.0)
				unit_layer.draw_rect(Rect2(pb + Vector2(-1.2, -vr * 0.1), Vector2(2.4, vr)), Color(0.93, 0.85, 0.56))
				unit_layer.draw_rect(Rect2(pb + Vector2(-1.2, -vr * 0.1), Vector2(1.0, vr)), Color(1, 0.96, 0.75))
				# officer flag: the video shows the colours flying over the line
				var wave := sin(anim_t * 4.0 + float(e.id)) * 1.5
				unit_layer.draw_line(pb + Vector2(4, -vr), pb + Vector2(4, -vr - 12), Color(0.3, 0.22, 0.14), 1.6)
				unit_layer.draw_colored_polygon([pb + Vector2(4, -vr - 12), pb + Vector2(12 + wave, -vr - 10), pb + Vector2(4, -vr - 8)], col)
			"drummer":
				unit_layer.draw_circle(pb, vr, coat_dk)
				unit_layer.draw_circle(pb, vr * 0.85, coat)
				unit_layer.draw_circle(pb + Vector2(0, -vr * 0.4), vr * 0.45, Color(0.91, 0.80, 0.63))
				unit_layer.draw_circle(pb + Vector2(-4, 2), vr * 0.5, Color(0.75, 0.65, 0.5))
				unit_layer.draw_circle(pb + Vector2(4, 2), vr * 0.5, Color(0.75, 0.65, 0.5))
				unit_layer.draw_arc(pb + Vector2(0, 2), vr * 0.7, 0, TAU, 12, Color(0.9, 0.85, 0.7), 1.5)
			"priest":
				unit_layer.draw_circle(pb, vr, Color(0.08, 0.08, 0.09))
				unit_layer.draw_circle(pb, vr * 0.85, Color(0.12, 0.11, 0.12))
				unit_layer.draw_circle(pb + Vector2(0, -vr * 0.4), vr * 0.45, Color(0.89, 0.78, 0.62))
				unit_layer.draw_line(pb + Vector2(0, -vr * 0.5), pb + Vector2(0, vr * 0.5), Color(0.85, 0.75, 0.4), 1.5)
				unit_layer.draw_line(pb + Vector2(-2.5, -1), pb + Vector2(2.5, -1), Color(0.85, 0.75, 0.4), 1.5)
			"archer":
				unit_layer.draw_circle(pb, vr, Color(0.28, 0.22, 0.14))
				unit_layer.draw_circle(pb, vr * 0.85, Color(0.50, 0.42, 0.30))
				unit_layer.draw_circle(pb + Vector2(-1, -1), vr * 0.5, Color(0.60, 0.52, 0.37))
				unit_layer.draw_circle(pb + Vector2(0, -vr * 0.4), vr * 0.48, Color(0.89, 0.76, 0.58))
				unit_layer.draw_rect(Rect2(pb + Vector2(-vr * 0.5, -vr * 1.1), Vector2(vr, vr * 0.32)), Color(0.32, 0.26, 0.18))
				var dir := Vector2(cos(e.face), sin(e.face))
				unit_layer.draw_line(pb + dir * 1.0, pb + dir * (vr + 8.0), Color(0.42, 0.31, 0.18), 2.0)
				unit_layer.draw_line(pb + dir * 1.0, pb + dir * (vr + 8.0) + Vector2(0, -1), Color(0.60, 0.47, 0.28, 0.7), 1.0)
			_:
				var dir := Vector2(cos(e.face), sin(e.face))
				unit_layer.draw_circle(pb, vr, coat_dk)
				unit_layer.draw_circle(pb, vr * 0.85, coat)
				unit_layer.draw_circle(pb + Vector2(-1.2, -1.2), vr * 0.5, coat_lt)
				unit_layer.draw_line(pb + Vector2(-vr * 0.45, -vr * 0.55), pb + Vector2(vr * 0.45, vr * 0.55), Color(0.93, 0.91, 0.83), 2.0)
				unit_layer.draw_circle(pb + Vector2(0, -vr * 0.4), vr * 0.46, Color(0.91, 0.80, 0.63))
				unit_layer.draw_circle(pb + Vector2(-1, -vr * 0.4 - 1), vr * 0.2, Color(0.97, 0.87, 0.71))
				unit_layer.draw_circle(pb + Vector2(0, -vr * 0.4), vr * 0.46, Color(0.45, 0.32, 0.20), false, 1.0)
				unit_layer.draw_rect(Rect2(pb + Vector2(-vr * 0.6, -vr * 1.2), Vector2(vr * 1.2, vr * 0.45)), Color(0.10, 0.10, 0.12))
				unit_layer.draw_rect(Rect2(pb + Vector2(-vr * 0.6, -vr * 1.2), Vector2(vr * 1.2, vr * 0.45)), coat_lt, false, 1.0)
				var tip: Vector2 = pb + dir * (vr + 9.0)
				unit_layer.draw_line(pb + dir * vr * 0.4, tip, Color(0.30, 0.21, 0.11), 2.4)
				if e.sid == "pikeman":
					unit_layer.draw_circle(tip, 2.0, Color(0.80, 0.80, 0.84))
					unit_layer.draw_circle(tip, 2.0, Color(0.35, 0.35, 0.38), false, 1.0)
					unit_layer.draw_circle(tip + Vector2(-0.6, -0.6), 0.7, Color(1, 1, 1, 0.8))
				else:
					unit_layer.draw_circle(tip, 1.6, Color(0.55, 0.42, 0.22))
		if e.get("selected", false):
			var fd := Vector2(cos(e.face), sin(e.face))
			unit_layer.draw_line(p + fd * (vr + 2.0), p + fd * (vr + 7.0), Color(1, 1, 1, 0.9), 2.0)
			if ov_sel != null:
				var sw := vr * 3.2
				unit_layer.draw_texture_rect(ov_sel, Rect2(p.x - sw / 2, p.y - sw * 0.25, sw, sw * 0.5), false)
		if e.hp < e.max_hp:
			var w: float = vr * 2.4
			unit_layer.draw_rect(Rect2(p.x - w / 2, p.y - vr - 11, w + 2, 6), Color(0, 0, 0, 0.7))
			unit_layer.draw_rect(Rect2(p.x - w / 2, p.y - vr - 10, w * clampf(float(e.hp) / e.max_hp, 0, 1), 4), Color(0.25, 0.9, 0.25))
			unit_layer.draw_rect(Rect2(p.x - w / 2, p.y - vr - 10, w * clampf(float(e.hp) / e.max_hp, 0, 1), 1.5), Color(0.6, 1, 0.6, 0.7))
			# morale pip: green holds, amber wavers, red routs (video: the line breaks)
			if not e.def.get("support", false) and e.sid != "peasant":
				var m: float = float(e.get("morale", 70.0))
				var mc := Color(0.3, 0.9, 0.3) if m > 50.0 else (Color(0.95, 0.8, 0.25) if m > 25.0 else Color(0.95, 0.25, 0.2))
				unit_layer.draw_circle(p + Vector2(-vr - 4, -vr - 6), 2.2, Color(0, 0, 0, 0.6))
				unit_layer.draw_circle(p + Vector2(-vr - 4, -vr - 6), 1.6, mc)
		if e.get("routing", false):
			unit_layer.draw_arc(p, vr + 9.0, 0, TAU, 16, Color(1, 0.3, 0.2, 0.8), 1.5)
			unit_layer.draw_line(p + Vector2(-5, -vr - 12), p + Vector2(5, -vr - 16), Color(1, 1, 1, 0.9), 1.5)
		if e.get("carry", 0) > 0:
			unit_layer.draw_circle(p + Vector2(vr * 0.8, -vr * 0.8), 3.4, Color(0.22, 0.16, 0.07))
			unit_layer.draw_circle(p + Vector2(vr * 0.8, -vr * 0.8), 2.4, Color(0.93, 0.81, 0.39))
			unit_layer.draw_circle(p + Vector2(vr * 0.8 - 0.8, -vr * 0.8 - 0.8), 1.0, Color(1, 0.95, 0.65))


func _draw_corpses() -> void:
	# the aftermath of a volley: fallen coats fading into the grass
	for c in game.corpses:
		var p := world_to_px(c.pos)
		if not view_rect.grow(64).has_point(p):
			continue
		if int(c.player) != 0 and not tile_explored(c.pos):
			continue
		var a := clampf(1.0 - c.t / c.life, 0.0, 1.0) * 0.55
		# death sheet (tools/bake_sprites.py): last falls linger, then fade
		var ckey := str(c.sid)
		var cinfo: Dictionary = _anim_info(ckey)
		if not cinfo.is_empty() and (cinfo.actions as Dictionary).has("death"):
			var dact: Dictionary = cinfo.actions.death
			var dn: int = int(dact.frames)
			var dd: float = maxf(0.05, float(dact.duration))
			var dcell: int = int(cinfo.cell)
			var dtk := ckey + "_death"
			if not anim_tex.has(dtk) and _res_exists(_anim_sheet(ckey, "death")):
				anim_tex[dtk] = load(_anim_sheet(ckey, "death"))
			if anim_tex.has(dtk):
				var dtex: Texture2D = anim_tex[dtk]
				if dtex == null:
					anim_tex.erase(dtk)
				else:
					var dfi: int = mini(dn - 1, int(float(c.t) / dd * dn))
					var ddir := posmod(int(fposmod(roundf(float(c.get("face", 0.0)) / (PI / 4.0)), 8.0)) + 4, 8)
					var dsrc := Rect2(ddir * dcell, dfi * dcell, dcell, dcell)
					var dfig: float = float(dact.get("fig_h", 1.0))
					var dfoot: float = float(dact.get("ay", dact.get("foot", 0.82)))
					var dcx: float = float(dact.get("ax", dact.get("cx", 0.5)))
					var dsc: float = 1.9 * view_scale / maxf(8.0, float(dcell) * dfig)
					var dsz := Vector2(dcell, dcell) * dsc
					var dtl := p - Vector2(dsz.x * dcx, dsz.y * dfoot)
					unit_layer.draw_texture_rect_region(dtex, Rect2(dtl, dsz), dsrc, Color(0.55, 0.5, 0.5, a))
					continue
		var cspr := _sprite_for(str(c.sid), 0.0)
		if cspr != null:
			var fade := Color(0.45, 0.4, 0.4, a)
			_draw_sprite(unit_layer, cspr, p, 1.9, fade, false)
			continue
		var col := _player_color(int(c.player)).darkened(0.3)
		unit_layer.draw_circle(p + Vector2(0, 1), 4.5, Color(0, 0, 0, a * 0.5))
		unit_layer.draw_circle(p, 4.0, Color(col.r, col.g, col.b, a))

func _draw_rubble() -> void:
	# lingering destroyed-building rubble, fading like corpses
	for c in game.rubble:
		var p := world_to_px(c.pos)
		if not view_rect.grow(64).has_point(p):
			continue
		var a := clampf(1.0 - c.t / c.life, 0.0, 1.0) * 0.6
		var nat := ""
		if int(c.player) >= 0 and int(c.player) < Data.PLAYER_NATIONS.size():
			nat = str(Data.PLAYER_NATIONS[int(c.player)])
		var tex: Texture2D = null
		for key in (["%s_%s_dead" % [nat, c.sid]] if nat != "" else []) + ["%s_dead" % c.sid]:
			tex = _bld_anim(key)
			if tex != null:
				break
		if tex != null:
			var cell := 320
			var sc: float = 3.0 * view_scale / float(cell)
			var sz := Vector2(cell, cell) * sc
			var tl := p - Vector2(sz.x * 0.5, sz.y * 0.82)
			bld_layer.draw_texture_rect(tex, Rect2(tl, sz), false, Color(0.5, 0.45, 0.4, a))
			continue
		bld_layer.draw_circle(p, 8.0, Color(0.3, 0.27, 0.24, a))

func _draw_ghost() -> void:
	# build placement preview (green = ok, red = blocked), like the original
	if game == null or hud == null:
		return
	var sid := str(hud.get("build_ghost_sid")) if hud.get("build_ghost_sid") != null else ""
	if sid == "":
		return
	var mp := get_viewport().get_mouse_position()
	var xform := get_viewport().get_canvas_transform().affine_inverse()
	var wp: Vector2 = (xform * mp) / maxf(1.0, view_scale)
	if not game.in_bounds(wp):
		return
	# The one "Mine" button previews whichever mine matches the ore deposit
	# currently under the cursor, so the ghost always shows the right type.
	sid = game.resolve_mine_sid(sid, wp)
	if not Data.BUILDINGS.has(sid):
		return
	var def: Dictionary = Data.BUILDINGS[sid]
	var chk: Dictionary = game.can_place(0, sid, wp)
	var ok: bool = bool(chk.get("ok", false)) and Data.can_pay(game.players[0].res, def.cost)
	var reason: String = str(chk.get("reason", ""))
	if not Data.can_pay(game.players[0].res, def.cost):
		reason = "Not enough resources."
	var c := Color(0.2, 1.0, 0.3, 0.5) if ok else Color(1.0, 0.25, 0.2, 0.5)
	var p := world_to_px(wp)
	var gkey := game._bld_scale_key(0, sid)
	var gsc: Dictionary = _bld_scale(gkey)
	var gr: float = def.radius * view_scale
	if gsc.has("w"):
		gr = float(gsc.w) * 0.5
	# transparent building: nation sheet if baked, else static sprite, else ring only
	var ghost_tex: Texture2D = _bld_tex({"player": 0, "sid": sid, "finished": true, "progress": 1.0, "def": def})
	if ghost_tex != null:
		var tint := Color(1, 1, 1, 0.45) if ok else Color(1, 0.4, 0.4, 0.45)
		# _draw_ghost() runs from fx_layer's draw signal, so every draw_* call
		# must target fx_layer. Drawing onto bld_layer here is rejected by Godot
		# ("Drawing is only allowed inside this node's _draw()") and the ghost
		# sprite silently never appears — only the footprint ring did.
		if gsc.has("sc"):
			var gcell: float = float(gsc.get("cell", 320.0))
			var gsz := Vector2(gcell, gcell) * float(gsc.sc)
			var gtl := p - Vector2(gsz.x * float(gsc.cx), gsz.y * float(gsc.foot))
			fx_layer.draw_texture_rect(ghost_tex, Rect2(gtl, gsz), false, tint)
		else:
			_draw_sprite(fx_layer, ghost_tex, p, 3.0, tint, false)
	# placement ring on the ground (original style: glowing footprint ring,
	# green = buildable, red = blocked)
	_ground_ellipse(fx_layer, p + Vector2(0, 3), gr * 1.45, gr * 0.72, c, 2.5)
	var r := gr
	if not ok:
		fx_layer.draw_line(p + Vector2(-r, -r * 0.5), p + Vector2(r, r * 0.5), Color(1, 0.2, 0.2, 0.9), 2.0)
		fx_layer.draw_line(p + Vector2(-r, r * 0.5), p + Vector2(r, -r * 0.5), Color(1, 0.2, 0.2, 0.9), 2.0)
		if hud != null and hud.has_method("show_hint") and reason != "":
			hud.show_hint(reason)

# P-20 / RE gap 1c: an arrow in flight leaves a short fading streak.  The
# event -> add_fx call arrives in the same tick the projectile is spawned, so
# this is where the world can pick up in-flight arrows without touching game.gd.
# One trail item per live arrow, reusing the existing fx-item schema and cap.
func _emit_arrow_trails() -> void:
	if game == null:
		return
	for pr in game.projectiles:
		if str(pr.get("kind", "")) not in ["arrow", "firearrow"]:
			continue
		var seen := false
		for f in fx_items:
			if str(f.get("kind", "")) == "trail" and f.get("pr") == pr:
				seen = true
				break
		if seen:
			continue
		fx_items.append({"kind": "trail", "pos": world_to_px(pr.pos), "t": 0.0,
			"life": 0.22, "pr": pr})
		if fx_items.size() > Data.FX_CAP:
			fx_items.pop_front()

func add_fx(kind: String, pos: Vector2) -> void:
	var life := 0.35
	match kind:
		"smoke":
			life = 1.6
		"explode", "crater":
			life = 0.8
		"fire":
			life = 0.9
		"heal":
			life = 0.9
		"capture", "rout":
			life = 1.2
	fx_items.append({"kind": kind, "pos": world_to_px(pos), "t": 0.0, "life": life})
	if fx_items.size() > Data.FX_CAP:
		fx_items.pop_front()
	_emit_arrow_trails()

func _draw_fx() -> void:
	dbg_fx += 1
	# squad links: faint lines from the officer to his soldiers (selected only)
	if game != null:
		for sid in game.squads:
			var s: Dictionary = game.squads[sid]
			var off: Dictionary = game.by_id.get(int(s.officer), {})
			if off.is_empty() or off.dead:
				continue
			if not bool(off.get("selected", false)):
				continue
			var op := world_to_px(off.pos)
			for uid in s.members + [int(s.get("drummer", 0))]:
				if uid == 0:
					continue
				var u: Dictionary = game.by_id.get(uid, {})
				if u.is_empty() or u.dead:
					continue
				fx_layer.draw_line(op, world_to_px(u.pos), Color(1, 1, 1, 0.35), 1.5)
	# rally flags on barracks / stables / town halls
	if game != null:
		for e in game.entities:
			if e.dead or e.kind != "building" or not e.has("rally"):
				continue
			if e.player != 0:
				continue
			var rp: Vector2 = e.rally
			var bp := world_to_px(e.pos)
			var fp := world_to_px(rp)
			fx_layer.draw_line(bp, fp, Color(1, 1, 1, 0.4), 1.5)
			fx_layer.draw_line(fp, fp + Vector2(0, -12), Color(0.3, 0.25, 0.2), 1.5)
			fx_layer.draw_colored_polygon([fp + Vector2(0, -12), fp + Vector2(9, -10), fp + Vector2(0, -8)],
				_player_color(e.player))
	_draw_ghost()
	# in-flight shells and arrows (video: cannonballs arc across the field)
	for pr in game.projectiles:
		var pp := world_to_px(pr.target.lerp(pr.pos, 1.0 - pr.t / maxf(0.01, pr.total)))
		if not view_rect.grow(64).has_point(pp):
			continue
		if pr.kind == "cannonball":
			fx_layer.draw_circle(pp, 3.0, Color(0.05, 0.05, 0.05))
			fx_layer.draw_circle(pp + Vector2(-4, -2), 2.0, Color(0.6, 0.6, 0.6, 0.5))
		else:
			fx_layer.draw_line(pp + Vector2(-3, 1), pp + Vector2(3, -1), Color(0.7, 0.6, 0.4, 0.9), 1.5)
	# drag-selection rectangle (screen-space friendly: drawn in map px)
	if sel_active and sel_rect.size.length() > 4.0:
		var a := world_to_px(Vector2(sel_rect.position.x, sel_rect.position.y))
		var b := world_to_px(Vector2(sel_rect.end.x, sel_rect.end.y))
		var r := Rect2(a, b - a).abs()
		fx_layer.draw_rect(r, Color(1, 1, 1, 0.9), false, 1.5)
		fx_layer.draw_rect(r, Color(1, 1, 1, 0.18), true)
	# ghost placement marker
	for f in fx_items:
		var k: float = f.t / f.life
		match f.kind:
			"shot":
				fx_layer.draw_circle(f.pos, 2.0, Color(1, 0.9, 0.5, 1.0 - k))
			"smoke":
				# musket volley smoke: grey-white puffs drifting up and fading
				var rise := k * 14.0
				fx_layer.draw_circle(f.pos + Vector2(0, -4 - rise), 5.0 + k * 9.0, Color(0.85, 0.85, 0.82, (1.0 - k) * 0.55))
				fx_layer.draw_circle(f.pos + Vector2(3, -7 - rise), 3.5 + k * 6.0, Color(0.95, 0.95, 0.92, (1.0 - k) * 0.4))
			"explode":
				fx_layer.draw_arc(f.pos, 4.0 + k * 26.0, 0, TAU, 20, Color(1, 0.6, 0.2, 1.0 - k), 3.0)
				fx_layer.draw_circle(f.pos, 6.0 * (1.0 - k) + 2.0, Color(1, 0.85, 0.4, 1.0 - k))
			"crater":
				fx_layer.draw_circle(f.pos, 7.0, Color(0.15, 0.12, 0.09, (1.0 - k) * 0.8 + 0.2))
				fx_layer.draw_arc(f.pos, 7.0 + k * 10.0, 0, TAU, 16, Color(0.5, 0.4, 0.3, 1.0 - k), 2.0)
			"fire":
				fx_layer.draw_circle(f.pos + Vector2(0, -6), 4.0 + sin(k * 12.0) * 1.5, Color(1, 0.45, 0.1, 1.0 - k))
				fx_layer.draw_circle(f.pos + Vector2(0, -9), 2.5, Color(1, 0.8, 0.3, 1.0 - k))
			"heal":
				fx_layer.draw_arc(f.pos + Vector2(0, -4), 3.0 + k * 7.0, 0, TAU, 14, Color(0.4, 1, 0.5, 1.0 - k), 1.5)
			"capture":
				fx_layer.draw_line(f.pos + Vector2(0, -10), f.pos + Vector2(0, -26), Color(0.4, 0.3, 0.2), 1.5)
				fx_layer.draw_colored_polygon([f.pos + Vector2(0, -26), f.pos + Vector2(10, -24), f.pos + Vector2(0, -22)], Color(1, 1, 1, 1.0 - k * 0.5))
			"rout":
				fx_layer.draw_line(f.pos + Vector2(-5, -12), f.pos + Vector2(5, -16), Color(1, 0.3, 0.2, 1.0 - k), 2.0)
			"chop":
				fx_layer.draw_circle(f.pos + Vector2(0, -6), 2.0 + k * 3.0, Color(0.7, 0.6, 0.3, 1.0 - k))
			"trail":
				# fading streak behind an in-flight arrow (CPU draw only, no sprite)
				var pr: Dictionary = f.get("pr", {})
				if not pr.is_empty():
					var head := world_to_px(pr.target.lerp(pr.pos, 1.0 - pr.t / maxf(0.01, pr.total)))
					var dir: Vector2 = (pr.target - pr.pos).normalized()
					if dir.length_squared() < 0.01:
						dir = Vector2.RIGHT
					fx_layer.draw_line(head - dir * (8.0 + k * 5.0), head,
						Color(1.0, 0.88, 0.62, 0.7 * (1.0 - k)), 1.5)
