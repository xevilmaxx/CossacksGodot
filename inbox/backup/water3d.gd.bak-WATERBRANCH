# ---- mapsizemod: generatemap.inc:655-657, live FLOAT division --------------
#   mapsizemod = (cWaterMapArrSize/((640/mapheight)*2))*cWaterFieldSize
# Delphi `640 div mapheight` is integer division; the outer division is float.
# Under the donor swap the `mapheight` axis is the port grid's first dim (w),
# which maps to world X (report §7.2). Both axes are exposed in stats.
func _mapsizemod(mapheight: int) -> float:
	if mapheight <= 0:
		return 0.0
	var ratio: int = int(C3_MAP_REFERENCE / float(mapheight))  # integer `div`
	if ratio <= 0:
		return 0.0
	return (float(C3_WATER_MAP_ARR_SIZE) / float(ratio * 2)) * float(C3_WATER_FIELD_SIZE)


# ---- Exact 2x2 block raster (report §7.1, [O]; gate execution [U8]) ---------
# Returns the list of field records. Each record carries the exact donor centre
# formula and name `x<wmx>y<wmy>`.
func _build_field_records() -> Array:
	var records: Array = []
	if not _height_bound:
		return records
	# Donor script axes: wmx indexes mapwidth, wmy indexes mapheight. Under the
	# donor engine x/z swap the port grid's first dim (w) is mapheight (world X)
	# and the second dim (h) is mapwidth (world Z).
	var mapheight: int = _grid_w
	var mapwidth: int = _grid_h
	var mod: float = _mapsizemod(mapheight)
	var max_wmy: int = int(ceil(float(mapheight) / float(C3_WATER_FIELD_SIZE)))
	var max_wmx: int = int(ceil(float(mapwidth) / float(C3_WATER_FIELD_SIZE)))
	for wmy in range(max_wmy):
		for wmx in range(max_wmx):
			var marked: bool = false
			var y0: int = wmy * C3_WATER_FIELD_SIZE
			var y1: int = mini((wmy + 1) * C3_WATER_FIELD_SIZE, mapheight - 1)
			var x0: int = wmx * C3_WATER_FIELD_SIZE
			var x1: int = mini((wmx + 1) * C3_WATER_FIELD_SIZE, mapwidth - 1)
			for gy in range(y0, y1 + 1):
				for gx in range(x0, x1 + 1):
					# Port grid: first index (x, size _grid_w) = donor script y (wmy);
					# second index (z, size _grid_h) = donor script x (wmx).
					var idx: int = gx * _grid_w + gy
					if idx < 0 or idx >= _height.size():
						continue
					if _mask_bound:
						# Exact donor generatemap.inc:316-317 gate.
						var rb: float = _mask_b[idx]
						var rr: float = _mask_r[idx]
						if rb > 0.0 and (rr < 1.0 or rb < 1.0):
							marked = true
							break
					else:
						# LABELED FALLBACK [U]: mask.b>0 covers bWater/bWaterShore
						# (texturemap.inc:463-472); use the shore threshold -0.1 as
						# the closest height-only proxy. NOT an exact donor gate.
						if _height[idx] < WATER_SHORE_HEIGHT:
							marked = true
							break
				if marked:
					break
			if not marked:
				continue
			# Donor script corners (tiles). tx/tz from script x/y; engine swap below.
			var tx: float = float(wmx * C3_WATER_FIELD_SIZE) - mod
			var tz: float = float(wmy * C3_WATER_FIELD_SIZE) - mod
			var bx: float = float((wmx + 1) * C3_WATER_FIELD_SIZE) - mod
			var bz: float = float((wmy + 1) * C3_WATER_FIELD_SIZE) - mod
			records.append({
				"name": "x" + str(wmx) + "y" + str(wmy),
				"wmx": wmx, "wmy": wmy,
				"tx": tx, "tz": tz, "bx": bx, "bz": bz,
				# FUN_0073b57c: engine X from script z, engine Z from script x.
				"cx": (tz + bz) * 0.5 * TILE_M,
				"cz": (tx + bx) * 0.5 * TILE_M,
				"cy": C3_OFFSET_Y,
				"extent_x": absf(bx - tx) * TILE_M,
				"extent_z": absf(bz - tz) * TILE_M,
				# hmapUV space: port grid coords (0..1). Donor -0.5 centring is
				# absorbed by bind_height_grid's (x+0.5)/w encoding.
				"u0": float(wmy * C3_WATER_FIELD_SIZE) / float(_grid_w),
				"u1": float((wmy + 1) * C3_WATER_FIELD_SIZE) / float(_grid_w),
				"v0": float(wmx * C3_WATER_FIELD_SIZE) / float(_grid_h),
				"v1": float((wmx + 1) * C3_WATER_FIELD_SIZE) / float(_grid_h),
			})
	return records


# ---- Finalize: build the merged field mesh + bind every donor uniform ------
func _finalize_water_node() -> bool:
	if not _built or not _height_bound or _material == null:
		return false
	_field_centres = _build_field_records()
	if _field_centres.is_empty():
		push_error("water3d: no water fields generated; refusing to draw a grey quad")
		return false

	var n: int = _field_centres.size()
	var verts := PackedVector3Array()
	var uvs := PackedVector2Array()
	var inds := PackedInt32Array()
	verts.resize(n * 4)
	uvs.resize(n * 4)
	inds.resize(n * 6)
	for i in range(n):
		var f: Dictionary = _field_centres[i]
		var x0: float = float(f["tz"]) * TILE_M
		var x1: float = float(f["bz"]) * TILE_M
		var z0: float = float(f["tx"]) * TILE_M
		var z1: float = float(f["bx"]) * TILE_M
		var y: float = C3_OFFSET_Y
		var b: int = i * 4
		verts[b] = Vector3(x0, y, z0)
		verts[b + 1] = Vector3(x1, y, z0)
		verts[b + 2] = Vector3(x1, y, z1)
		verts[b + 3] = Vector3(x0, y, z1)
		uvs[b] = Vector2(float(f["u0"]), float(f["v0"]))
		uvs[b + 1] = Vector2(float(f["u1"]), float(f["v0"]))
		uvs[b + 2] = Vector2(float(f["u1"]), float(f["v1"]))
		uvs[b + 3] = Vector2(float(f["u0"]), float(f["v1"]))
		var t: int = i * 6
		inds[t] = b
		inds[t + 1] = b + 3
		inds[t + 2] = b + 1
		inds[t + 3] = b + 1
		inds[t + 4] = b + 3
		inds[t + 5] = b + 2
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = verts
	arr[Mesh.ARRAY_TEX_UV] = uvs
	arr[Mesh.ARRAY_INDEX] = inds
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)

	# hmapTex substitute: real decoded grid only, alpha = (h+2.96)/(2*2.96).
	var img := Image.create(_grid_w, _grid_h, false, Image.FORMAT_RGBA8)
	for z in range(_grid_h):
		for x in range(_grid_w):
			var hval: float = _height[z * _grid_w + x]
			var a: float = clampf((hval + MAX_HEIGHT) / (2.0 * MAX_HEIGHT), 0.0, 1.0)
			img.set_pixel(x, z, Color(0.0, 0.0, 0.0, a))
	var height_img := ImageTexture.create_from_image(img)
	_material.set_shader_parameter("height_tex", height_img)
	_material.set_shader_parameter("map_size", Vector2(float(_grid_w), float(_grid_h)))
	# LEGACY hmapTex: the same [U3] decoded-grid substitute as DEV, explicitly
	# labelled; the raw texel is kept on dry pixels exactly as water.frag does.
	# Never a neutral 1x1 texel (that is the grey-fallback bug, report §9.5).
	if _water_shader_path == WaterShaderPath.LEGACY:
		_material.set_shader_parameter("hmapTex", height_img)
		_material.set_shader_parameter("hmapTexBound", true)
		# Exact §4.3 donor keys hmapW/hmapH/hmapMin/hmapMax. Their engine values
		# are [U3]; the decoded grid dims and the DEV +/-MAX_HEIGHT span are the
		# labelled port substitutes, never silently presented as recovered.
		_material.set_shader_parameter("hmapW", _grid_w)
		_material.set_shader_parameter("hmapH", _grid_h)
		_material.set_shader_parameter("hmapMin", -MAX_HEIGHT)
		_material.set_shader_parameter("hmapMax", MAX_HEIGHT)
	# WATERCOMPILE: BUILTIN is now the default, so this is the common path.
	# [U12] DEC_U_water_runtime.md §8/§10.5 — FBO names exist in CODE but no
	# water-specific creation was recovered; the reflection target is an engine
	# texture object at C+0x4c with unresolved provenance. HARD-FAIL when no real
	# target is bound: push_error + return false from _finalize_water_node() =>
	# NO water node is added (owner's build->bind_height_grid flow gets no plane),
	# never a neutral/grey quad. The shader also discards when reflectionMapBound
	# is false, so an unbound sampler can never produce a grey fallback.
	if _water_shader_path == WaterShaderPath.BUILTIN:
		if _reflection_map == null:
			push_error("water3d: BUILTIN (labelled default) selected but reflectionMap is unbound "
				+ "([U12] DEC_U §8 FBO provenance unresolved); HARD-FAIL: no water drawn, "
				+ "no grey fallback. Use bind_reflection_map() with a real target.")
			return false
		_material.set_shader_parameter("reflectionMap", _reflection_map)
		_material.set_shader_parameter("reflectionMapBound", true)

	if _water == null:
		_water = MeshInstance3D.new()
		_water.name = "WaterPlane3D"
		_water.mesh = mesh
		_water.material_override = _material
		add_child(_water)
	else:
		_water.mesh = mesh

	# Structural verification (report §10.11; no parity claim).
	var all_y_exact: bool = true
	var centre_ok: bool = true
	for f in _field_centres:
		if not is_equal_approx(float(f["cy"]), C3_OFFSET_Y):
			all_y_exact = false
		var expect_cx: float = (float(f["tz"]) + float(f["bz"])) * 0.5 * TILE_M
		var expect_cz: float = (float(f["tx"]) + float(f["bx"])) * 0.5 * TILE_M
		if not is_equal_approx(float(f["cx"]), expect_cx) or not is_equal_approx(float(f["cz"]), expect_cz):
			centre_ok = false
	stats["field_count"] = n
	stats["plane_vertices"] = n * 4
	stats["plane_triangles"] = n * 2
	stats["field_geometry_verified"] = {"plane_y_all_minus_half": all_y_exact, "centre_formula_exact": centre_ok}
	stats["height_aware"] = true
	stats["height_grid"] = {"w": _grid_w, "h": _grid_h}
	stats["field_source"] = ("EXACT gMapMask gate (bind_water_mask)" if _mask_bound
		else "HEIGHT-DERIVED FALLBACK [U] - exact donor gate needs bind_water_mask")
	return true


# ---- build(): donor-literal material + exact field geometry -----------------
# All three donor-literal paths now exist in water3d.gdshader. Selection is
# explicit (report §10 rule c): water_shader_path is set from the labelled enum,
# never inferred. Each variant binds the exact §4.3 donor uniform names; the
# per-variant REQUIRED texture (BUILTIN reflectionMap [U12], LEGACY hmapTex [U3])
# is enforced in _finalize_water_node() with a labelled hard-fail, not a neutral
# texture. DEV equations/uniform values below are unchanged.
func build(w: int = DEFAULT_GRID, h: int = DEFAULT_GRID) -> bool:
	invalidate()
	_grid_w = w
	_grid_h = h

	# CONFIG-WIRE-WATER (config.gd read-only): config supplies an A/B surface Y;
	# for the donor path the plane Y is the recovered cOffsetY=-0.5, so the config
	# value is recorded for audit only and NEVER substituted silently.
	var cfg = C3ConfigScript.active
	var cfg_surface_y: float = -0.25
	var cfg_alpha_confine: bool = true
	var cfg_shore_prox: bool = false
	if cfg != null:
		cfg_surface_y = cfg.feature_water_surface_y()
		cfg_alpha_confine = cfg.feature_water_alpha_confine()
		cfg_shore_prox = cfg.feature_water_shore_prox()

	var label: String = shader_path_label()
	# DEC-U §7.2 / §0 discipline: the 11 scalars + waveDirs are [U4*] (FILE vs
	# ENGINE diverge). NO default — unset => push_error + no water. Never invent
	# a scalar or silently pick one tuple as "the" donor value.
	if _water_scalar_source == WATER_SCALAR_SOURCE_UNSET:
		push_error("water3d: water_scalar_source UNSET [U4*] (FILE vs ENGINE); no water drawn. "
			+ "Call set_water_scalar_source(\"FILE\"|\"ENGINE\") only after U4* capture: " + U4_CAPTURE_ID)
		_material = null
		return false
	var shader := load(SHADER_PATH) as Shader
	if shader == null:
		push_error("water3d: cannot load " + SHADER_PATH + " (no water drawn)")
		return false
	_material = ShaderMaterial.new()
	_material.shader = shader
	# Explicit, labelled per-variant mode selection (report §10 rule c).
	_material.set_shader_parameter("water_shader_path", _water_shader_path)

	# Donor literals -> uniforms. DEV values below are unchanged.
	_material.set_shader_parameter("water_level", WATER_LEVEL)         # -0.25 classification
	_material.set_shader_parameter("water_surface_y", C3_OFFSET_Y)     # donor plane Y = -0.5
	_material.set_shader_parameter("shore_height", WATER_SHORE_HEIGHT) # -0.1 (inert in DEV frag)
	_material.set_shader_parameter("max_height", MAX_HEIGHT)
	_material.set_shader_parameter("coast_fade_depth", COAST_FADE)     # 0.57
	_material.set_shader_parameter("deep_fade_depth", DEEP_FADE)       # 1.07
	_material.set_shader_parameter("tex_scale_s", TEX_SCALE_S)         # 0.1
	_material.set_shader_parameter("tex_scale_t", TEX_SCALE_T)         # 0.01
	_material.set_shader_parameter("hdr_multiplier", HDR_MULTIPLIER)   # 1
	_material.set_shader_parameter("spec_soft", SPEC_SOFT)             # 170
	_material.set_shader_parameter("spec_glossy", SPEC_GLOSSY)         # 120
	_material.set_shader_parameter("particle_amount", PARTICLE_AMOUNT) # 30
	_material.set_shader_parameter("shallow_color", DEV_SHALLOW_COLOR) # (0.1,0.24,0.24)
	_material.set_shader_parameter("deep_color", DEV_DEEP_COLOR)       # (0,0.025,0.05)
	_material.set_shader_parameter("spec_color", DEV_SPEC_COLOR)       # (0.4,0.4,0.4)
	_material.set_shader_parameter("sun_dir", SUN_LIGHTVEC)
	_material.set_shader_parameter("fog_color", FOG_COLOR)
	_material.set_shader_parameter("fog_density", 0.0)
	_material.set_shader_parameter("fog_enabled", 0)                  # colors.lib:36 FogMode=0
	_material.set_shader_parameter("time", 0.0)
	# reflectionMap FBO is [U12]; DEV reflection branch stays disabled. No
	# reflection_map texture is invented/bound.
	_material.set_shader_parameter("reflection_enabled", 0.0)
	# height_tex / map_size are bound only by bind_height_grid (no grey fallback).

	# waveMap = diffusewaves0.png, donor-derived and shipped. Missing => hard fail.
