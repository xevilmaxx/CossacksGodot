# --- FIX-SELECTVIS: selection ring / owner indicator -----------------------
# PROCEDURAL STAND-IN — `PORT APPROXIMATION — NOT DONOR PARITY`.
# The 2D aura is a squashed, player-tinted set of draw calls using the private
# `ring_sel.png` / `ring_p0.png` overlays (app/scripts/world.gd:210-211,319-320,
# :3011-3041) and a per-player unit ring (world.gd:3252-3254). No donor texture
# is readable/copiable here, so the equivalent 3D feedback is geometry: a flat
# TorusMesh ring in the donor key colour, a thin dark under-ring for contrast
# on light terrain, and a small owner-colour disc at the centre. Same semantics,
# different pixels: selection is visible and ownership is distinguishable.

func _make_selection_marker(id: int, p3: Vector3, player: int, kind: String,
		radius: float) -> Dictionary:
	var holder := Node3D.new()
	holder.name = "SelRing_%d" % id
	holder.position = p3
	_selection_root.add_child(holder)

	var c: Color = _player_color(player)
	var ring_mat := _material(Color(c.r, c.g, c.b, 0.92), false)
	var under_mat := _material(Color(0.05, 0.04, 0.03, 0.80), false)  # world.gd:3032
	var pip_mat := _material(Color(c.r, c.g, c.b, 1.0), false)

	var ring_mesh := TorusMesh.new()
	var under_mesh := TorusMesh.new()
	var pip_mesh := CylinderMesh.new()
	pip_mesh.height = 0.05

	var ring := _add_mesh(holder, ring_mesh, ring_mat, Vector3(0, 0.08, 0), Vector3.ZERO)
	ring.name = "Ring"
	var under := _add_mesh(holder, under_mesh, under_mat, Vector3(0, 0.055, 0), Vector3.ZERO)
	under.name = "UnderRing"
	var pip := _add_mesh(holder, pip_mesh, pip_mat, Vector3(0, 0.14, 0), Vector3.ZERO)
	pip.name = "OwnerPip"

	# Buildings 2D ring radius = def.radius*view_scale+9 (world.gd:3017);
	# units use def.radius*view_scale*UNIT_SCALE*1.7+2 (world.gd:3244-3245).
	# Here `radius` is already sim metres, so add a modest screen-space margin.
	var m: Dictionary = {
		"node": holder, "id": id, "player": player, "kind": kind,
		"ring_mat": ring_mat, "under_mat": under_mat, "pip_mat": pip_mat,
		"ring_mesh": ring_mesh, "under_mesh": under_mesh, "pip_mesh": pip_mesh,
		"ring": ring, "under": under, "pip": pip,
	}
	_scale_selection_marker(m, radius)
	return m


# Resize the three procedural meshes to the entity footprint. TorusMesh is
# generated in the XZ plane so it already hugs the ground (no rotation needed).
func _scale_selection_marker(m: Dictionary, radius: float) -> void:
	var outer := clampf(radius * 1.25, 0.45, 12.0)
	var rm: TorusMesh = m.get("ring_mesh")
	if rm != null:
		rm.inner_radius = outer * 0.78
		rm.outer_radius = outer
	var um: TorusMesh = m.get("under_mesh")
	if um != null:
		um.inner_radius = outer * 0.96
		um.outer_radius = outer * 1.10
	var pm: CylinderMesh = m.get("pip_mesh")
	if pm != null:
		var pr := clampf(outer * 0.20, 0.10, 0.40)
		pm.top_radius = pr
		pm.bottom_radius = pr


# Owner colour always comes from the 13 donor slots; capture/player changes
# recolour the ring and pip on the next sync (no fallback palette — V7-65).
func _set_selection_color(m: Dictionary, player: int) -> void:
	if int(m.get("player", -1)) == player:
		return
	m["player"] = player
	var c: Color = _player_color(player)
	var ring_mat: StandardMaterial3D = m.get("ring_mat")
	if ring_mat != null:
		ring_mat.albedo_color = Color(c.r, c.g, c.b, ring_mat.albedo_color.a)
		ring_mat.emission = Color(c.r, c.g, c.b)
	var pip_mat: StandardMaterial3D = m.get("pip_mat")
	if pip_mat != null:
		pip_mat.albedo_color = c
		pip_mat.emission = Color(c.r, c.g, c.b)


func _free_selection_marker(id: int) -> void:
	var m = _selection_markers.get(id, null)
	if m is Dictionary:
		var n = (m as Dictionary).get("node")
		if n != null and is_instance_valid(n):
			# Immediate (not queue_free): 2D clears the aura the very frame the
			# selection flag flips; a queued node would linger for one frame and
			# would also be invisible to a synchronous integration probe.
			(n as Node3D).free()
	_selection_markers.erase(id)
	_selection_positions.erase(id)


# Deterministic pulse only (world.gd:3019 uses the same sin(anim_t*3 + id*0.7)).
# No RNG; the ring's base alpha is restored before apply so it cannot drift.
func _update_selection() -> void:
	for id in _selection_markers.keys():
		var m: Dictionary = _selection_markers[id]
		var mat: StandardMaterial3D = m.get("ring_mat")
		if mat == null:
			continue
		var pulse: float = 0.82 + 0.18 * sin(_time * 3.0 + float(id) * 0.7)
		mat.albedo_color.a = 0.92 * pulse
		mat.emission_energy_multiplier = 0.35 * pulse
	stats["selection_rings"] = _selection_markers.size()


# --- per-frame animation ---------------------------------------------------

func _update_fx(dt: float) -> void:
	var keep: Array = []
	for item in fx_items:
		var age: float = float(item.get("age", 0.0)) + dt
		item["age"] = age
		var life: float = maxf(0.001, float(item.get("life", DEFAULT_LIFE)))
		var k: float = clampf(age / life, 0.0, 1.0)
		var node = item.get("node")
		if node == null or not is_instance_valid(node):
			continue
		var idx: float = float(item.get("index", 0))
		match str(item.get("kind", "")):
			"smoke":
				node.position.y = float(item.get("base_y", 0.0)) + k * 1.6
				var s: float = 1.0 + k * 1.4
				node.scale = Vector3(s, s, s)
			"explode":
				var s2: float = 1.0 + k * 2.2
				node.scale = Vector3(s2, s2, s2)
			"heal":
				var s3: float = 0.6 + k * 2.0
				node.scale = Vector3(s3, 1.0, s3)
			"fire":
				var f: float = 0.85 + 0.15 * sin(age * 14.0 + idx)
				node.scale = Vector3(f, f, f)
			"trail":
				_orient_trail(item, node)
			# FX-IMPACT-01 — per-kind motion (all PORT APPROXIMATIONS):
			"volley_smoke":
				node.position.y = float(item.get("base_y", 0.0)) + k * 0.8
			"muzzle_flash":
				pass   # static face-camera quad; alpha HOLD below, no drift
			"arrow_trail":
				_orient_impact_trail(item, node)
		var mat: StandardMaterial3D = item.get("mat")
		if mat != null:
			var c: Color = mat.albedo_color
			var base_a: float = float(item.get("base_alpha", 1.0))
			var alpha: float = base_a * (1.0 - k)
			var ks: String = str(item.get("kind", ""))
			if ks == "volley_smoke":
				# AlphaPower = 1.5 (source.pfx:62) is a donor-grounded fade CURVE;
				# AlphaTime→seconds is UNVERIFIED (DFX-01 §6), so the curve over a
				# PORT life is a PORT APPROXIMATION, not donor parity.
				alpha = base_a * pow(1.0 - k, IMPACT_SMOKE_ALPHA_POWER)
			elif ks == "muzzle_flash":
				# OnEndFrameHide = True (source.pfx:176): hold, then cut on expiry.
				# No donor frame→second mapping exists -> PORT APPROXIMATION.
				alpha = base_a
			# arrow_trail keeps the generic linear fade: AlphaFade = True
			# (source.pfx:1743), base alpha = literal Alpha 0.2 (:1742).
			c.a = alpha
			mat.albedo_color = c
			mat.emission_energy_multiplier = 0.35 * (1.0 - k)
		var light: OmniLight3D = item.get("light")
		if light != null and is_instance_valid(light):
			light.light_energy = float(item.get("light_energy", 0.0)) * (1.0 - k)
		if age < life:
			keep.append(item)
		else:
			_free_item(item)
			stats["expired"] = int(stats.get("expired", 0)) + 1
	fx_items = keep


func _orient_trail(item: Dictionary, node: Node3D) -> void:
	var pr = item.get("pr")
	if not (pr is Dictionary):
		return
	if not (pr.has("pos") and pr.has("target") and pr.has("t") and pr.has("total")):
		return
	if not (pr.get("pos") is Vector2 and pr.get("target") is Vector2):
		return
	var head2: Vector2 = (pr["target"] as Vector2).lerp(
		pr["pos"] as Vector2, 1.0 - float(pr["t"]) / maxf(0.01, float(pr["total"])))
	var dir2: Vector2 = (pr["target"] as Vector2) - (pr["pos"] as Vector2)
	if dir2.length_squared() < 0.01:
		dir2 = Vector2.RIGHT
	dir2 = dir2.normalized()
	var tail2: Vector2 = head2 - dir2 * TRAIL_STREAK_M
	var a: Vector3 = world_pos(tail2)
	var b: Vector3 = world_pos(head2)
	node.position = (a + b) * 0.5
	if node.is_inside_tree() and a.distance_to(b) > 0.001:
		node.look_at(b, Vector3.UP)


# FX-IMPACT-01 — face-camera trail placement. The donor trail is a msFaceCamera
# ribbon (source.pfx:1745) sampled at MinDistance 0.05 (source.pfx:1741) with a
# 0.2 s TimeLimit (:1740). This module owns no camera reference, so the port
# places a billboarded quad at the world-space head/tail midpoint and scales its
# length by the segment; screen-space ribbon alignment is NOT reproduced.
# PORT APPROXIMATION — NOT DONOR PARITY. No solid BoxMesh is used here.
func _orient_impact_trail(item: Dictionary, node: Node3D) -> void:
	var pr = item.get("pr")
	if not (pr is Dictionary):
		return
	if not (pr.has("pos") and pr.has("target") and pr.has("t") and pr.has("total")):
		return
	if not (pr.get("pos") is Vector2 and pr.get("target") is Vector2):
		return
	var start2: Vector2 = pr["pos"] as Vector2
	var end2: Vector2 = pr["target"] as Vector2
	var head2: Vector2 = end2.lerp(start2, 1.0 - float(pr["t"]) / maxf(0.01, float(pr["total"])))
	var dir2: Vector2 = end2 - start2
	if dir2.length_squared() < 0.01:
		dir2 = Vector2.RIGHT
	var tail2: Vector2 = head2 - dir2.normalized() * IMPACT_TRAIL_STREAK_M
	var a: Vector3 = world_pos(tail2)
	var b: Vector3 = world_pos(head2)
	node.position = (a + b) * 0.5
	var mi = item.get("mesh")
	if mi is MeshInstance3D and is_instance_valid(mi):
		var q: QuadMesh = (mi as MeshInstance3D).mesh as QuadMesh
		if q != null:
			var seg: float = a.distance_to(b)
			q.size = Vector2(IMPACT_TRAIL_WIDTH,
				clampf(minf(IMPACT_TRAIL_STREAK_M, seg), IMPACT_TRAIL_MIN_DISTANCE, IMPACT_TRAIL_STREAK_M))


func _update_rally() -> void:
	var stale: Array = []
	for key in _rally_markers.keys():
		var m: Dictionary = _rally_markers[key]
		if _time - float(m.get("seen", 0.0)) <= RALLY_TTL:
			continue
		var n = m.get("node")
		if n != null and is_instance_valid(n):
			n.queue_free()
		stale.append(key)
	for key in stale:
		_rally_markers.erase(key)
	stats["rally_active"] = _rally_markers.size()


func _update_ghost() -> void:
	if _ghost_root == null:
		return
	_ghost_root.visible = _ghost_active
	if not _ghost_active or _ghost_mat == null:
		return
	var c: Color = GHOST_OK if _ghost_ok else GHOST_BAD
	var pulse: float = 0.85 + 0.15 * sin(_time * 4.0)
	c.a *= pulse
	_ghost_mat.albedo_color = c
	_ghost_mat.emission = Color(c.r, c.g, c.b)


# --- small helpers ---------------------------------------------------------

func _enforce_cap() -> void:
	var cap: int = FALLBACK_FX_CAP
	if Data != null:
		cap = int(Data.FX_CAP)
	if cap <= 0:
		cap = FALLBACK_FX_CAP
	while fx_items.size() > cap:
		var old: Dictionary = fx_items.pop_front()
		_free_item(old)


func _free_item(item: Dictionary) -> void:
	var n = item.get("node")
	if n != null and is_instance_valid(n):
		n.queue_free()
	item["node"] = null
	item["mat"] = null
	item["light"] = null


func _finite(x: float) -> bool:
	return not is_nan(x) and not is_inf(x)


func _finite3(v: Vector3) -> bool:
	return _finite(v.x) and _finite(v.y) and _finite(v.z)


func _valid_pos(p) -> bool:
	if p is Vector2:
		var v: Vector2 = p
		return _finite(v.x) and _finite(v.y)
	if p is Vector3:
		return _finite3(p)
	return false


# Donor guard misc.script:5070: only slots 0..12 exist; no wrapi() fallback to
# a made-up colour. On load failure the pennant material is transparent.
func _player_color(p: int) -> Color:
	if not _key_colors_loaded:
		return Color(0.0, 0.0, 0.0, 0.0)
	if p < 0 or p >= PLAYER_COLORS.size():
		return Color(0.0, 0.0, 0.0, 0.0)
	return PLAYER_COLORS[p]


func _building_radius(sid: String) -> float:
	if Data != null and Data.BUILDINGS.has(sid):
		var d = Data.BUILDINGS[sid]
		if d is Dictionary and d.has("radius"):
			return maxf(0.25, float(d.radius))
	return 1.5
