# Resolve the origin from the bound game unless an explicit offset was given.
# MAP_W/MAP_H are ints on game.gd:35-36 (config.json:39-40 sets both to 320);
# Dictionary stubs expose the same keys. Missing/invalid values keep ZERO and
# are reported in stats rather than guessed from a port default.
func _apply_world_offset(override = null) -> void:
	if override is Vector2:
		var v: Vector2 = override
		if _finite(v.x) and _finite(v.y):
			world_offset = v
			_offset_pinned = true
			stats["world_offset_source"] = "explicit_bind_arg"
			stats["world_offset"] = [v.x, v.y]
			return
		stats["world_offset_source"] = "invalid_explicit_ignored"
	if _offset_pinned:
		# An explicit bind arg / setter call outranks later re-derivation.
		stats["world_offset_source"] = "pinned_retained"
		stats["world_offset"] = [world_offset.x, world_offset.y]
		return
	var w := _map_tiles(game, "MAP_W")
	var h := _map_tiles(game, "MAP_H")
	if w > 0 and h > 0:
		world_offset = Vector2(float(w), float(h)) * (0.5 * TILE_M)
		stats["world_offset_source"] = "game.MAP_W/MAP_H"
	else:
		world_offset = Vector2.ZERO
		stats["world_offset_source"] = "unavailable_zero"
	stats["world_offset"] = [world_offset.x, world_offset.y]


func _map_tiles(g, key: String) -> int:
	if g == null:
		return -1
	var v = g.get(key)
	if v is int or v is float:
		return int(v)
	return -1


# Shift only XZ; Y is height_bias/height_at driven and must not be touched.
func _shift_created_nodes(shift: Vector2) -> void:
	for item in fx_items:
		var n = item.get("node")
		if n is Node3D and is_instance_valid(n):
			(n as Node3D).position.x += shift.x
			(n as Node3D).position.z += shift.y
	if _ghost_root != null and is_instance_valid(_ghost_root):
		_ghost_root.position.x += shift.x
		_ghost_root.position.z += shift.y
	for key in _rally_markers.keys():
		var m: Dictionary = _rally_markers[key]
		var rn = m.get("node")
		if rn is Node3D and is_instance_valid(rn):
			(rn as Node3D).position.x += shift.x
			(rn as Node3D).position.z += shift.y
	# FIX-SELECTVIS: selection markers store their map-origin Vector2 so a late
	# world_offset change re-places them exactly like FX/rally (V7-73).
	for key in _selection_markers.keys():
		var sm: Dictionary = _selection_markers[key]
		var sn = sm.get("node")
		var sp = _selection_positions.get(key, null)
		if sn is Node3D and is_instance_valid(sn) and (_valid_pos(sp)):
			var np3: Vector3 = world_pos(sp)
			if _finite3(np3):
				(sn as Node3D).position = np3
	# FX-WEATHER-01: the weather root is a child of _root, not an fx_item. The
	# donor particle manager is camera-relative (AutoOffsetFromCamera=True,
	# particles.lib:11) and must not be shifted with sim FX. Camera-follow is an
	# OPEN integration item (no camera reference is owned by this module).


# V7-65: exact donor formula output (rgb_godot_float), NOT the old invented
# 2D palette. Missing/malformed JSON => push_error and NO player-coloured FX
# (a transparent marker), never a fallback palette.
func _load_player_colors() -> void:
	PLAYER_COLORS.clear()
	_key_colors_loaded = false
	_key_colors_error = ""
	if not FileAccess.file_exists(KEY_COLORS_PATH):
		_key_colors_error = "missing file " + KEY_COLORS_PATH
		push_error("world3d_fx: donor key colours unavailable (" + _key_colors_error + "); rally pennant left TRANSPARENT - no fallback palette")
		return
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(KEY_COLORS_PATH))
	if not (parsed is Dictionary) or not (parsed as Dictionary).has("slots") \
			or not ((parsed as Dictionary)["slots"] is Array):
		_key_colors_error = "malformed JSON or missing slots array"
		push_error("world3d_fx: donor key colours unavailable (" + _key_colors_error + "); rally pennant left TRANSPARENT - no fallback palette")
		return
	for entry in ((parsed as Dictionary)["slots"] as Array):
		if not (entry is Dictionary):
			continue
		var d := entry as Dictionary
		var idx := int(d.get("index", -1))
		var rgb = d.get("rgb_godot_float", [])
		if idx < 0 or not (rgb is Array) or (rgb as Array).size() < 3:
			continue
		var arr = rgb
		var c := Color(float(arr[0]), float(arr[1]), float(arr[2]), 1.0)
		if PLAYER_COLORS.size() <= idx:
			PLAYER_COLORS.resize(idx + 1)
		PLAYER_COLORS[idx] = c
	_key_colors_loaded = PLAYER_COLORS.size() > 0
	if not _key_colors_loaded:
		_key_colors_error = "no usable slot entries"
		push_error("world3d_fx: donor key colours unavailable (" + _key_colors_error + "); rally pennant left TRANSPARENT - no fallback palette")


func sync(dt) -> void:
	var d: float = maxf(0.0, float(dt))
	_time += d
	if consume_events:
		_consume_events()
	if emit_arrow_trails:
		_emit_arrow_trails()
	_update_fx(d)
	_update_rally()
	_update_ghost()
	_update_selection()   # FIX-SELECTVIS: deterministic pulse only; set reconcile is in sync_selection()


# Exact signature per contract: add_fx(pos, kind, life). `life` <= 0 means
# "use the port lifetime table" so a caller may pass -1 / 0 as a sentinel.
func add_fx(pos, kind, life := -1.0) -> Dictionary:
	_ensure_roots()
	var k: String = str(kind)
	var span: float = float(life)
	if span <= 0.0:
		span = float(LIFE.get(k, DEFAULT_LIFE))
	if span <= 0.0:
		span = DEFAULT_LIFE
	var p3: Vector3 = world_pos(pos)
	if not _finite3(p3):
		return {}
	_spawn_index += 1
	var holder := Node3D.new()
	holder.name = "FX_%s_%d" % [k, _spawn_index]
	holder.position = p3
	_root.add_child(holder)

	var item: Dictionary = {
		"kind": k, "pos": pos, "life": span, "age": 0.0,
		"node": holder, "mat": null, "light": null,
		"base_alpha": 1.0, "light_energy": 0.0, "base_y": p3.y,
		"pr": null, "index": _spawn_index,
	}
	_build_visual(item, k)
	fx_items.append(item)
	_enforce_cap()
	stats["spawned"] = int(stats.get("spawned", 0)) + 1
	return item


# FX-IMPACT-01 — donor-key entry point. Accepts the literal donor effect/source
# keys (DFX-01 §5.2/§7.1-7.3) and maps them to the three additive port kinds.
# This is a THIN ADAPTER, not a donor translation: visual fidelity is a PORT
# APPROXIMATION and no donor art is loaded. Unknown keys return {} (no-op),
# matching the donor's `GetOrCreate` lookup of an absent key -> -1 (pfx.script:353-360).
func add_impact_fx(kind, pos, life := -1.0) -> Dictionary:
	var k: String = str(kind)
	var mapped: String = ""
	match k:
		"shotmusket", "musketsmoke", "volley_smoke":
			mapped = "volley_smoke"
		"musketflash", "shotmusket_flash", "muzzle_flash":
			mapped = "muzzle_flash"
		"bullettrail", "firearrowtrail", "fragtrail", "arrow_trail":
			mapped = "arrow_trail"
	if mapped.is_empty():
		return {}
	var item: Dictionary = add_fx(pos, mapped, life)
	if not item.is_empty():
		stats["impact_fx_spawned"] = int(stats.get("impact_fx_spawned", 0)) + 1
		stats["impact_last_kind"] = mapped
	return item


# Translucent green (ok) / red (blocked) 3D footprint. PORT primitives:
# no donor ghost config was readable; colour follows world.gd:3509.
func draw_ghost(sid, pos, ok: bool) -> void:
	_ensure_roots()
	var s: String = str(sid)
	if s.is_empty() or not _valid_pos(pos):
		_ghost_active = false
		_ghost_root.visible = false
		return
	_ghost_active = true
	_ghost_sid = s
	_ghost_ok = bool(ok)
	var p3: Vector3 = world_pos(pos)
	if not _finite3(p3):
		_ghost_active = false
		_ghost_root.visible = false
		return
	_ghost_root.position = p3
	_ghost_root.visible = true
	var r: float = _building_radius(s)
	_ghost_mesh.scale = Vector3(r * 2.0, 1.0, r * 2.0)
	stats["ghost_shown"] = int(stats.get("ghost_shown", 0)) + 1


# Pole + pennant in player colour. PROCEDURAL PRIMITIVE — the donor
# `rallypoint.dds` is private-use and stays uncopied (see world.gd:3602-3604).
func draw_rally(pos, player: int) -> void:
	_ensure_roots()
	var p3: Vector3 = world_pos(pos)
	if not _finite3(p3):
		return
	var key := Vector2(roundf(p3.x * 2.0) * 0.5, roundf(p3.z * 2.0) * 0.5)
	if _rally_markers.has(key):
		var old: Dictionary = _rally_markers[key]
		old["seen"] = _time
		_set_rally_color(old, int(player))
	else:
		_rally_markers[key] = _make_rally(p3, int(player))
	stats["rally_active"] = _rally_markers.size()


# FIX-SELECTVIS — PUBLIC SELECTION API (V7-76 ghost/rally pattern):
# `entries` is an Array of Dictionaries, one per currently selected entity:
#   {"id": int, "pos": Vector2|Vector3, "player": int,
#    "kind": "unit"|"building", "radius": float}
# Set semantics, NOT TTL: an id absent from `entries` has its ring removed in
# the SAME call (2D clears the aura the frame e.selected goes false). This is
# driven by world3d.gd from the read-only selected_ids / selected mirror; no
# sim state is written here and no donor texture is loaded.
func sync_selection(entries) -> void:
	_ensure_roots()
	var want: Dictionary = {}
	if entries is Array:
		for raw in (entries as Array):
			if not (raw is Dictionary):
				continue
			var d := raw as Dictionary
			var id := int(d.get("id", -1))
			if id < 0 or want.has(id):
				continue
			var pos = d.get("pos", null)
			if not _valid_pos(pos):
				continue
			want[id] = d
	# Remove first: ids that left the selection lose their node immediately.
	for id in _selection_markers.keys():
		if want.has(id):
			continue
		_free_selection_marker(int(id))
	# Add / refresh. Owner colour is re-resolved every call from the 13 donor
	# slots so a capture (player change) recolours the pip on the next sync.
	var colors: Array = []
	for id in want.keys():
		var d: Dictionary = want[id]
		var p3: Vector3 = world_pos(d.get("pos"))
		if not _finite3(p3):
			continue
		var player := int(d.get("player", -1))
		var kind := str(d.get("kind", ""))
		var radius := maxf(0.25, float(d.get("radius", 0.5)))
		var marker = _selection_markers.get(id, null)
		if marker == null:
			marker = _make_selection_marker(id, p3, player, kind, radius)
			_selection_markers[id] = marker
		else:
			var m: Dictionary = marker
			(m.get("node") as Node3D).position = p3
			_set_selection_color(m, player)
			_scale_selection_marker(m, radius)
		_selection_positions[id] = d.get("pos")
		colors.append([_player_color(player).r, _player_color(player).g, _player_color(player).b])
	stats["selection_entries"] = want.size()
	stats["selection_rings"] = _selection_markers.size()
	stats["selection_owner_colors"] = colors


func clear_all() -> void:
	for item in fx_items:
		_free_item(item)
	fx_items.clear()
	for key in _rally_markers.keys():
		var m: Dictionary = _rally_markers[key]
		var n = m.get("node")
		if n != null and is_instance_valid(n):
			n.queue_free()
	_rally_markers.clear()
	for key in _selection_markers.keys():
		_free_selection_marker(int(key))
	_selection_markers.clear()
	_selection_positions.clear()
	stats["selection_rings"] = 0
	stats["selection_entries"] = 0
	stats["selection_owner_colors"] = []
	_ghost_active = false
	if _ghost_root != null:
		_ghost_root.visible = false
	stats["rally_active"] = 0
	# FX-WEATHER-01: the snow layer is persistent weather state, not a transient
	# FX item, so clear_all() deliberately leaves its gate/state untouched.


# --- coordinate helper -----------------------------------------------------

# Map positions are Vector2 metres (game.gd:16 TILE=2.0, game.height_at at
# game.gd:1893-1907). Vector3 callers are passed through unchanged so the
# integration owner can feed already-transformed scene coordinates.
func world_pos(p) -> Vector3:
	if p is Vector3:
		return p
	if not (p is Vector2):
		return Vector3.ZERO
	var v2: Vector2 = p
	var h: float = height_bias
	if game != null and game.has_method("height_at"):
		h += float(game.call("height_at", v2))
	return Vector3(v2.x - world_offset.x, h, v2.y - world_offset.y)


# --- event stream (peek, never clear or edit the sim) ----------------------

# game.gd:2823 appends {"type","pos","kind","extra"} to game.events. main.gd
# clears that array in its own _consume_events (main.gd:1514-1564). This module
# peeks with a high-water index and NEVER clears: if main clears first there is
# nothing to see, so integration should call fx.sync() before main consumes,
# or set consume_events=false and forward add_fx() itself. Open question Q3.
func _consume_events() -> void:
	if game == null:
		return
	var evs = game.get("events")
	if not (evs is Array):
		return
	if evs.size() < _events_seen:
		_events_seen = 0
	for i in range(_events_seen, evs.size()):
		var ev = evs[i]
		if not (ev is Dictionary):
			continue
		var kind: String = str(EVENT_FX.get(str(ev.get("type", "")), ""))
		if kind.is_empty():
			continue
		if not _valid_pos(ev.get("pos", null)):
			continue
		add_fx(ev.get("pos"), kind, -1.0)
		stats["events_consumed"] = int(stats.get("events_consumed", 0)) + 1
		# FX-IMPACT-01 opt-in: a donor shot is a 5-layer composition — at minimum
		# a muzzle flash + volley smoke (fx.tree:4-63). Default OFF; no change to
		# the legacy single `shot` FX unless a caller enables the flag.
		if emit_donor_shot_fx and kind == "shot":
			add_impact_fx("muzzle_flash", ev.get("pos"), -1.0)
			add_impact_fx("shotmusket", ev.get("pos"), -1.0)
	_events_seen = evs.size()


# Mirrors world.gd:3545-3561 `_emit_arrow_trails`; reads game.projectiles only.
# Donor trail timing/width come from source.pfx:1740/1746 (literal, UNVERIFIED).
func _emit_arrow_trails() -> void:
	if game == null:
		return
	var prs = game.get("projectiles")
	if not (prs is Array):
		return
	# FX-IMPACT-01 opt-in: default keeps the legacy solid-box `trail` exactly as
	# before. When enabled, emit the face-camera billboard `arrow_trail` (donor
	# MarkStyle msFaceCamera, source.pfx:1745) at the donor TimeLimit/Alpha.
	var trail_kind: String = "arrow_trail" if use_donor_arrow_trail else "trail"
	var trail_life: float = IMPACT_TRAIL_TIME_LIMIT if use_donor_arrow_trail else TRAIL_TIME_LIMIT
	var trail_alpha: float = IMPACT_TRAIL_ALPHA if use_donor_arrow_trail else TRAIL_ALPHA
	for pr in prs:
		if not (pr is Dictionary):
			continue
		if str(pr.get("kind", "")) not in ["arrow", "firearrow"]:
			continue
		var seen := false
		for item in fx_items:
			if str(item.get("kind", "")) == trail_kind and item.get("pr") == pr:
				seen = true
				break
		if seen:
			continue
		var pos = pr.get("pos", null)
		if not _valid_pos(pos):
			continue
		var item: Dictionary = add_fx(pos, trail_kind, trail_life)
		if not item.is_empty():
			item["pr"] = pr
			item["base_alpha"] = trail_alpha


# --- node construction -----------------------------------------------------

func _ensure_roots() -> void:
	if _root == null:
		_root = Node3D.new()
		_root.name = "FX3D"
		add_child(_root)
	if _ghost_root == null:
		_ghost_root = Node3D.new()
		_ghost_root.name = "BuildGhost3D"
		_ghost_root.visible = false
		add_child(_ghost_root)
		_ghost_mat = _material(GHOST_OK, false)
		var bm := BoxMesh.new()
		bm.size = Vector3(1.0, 0.05, 1.0)
		_ghost_mesh = MeshInstance3D.new()
		_ghost_mesh.name = "Footprint"
		_ghost_mesh.mesh = bm
		_ghost_mesh.material_override = _ghost_mat
		_ghost_root.add_child(_ghost_mesh)
	if _rally_root == null:
		_rally_root = Node3D.new()
		_rally_root.name = "Rally3D"
		add_child(_rally_root)
	if _selection_root == null:
		_selection_root = Node3D.new()
		_selection_root.name = "Selection3D"
		add_child(_selection_root)
	# FX-WEATHER-01: one Node3D weather root UNDER the FX layer (_root/FX3D).
	if _weather_root == null:
		_weather_root = Node3D.new()
		_weather_root.name = "WeatherSnow3D"
		_root.add_child(_weather_root)
		_build_snow_emitters()
		_apply_snow_gate()


# Donor weather band, 0..99 scale (clouds.weather:21-22). Month band 1..12
# (particles.snow.cfg:34-35) covers every month in the shipped config.
func _snow_band_ok() -> bool:
	return _weather_value >= SNOW_WEATHER_START \
		and _weather_value <= SNOW_WEATHER_END \
		and _weather_month >= SNOW_MONTH_START \
		and _weather_month <= SNOW_MONTH_END


# Gate the whole layer: hidden + not emitting while Weather=40 < WeatherStart=70
# (derived from clouds.weather:3 and particles.snow.cfg:32-33).
func _apply_snow_gate() -> void:
	var active: bool = _snow_band_ok()
	if _weather_root != null and is_instance_valid(_weather_root):
		_weather_root.visible = active
	for emitter in _snow_emitters:
		if emitter is GPUParticles3D and is_instance_valid(emitter):
			(emitter as GPUParticles3D).emitting = active
	stats["snow_weather"] = _weather_value
	stats["snow_month"] = _weather_month
	stats["snow_band"] = [SNOW_WEATHER_START, SNOW_WEATHER_END]
	stats["snow_active"] = active
	stats["snow_emitter_count"] = _snow_emitters.size()
	stats["snow_status"] = "PORT APPROXIMATION — NOT DONOR PARITY; unit mapping UNVERIFIED"


# Four donor emitters snow1..snow4 (particles.snow.cfg:2,42,82,122), each a
# GPUParticles3D + ParticleProcessMaterial. Draw pass is a plain white billboard
# quad — NO donor snow*.bmp copied: PORT APPROXIMATION, NOT DONOR PARITY.
# Donor spiral motion (SpiralRotatingRadius/Speed :14-15 etc) is NOT reproduced.
func _build_snow_emitters() -> void:
	_snow_emitters.clear()
	var sprite_mat := StandardMaterial3D.new()
	sprite_mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	sprite_mat.albedo_color = Color(1.0, 1.0, 1.0, SNOW_ALPHA)  # :6,46,86,126
	sprite_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	sprite_mat.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED  # btBillboard :16,56,96,136
	sprite_mat.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_DISABLED  # NoZWrite=True :7,47,87,127
	sprite_mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	for i in range(4):
		var emitter := GPUParticles3D.new()
		emitter.name = "Snow%d" % (i + 1)   # donor snow1..snow4
		# Flake size is the donor Height/Width literal, applied to the draw-pass
		# quad directly (no particle-size property in Godot 4.7). Unit UNVERIFIED.
		var quad := QuadMesh.new()
		quad.size = Vector2(float(SNOW_SIZES[i]), float(SNOW_SIZES[i]))
		quad.material = sprite_mat
		var ppm := ParticleProcessMaterial.new()
		ppm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
		ppm.emission_box_extents = SNOW_CUBE_EXTENTS   # CreatingCubeStart/End (+/-0.5)
		ppm.direction = SNOW_MOVE_DIR                 # MoveDirection (0,-1,0)
		ppm.spread = 0.0
		ppm.gravity = Vector3.ZERO                    # donor has no gravity field
		var speed: float = float(SNOW_SPEEDS[i])
		ppm.initial_velocity_min = speed
		ppm.initial_velocity_max = speed
		emitter.process_material = ppm
		emitter.lifetime = SNOW_PORT_LIFETIME         # PORT ONLY, no donor lifetime key
		emitter.amount = int(SNOW_COUNTS[i])          # Count 100/100/100/200
		emitter.draw_pass_1 = quad
		emitter.emitting = false                      # gated OFF until Weather >= 70
		_weather_root.add_child(emitter)
		_snow_emitters.append(emitter)


func _material(col: Color, additive: bool) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.albedo_color = col
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.emission_enabled = true
	m.emission = Color(col.r, col.g, col.b)
	m.emission_energy_multiplier = 0.35
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	if additive:
		m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	return m


# FX-IMPACT-01 — face-camera billboard material (donor msFaceCamera,
# source.pfx:1745). Plain untextured quad: NO donor sprite sheet is copied.
# `no_depth_write` mirrors donor trail `ZWrite = False` (source.pfx:1748).
# PORT APPROXIMATION — NOT DONOR PARITY (no donor art / shader port).
func _impact_material(col: Color, additive: bool, no_depth_write: bool) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.albedo_color = col
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.emission_enabled = true
	m.emission = Color(col.r, col.g, col.b)
	m.emission_energy_multiplier = 0.35
	m.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED   # msFaceCamera
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	if no_depth_write:
		m.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_DISABLED
	if additive:
		m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	return m


func _add_mesh(holder: Node3D, mesh: Mesh, mat: Material,
		p: Vector3, rot: Vector3) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	mi.material_override = mat
	mi.position = p
	mi.rotation = rot
	holder.add_child(mi)
	return mi


func _add_light(holder: Node3D, col: Color, energy: float, range_m: float) -> OmniLight3D:
	var l := OmniLight3D.new()
	l.light_color = col
	l.light_energy = energy
	l.omni_range = range_m
	l.shadow_enabled = false
	holder.add_child(l)
	return l


func _kind_color(k: String) -> Color:
	match k:
		"shot":
			return Color(1.0, 0.90, 0.50, 0.95)   # world.gd:3653
		"smoke":
			return Color(0.85, 0.85, 0.82, 0.55)  # world.gd:3657
		"explode":
			return Color(1.0, 0.60, 0.20, 0.90)   # world.gd:3660
		"crater":
			return Color(0.15, 0.12, 0.09, 0.80)  # world.gd:3663
		"fire":
			return Color(1.0, 0.45, 0.10, 0.85)   # world.gd:3666
		"heal":
			return Color(0.40, 1.00, 0.50, 0.80)  # world.gd:3669
		"capture":
			return Color(1.0, 1.0, 1.0, 0.85)     # world.gd:3672
		"rout":
			return Color(1.0, 0.30, 0.20, 0.85)   # world.gd:3674
		"chop":
			return Color(0.70, 0.60, 0.30, 0.80)  # world.gd:3676
		"trail":
			return Color(1.0, 0.88, 0.62, TRAIL_ALPHA)  # world.gd:3685
		# FX-IMPACT-01 — additive kinds (donor-tinted where a key is readable):
		"volley_smoke":
			# material.mat:17-37 shared smoke tint 0.3137255 (=80/255) grey;
			# alpha is a PORT choice (donor diffuse alpha UNVERIFIED).
			return Color(IMPACT_SMOKE_TINT_GREY, IMPACT_SMOKE_TINT_GREY,
				IMPACT_SMOKE_TINT_GREY, IMPACT_SMOKE_ALPHA)
		"muzzle_flash":
			return Color(1.0, 1.0, 1.0, 1.0)  # material.mat:63-81 tint (1,1,1,1)
		"arrow_trail":
			return Color(IMPACT_TRAIL_DIFFUSE_ALPHA, IMPACT_TRAIL_DIFFUSE_ALPHA,
				IMPACT_TRAIL_DIFFUSE_ALPHA, IMPACT_TRAIL_ALPHA)  # source.pfx:1742,1759-1763
	return Color(1.0, 1.0, 1.0, 0.6)


