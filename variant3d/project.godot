; Engine configuration file.
config_version=5

[application]

config/name="CossacksGodot - 3D Skirmish Variant"
config/description="CossacksGodot 3D variant (singleplayer skirmish only). Donor-driven; numbers read from original game data files."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]
C3Log="*res://scripts/c3_log.gd"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.06, 0.06, 0.05, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; The Compatibility renderer runs the same picture on every platform
; (Windows, macOS, Linux) and starts fast on weak graphics cards.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.09, 0.11, 0.08, 1)
