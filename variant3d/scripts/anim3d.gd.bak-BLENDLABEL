	return {
		"auto_loaded": _shipped_count,
		"index": SKIN_INDEX_PATH,
		"asset_dir": SKIN_ASSET_DIR,
		"total_bytes": _shipped_bytes,
		"error": _shipped_error,
		"registered_sids": _skins.keys(),
		"label": PORT_LABEL,
		"visual": "UNVERIFIED",
	}


