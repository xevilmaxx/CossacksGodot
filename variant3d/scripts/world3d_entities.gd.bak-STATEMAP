# BUILD-STAGES-01 — donor construction-stage presentation (no stage art shipped).
# Donor truth (DBUILD-01 §2, line citations there): build progress is hp/maxhp
# clamped to 1 (unit.script:6583-6590); stage = floor(progress*4)
# (unit.script:6596, doprogressorders.inc:84-93); visual tag 0..3 -> mesh
# suffix 1..4 (ontagstates.inc:240-251); walls fold that stage with
# `stage := 1 + stage div 3`, so they use only mesh 1 or 2
# (ontagstates.inc:247-248); a separate stage-synced scaffold auto-child uses
# <sid>a / <sid><1..4>a meshes with the `scaffold` material
# (engcen.prop:72-112, ontagstates.inc:253-259).
# BUILD-ART-C-01: 108 converted stage/scaffold OBJs now exist under
# assets/models/obj/** (BUILD_ART_BATCH_01.md, STAGE_IMPORT_01.md ticket 534).
# The 2D *_s1..s4 PNG bakes are out of scope here (header: NO 2D BAKE
# PIPELINE). Sids whose OBJ is absent still reuse the base donor mesh with an
# explicit PORT APPROXIMATION label. No donor bytes are copied by this module,
# no art is invented and the rendered result remains UNVERIFIED.
const BUILD_STAGE_STEPS: int = 4                          # donor number, unit.script:6596
const BUILD_WALL_MAX_STAGE: int = 2                       # donor number, ontagstates.inc:247-248
const BUILD_STAGE_SUFFIXES: Array[String] = ["1", "2", "3", "4"]  # ontagstates.inc:240-251
const BUILD_STAGE_LABEL: String = PORT_LABEL + " — donor floor(hp/max_hp*4) / wall 1+stage div 3 selector (unit.script:6583-6596, ontagstates.inc:240-251); converted <sid>1..4 OBJ bound when present (per-stage manifest bbox), base donor mesh reused otherwise; visual UNVERIFIED"
const BUILD_SCAFFOLD_LABEL: String = PORT_LABEL + " — donor stage-synced scaffold auto-child (engcen.prop:72-112); converted <sid>1a..4a OBJ bound and visible when present, hidden structural placeholder otherwise; visual UNVERIFIED"

# Deliberately UNTYPED: the integration seam passes the live C3Game (a Node)
# but atomic tests bind a RefCounted stub. V7-1 §3 "relaxed Node typing".
var game = null
var stats: Dictionary = {}
var anim_handoff: Dictionary = {"status": ANIM_STATUS, "owner": "anim3d.gd",
	"reason": "V7-2 Table B1 BLOCKED", "applied": false}

var _bbox: Dictionary = {}          # sid -> donor bbox [x0,x1,y0,y1,z0,z1]
var _mesh_cache: Dictionary = {}    # key -> {"mesh":Mesh,"source":String,"scale":float,"height":float}
var _batches: Dictionary = {}       # key -> {"node":MultiMeshInstance3D,"mm":MultiMesh,"ids":Array}
var _slot: Dictionary = {}          # entity id -> {"key":String,"index":int,"class":String}
var _refs: Dictionary = {}          # entity id -> entity Dictionary (sim object, read-only)
var _nodes: Dictionary = {}         # building id -> MeshInstance3D
var _rotors: Dictionary = {}        # MILLFIX: building id -> MillRotor_<id> child
# BUILD-STAGES-01: presentation mirrors only, never written back to the sim.
var _build_scaffolds: Dictionary = {}   # building id -> Scaffold_<sid>_<id> child
var _stage_mesh_cache: Dictionary = {} # sid|suffix|kind -> {"mesh":Mesh,"source":String}
# BLDDEATH-1TO1: presentation mirrors only, never written back to the sim.
var _death_mesh_cache: Dictionary = {}  # sid|suffix|kind -> derived death art info
var _death_prev: Dictionary = {}        # id -> {"dead":bool,"finished":bool,"stage":int}
var _death_materials: Dictionary = {}   # derived debris/scaffold texture+material cache
# world3d_fx.gd sibling (same add_child'd world Node3D as anim3d.gd), found once.
var _fx = null
var _fx_checked: bool = false
# MOTION-ANIM-01/ROTOR: one warning per process, even with many mills. Never
# reset in bind(): the fallback is a project/import state, not a per-game state.
var _rotor_fallback_warned: bool = false
var _field_visual: Dictionary = {}  # field id -> state/material/texture/scale CPU mirror
var _field_decals: Dictionary = {}   # field id -> terrain-conforming MeshInstance3D
var _field_decal_materials: Dictionary = {}  # season -> shared StandardMaterial3D
var _field_asset_status: Dictionary = {}  # donor material -> resolved texture/skip label
var _field_decal_paths: Dictionary = {}  # donor summer/winter decal paths found at bind
var _mesh_sources: Dictionary = {}  # source label -> sid count (measured at bind)
var _anim_t: float = 0.0

# MOTION-ANIM-01 — presentation-side mirrors of the SIM, never written back.
# id -> {"pos": Vector2, "t": float}: last SIM position/anim-clock sampled in
# sync(), used to MEASURE displacement speed instead of trusting `moving`.
var _motion_sample: Dictionary = {}
# PORT1TO1-ENT1TO1: "sid|action" -> count of donor AAF actions that exist in the
# unit's own AAF but are absent from its shipped skin export. Diagnostic only.
var _action_gaps: Dictionary = {}
# DEC-U-AAF-TRIGGERS: "sid|tid|token|blend|OK|GAP" -> count of statically
# resolved donor selector outcomes, and "sid|tid|chain-as-tried" -> count of
# misses. Intent-only diagnostics (DEC-U §7 F3/F9): they never drive a pose,
# a blend interpolation or a completion event. No donor parity is claimed.
var _donor_trigger_intents: Dictionary = {}
var _donor_trigger_gaps: Dictionary = {}
# token -> anim3d donor_orphan_note() for explicit DATA requests only. Label
# only: no selector, no fallback, no auto-trigger (DEC-U T23-T25).
var _donor_orphan_labels: Dictionary = {}
# id -> float: yaw-smoothed SIM face (radians, wrapped to -PI..PI). PORT APPROX.
var _face_smooth: Dictionary = {}
# id -> int: donor frame actually bound to a mesh batch, so a frozen sim can
# still be refreshed when the normal frame-migration callback is skipped.
var _applied_pose_frame: Dictionary = {}

# V7-74: anim3d.gd instance, discovered once among the composed world's
# children (world3d.gd:152-165 add_child's every module under one Node3D).
# No edit to world3d.gd is needed; atomic tests that bind a bare stub have no
# sibling anim module and therefore keep the static bind path.
var _anim = null
var _anim_checked: bool = false
# sid|action|frame -> {"mesh":ArrayMesh, "frame":int, "action":String, ...}
# Bounded by the distinct donor frames actually visited; shared by all units.
var _morph_meshes: Dictionary = {}
# sid -> donor OBJ v/vt/f topology, parsed once (the Godot OBJ importer
# de-indexes and reorders verts, so its 719-vertex buffer cannot be addressed
# by the 577 donor indices; the source OBJ is the common index space).
var _obj_topology: Dictionary = {}

# V7-65 donor key-colour table. Index = PLAYER SLOT (identity mapping, see
# bind() stats + report), NOT nation. _key_colors[i] is Color(rgb_godot_float,
# alpha=1.0); alpha is a PORT choice (donor alpha UNVERIFIED, V7-61 §5).
var _key_colors: Array = []
var _key_colors_loaded: bool = false
var _key_colors_error: String = ""

# FIX-COLOR state. The donor DDS path is read from the manifest this module
# already parses in bind(); it is NOT a new port invention. Every entry is
# derived from donor data, and a missing/unreadable mask means NO tint at all
# (never the V7-65 whole-body fallback).
var _donor_texture_paths: Dictionary = {}   # sid -> donor DDS absolute path
var _band_mask_cache: Dictionary = {}       # sid -> {"image":Image,"texture":ImageTexture}
var _band_mask_stats: Dictionary = {}       # sid -> measured mask/vertex/face counts

# P11 DRAW-CALL/INSTANCE: one Shader + one ShaderMaterial per
# (sid, kind, tint RGBA, base material identity). _tinted_material() used to
# create a NEW Shader and ShaderMaterial for every batch and every building
# stage swap; sharing keeps custColor per player slot while removing repeated
# shader parse/material allocation. No art, tint value or label is changed.
var _tint_shader: Shader = null
var _tint_material_cache: Dictionary = {}  # key -> ShaderMaterial (shared)


# ---------------------------------------------------------------- bind / stats
func bind(g) -> void:
	game = g
	_load_key_colors()
	_bbox.clear()
	_mesh_cache.clear()
	_mesh_sources.clear()
	_morph_meshes.clear()
	_obj_topology.clear()
	_donor_texture_paths.clear()
	_band_mask_cache.clear()
	_band_mask_stats.clear()
	# P11: shared materials belong to the previous game meshes; rebuild.
	_tint_material_cache.clear()
	_tint_shader = null
	# MOTION-ANIM-01: per-unit presentation mirrors are rebuilt from the new game.
	_motion_sample.clear()
	_face_smooth.clear()
	_applied_pose_frame.clear()
	_action_gaps.clear()
	_donor_trigger_intents.clear()
	_donor_trigger_gaps.clear()
	_donor_orphan_labels.clear()
	_rotors.clear()
	# BUILD-STAGES-01: rebuild presentation mirrors from the new game.
	_build_scaffolds.clear()
	_stage_mesh_cache.clear()
	# BLDDEATH-1TO1: rebuild derived death mirrors from the new game.
	_death_mesh_cache.clear()
	_death_prev.clear()
	_death_materials.clear()
	_fx = null
	_fx_checked = false
	_field_visual.clear()
	for fid in _field_decals.keys():
		var decal = _field_decals[fid]
		if is_instance_valid(decal):
			(decal as Node).free()
	_field_decals.clear()
	_field_decal_materials.clear()
	_field_asset_status.clear()
	# FIX-FIELD-DONOR: both converted donor ground-decal PNGs are present;
	# actual terrain-conforming decals are created per field below.
	_field_decal_paths = {
		"summer": FIELD_DECAL_SUMMER if ResourceLoader.exists(FIELD_DECAL_SUMMER) else "",
		"winter": FIELD_DECAL_WINTER if ResourceLoader.exists(FIELD_DECAL_WINTER) else "",
	}
	_anim = null
	_anim_checked = false
	var models: int = 0
	if FileAccess.file_exists(MANIFEST_PATH):
		var parsed = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST_PATH))
		if parsed is Dictionary and parsed.has("models"):
			for m in (parsed["models"] as Array):
				var sid := str(m.get("sid", ""))
				var bb = m.get("bbox", [])
				if sid != "" and bb is Array and (bb as Array).size() >= 6:
					_bbox[sid] = bb
				# FIX-COLOR: manifest.json:models[i].texture is the DONOR DDS
				# absolute path (measured for peasant:
				# ...\materials\units\peaukr.dds). Kept verbatim, no guessing.
				var donor_tex := str(m.get("texture", ""))
				if sid != "" and donor_tex != "":
					_donor_texture_paths[sid] = donor_tex
				models += 1
	# FIX-FIELD-DONOR: preflight every authored summer/winter crop material.
	# Only converted port assets are eligible. Missing art is a labelled SKIP;
	# the existing field1 conversion may be used only as an explicit fallback.
	var field_material_names: Array[String] = []
	for base_name in ["field", "field1", "field2", "field3", "field4", "field5", "field6", "field7"]:
		field_material_names.append(base_name)
		field_material_names.append(base_name + "w")
	var field_skipped: Array[String] = []
	for material_name in field_material_names:
		var texture_status: Dictionary = _field_texture_path(material_name)
		_field_asset_status[material_name] = texture_status
		if bool(texture_status.get("skipped", false)):
			field_skipped.append(material_name)
	if not field_skipped.is_empty():
		push_warning("world3d_entities: FIX-FIELD-DONOR SKIP missing converted crop art for " + ", ".join(field_skipped) + "; existing field1 art is an explicitly labelled fallback, never synthesized gold art")
	# Asset availability is MEASURED here with ResourceLoader.exists(); actual
	# load() happens lazily in _mesh_info() and is recorded in _mesh_sources.
	var obj_available: int = 0
	for sid in _bbox.keys():
		if ResourceLoader.exists(AssetPaths.existing(str(sid), "obj")):
			obj_available += 1
	var glb_available: int = 0
	for sid in _bbox.keys():
		if ResourceLoader.exists(AssetPaths.existing(str(sid), "glb")):
			glb_available += 1
	# DECOR-01: measure the live tree pool against disk instead of assuming it.
	var tree_pool_available: Array = []
	for sid in POOL_TREE:
		if _bbox.has(sid) and ResourceLoader.exists(AssetPaths.existing(str(sid), "obj")) \
				and ResourceLoader.exists(AssetPaths.existing(str(sid), "tex")):
			tree_pool_available.append(sid)
	# BUILD-STAGES-01: measure donor-named stage/scaffold OBJs on disk instead
	# of assuming art. No asset is copied or generated by this module.
	var stage_obj_sids: Array = []
	var scaffold_obj_sids: Array = []
	for sid in _bbox.keys():
		var s := str(sid)
		if ResourceLoader.exists(AssetPaths.existing(s, "obj", "1")):
			stage_obj_sids.append(s)
		if ResourceLoader.exists(AssetPaths.existing(s, "obj", "a")):
			scaffold_obj_sids.append(s)
	# FIX-FIELD-DECAL-VISUAL: asset-status telemetry. Every authored crop name
	# is measured, and the mature "field" entry is surfaced explicitly so the
	# ripe-parcel art choice is auditable without a Godot capture.
	var field_converted := 0
	for mname in _field_asset_status.keys():
		if not bool((_field_asset_status[mname] as Dictionary).get("skipped", true)):
			field_converted += 1
	var mature_asset: Dictionary = _field_asset_status.get("field", {}) as Dictionary
	stats = {
		"module": "V7-14 world3d_entities",
		"extends": "Node3D",
		"api": ["bind(game)", "sync(dt)", "add_unit(e)", "add_building(e)",
			"add_resource(n)", "remove(id)"],
		"manifest_sids": models,
		"bbox_sids": _bbox.size(),
		"obj_available": obj_available,
		"glb_available": glb_available,
		"obj_dir": OBJ_DIR,
		"glb_dir": GLB_DIR,
		"tex_dir": TEX_DIR,
		"mesh_sources_loaded": _mesh_sources,
		"batch_capacity": BATCH_CAPACITY,
		"batches": 0,
		"units": 0,
		"buildings": 0,
		"resources": 0,
		"axis": "Z-up to Y-up baked: (x,y,z) -> (x,z,-y); V7-2 section 4.1",
		"scale": "bbox height; units/buildings s=1, env uses envscales.cfg, field exempt; V7-2 4.1/1.1/2.3",
		"animation": ANIM_STATUS,
		# V7-74 donor morph telemetry (structural/numeric, NOT a visual claim).
		"donor_morph_api": "anim3d.gd.pose_for(e, action, t) -> pose['verts'] (V764 report section 4)",
		"donor_morph_label": PORT_LABEL,
		"donor_morph_visual": "UNVERIFIED",
		"donor_morph_rig": "BLOCKED_RIG - flat root only, donor bone parents unreadable (V7-2 Table B1)",
		"donor_morph_coord": "donor Z-up metres -> bbox/Y-up; vertex i == assets/models/obj/<sid>.obj vertex i",
		"donor_morph_action_map": MORPH_ACTION_MAP,
		"motion_gate_label": MOTION_GATE_STATUS,
		"motion_walk_gate_m_s": WALK_SPEED_GATE_M_S,
		"motion_walk_gate_label": MOTION_GATE_STATUS,
		"motion_yaw_clamp_label": YAW_CLAMP_STATUS,
		"motion_yaw_max_rate_rad_s": YAW_MAX_RATE_RAD_S,
		"motion_yaw_final_turn_label": YAW_FINAL_TURN_STATUS,
		# PORT1TO1-ENT1TO1 — donor telemetry, no parity claim.
		"action_selection_label": ACTION_SELECTION_STATUS,
		"action_selection_fallback_label": DONOR_FALLBACK_STATUS,
		"action_selection_attack2_tokens": AAF_ATTACK2_TOKENS.duplicate(),
		"construct_skin_label": CONSTRUCT_SKIN_STATUS,
		"action_selection_gaps": _action_gaps.duplicate(true),
		# DEC-U-AAF-TRIGGERS: additive telemetry only; every pre-existing key
		# (death-art, AAF action-map, v5 save seam) is left untouched.
		"donor_trigger_selector_label": DONOR_TRIGGER_STATUS,
		"donor_trigger_orphan_label": DONOR_TRIGGER_ORPHAN_STATUS,
		"donor_trigger_intents": _donor_trigger_intents.duplicate(true),
		"donor_trigger_gaps": _donor_trigger_gaps.duplicate(true),
		"donor_trigger_orphans": _donor_orphan_labels.duplicate(true),
		"donor_lod_label": LOD_STATUS,
		"donor_lod_mesh_range": [DONOR_LOD_MESH_MIN_DIST, DONOR_LOD_MESH_MAX_DIST],
		"donor_lod_shader_range": [DONOR_LOD_SHADER_MIN_DIST, DONOR_LOD_SHADER_MAX_DIST],
		"donor_lod_child_pool_max": DONOR_LOD_CHILD_POOL_MAX,
		"donor_material_state_label": MATERIAL_STATE_STATUS,
		"donor_collision_label": COLLISION_MODEL_STATUS,
		"donor_unit_radius_m": DONOR_UNIT_RADIUS_M.duplicate(true),
		"donor_collision_tags": DONOR_COLLISION_TAGS.duplicate(true),
		"donor_unit_aabb": DONOR_UNIT_AABB.duplicate(true),
		"motion_frozen_refresh_label": "PORT APPROX — frozen sim (measured speed below gate) still re-samples pose and rebinds the batch mesh; visual confirmation UNVERIFIED",
		"donor_morph_normals": "generated from morphed donor faces (donor .oss emits positions only); tangents unset - UNVERIFIED",
		"no_2d_sprite_sheets": true,
		"tile_m": TILE_M,
		# V7-65 donor tint telemetry (measured, not a visual-parity claim).
		"donor_key_colors_path": KEY_COLORS_PATH,
		"donor_key_colors_loaded": _key_colors_loaded,
		"donor_key_colors_slots": _key_colors.size(),
		"donor_key_colors_error": _key_colors_error,
		"donor_tint_mapping": "player slot index -> donor gKeyColor slot (identity; mercenary slot 12); NOT nation",
		# NATION-MODEL-01 telemetry (structural only; no visual-parity claim).
		"nation_mesh_label": NATION_MESH_EXACT_STATUS,
		"nation_mesh_fallback_label": NATION_MESH_FALLBACK_STATUS,
		"nation_mesh_usage": {},
		"nation_mesh_blocked_evidence": NATION_MESH_BLOCKED_EVIDENCE,
		# BUILD-ANIM-DIAG-01 telemetry (presentation only, no parity claim).
		"construct_action_status": CONSTRUCT_SKIN_STATUS,
		# FIX-COLOR: corrected scope — band mask, not a whole-body albedo paint.
		"donor_tint_target": "ShaderMaterial custColor (uniform-0 analogue), donor mix(tex, custColor*tex, tex.a*custColor.a) — unit.smx9.id8.frag:37-38",
		"donor_tint_scope": "tfRGBA albedo ALPHA bands only (refunit.mat:37, refbuilding.mat:37, misc.script:5072); tfDefault children untinted (units.mat:9,20)",
		"donor_tint_alpha": 1.0,
		"donor_tint_label": PORT_LABEL,
		"donor_tint_visual": "UNVERIFIED",
		"donor_tint_mask_source": "manifest.json models[i].texture -> donor DDS first-mip DXT5 alpha (port PNG alpha dropped: tools/convert_models.py:148-151,449-450)",
		"donor_tint_mask_stats": _band_mask_stats,
		"donor_tint_unverified": "donor shader binary not executed; mask decoded from donor DDS text-asset path, not from a donor render; >1.0 clamp UNVERIFIED (V7-61 §5; AUDIT3D-02 Q3)",
		# MILLFIX telemetry: structural/numeric only, never a visual-parity claim.
		"mill_rotor_label": ROTOR_STATUS,
		"mill_rotor_visual": "UNVERIFIED",
		"mill_rotor_source": ROTOR_TEX_PATH,
		"mill_rotor_import_path": ROTOR_TEX_IMPORT_PATH,
		"mill_rotor_meta": ROTOR_META_PATH,
		"mill_rotor_spin_rad_per_s": MILL_SPIN,
		"mill_rotor_spin_axis_label": ROTOR_SPIN_AXIS_STATUS,
		"mill_rotor_texture_status": ROTOR_FALLBACK_STATUS,
		# BUILD-STAGES-01 telemetry (structural/numeric only, no visual claim).
		"build_stage_label": BUILD_STAGE_LABEL,
		"build_stage_visual": "UNVERIFIED",
		"build_stage_rule": "floor(clamp(hp/max_hp,0,1)*4) -> suffix 1..4; unit.script:6583-6596, ontagstates.inc:240-251 (PORT1TO1-ENT1TO1 D10: progress/build_time removed)",
		"build_stage_wall_rule": "sid 'wal': 1 + stage div 3 -> suffix 1..2; ontagstates.inc:247-248",
		"build_death_stage_rule": "floor(hp/max_hp*4) read directly from hp/max_hp, wall 1+stage div 3; ontagstates.inc:240-259; NOT build_time",
		"build_death_art_manifest": BLD_DEATH_MANIFEST,
		"build_death_art_status": BUILDING_DEATH_STATUS,
		"build_death_burn_status": BLD_DEATH_BURN_STATUS,
		"build_death_explosion_status": BLD_DEATH_EXPLOSION_STATUS,
		"build_death_schedule_rule": "settagstates.inc:32-53 — death forces visual stage_0 (_death1), DeathStage1 after deathtime_0=%d -> stage_1 (_death2), DeathStage2 after deathtime_1=%d -> destroy; birth-death forces stage_1 immediately (:34-39); STAGE TIMERS, NOT a visual TTL; time base [U] U14" % [BLD_DEATH_STAGE_TIMER_UNITS, BLD_DEATH_STAGE_TIMER_UNITS],
		"build_death_sound_key": BLD_DEATH_SOUND_KEY,
		"build_death_sound_status": BLD_DEATH_SOUND_STATUS,
		"build_death_explosion_keys": BLD_DEATH_EXPLOSION_KEYS.duplicate(),
		"build_stage_scaffold_label": BUILD_SCAFFOLD_LABEL,
		"build_stage_obj_sids": stage_obj_sids,
		"build_scaffold_obj_sids": scaffold_obj_sids,
		"build_stage_art_status": (PORT_LABEL + " — BLOCKED: no stage/scaffold OBJ on disk; base donor mesh reused; visual UNVERIFIED") if stage_obj_sids.is_empty() else (PORT_LABEL + " — converted stage/scaffold OBJ present for measured sids; per-stage manifest bbox applied on swap; visual UNVERIFIED"),
		"field_visual_label": FIELD_STATUS,
		"field_visual_visual": "UNVERIFIED",
		"field_visual_decals": _field_decal_paths,
		"field_visual_asset_status": _field_asset_status,
		"field_visual_stage_assets_total": _field_asset_status.size(),
		"field_visual_stage_assets_converted": field_converted,
		"field_visual_mature_asset_path": str(mature_asset.get("path", "")),
		"field_visual_mature_asset_status": str(mature_asset.get("status", "")),
		"field_visual_material_status": FIELD_EMISSION_STATUS,
		"field_visual_crop_material_status": FIELD_CROP_MATERIAL_STATUS,
		"field_visual_crop_footprint_status": FIELD_CROP_FOOTPRINT_STATUS,
		"field_visual_crop_footprint_m": FIELD_CROP_FOOTPRINT_M,
		"field_visual_mature_texture_path": str((_field_asset_status.get("field", {}) as Dictionary).get("path", "")),
		"field_visual_decal_status": FIELD_DECAL_STATUS,
		"field_visual_decal_material_status": FIELD_DECAL_MATERIAL_STATUS,
		"field_visual_texture_import_status": FIELD_TEXTURE_IMPORT_STATUS,
		"field_visual_decal_constants": {
			"angles_deg": FIELD_DECAL_ANGLES,
			"size_multiplier": FIELD_DECAL_SIZE_MULTIPLIER,
			"uv_scale": FIELD_DECAL_UV_SCALE,
			"uv_offset": FIELD_DECAL_UV_OFFSET,
			"epsilon": FIELD_DECAL_EPSILON,
			"port_size_m": FIELD_DECAL_SIZE_M,
		},
		"field_visual_sow_step_m": FIELD_STEP_M,
		"field_visual_target_span_m": FIELD_SPAN_M,
		# DECOR-01 telemetry (structural/numeric/measurement only, no visual claim).
		"decor_tree_pool_declared": POOL_TREE.size(),
		"decor_tree_pool_resolvable": tree_pool_available.size(),
		"decor_tree_pool_sids": tree_pool_available,
		"decor_tree_ladder_sids": ENV_TREE_SCALE.size(),
		"decor_tree_ladder": "envscales.cfg:158-585 per-sid ladder; 0.475..0.76 bases; all tree jitter wide 0.85..1.15 (:162-164)",
		"decor_tree_jitter_band": TREE_JITTER_BAND,
		"decor_tree_jitter_range": [ENV_JITTER_BANDS[TREE_JITTER_BAND].x, ENV_JITTER_BANDS[TREE_JITTER_BAND].y],
		"decor_jitter_bands": {"none": [1.0, 1.0], "tight": [0.95, 1.05], "wide": [0.85, 1.15]},
		"decor_tree_yaw": TREE_YAW_STATUS,
		"decor_forest_stand": TREE_STAND_STATUS,
		"decor_mine_scale": ENV_SCALE["mine"],
		"decor_mine_jitter_band": "none",
		"decor_mine_ground_disc": MINE_DISC_STATUS,
	}
	push_warning("world3d_entities: " + ANIM_STATUS)


# ---------------------------------------------------------------- mesh loading
func _first_mesh(n: Node) -> Mesh:
	if n is MeshInstance3D:
		var mi := n as MeshInstance3D
		if mi.mesh != null:
			return mi.mesh
	for c in n.get_children():
		var m := _first_mesh(c)
		if m != null:
			return m
	return null


func _env_group(sid: String) -> String:
	if sid.begins_with("mine"):
		return "mine"
	if sid.begins_with("rock") or sid == "stone":
		return "stone"
	if sid.begins_with("tree"):
		return "tree"
	return ""


# DECOR-01: donor per-sid envscale factor. Returns the donor value only for the
# 18 tree sids that have an explicit envscales.cfg entry; stumps and oak
# deliberately fall through to the unchanged legacy ENV_SCALE["tree"] = 0.5.
func _env_scale_factor(sid: String) -> float:
	if ENV_TREE_SCALE.has(sid):
		return float(ENV_TREE_SCALE[sid])
	return float(ENV_SCALE.get(_env_group(sid), 1.0))


# DECOR-01: deterministic position hash in [0,1). Same no-RNG policy as
# _pick_sid(): integer arithmetic only, so two identical-seed runs agree.
func _hash01(p: Vector2) -> float:
	var ix: int = int(absf(p.x) * 100.0)
	var iy: int = int(absf(p.y) * 100.0)
	var h: int = (ix * 73856093 + iy * 19349663) & 0x7FFFFFFF
	return float(h % 100000) / 100000.0


# DECOR-01: scale multiplier for one instance inside its donor band.
# "none" (mines/field) returns exactly 1.0 - the existing jitter bypass is
# preserved, not redone. "wide" is the tree band: 0.85..1.15 at envscales.cfg:162-164.
func _jitter_factor(band: String, p: Vector2) -> float:
	var r: Vector2 = ENV_JITTER_BANDS.get(band, ENV_JITTER_BANDS["wide"])
	if is_equal_approx(r.x, r.y):
		return 1.0
	return r.x + (r.y - r.x) * _hash01(p)


func _default_material(sid: String, kind: String) -> Material:
	var mat := StandardMaterial3D.new()
	var tex_path := AssetPaths.existing(sid, "tex")
	if ResourceLoader.exists(tex_path):
		var tex := load(tex_path) as Texture2D
		if tex != null:
			mat.albedo_texture = tex
	mat.roughness = 1.0
	mat.metallic = 0.0
	# Donor env PNGs are RGBA (V7-2 section 2.3). Cut-out is a PORT
	# APPROXIMATION: donor GLB alphaMode is UNVERIFIED (V7-2 Table B1).
	if kind == "res":
		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
		mat.alpha_scissor_threshold = 0.5
	# The OBJ importer keeps donor winding; disable culling so a convention
	# mismatch cannot make a whole silhouette disappear (V7-2 4.1 warns not
	# to double-swap winding).
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	return mat


# ---------------------------------------------------------------- field donor visuals
func _is_field_batch(key: String) -> bool:
	return key.begins_with("res|field|")


func _field_season() -> String:
	# Data.BIOME is the existing canonical season string (data.gd:230).
	# Desert has no separate donor field crop binding in the read sources;
	# summer art is the explicit port fallback there, never a winter claim.
	return "winter" if str(Data.BIOME).to_lower() == "winter" else "summer"


func _field_texture_path(material_name: String) -> Dictionary:
	# FIX-FIELD-DECAL-VISUAL: resolve every authored crop name directly against
	# the converted asset registered in manifest.json. FIX-FIELD-ASSETS converted
	# all 16 stage textures (field, field1..7, fieldw, field1w..7w) to
	# res://assets/models/tex/shared/terrain/<name>.png, and the manifest sid
	# "field" now records the DONOR mature field.dds (not the old field1 alias).
	# The previous provenance-gated branches could silently skip a requested
	# stage and fall back to growth-stage art; asking for the name we mean makes
	# "ripe" bind field.png (mature) and every field1..7/winter bind its own art.
	var candidate := AssetPaths.existing(material_name, "tex")
	if candidate != "" and ResourceLoader.exists(candidate):
		return {"requested_material": material_name, "texture_material": material_name,
			"path": candidate, "skipped": false,
			"status": "DONOR_CONVERTED " + material_name + " -> " + candidate}
	# A genuinely missing stage/winter asset is never synthesized. The only
	# fallback is the explicitly converted field1.png, never the mature field.png
	# (which now resolves under the "field" name) and never invented gold art.
	var fallback := AssetPaths.existing("field1", "tex")
	if fallback != "" and ResourceLoader.exists(fallback):
		return {"requested_material": material_name, "texture_material": "field1",
			"path": fallback, "skipped": true,
			"status": "SKIP " + material_name + ": converted donor texture absent; fallback field1.png -> " + fallback + " (PORT APPROXIMATION)"}
	return {"requested_material": material_name, "texture_material": "",
		"path": "", "skipped": true,
		"status": "SKIP " + material_name + ": converted donor texture absent; no crop texture fallback"}


func _field_spec(fe: Dictionary) -> Dictionary:
	var st := ""
	var g := 0.0
	if game != null:
		if game.has_method("field_state"):
			st = str(game.call("field_state", fe))
		if game.has_method("field_growth01"):
			g = clampf(float(game.call("field_growth01", fe)), 0.0, 1.0)
	if st == "":
		st = "ripe" if g > 0.0 else "depleted"
	# [O] Donor harvested HP bands are 13000/5000/25000 (DEC_VIS_03 §3.3).
	# The port's hits ratio is left untouched; only its visual material changes.
	var donor_material := "field7"
	match st:
		"ripe":
			donor_material = "field"
		"growing":
			if g >= FIELD_DONOR_HP_MATURE / FIELD_DONOR_HP_MAX:
				donor_material = "field"
			elif g >= FIELD_DONOR_HP_FIELD5 / FIELD_DONOR_HP_MAX:
				donor_material = "field5"
			else:
				donor_material = "field6"
		"regrowing":
			# The port has one regrow timer, not the donor's separate rest/grow
			# timers. Map its existing 0..1 progress to the four donor growth
			# materials without changing the timer or any sim value.
			if g <= 0.0:
				donor_material = "field7"
			elif g >= 1.0:
				donor_material = "field"
			else:
				var growth_stage := mini(int(floor(g * 4.0)), FIELD_GROWTH_MATERIALS.size() - 1)
				donor_material = FIELD_GROWTH_MATERIALS[growth_stage]
		_:
			donor_material = "field7"
	var season := _field_season()
	if season == "winter":
		donor_material += "w"
	var emission := FIELD_EMISSION_WARM if donor_material == "field" or donor_material == "fieldw" else FIELD_EMISSION_NEUTRAL
	var texture_status: Dictionary
	if _field_asset_status.has(donor_material):
		texture_status = _field_asset_status[donor_material]
	else:
		texture_status = _field_texture_path(donor_material)
	return {"state": st, "growth01": g, "season": season,
		"material": donor_material, "emission": emission,
		"texture_path": str(texture_status.get("path", "")),
		"texture_material": str(texture_status.get("texture_material", "")),
		"texture_status": str(texture_status.get("status", "")),
		"texture_skipped": bool(texture_status.get("skipped", false))}


func _field_crop_material(spec: Dictionary) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	var texture_path := str(spec.get("texture_path", ""))
	if texture_path != "" and ResourceLoader.exists(texture_path):
		mat.albedo_texture = load(texture_path) as Texture2D
	# Exact authored warm/neutral RGB, applied as a multiplier rather than an
	# additive emission-energy approximation. See FIELD_EMISSION_STATUS.
	mat.albedo_color = spec.get("emission", Color(1, 1, 1, 1))
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.disable_ambient_light = true
	mat.roughness = 1.0
	mat.metallic = 0.0
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	# Donor refbase.mat bmAlphaTest50 + fcNoCull. Instance alpha stays 1.0.
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	mat.alpha_scissor_threshold = 0.5
	mat.vertex_color_use_as_albedo = true
	mat.emission_enabled = false
	# Donor twBoth + linear/linear-mipmap-linear filtering.
	mat.texture_repeat = true
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	# FIX-FIELD-VISIBILITY: mirror the real cut-out state for telemetry. This is
	# introspection only - it does not change any rendering value above.
	mat.set_meta("field_crop_material_state", {
		"transparency": "TRANSPARENCY_ALPHA_SCISSOR",
		"alpha_scissor_threshold": mat.alpha_scissor_threshold,
		"cull_mode": "CULL_DISABLED",
		"shading_mode": "SHADING_MODE_UNSHADED",
		"instance_alpha": 1.0,
		"emission_enabled": mat.emission_enabled,
		"vertex_color_use_as_albedo": mat.vertex_color_use_as_albedo,
		"texture_path": texture_path,
		"status": FIELD_CROP_MATERIAL_STATUS,
	})
	return mat


func _field_decal_material(season: String) -> Material:
	if _field_decal_materials.has(season):
		return _field_decal_materials[season] as Material
	var texture_path := str(_field_decal_paths.get(season, ""))
	if texture_path == "":
		return null
	var mat := StandardMaterial3D.new()
	mat.albedo_texture = load(texture_path) as Texture2D
	# decals.mat:51-103 authors diffuse 200/255, ambient 0.15686, specular and
	# emission 0. StandardMaterial3D cannot express the separate authored
	# ambient, so only the authored diffuse factor is used as a neutral albedo
	# multiplier. No invented gold tint and no emission-energy scalar.
	mat.albedo_color = Color(200.0 / 255.0, 200.0 / 255.0, 200.0 / 255.0, 1.0)
	# [O] envfieldd/w.png carry a real alpha channel, so TRANSPARENCY_ALPHA +
	# BLEND_MODE_MIX makes the ground quad an alpha cut-out/blend instead of a
	# dark opaque square. [O/U] decals.mat uses bmTransparency; the recovered
	# generic GL_DST_ALPHA / GL_ONE_MINUS_DST_ALPHA factors cannot be encoded in
	# Godot and a decal-specific override is unresolved, so this conventional
	# source-alpha blend stays a labelled PORT APPROXIMATION (FIELD_DECAL_STATUS).
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.blend_mode = BaseMaterial3D.BLEND_MODE_MIX
	mat.cull_mode = BaseMaterial3D.CULL_BACK
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
	# FIX-FIELD-DECAL-VISUAL: the 1.3x decal quad lies only FIELD_DECAL_EPSILON
	# above the terrain and can overlap the standing wheat. Never write its
	# depth and draw it before other transparents so it cannot overdraw/hide
	# the alpha-tested crop layer. Both settings are constants (deterministic).
	mat.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_DISABLED
	mat.render_priority = -1
	mat.roughness = 1.0
	mat.metallic = 0.0
	mat.specular_mode = BaseMaterial3D.SPECULAR_DISABLED
	mat.disable_fog = true
	mat.emission_enabled = false
	mat.texture_repeat = true
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	# FIX-FIELD-VISIBILITY: mirror the real draw state for telemetry. Introspection
	# only - no rendering value above is changed. DEPTH_DRAW_DISABLED means "do not
	# WRITE depth"; depth TEST stays at default, so the opaque scissored crop already
	# in the depth buffer rejects these fragments instead of being overpainted.
	mat.set_meta("field_decal_material_state", {
		"transparency": "TRANSPARENCY_ALPHA",
		"blend_mode": "BLEND_MODE_MIX",
		"depth_draw_mode": "DEPTH_DRAW_DISABLED",
		"render_priority": mat.render_priority,
		"cull_mode": "CULL_BACK",
		"no_depth_test_flag": mat.get_flag(BaseMaterial3D.FLAG_DISABLE_DEPTH_TEST),
		"texture_path": texture_path,
		"status": FIELD_DECAL_MATERIAL_STATUS,
	})
	_field_decal_materials[season] = mat
	return mat


# FIX-FIELD-VISIBILITY: read the material meta back without allocating a material
# or switching season. Returns the declared defaults when nothing is built yet.
func _field_decal_material_state() -> Dictionary:
	var season := _field_season()
	var mat = _field_decal_materials.get(season, null)
	if mat is Material:
		var state: Variant = (mat as Material).get_meta("field_decal_material_state", {})
		if state is Dictionary:
			return state as Dictionary
	return {"transparency": "TRANSPARENCY_ALPHA", "blend_mode": "BLEND_MODE_MIX",
		"depth_draw_mode": "DEPTH_DRAW_DISABLED", "render_priority": -1,
		"cull_mode": "CULL_BACK", "no_depth_test_flag": false,
		"texture_path": str(_field_decal_paths.get(season, "")),
		"state_source": "declared_default_no_material_yet"}


# FIX-FIELD-VISIBILITY: same idea for the crop, read from a live field batch.
func _field_crop_material_state() -> Dictionary:
	for key in _batches.keys():
		if not _is_field_batch(str(key)):
			continue
		var node = (_batches[key] as Dictionary).get("node", null)
		if node is GeometryInstance3D:
			var mat = (node as GeometryInstance3D).material_override
			if mat is Material:
				var state: Variant = (mat as Material).get_meta("field_crop_material_state", {})
				if state is Dictionary:
					return state as Dictionary
	return {"transparency": "TRANSPARENCY_ALPHA_SCISSOR", "alpha_scissor_threshold": 0.5,
		"cull_mode": "CULL_DISABLED", "shading_mode": "SHADING_MODE_UNSHADED",
		"instance_alpha": 1.0, "emission_enabled": false,
		"vertex_color_use_as_albedo": true, "texture_path": "",
		"state_source": "declared_default_no_batch_yet"}


func _field_decal_mesh(fe: Dictionary, angle_deg: float) -> ArrayMesh:
	var p: Vector2 = fe.get("pos", Vector2.ZERO)
	var half := FIELD_DECAL_SIZE_M * 0.5
	var segments := FIELD_DECAL_GRID_SEGMENTS
	var row := segments + 1
	var c := cos(deg_to_rad(angle_deg))
	var s := sin(deg_to_rad(angle_deg))
	var verts := PackedVector3Array()
	var uvs := PackedVector2Array()
	var indices := PackedInt32Array()
	for iz in range(row):
		var local_z := half - 2.0 * half * float(iz) / float(segments)
		for ix in range(row):
			var local_x := -half + 2.0 * half * float(ix) / float(segments)
			var rotated := Vector2(local_x * c + local_z * s, -local_x * s + local_z * c)
			var world := _world_pos(p + rotated)
			# FIX-FIELD-DECAL-VISUAL: epsilon stays a single compile-time constant
			# (donor 0.01, API world units [U]) sampled deterministically per grid
			# vertex. No per-frame jitter and no crop-geometry/7x7/RNG change.
			# Residual z-fighting against the port terrain triangulation is [U].
			verts.append(Vector3(world.x, world.y + FIELD_DECAL_EPSILON, world.z))
			var base_uv := Vector2(float(ix) / float(segments), float(iz) / float(segments))
			# decals.lib texflipvertical=True, then misc.script's 1.3/-0.15.
			var flipped := Vector2(base_uv.x, 1.0 - base_uv.y)
			uvs.append(flipped * FIELD_DECAL_UV_SCALE + Vector2(FIELD_DECAL_UV_OFFSET, FIELD_DECAL_UV_OFFSET))
	for iz in range(segments):
		for ix in range(segments):
			var a := iz * row + ix
			var b := a + 1
			var cc := a + row
			var d := cc + 1
			# Clockwise/upward winding for Godot's back-face culling.
			indices.append(a)
			indices.append(b)
			indices.append(cc)
			indices.append(b)
			indices.append(d)
			indices.append(cc)
	var normals := PackedVector3Array()
	normals.resize(verts.size())
	for i in range(0, indices.size(), 3):
		var a := verts[indices[i]]
		var b := verts[indices[i + 1]]
		var cc := verts[indices[i + 2]]
		var face_normal := (b - a).cross(cc - a)
		normals[indices[i]] += face_normal
		normals[indices[i + 1]] += face_normal
		normals[indices[i + 2]] += face_normal
	for i in range(normals.size()):
		if normals[i].length_squared() > 0.0:
			normals[i] = normals[i].normalized()
		else:
			normals[i] = Vector3.UP
	var arrays: Array = []
	arrays.resize(Mesh.ARRAY_MAX)
	for i in range(Mesh.ARRAY_MAX):
		arrays[i] = null
	arrays[Mesh.ARRAY_VERTEX] = verts
	arrays[Mesh.ARRAY_TEX_UV] = uvs
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_INDEX] = indices
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh


func _sync_field_decal(fid: int, spec: Dictionary) -> void:
	var fe = _refs.get(fid)
	if not (fe is Dictionary):
		return
	var ed := fe as Dictionary
	var season := str(spec.get("season", "summer"))
	var texture_path := str(_field_decal_paths.get(season, ""))
	var existing = _field_decals.get(fid, null)
	if texture_path == "":
		if existing is MeshInstance3D and is_instance_valid(existing):
			(existing as MeshInstance3D).free()
		_field_decals.erase(fid)
		return
	var p: Vector2 = ed.get("pos", Vector2.ZERO)
	# Donor random>0.5 chooses 45, else 225. Position hash preserves the shared
	# RNG stream and gives deterministic 45/225 variation without a new draw.
	var angle := 225.0 if _hash01(p) > 0.5 else 45.0
	var rebuild := not (existing is MeshInstance3D and is_instance_valid(existing))
	if not rebuild:
		var old_pos: Variant = (existing as MeshInstance3D).get_meta("field_pos", Vector2.INF)
		rebuild = not (old_pos is Vector2) or (old_pos as Vector2) != p \
			or float((existing as MeshInstance3D).get_meta("field_angle_deg", -1.0)) != angle
	if rebuild:
		if existing is MeshInstance3D and is_instance_valid(existing):
			(existing as MeshInstance3D).free()
		var mi := MeshInstance3D.new()
		mi.name = "FieldDecal_" + str(fid)
		mi.mesh = _field_decal_mesh(ed, angle)
		mi.material_override = _field_decal_material(season)
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		mi.set_meta("field_pos", p)
		mi.set_meta("field_angle_deg", angle)
		mi.set_meta("field_decal_material", "envfielddw" if season == "winter" else "envfieldd")
		mi.set_meta("field_decal_status", FIELD_DECAL_STATUS)
		mi.set_meta("field_decal_material_status", FIELD_DECAL_MATERIAL_STATUS)
		mi.set_meta("visual_status", "UNVERIFIED")
		add_child(mi)
		_field_decals[fid] = mi
		existing = mi
	else:
		(existing as MeshInstance3D).material_override = _field_decal_material(season)
	(existing as MeshInstance3D).visible = not _is_hidden(ed)


# --- V7-65 donor player-slot key colours -----------------------------------
# Loads res://data/donor_key_colors.json (V7-61) at runtime. On ANY failure it
# pushes an error and leaves bodies UNTINTED: no invented fallback palette is
# ever substituted. rgb_godot_float is the exact donor formula output; alpha
# 1.0 is an explicit port choice (donor alpha UNVERIFIED).
func _load_key_colors() -> void:
	_key_colors.clear()
	_key_colors_loaded = false
	_key_colors_error = ""
	if not FileAccess.file_exists(KEY_COLORS_PATH):
		_key_colors_error = "missing file " + KEY_COLORS_PATH
		push_error("world3d_entities: donor key colours unavailable (" + _key_colors_error + "); bodies left UNTINTED - no fallback palette")
		return
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(KEY_COLORS_PATH))
	if not (parsed is Dictionary) or not (parsed as Dictionary).has("slots") \
			or not ((parsed as Dictionary)["slots"] is Array):
		_key_colors_error = "malformed JSON or missing slots array"
		push_error("world3d_entities: donor key colours unavailable (" + _key_colors_error + "); bodies left UNTINTED - no fallback palette")
		return
	for entry in ((parsed as Dictionary)["slots"] as Array):
		if not (entry is Dictionary):
			continue
		var d := entry as Dictionary
		var idx := int(d.get("index", -1))
		var rgb = d.get("rgb_godot_float", [])
		if idx < 0 or not (rgb is Array) or (rgb as Array).size() < 3:
			continue
		var arr = rgb
		var c := Color(float(arr[0]), float(arr[1]), float(arr[2]), 1.0)
		if _key_colors.size() <= idx:
			_key_colors.resize(idx + 1)
		_key_colors[idx] = c
	_key_colors_loaded = _key_colors.size() > 0
	if not _key_colors_loaded:
		_key_colors_error = "no usable slot entries"
		push_error("world3d_entities: donor key colours unavailable (" + _key_colors_error + "); bodies left UNTINTED - no fallback palette")


# Donor guard misc.script:5070: only 0 <= colorInd < gc_MaxColorCount (13) is
# applied. Anything else returns null = no tint, never a made-up colour.
func _player_tint(player: int) -> Variant:
	if not _key_colors_loaded or player < 0 or player >= _key_colors.size():
		return null
	return _key_colors[player]


func _player_index(ed: Dictionary) -> int:
	var pv = ed.get("player", -1)
	if pv is int:
		return int(pv)
	if pv is float:
		return int(pv)
	return -1


# --- NATION-MODEL-01: nation-aware mesh selection -------------------------
# The entity Dictionary itself carries no "nation" key (game.gd:2186-2197
# spawn sets id/kind/player/sid/def/...). Read the nation from, in order:
#   1) an explicit ed["nation"] if a future owner adds one;
#   2) game.players[player]["nation"]  (game.gd:386, :3976);
#   3) Data.PLAYER_NATIONS[player]     (menu/main hand-off).
# Everything is READ-ONLY. Return "" when no nation can be established.
func _nation_of(ed: Dictionary) -> String:
	var n := str(ed.get("nation", "")).strip_edges().to_lower()
	if n != "":
		return n
	var p := _player_index(ed)
	if game != null:
		var plist = game.get("players")
		if plist is Array and p >= 0 and p < (plist as Array).size():
			var pp = (plist as Array)[p]
			if pp is Dictionary:
				var pn := str((pp as Dictionary).get("nation", "")).strip_edges().to_lower()
				if pn != "":
					return pn
	var pnations = Data.PLAYER_NATIONS
	if pnations is Array and p >= 0 and p < (pnations as Array).size():
		var pn2 := str((pnations as Array)[p]).strip_edges().to_lower()
		if pn2 != "":
			return pn2
	return ""


# Read-only probe: never constructs a file, only asks the loader whether the
# exact donor-derived mesh stem already exists on disk.
func _nation_mesh_on_disk(sid: String) -> bool:
	if sid == "":
		return false
	return ResourceLoader.exists(AssetPaths.existing(sid, "obj")) \
		or ResourceLoader.exists(AssetPaths.existing(sid, "glb"))


# NATION_DONOR_01 §2.4 — donor building sidmask (country.script:138-206):
# %nat% families use the nation's own 3-letter prefix; %com% families resolve
# to rus* for rus/ukr, tur* for tur/alg, eur* for everyone else, with the
# explicit por/wwa/spa/mis overrides below. Returned PREFIX is concatenated
# with the port's 3-char base family sid and PROBED against disk; no file is
# created and no name is invented beyond the donor's own prefix+sid rule.
func _donor_building_prefix(nation: String, family: String) -> String:
	const OWN_FAMILIES := ["aca", "art", "ba2", "bar", "bla", "cen",
		"dip", "hou", "sta", "tem"]
	if OWN_FAMILIES.has(family):
		return nation
	match family:
		"por":
			if nation in ["ukr", "rus", "tur", "alg", "por"]:
				return nation
		"mil", "tow", "swa":
			if nation in ["rus", "ukr"]:
				return "rus"
			if nation in ["tur", "alg"]:
				return "tur"
		"wwa":
			return "ukr"
		"sto", "mar":
			if nation in ["rus", "ukr"]:
				return "rus"
			if nation in ["tur", "alg"]:
				return "tur"
			if nation in ["spa", "por"]:
				return "spa"
		"blg", "blg2":
			return "mis"
	return "eur"   # country.script:161 default


# Choose the 3D mesh sid for one entity. keydict:
#   sid      = mesh sid to pass to _mesh_info()
#   nation   = resolved nation code ("" when unavailable)
#   family   = "units" | "buildings" | "naval"
#   candidate= exact-nation stem probed on disk ("" when none)
#   exact    = true only when that stem actually exists on disk
#   status   = honest PORT APPROXIMATION label
# Donor evidence (NATION_DONOR_01 §2-§4, all READ-ONLY):
#   units     — nation identity IS the sid (pikemanrus, musketeer18bav,
#               peaukr/pearus); no donor skin swap exists. The only canonical
#               port-side mapping is Data.resolve_sid() <- country.script.
#   buildings — `%nat%`/`%com%` 3-letter-family prefix (CS:138-206); rus/ukr
#               share rus*, bav shares eur*, bavmil/bavpor do NOT exist.
#   naval     — family-keyed; yachttur/chaika are distinct roster sids, not
#               skins, so there is no nation stem to probe.
# Every candidate below is a DONOR-derived stem, probed against disk; none is
# fabricated, none is copied, and a miss is reported BLOCKED, never "fixed".
func _entity_mesh_sid(ed: Dictionary, base_sid: String, kind: String) -> Dictionary:
	var nation := _nation_of(ed)
	var def: Dictionary = {}
	var dv = ed.get("def", null)
	if dv is Dictionary:
		def = dv as Dictionary
	var family := "units"
	if kind == "building":
		family = "buildings"
	elif bool(def.get("naval", false)):
		family = "naval"
	var candidates: Array[String] = []
	var role_sub := false
	if nation != "" and base_sid != "":
		match family:
			"units":
				# "exact" is claimed ONLY for a real generic->nation remap.
				# A base sid that is already nation-coded (strelet,
				# sco_highlandersword, ...) keeps its correct mesh but is
				# conservatively labelled fallback: another owner may map a
				# nation to a GENERIC sid (data.gd bav:296), and calling that
				# "exact nation art" would be a false claim.
				var rsid := Data.resolve_sid(nation, base_sid)
				if rsid != base_sid:
					candidates.append(rsid)
					# B-NATION-PLAN2 T2b: generic donor role substitutes
					# (data.gd:296 bav serdiuk->musketeer, cossack->hussar)
					# are NOT nation-unique art; gated to exact=false below.
					if NATION_ROLE_SUB_SIDS.has(rsid):
						role_sub = true
				# WAVE-N/N04 (b): donor's eight nation peasant bases are
				# PRESENTATION ONLY. Add the donor-derived stem as a candidate
				# for base "peasant"; Data.resolve_sid() cannot do this (its
				# UNITS trap: pea* have no UNITS_BASE row, N06 §4.3). The
				# common disk probe below makes it inert if art is absent and
				# leaves ed["sid"]/"peasant" (and all sim stats) untouched.
				if base_sid == "peasant" and nation != "" \
						and NATION_PEASANT_SIDS.has(nation):
					var psid := str(NATION_PEASANT_SIDS[nation])
					if psid != base_sid and not candidates.has(psid):
						candidates.append(psid)
			"buildings":
				candidates.append(_donor_building_prefix(nation, base_sid) + base_sid)
			"naval":
				pass   # no nation stem exists (yachttur/chaika are base sids)
	var sid := base_sid
	var candidate := ""
	var exact := false
	for c in candidates:
		if _nation_mesh_on_disk(c):
			sid = c
			candidate = c
			exact = true
			break
	var status := NATION_MESH_EXACT_STATUS if exact else NATION_MESH_FALLBACK_STATUS
	# WAVE-N/N04 (c): a nation hall can be exact while its stage/ghost art is
	# not. Probe the donor-derived nation stage stem at bind time (never per
	# frame) and make the remaining gap explicit; no stage/ghost mesh is invented.
	if family == "buildings" and nation != "" and base_sid != "" \
			and not _nation_mesh_on_disk(nation + base_sid + "1"):
		status += " | " + NATION_STAGE_GHOST_BLOCKED_STATUS
	# B-NATION-PLAN2 T2b role-substitution exactness: a disk hit on a generic
	# role substitute (bav musketeer/hussar) keeps sid/candidate/candidates
	# but is labelled role-substitute with exact=false, never exact nation art.
	# Russian nation-coded remaps (strelet/cossackdon) are unaffected.
	# Fallback-when-absent (:765) and naval/buildings branches untouched.
	if role_sub and exact:
		exact = false
		status = NATION_MESH_ROLE_SUB_STATUS
	return {"sid": sid, "nation": nation, "family": family,
		"candidate": candidate, "candidates": candidates,
		"exact": exact, "status": status}


func _record_nation_mesh(ns: Dictionary, base_sid: String) -> void:
	var usage = stats.get("nation_mesh_usage", {})
	var uk := str(ns.get("family", "")) + "|" + str(ns.get("nation", "")) \
		+ "|" + base_sid + "->" + str(ns.get("sid", ""))
	usage[uk] = int(usage.get(uk, 0)) + 1
	stats["nation_mesh_usage"] = usage


# --- FIX-COLOR: donor albedo-alpha band mask ------------------------------
# Decode ONLY the first mip's DXT5 alpha from the donor DDS named by
# manifest.json:models[i].texture. The 4x4 blocks carry 2 alpha endpoints and
# 16 3-bit indices in 6 bytes; the colour endpoints/indices are deliberately
# ignored because donor uses texture alpha solely as the uniform-0 mask
# (unit.smx9.id8.frag:37-38,42). On ANY structural mismatch return null — a
# missing mask means NO tint, never an invented band and never a whole-body
# fallback.
func _dxt5_mask(path: String) -> Image:
	if path == "" or not FileAccess.file_exists(path):
		return null
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return null
	var hdr: PackedByteArray = f.get_buffer(DDS_HEADER_SIZE)
	# PackedByteArray has no subarray() in Godot 4.7: compare the four magic
	# bytes directly ("DDS " = 68,68,83,32; DXT5 = 68,88,84,53).
	if hdr.size() < DDS_HEADER_SIZE or hdr[0] != 68 or hdr[1] != 68 or hdr[2] != 83 or hdr[3] != 32:
		f.close()
		return null
	# DDS header: height :12, width :16, pixel format fourcc :84 (DXT5).
	var h: int = int(hdr[12]) | (int(hdr[13]) << 8) | (int(hdr[14]) << 16) | (int(hdr[15]) << 24)
	var w: int = int(hdr[16]) | (int(hdr[17]) << 8) | (int(hdr[18]) << 16) | (int(hdr[19]) << 24)
	if hdr[84] != 68 or hdr[85] != 88 or hdr[86] != 84 or hdr[87] != 53 or w <= 0 or h <= 0:
		f.close()
		return null
	var blocks_x: int = maxi(1, (w + 3) / 4)
	var blocks_y: int = maxi(1, (h + 3) / 4)
	var payload: PackedByteArray = f.get_buffer(blocks_x * blocks_y * DXT5_BLOCK_BYTES)
	f.close()
	if payload.size() < blocks_x * blocks_y * DXT5_BLOCK_BYTES:
		return null
	var data := PackedByteArray()
	data.resize(w * h * 4)
	data.fill(255)
	var bi: int = 0
	for by in range(blocks_y):
		for bx in range(blocks_x):
			var o: int = bi * DXT5_BLOCK_BYTES
			bi += 1
			var a0: int = payload[o]
			var a1: int = payload[o + 1]
			var bits: int = 0
			for k in range(6):
				bits |= int(payload[o + 2 + k]) << (k * 8)
			for i in range(16):
				var idx: int = (bits >> (i * 3)) & 7
				var av: int = 255
				if a0 > a1:
					av = clamped_dxt5(((8 - idx) * a0 + (idx - 1) * a1) / 7)
				elif idx == 0:
					av = a0
				elif idx == 1:
					av = a1
				elif idx == 6:
					av = 0
				elif idx == 7:
					av = 255
				else:
					av = clamped_dxt5(((6 - idx) * a0 + (idx - 1) * a1) / 5)
				var px: int = bx * 4 + (i % 4)
				var py: int = by * 4 + (i / 4)
				if px < w and py < h:
					var di: int = (py * w + px) * 4
					data[di] = av
					data[di + 1] = av
					data[di + 2] = av
					data[di + 3] = av
	return Image.create_from_data(w, h, false, Image.FORMAT_RGBA8, data)


func clamped_dxt5(v: float) -> int:
	return clampi(int(v), 0, 255)


# Per-sid mask cache + measured texel counts (structural, never a visual claim).
func _band_mask(sid: String) -> Image:
	if _band_mask_cache.has(sid):
		var cached = _band_mask_cache[sid]
		if cached is Dictionary and (cached as Dictionary).get("image") is Image:
			return (cached as Dictionary)["image"] as Image
	var img := _dxt5_mask(str(_donor_texture_paths.get(sid, "")))
	if img == null:
		return null
	var w: int = img.get_width()
	var h: int = img.get_height()
	var raw: PackedByteArray = img.get_data()
	var masked: int = 0
	for i in range(3, raw.size(), 4):
		if int(raw[i]) >= int(TINT_MASK_THRESHOLD * 255.0):
			masked += 1
	_band_mask_cache[sid] = {"image": img, "texture": ImageTexture.create_from_image(img)}
	_band_mask_stats[sid] = {"source": str(_donor_texture_paths.get(sid, "")),
		"texels": w * h, "mask_texels": masked, "verts": 0, "tinted_verts": 0,
		"faces": 0, "tinted_faces": 0, "label": PORT_LABEL, "visual": "UNVERIFIED"}
	return img


func _band_mask_texture(sid: String) -> Texture2D:
	_band_mask(sid)
	var cached = _band_mask_cache.get(sid)
	if cached is Dictionary:
		return (cached as Dictionary).get("texture") as Texture2D
	return null


func _mask_at(img: Image, uv: Vector2) -> bool:
	var w: int = img.get_width()
	var h: int = img.get_height()
	var px: int = clampi(int(uv.x * float(w)), 0, w - 1)
	var py: int = clampi(int(uv.y * float(h)), 0, h - 1)
	return img.get_pixel(px, py).a >= TINT_MASK_THRESHOLD


# Count how many mesh vertices/faces actually land on donor band texels. The
# vertex count is shared with the morph path (UVs there are Godot-V-flipped),
# so sampling the baked surface UVs keeps one index space for both paths.
func _measure_band(sid: String, mesh: Mesh) -> void:
	var img := _band_mask(sid)
	if img == null or mesh == null:
		return
	var st = _band_mask_stats.get(sid)
	if not (st is Dictionary):
		return
	var d := st as Dictionary
	if int(d.get("verts", 0)) > 0:
		return
	for s in range(mesh.get_surface_count()):
		var arr: Array = mesh.surface_get_arrays(s)
		var uvs = arr[Mesh.ARRAY_TEX_UV]
		if not (uvs is PackedVector2Array):
			continue
		var uvarr: PackedVector2Array = uvs
		var vs = arr[Mesh.ARRAY_VERTEX]
		var n: int = (vs as PackedVector3Array).size() if vs is PackedVector3Array else 0
		var tinted: int = 0
		for i in range(uvarr.size()):
			if _mask_at(img, uvarr[i]):
				tinted += 1
		d["verts"] = int(d.get("verts", 0)) + n
		d["tinted_verts"] = int(d.get("tinted_verts", 0)) + tinted
		var faces: int = 0
		var tinted_faces: int = 0
		var ix = arr[Mesh.ARRAY_INDEX]
		if ix is PackedInt32Array:
			var ia: PackedInt32Array = ix
			for fi in range(0, ia.size() - 2, 3):
				var i0: int = ia[fi]
				var i1: int = ia[fi + 1]
				var i2: int = ia[fi + 2]
				faces += 1
				if i0 < uvarr.size() and i1 < uvarr.size() and i2 < uvarr.size() \
						and _mask_at(img, uvarr[i0]) and _mask_at(img, uvarr[i1]) \
						and _mask_at(img, uvarr[i2]):
					tinted_faces += 1
		else:
			faces = n / 3
		d["faces"] = int(d.get("faces", 0)) + faces
		d["tinted_faces"] = int(d.get("tinted_faces", 0)) + tinted_faces


# FIX-COLOR: donor uniform-0, reproduced as a ShaderMaterial using the donor
# albedo texture + the donor alpha band mask. If no donor-derived mask is
# available the material is left UNTINTED — V7-65's whole-body albedo tint was
# the reported defect and is never reinstated as a fallback.
func _tinted_material(base: Material, tint: Color, sid: String, kind: String) -> Material:
	var mask := _band_mask_texture(sid)
	if mask == null:
		push_warning("world3d_entities: no donor band mask for " + sid + " - left UNTINTED, no whole-body fallback")
		return base.duplicate() if base != null else _default_material(sid, kind)
	var bm: Material = base
	if bm == null:
		bm = _default_material(sid, kind)
	# P11: key includes the base material identity so two sids/kinds or two
	# distinct imported albedo materials can never share the wrong texture.
	var ck := str(sid) + "|" + kind + "|" + str(tint.r) + "," + str(tint.g) \
		+ "," + str(tint.b) + "," + str(tint.a) + "|" + str(bm.get_instance_id())
	if _tint_material_cache.has(ck):
		return _tint_material_cache[ck] as Material
	var albedo: Texture2D = null
	if bm is StandardMaterial3D:
		albedo = (bm as StandardMaterial3D).albedo_texture
	var albedo_path := AssetPaths.existing(sid, "tex")
	if albedo == null and ResourceLoader.exists(albedo_path):
		albedo = load(albedo_path) as Texture2D
	if _tint_shader == null:
		_tint_shader = Shader.new()
		_tint_shader.code = TINT_SHADER_CODE
	var m := ShaderMaterial.new()
	m.shader = _tint_shader
	m.set_shader_parameter("albedo_tex", albedo)
	m.set_shader_parameter("mask_tex", mask)
	m.set_shader_parameter("custColor", tint)
	_tint_material_cache[ck] = m
	return m


# Per-instance tint, still sharing the baked donor mesh.
# Godot 4: MultiMeshInstance3D derives from GeometryInstance3D, NOT from
# MeshInstance3D, so it has no set_surface_override_material(). Use the
# GeometryInstance3D.material_override on batches (built from the donor
# albedo material of surface 0, so the donor texture is kept) and the normal
# surface overrides on building MeshInstance3Ds. One override per batch means
# the player slot is part of the batch key (see add_unit), as batching allows.
# FIX-COLOR: the override is now a masked ShaderMaterial, not an
# albedo_color paint; _measure_band records the measured donor-band subset.
func _apply_tint(instance: GeometryInstance3D, mesh: Mesh, tint: Color,
		sid: String, kind: String) -> void:
	if mesh == null:
		return
	_measure_band(sid, mesh)
	instance.set_meta("donor_tint_label", PORT_LABEL)
	instance.set_meta("donor_tint_visual", "UNVERIFIED")
	if instance is MultiMeshInstance3D:
		var base: Material = null
		if mesh.get_surface_count() > 0:
			base = mesh.surface_get_material(0)
		instance.material_override = _tinted_material(base, tint, sid, kind)
		return
	if instance is MeshInstance3D:
		for s in range(mesh.get_surface_count()):
			var base_m: Material = mesh.surface_get_material(s)
			(instance as MeshInstance3D).set_surface_override_material(
				s, _tinted_material(base_m, tint, sid, kind))


# Box sized from the donor bbox. Used only when neither OBJ nor GLB exists.
# Its geometry is still donor-BBOX-DERIVED, never an invented size.
func _proxy_mesh_raw(bbox: Array) -> Mesh:
	if bbox.size() < 6:
		bbox = [-0.5, 0.5, -0.5, 0.5, 0.0, 1.0]
	var x0 := float(bbox[0]); var x1 := float(bbox[1])
	var y0 := float(bbox[2]); var y1 := float(bbox[3])
	var z0 := float(bbox[4]); var z1 := float(bbox[5])
	var box := BoxMesh.new()
	box.size = Vector3(maxf(x1 - x0, 0.05), maxf(y1 - y0, 0.05), maxf(z1 - z0, 0.05))
	var src: Array = box.surface_get_arrays(0)
	var verts: PackedVector3Array = src[Mesh.ARRAY_VERTEX]
	var centre := Vector3((x0 + x1) * 0.5, (y0 + y1) * 0.5, (z0 + z1) * 0.5)
	for i in range(verts.size()):
		verts[i] += centre
	var dst: Array = []
	dst.resize(Mesh.ARRAY_MAX)
	for i in range(Mesh.ARRAY_MAX):
		dst[i] = src[i] if i < src.size() else null
	dst[Mesh.ARRAY_VERTEX] = verts
	var out := ArrayMesh.new()
	out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, dst)
	return out


# Bake Z-up -> Y-up, bbox centring and bbox-derived scale into a cached mesh.
func _bake_mesh(src_mesh: Mesh, bbox: Array, scale: float, target_h: float,
		pre_normalised: bool, sid: String, kind: String) -> Dictionary:
	if pre_normalised:
		# V7-8 GLB is expected to be exported Y-up and bbox-normalised already.
		# That is an UNVERIFIED assumption until T-V72-1; recorded in stats.
		return {"mesh": src_mesh, "source": "glb_assumed_yup",
			"scale": scale, "height": target_h}
	if bbox.size() < 6:
		bbox = [-0.5, 0.5, -0.5, 0.5, 0.0, 1.0]
	var cx := (float(bbox[0]) + float(bbox[1])) * 0.5
	var cy := (float(bbox[2]) + float(bbox[3])) * 0.5
	var z0 := float(bbox[4])
	var out := ArrayMesh.new()
	for s in range(src_mesh.get_surface_count()):
		var src: Array = src_mesh.surface_get_arrays(s)
		var dst: Array = []
		dst.resize(Mesh.ARRAY_MAX)
		for i in range(Mesh.ARRAY_MAX):
			dst[i] = src[i] if i < src.size() else null
		var vs = src[Mesh.ARRAY_VERTEX]
		if vs is PackedVector3Array:
			var nv := PackedVector3Array()
			nv.resize((vs as PackedVector3Array).size())
			for i in range((vs as PackedVector3Array).size()):
				var v: Vector3 = (vs as PackedVector3Array)[i]
				nv[i] = Vector3((v.x - cx) * scale,
					(v.z - z0) * scale,
					-(v.y - cy) * scale)
			dst[Mesh.ARRAY_VERTEX] = nv
		var ns = src[Mesh.ARRAY_NORMAL]
		if ns is PackedVector3Array:
			var nn := PackedVector3Array()
			nn.resize((ns as PackedVector3Array).size())
			for i in range((ns as PackedVector3Array).size()):
				var n: Vector3 = (ns as PackedVector3Array)[i]
				nn[i] = Vector3(n.x, n.z, -n.y).normalized()
			dst[Mesh.ARRAY_NORMAL] = nn
		var ts = src[Mesh.ARRAY_TANGENT]
		if ts is PackedFloat32Array:
			var nt := PackedFloat32Array()
			nt.resize((ts as PackedFloat32Array).size())
			for i in range(0, (ts as PackedFloat32Array).size(), 4):
				nt[i] = (ts as PackedFloat32Array)[i]
				nt[i + 1] = (ts as PackedFloat32Array)[i + 2]
				nt[i + 2] = -(ts as PackedFloat32Array)[i + 1]
				nt[i + 3] = (ts as PackedFloat32Array)[i + 3]
			dst[Mesh.ARRAY_TANGENT] = nt
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, dst)
		var mat: Material = src_mesh.surface_get_material(s)
		if mat == null:
			mat = _default_material(sid, kind)
		out.surface_set_material(out.get_surface_count() - 1, mat)
	return {"mesh": out, "source": "converted", "scale": scale,
		"height": target_h}


func _mesh_info(sid: String, kind: String) -> Dictionary:
	var key := kind + "|" + sid
	if _mesh_cache.has(key):
		return _mesh_cache[key]
	var bbox: Array = _bbox.get(sid, [])
	var native_h: float = 1.0
	if bbox.size() >= 6:
		native_h = float(bbox[5]) - float(bbox[4])
	if native_h <= 0.0:
		native_h = 1.0
	# bbox-derived scale. Env scale is the donor per-instance multiplier, not
	# a new size guess; field is exempt (ground patch caveat, V7-2 2.3).
	# DECOR-01: tree sids get the per-sid donor envscale ladder (0.475..0.76,
	# envscales.cfg:158-585) instead of the old blanket 0.5; non-tree sids keep
	# the exact pre-ticket values. Per-instance jitter is applied in _xf()
	# because this mesh cache is shared by all instances of one sid.
	var factor: float = 1.0
	if kind == "res":
		factor = _env_scale_factor(sid)
	var target_h: float = native_h * factor
	var scale: float = target_h / native_h
	var src_mesh: Mesh = null
	var pre_normalised := false
	var source := "donor_bbox_proxy"
	var glb := AssetPaths.existing(sid, "glb")
	if ResourceLoader.exists(glb):
		var packed = load(glb)
		if packed is PackedScene:
			var inst: Node = (packed as PackedScene).instantiate()
			src_mesh = _first_mesh(inst)
			inst.free()
		elif packed is Mesh:
			src_mesh = packed as Mesh
		if src_mesh != null:
			pre_normalised = true
			source = "glb_assumed_yup"
	var obj := AssetPaths.existing(sid, "obj")
	if src_mesh == null and ResourceLoader.exists(obj):
		src_mesh = load(obj) as Mesh
		if src_mesh != null:
			source = "obj_zup_bbox_normalised"
	if src_mesh == null:
		src_mesh = _proxy_mesh_raw(bbox)
	var info := _bake_mesh(src_mesh, bbox, scale, target_h, pre_normalised, sid, kind)
	info["source"] = source
	info["sid"] = sid       # V7-65: needed by per-player material cloning
	info["kind"] = kind
	_mesh_cache[key] = info
	_mesh_sources[source] = int(_mesh_sources.get(source, 0)) + 1
	stats["mesh_sources_loaded"] = _mesh_sources
	return info


# ---------------------------------------------------------------- V7-74 morph
# The anim module is a SIBLING of this module under world3d.gd (both are
# add_child'd at world3d.gd:152-165). Discover it once by its handoff methods;
# never fabricate pose data when it is absent (atomic stub tests, shipped
# runtime without a registered skin).
func _find_anim():
	if _anim != null and is_instance_valid(_anim):
		return _anim
	if _anim_checked:
		return null
	_anim_checked = true
	var parent := get_parent()
	if parent == null:
		return null
	for child in parent.get_children():
		if child == self:
			continue
		if child.has_method("pose_for") and child.has_method("has_skin"):
			_anim = child
			break
	return _anim


# DEC-U-AAF-ART C3 — prop state -> donor AAF selection by PER-SID availability
# with a donor-style fallback chain (_unit_IsAnimationExists,
# unit.script:11048-11051,11092-11093; attack2→attack0→idle, DEC_U §5 C3).
# Every donor-named branch is gated by anim3d.has_action(sid,...) reading that
# sid's OWN shipped AAF export (C1). No state->AAF trigger is invented: the
# only extra hook is an explicit `anim_action` DATA request on the entity,
# kept [U] U2 (DEC_U §1.2/§4). A missing action is recorded in _action_gaps,
# never replaced by another sid's clip. `moving` alone is not a motion
# measurement (VID-AN-01 §3/§5): measured speed wins; speed < 0 keeps the
# direct/stub-caller fallback unchanged.
# DEC-U-AAF-TRIGGERS adds a PURE static resolver attempt ahead of this chain:
# no sim mutation, no frame interpolation, no orphan selector. See
# DONOR_TRIGGER_STATUS / DONOR_TRIGGER_ORPHAN_STATUS for the carry labels.
func _unit_action(ed: Dictionary, speed: float = -1.0) -> String:
	var od = ed.get("order", null)
	var otype := ""
	if od is Dictionary:
		otype = str((od as Dictionary).get("type", ""))
	var measured: bool = speed >= 0.0
	var moving: bool = (speed >= WALK_SPEED_GATE_M_S) if measured else bool(ed.get("moving", false))
	var sid := str(ed.get("sid", ""))
	var dead: bool = bool(ed.get("dead", false))
	var explicit := str(ed.get("anim_action", ""))
	# DEC-U-AAF-TRIGGERS: STATIC donor resolver attempt, in the donor's own
	# set-site branch order (hide T26 -> death T21 -> extract/build/attack
	# T1-T7 -> carry T8-T13 -> weapon-state T14-T17 -> sticky readback T18-T20;
	# anim3d.gd:1356-1440). The resolver is PURE and gates every concrete token
	# with has_action(sid,token) (_unit_IsAnimationExists, unit.script:369-373,
	# :10888): an orphan row (T23-T25) or a hide row returns token="", never an
	# invented selector. A miss is recorded with the donor chain as tried; the
	# preserved C3 port chain below stays the fallback, never a substitution.
	# A live explicit DATA request keeps its C3 precedence (the ONLY path for
	# orphans); donor death keeps its existing precedence over explicit.
	if explicit == "" or dead:
		var dres := _resolve_donor_action(sid, ed, speed, otype)
		var dtok := str(dres.get("token", ""))
		if dtok != "":
			_record_donor_trigger_intent(sid, str(dres.get("tid", "")), dtok,
				str(dres.get("blend", "")), true)
			return dtok
		if bool(dres.get("attempted", false)):
			var rd = dres.get("resolved", {})
			if not (rd is Dictionary):
				rd = {}
			var rdd := rd as Dictionary
			var tid := str(rdd.get("trigger_id", ""))
			var mtok := str(rdd.get("token", ""))
			_record_donor_trigger_intent(sid, tid, mtok,
				str(rdd.get("blend", "")), false)
			_record_donor_trigger_gap(sid, tid, _donor_trigger_chain(tid, mtok))
	if dead:
		return "death"   # essential state (ontagstates.inc:264-311)
	# Explicit donor action request carried as DATA. No sim-state -> AAF table
	# for reaction/attack2 was recovered ([U] U2), so none is invented here.
	# Orphan allow-list (DEC-U T23 attack2before/after, T24 reaction,
	# T25 prepare*/trans*/walkprepare*/walkunprepare* readback-only; plus
	# turn*/collide* vocabulary-only and the donor-dead walk1): NO donor
	# set-site, no selector and no fallback invented on this path.
	if explicit != "":
		_label_donor_orphan(explicit)
		if _action_available(sid, explicit):
			return explicit
		if explicit in AAF_ATTACK2_TOKENS:
			var atk2 := _donor_action_fallback(sid, ["attack2", "attack1", "attack0", "idle"])
			if atk2 != "":
				return atk2
		_record_action_gap(sid, explicit, "idle", "")
	# build/repair -> construct (dmscript.global:13,926; unit.script:10877;
	# peaukr.aaf:17). A builder still travelling keeps its travel action.
	if (otype == "build" or otype == "repair") and not moving \
			and _action_available(sid, "construct"):
		return "construct"
	# work / carry family (peaukr.aaf:8-16). C1 exports these windows from each
	# sid's own AAF; the state ordering mirrors world.gd:521-537 (port [O],
	# donor trigger [U] U2). Every candidate is availability-gated; a miss is
	# a per-sid DATA GAP, never donor truth and never a foreign sid's clip.
	var res := _donor_resource_suffix(ed, od, otype)
	if res != "":
		var work_action := "work" + res
		var walk_action := "walk" + res
		var idle_action := "idle" + res
		var gathering: bool = otype == "gather" or otype == "resow"
		var carrying: bool = int(ed.get("carry", 0)) > 0
		if gathering or carrying:
			var chain: Array = []
			if gathering and not moving:
				chain = [work_action, idle_action, walk_action, "idle"]
			elif moving:
				chain = [walk_action, idle_action, "walk", "idle"]
			else:
				chain = [idle_action, walk_action, "idle"]
			var carried := _donor_action_fallback(sid, chain)
			if carried != "":
				return carried
			_record_action_gap(sid, work_action, idle_action, walk_action)
	# attack0/attack1(/attack2) (peaukr.aaf:7, musketeer.aaf:7,
	# grenadier.aaf:28-30). Bullet weapon -> attack1 then attack0
	# (world.gd:515-516 [O]; weapon gating [I]/[U] U2). The attack2 family is
	# only selected by the explicit request above: no grenade trigger exists in
	# this sim's data (data.gd WK has no grenade kind), so none is invented.
	if otype in ATTACK_ORDER_TYPES and not moving:
		var weapon := _weapon_kind(ed)
		var attack_chain: Array = []
		if weapon == "bullet":
			attack_chain = ["attack1", "attack0", "idle"]
		else:
			attack_chain = ["attack0", "attack1", "idle"]
		var fired := _donor_action_fallback(sid, attack_chain)
		if fired != "":
			return fired
		_record_action_gap(sid, attack_chain[0], attack_chain[1], attack_chain[2])
	# donor 'reaction' (peaukr.aaf:18) is exported since C1 but has no recovered
	# sim trigger ([U] U2); only the explicit DATA request above selects it.
	return "walk" if moving else "idle"


# True only when the RESOLVED sid's own shipped donor AAF exports the action.
# DEC-U §7 F7 / unit.script:369-373: donor _unit_IsAnimationExists treats
# anim=='' as TRUE (an empty request is a NO-OP, not 'idle'). This port gate
# deliberately returns false for an empty action so no token is invented;
# empty requests never reach a selector or a pose call. No silent substitution.
func _action_available(sid: String, action: String) -> bool:
	if sid.is_empty() or action.is_empty():
		return false
	var anim = _find_anim()
	if anim != null and anim.has_method("has_action"):
		return bool(anim.call("has_action", sid, action))
	return false


# DEC-U-AAF-ART C3: donor-style _unit_IsAnimationExists chain
# (unit.script:11048-11051,11092-11093; attack2→attack0→idle per DEC_U §5 C3).
# Candidates are tried in ORDER on the RESOLVED sid only. Returns "" when none
# exists so the caller records a per-sid DATA GAP instead of borrowing a clip.
func _donor_action_fallback(sid: String, chain: Array) -> String:
	for candidate in chain:
		var a := str(candidate)
		if a != "" and _action_available(sid, a):
			return a
	return ""


# Sim resource classes (game.gd:3615-3635, :3034-3052) -> donor work/carry AAF
# suffix. food/wood/stone map directly; permanent ores mine as 'stone'. [D]/[I]
# with decomp target [U] U2. resow = sowing food fields.
func _donor_resource_suffix(ed: Dictionary, od, otype: String) -> String:
	var res := ""
	if od is Dictionary:
		res = str((od as Dictionary).get("res", ""))
	if res.is_empty():
		res = str(ed.get("carry_type", ""))
	if res.is_empty() and otype == "resow":
		res = "food"
	if res in ["wood", "lumber"]:
		return "wood"
	if res in ["stone", "gold", "iron", "coal"]:
		return "stone"
	if res in ["food", "farm", "wheat", "grain"]:
		return "food"
	return ""


func _weapon_kind(ed: Dictionary) -> String:
	var def = ed.get("def", null)
	if def is Dictionary:
		var ws = (def as Dictionary).get("weapons", [])
		if ws is Array and not (ws as Array).is_empty():
			var w = (ws as Array)[0]
			if w is Dictionary:
				return str((w as Dictionary).get("kind", ""))
	return ""


# DEC-U-AAF-TRIGGERS §1.2 / IMPL §5 R2 — decode the sim entity into the donor
# tag fields consumed by anim3d.gd.resolve_donor_action(). Only fields with a
# recovered donor/port basis are produced: iEssential from ed.dead, iAction
# from a STATIONARY build/extract/attack order (mirrors the preserved chain's
# `not moving` gates), iResource from _donor_resource_suffix(), iMove from the
# same measured-speed gate, and iWeapon ONLY for attack/death from an explicit
# donor index or the already-labelled port bullet mapping ([U]-W, DEC-U D6).
# iVisual is pass-through only: no hide state is invented (T26 stays data-
# driven), and current_anim is NOT supplied so sticky T18-T20 stay dormant
# until capture R-S (IMPL §5 R6). An explicit donor tag on the entity wins.
func _donor_tag_fields(ed: Dictionary, speed: float, otype: String) -> Dictionary:
	var fields: Dictionary = {}
	var measured: bool = speed >= 0.0
	var moving: bool = (speed >= WALK_SPEED_GATE_M_S) if measured else bool(ed.get("moving", false))
	if bool(ed.get("dead", false)):
		fields["iEssential"] = "death"
	fields["iMove"] = "walk" if moving else "idle"
	var gathering: bool = otype == "gather" or otype == "resow"
	var carrying: bool = int(ed.get("carry", 0)) > 0
	if gathering or carrying:
		var res := _donor_resource_suffix(ed, ed.get("order", null), otype)
		if res != "":
			fields["iResource"] = res
	var action := ""
	if not moving:
		if gathering:
			action = "extract"
		elif otype == "build" or otype == "repair":
			action = "build"
		elif otype in ATTACK_ORDER_TYPES:
			action = "attack"
	if action != "":
		fields["iAction"] = action
	if (action == "attack" or str(fields.get("iEssential", "")) == "death") \
			and not fields.has("iWeapon"):
		var wi := _donor_weapon_index(ed)
		if wi != "":
			fields["iWeapon"] = wi
	# Explicit donor tag pass-through (DATA only, never synthesized).
	for key in ["iAction", "iWeapon", "iResource", "iMove", "iEssential", "iVisual"]:
		if not ed.has(key) or str(ed.get(key, "")) == "":
			continue
		if key == "iWeapon":
			var iv := str(ed.get(key, ""))
			if iv in ["0", "1", "2", "none"]:
				fields[key] = iv
			continue
		fields[key] = str(ed.get(key, ""))
	return fields


# Donor iWeapon tag index (unit.script:10837-10843/10878-10883). An explicit
# index carried on the entity is donor-faithful [O]. `_weapon_kind()=="bullet"`
# -> "1" is the PORT mapping from world.gd:515-516 (DEC-U D6; [U]-W), used
# ONLY for attack/death and never presented as donor proof. "2" (grenade) is
# never produced without an explicit index plus capture R-W.
func _donor_weapon_index(ed: Dictionary) -> String:
	for key in ["iWeapon", "weapon_index", "weapon_slot"]:
		if ed.has(key) and str(ed.get(key, "")) != "":
			var v := str(ed.get(key, ""))
			if v in ["0", "1", "2"]:
				return v
	if _weapon_kind(ed) == "bullet":
		return "1"
	return "none"


# DEC-U-AAF-TRIGGERS / IMPL §5 R1 — call anim3d.gd's PURE donor resolver.
# Returns {"token","tid","blend","resolved","attempted"}. A token is returned
# only when anim3d actually resolved it AND has_action(sid,token) passed;
# orphans, hide and misses return an empty token. No pose, no interpolation,
# no completion event is fired here ([U]-B / [U]-C1/C2 stay open).
func _resolve_donor_action(sid: String, ed: Dictionary, speed: float, otype: String) -> Dictionary:
	var out: Dictionary = {"token": "", "tid": "", "blend": "", "resolved": {}, "attempted": false}
	if sid.is_empty():
		return out
	var anim = _find_anim()
	if anim == null or not anim.has_method("resolve_donor_action"):
		return out
	out["attempted"] = true
	var fields := _donor_tag_fields(ed, speed, otype)
	var rr = anim.call("resolve_donor_action", sid, fields)
	if not (rr is Dictionary):
		return out
	var r := rr as Dictionary
	out["resolved"] = r
	out["tid"] = str(r.get("trigger_id", ""))
	out["blend"] = str(r.get("blend", ""))
	var token := str(r.get("token", ""))
	if token.is_empty() or not bool(r.get("available", false)):
		return out
	if bool(r.get("orphan", false)) or token == "walk1":
		return out   # T23-T25 and the donor-dead name never become selectors
	out["token"] = token
	return out


# Intent-only ledger (DEC-U §7 F3/F9): the per-site blend ("0,0" bypass vs
# "6,8" deferred) and the donor chain as tried are RECORDED, never applied.
# No frame value, no interpolation and no completion event comes from here.
func _record_donor_trigger_intent(sid: String, tid: String, token: String, blend: String, ok: bool) -> void:
	var key := sid + "|" + tid + "|" + token + "|" + blend + "|" + ("OK" if ok else "GAP")
	_donor_trigger_intents[key] = int(_donor_trigger_intents.get(key, 0)) + 1


func _record_donor_trigger_gap(sid: String, tid: String, chain: Array) -> void:
	var tried := ""
	for c in chain:
		var a := str(c)
		if a.is_empty():
			continue
		tried += ("," if tried != "" else "") + a
	if tried.is_empty():
		return   # T23-T26 have no donor set-site: nothing to append
	var key := sid + "|" + tid + "|" + tried
	_donor_trigger_gaps[key] = int(_donor_trigger_gaps.get(key, 0)) + 1


# Donor fallback ORDER per cited row (DEC-U §1.2 gate column):
# weapon death -> plain death (:11092-11093); animidle -> idle (:11036-11037);
# animwalk -> walk incl. dead walk1 (:11048-11051); attack2 -> attack1 ->
# attack0 -> idle (DEC_U §5 C3). Logged for R-W/R-W2/R-S audit only.
func _donor_trigger_chain(tid: String, token: String) -> Array:
	if tid == "T21":
		return [token, "death"]
	if tid in ["T8", "T10", "T12", "T18", "T19", "T20"]:
		return [token, "idle"]
	if tid in ["T9", "T11", "T13", "T14", "T15", "T16", "T17"]:
		return [token, "walk"]
	if tid == "T7" and token == "attack2":
		return ["attack2", "attack1", "attack0", "idle"]
	if token != "":
		return [token]
	return []


# LABEL ONLY (DEC-U T23-T25): classify an explicit DATA request with anim3d's
# orphan vocabulary. Never selects, never falls back, never auto-triggers.
func _label_donor_orphan(token: String) -> void:
	if _donor_orphan_labels.has(token):
		return
	var anim = _find_anim()
	if anim == null or not anim.has_method("is_donor_orphan_token"):
		return
	if not bool(anim.call("is_donor_orphan_token", token)):
		return
	var note := ""
	if anim.has_method("donor_orphan_note"):
		note = str(anim.call("donor_orphan_note", token))
	_donor_orphan_labels[token] = note if note != "" else DONOR_TRIGGER_ORPHAN_STATUS


func _record_action_gap(sid: String, a: String, b: String, c: String) -> void:
	for action in [a, b, c]:
		if str(action).is_empty():
			continue
		var key := sid + "|" + str(action)
		_action_gaps[key] = int(_action_gaps.get(key, 0)) + 1


# MOTION-ANIM-01: MEASURE the SIM, never write to it. The entity Dictionary is
# the live sim object (_refs holds the reference), so pos is read after the
# sim's fixed ticks. Speed = |pos - last_pos| / (anim_clock - last_clock),
# both of which this module already owns; no second wall-clock timer is added.
func _measure_speed(id: int, ed: Dictionary) -> float:
	var pos: Vector2 = ed.get("pos", Vector2.ZERO)
	var prev = _motion_sample.get(id)
	var speed := 0.0
	if prev is Dictionary:
		var pd := prev as Dictionary
		var step_t := _anim_t - float(pd.get("t", _anim_t))
		if step_t > 0.0:
			var prev_pos: Vector2 = pd.get("pos", pos)
			speed = (pos - prev_pos).length() / step_t
	_motion_sample[id] = {"pos": pos, "t": _anim_t}
	return speed


# MOTION-ANIM-01: PORT APPROX yaw clamp. The donor authors frame blending but
# its engine semantics are UNVERIFIED (DANIM-01 §4.3), so this is explicitly a
# presentation-rate limiter, not a donor blend. Shortest signed arc is clamped
# to rate * sync dt; wrap is normalised so a +179 -> -179 flip is treated as 2 deg.
func _smooth_face(id: int, target: float, dt: float) -> float:
	var prev := float(_face_smooth.get(id, target))
	var max_step := YAW_MAX_RATE_RAD_S * maxf(dt, 0.0)
	var delta := fposmod(target - prev + PI, TAU) - PI
	if absf(delta) > max_step:
		delta = signf(delta) * max_step
	return fposmod(prev + delta + PI, TAU) - PI


# Parse the DONOR-CONVERTED OBJ (convert_models.py:43-66, :109-125) once per
# sid. Its vertex i is the donor .oss vertex i == pose vert i (V764 section 4),
# and its f/vt rows are the donor faces/UVs. The Godot importer may de-index
# and reorder vertices (measured: 719 imported vs 577 donor for peasant), so
# this source topology - not the imported buffer - is the shared index space.
func _load_obj_topology(sid: String) -> Dictionary:
	if _obj_topology.has(sid):
		return _obj_topology[sid]
	var result: Dictionary = {"verts": [], "uvs": [], "tris": []}
	var path := AssetPaths.existing(sid, "obj")
	if not FileAccess.file_exists(path):
		_obj_topology[sid] = result
		return result
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		_obj_topology[sid] = result
		return result
	var vv: Array = []
	var uu: Array = []
	var tt: Array = []
	while not f.eof_reached():
		var line := f.get_line().strip_edges()
		if line.begins_with("v "):
			var p := line.split(" ", false)
			if p.size() >= 4:
				vv.append(Vector3(float(p[1]), float(p[2]), float(p[3])))
		elif line.begins_with("vt "):
			var p := line.split(" ", false)
			if p.size() >= 3:
				uu.append(Vector2(float(p[1]), float(p[2])))
		elif line.begins_with("f "):
			var corners: Array = []
			var p := line.split(" ", false)
			for token in p.slice(1):
				var sub := token.split("/", false)
				if sub.is_empty():
					continue
				var vi: int = int(sub[0]) - 1
				var ui: int = int(sub[1]) - 1 if sub.size() > 1 and sub[1] != "" else -1
				corners.append([vi, ui])
			# Fan-triangulate any non-triangle face (this donor OBJ is all tris).
			for j in range(1, corners.size() - 1):
				tt.append([corners[0], corners[j], corners[j + 1]])
	f.close()
	result = {"verts": vv, "uvs": uu, "tris": tt}
	_obj_topology[sid] = result
	return result


# Rebuild the mesh from donor flat-root verts + donor OBJ topology using the
# EXACT transform of _bake_mesh (:341-360): (x-cx, z-z0, -(y-cy)) * scale.
# On any structural mismatch return no mesh and the caller keeps the static
# bind pose - never a filled/guessed vertex. Normals are generated from the
# morphed donor geometry (the donor skin emits positions only); UVs keep the
# donor vt values with the standard Godot V flip, both UNVERIFIED vs a render.
func _morph_mesh(sid: String, info: Dictionary, frame: int, action: String,
		verts: PackedVector3Array) -> Dictionary:
	var key := sid + "|" + action + "|f" + str(frame)
	if _morph_meshes.has(key):
		return _morph_meshes[key]
	var result: Dictionary = {"mesh": null, "reason": ""}
	var base := info.get("mesh") as Mesh
	if base == null or base.get_surface_count() < 1 or verts.is_empty():
		result["reason"] = "no source mesh or empty donor verts"
		_morph_meshes[key] = result
		return result
	var topo: Dictionary = _load_obj_topology(sid)
	var bind_verts: Array = topo.get("verts", [])
	var uvs: Array = topo.get("uvs", [])
	var tris: Array = topo.get("tris", [])
	if bind_verts.is_empty() or tris.is_empty() or bind_verts.size() != verts.size():
		result["reason"] = "no donor OBJ topology or vertex count mismatch: obj=%d donor=%d" % [bind_verts.size(), verts.size()]
		_morph_meshes[key] = result
		return result
	var bbox: Array = _bbox.get(sid, [])
	var cx := 0.0
	var cy := 0.0
	var z0 := 0.0
	if bbox.size() >= 6:
		cx = (float(bbox[0]) + float(bbox[1])) * 0.5
		cy = (float(bbox[2]) + float(bbox[3])) * 0.5
		z0 = float(bbox[4])
	var sc := float(info.get("scale", 1.0))
	var out_v := PackedVector3Array()
	var out_uv := PackedVector2Array()
	var out_idx := PackedInt32Array()
	var corner_map: Dictionary = {}
	for tri in tris:
		for corner in tri:
			var vi: int = int(corner[0])
			var ui: int = int(corner[1])
			if vi < 0 or vi >= verts.size():
				result["reason"] = "OBJ face index out of range: %d" % vi
				_morph_meshes[key] = result
				return result
			var ck := str(vi) + "," + str(ui)
			var ni: int = int(corner_map.get(ck, -1))
			if ni < 0:
				ni = out_v.size()
				corner_map[ck] = ni
				var mv: Vector3 = verts[vi]
				out_v.append(Vector3((mv.x - cx) * sc, (mv.z - z0) * sc, -(mv.y - cy) * sc))
				if ui >= 0 and ui < uvs.size():
					var uv: Vector2 = uvs[ui]
					out_uv.append(Vector2(uv.x, 1.0 - uv.y))
				else:
					out_uv.append(Vector2.ZERO)
			out_idx.append(ni)
	var dst: Array = []
	dst.resize(Mesh.ARRAY_MAX)
	for i in range(Mesh.ARRAY_MAX):
		dst[i] = null
	dst[Mesh.ARRAY_VERTEX] = out_v
	dst[Mesh.ARRAY_TEX_UV] = out_uv
	dst[Mesh.ARRAY_INDEX] = out_idx
	# ArrayMesh has no generate_normals() in Godot 4.7; accumulate face normals
	# from the morphed donor geometry (no donor normals exist in the .oss).
	var norms := PackedVector3Array()
	norms.resize(out_v.size())
	for i in range(0, out_idx.size(), 3):
		var i0: int = out_idx[i]
		var i1: int = out_idx[i + 1]
		var i2: int = out_idx[i + 2]
		var a: Vector3 = out_v[i0]
		var b: Vector3 = out_v[i1]
		var c: Vector3 = out_v[i2]
		var n: Vector3 = (b - a).cross(c - a)
		norms[i0] += n
		norms[i1] += n
		norms[i2] += n
	for i in range(norms.size()):
		norms[i] = norms[i].normalized()
	dst[Mesh.ARRAY_NORMAL] = norms
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, dst)
	var mat: Material = base.surface_get_material(0)
	if mat == null:
		mat = _default_material(sid, "unit")
	mesh.surface_set_material(0, mat)
	result = {"mesh": mesh, "frame": frame, "action": action,
		"verts": out_v.size(), "source": "donor_flat_root_morph",
		"coord": "donor Z-up -> bbox/Y-up (V764 section 4)",
		"label": PORT_LABEL, "visual": "UNVERIFIED"}
	_morph_meshes[key] = result
	return result


# ---------------------------------------------------------------- batching
func _new_batch(key: String, info: Dictionary, cls: String,
		pose: Dictionary = {}) -> Dictionary:
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = info["mesh"]
	# FIX-FIELD-DONOR: one batch per requested donor material/season. A
	# MultiMesh has one material, so stage changes migrate the field slot to the
	# matching key instead of tinting one shared field1 texture.
	var field_spec: Dictionary = info.get("field_spec", {})
	var is_field := _is_field_batch(key) and not field_spec.is_empty()
	if is_field:
		# Godot 4.7 permits use_colors only while instance_count == 0.
		mm.use_colors = true
	# P11: allocate only the initial buffer; use_colors is toggled above while
	# instance_count is still 0, which Godot 4.7 requires.
	var cap: int = mini(BATCH_INITIAL_CAPACITY, BATCH_CAPACITY)
	mm.instance_count = cap
	mm.visible_instance_count = 0
	var mmi := MultiMeshInstance3D.new()
	var is_morph: bool = not pose.is_empty()
	var tag := "MORPH_a" + str(pose.get("action", "?")) + "_f" + str(pose.get("frame", -1)) \
		if is_morph else "STATIC_POSE"
	mmi.name = "Batch_" + key.replace("|", "_") + "_" + tag
	mmi.set_meta("anim_status", ANIM_STATUS)
	mmi.set_meta("mesh_source", str(info.get("source", "?")))
	# PORT1TO1-ENT1TO1 / D9 — donor LOD is TWO ranges, not one. Mesh LOD 0..150
	# (refobj.actor:88-105) binds to Godot's visibility range; shader LOD and
	# child pool 0..2500 (refobj.actor:36-52) are kept DISTINCT as instance
	# state. No metre meaning, per-sid override or impostor is invented: [U] U5.
	mmi.visibility_range_begin = DONOR_LOD_MESH_MIN_DIST
	mmi.visibility_range_end = DONOR_LOD_MESH_MAX_DIST
	mmi.set_meta("donor_lod_mesh_range", [DONOR_LOD_MESH_MIN_DIST, DONOR_LOD_MESH_MAX_DIST])
	mmi.set_meta("donor_lod_shader_range", [DONOR_LOD_SHADER_MIN_DIST, DONOR_LOD_SHADER_MAX_DIST])
	mmi.set_meta("donor_lod_child_pool_max", DONOR_LOD_CHILD_POOL_MAX)
	mmi.set_meta("donor_lod_status", LOD_STATUS)
	mmi.set_meta("donor_lod_visual", "UNVERIFIED")
	if is_morph:
		mmi.set_meta("donor_pose_source", MORPH_POSE_SOURCE)
		mmi.set_meta("donor_frame", int(pose.get("frame", -1)))
		mmi.set_meta("donor_action", str(pose.get("action", "")))
		mmi.set_meta("donor_label", PORT_LABEL)
		mmi.set_meta("donor_visual", "UNVERIFIED")
	if is_field:
		# material_override keeps the shared crop mesh immutable while each
		# stage batch binds its own resolved texture/authored RGB.
		mmi.material_override = _field_crop_material(field_spec)
		mmi.set_meta("field_material", str(field_spec.get("material", "")))
		mmi.set_meta("field_texture_status", str(field_spec.get("texture_status", "")))
		mmi.set_meta("field_material_status", FIELD_EMISSION_STATUS)
		mmi.set_meta("visual_status", "UNVERIFIED")
	mmi.multimesh = mm
	add_child(mmi)
	# xforms is a CPU mirror. Headless Godot 4.7 dummy RenderingServer makes
	# MultiMesh.get_instance_transform() return identity for every slot, so a
	# mirror is needed for O(1) swap-removal and headless verification.
	return {"node": mmi, "mm": mm, "ids": [], "xforms": [], "class": cls,
		"key": key, "morph": is_morph, "capacity": cap}


# P11: grow the allocated instance buffer geometrically, never past the
# unchanged BATCH_CAPACITY ceiling. Node name, batch key, slot indices,
# visible_instance_count and the CPU xform mirror are all untouched; existing
# slots are rewritten from the mirror because it is authoritative under the
# headless dummy RenderingServer.
func _grow_batch(b: Dictionary, needed: int) -> void:
	var mm: MultiMesh = b["mm"]
	var cap: int = int(b.get("capacity", BATCH_CAPACITY))
	if needed <= cap or cap >= BATCH_CAPACITY:
		return
	var new_cap: int = cap
	while new_cap < needed and new_cap < BATCH_CAPACITY:
		new_cap = mini(new_cap * 2, BATCH_CAPACITY)
	mm.instance_count = new_cap
	b["capacity"] = new_cap
	var xforms: Array = b["xforms"]
	var ids: Array = b["ids"]
	for i in range(xforms.size()):
		mm.set_instance_transform(i, xforms[i])
	# FIX-FIELD-DONOR field colours are read-only here: re-apply neutral
	# alpha=1 from the mirror so a resize is byte-identical on the next render.
	if _is_field_batch(str(b.get("key", ""))):
		for i in range(xforms.size()):
			var fv = _field_visual.get(int(ids[i]))
			if fv is Dictionary:
				mm.set_instance_color(i, (fv as Dictionary).get("color", Color(1, 1, 1, 1)))


# V7-65: `tint` / `player` are INTERNAL batching-key extensions only; the six
# public signatures are unchanged. Resources pass tint=null and stay untinted.
func _acquire(key: String, id: int, info: Dictionary, cls: String,
		tint: Variant = null, player: int = -1,
		pose: Dictionary = {}) -> int:
	var b = _batches.get(key)
	if not (b is Dictionary):
		b = _new_batch(key, info, cls, pose)
		_batches[key] = b
		(b as Dictionary)["tint"] = tint
		(b as Dictionary)["player"] = player
		if tint is Color:
			_apply_tint((b as Dictionary)["node"], info["mesh"], tint,
				str(info.get("sid", "")), str(info.get("kind", cls)))
	var ids: Array = b["ids"]
	# P11: grow only when the allocated buffer is full; hard ceiling unchanged.
	if ids.size() >= int((b as Dictionary).get("capacity", BATCH_CAPACITY)):
		_grow_batch(b as Dictionary, ids.size() + 1)
	if ids.size() >= BATCH_CAPACITY:
		push_warning("world3d_entities: batch full " + key + " (cap " + str(BATCH_CAPACITY) + ")")
		return -1
	var ix: int = ids.size()
	ids.append(id)
	(b as Dictionary)["xforms"].append(Transform3D())
	# Keep tint/player/pose on the slot so a frame change can re-acquire the
	# matching batch without re-reading sim state or guessing a key.
	# WAVE-N/N04 (a): persist the RESOLVED presentation sid on the slot.
	# info["sid"] is the nation-resolved sid on both the static bind and the
	# morph re-acquire path, so a frame change cannot silently revert sync()
	# to the base sim sid. No sim field is written.
	_slot[id] = {"key": key, "index": ix, "class": cls, "tint": tint,
		"mesh_sid": str(info.get("sid", "")),
		"player": player, "pose_source": str(pose.get("pose_source", "static_bind_pose")),
		"frame": int(pose.get("frame", -1)), "action": str(pose.get("action", ""))}
	var mm: MultiMesh = b["mm"]
	# FIX-FIELD-DONOR: neutral initial instance colour; sync() keeps alpha 1.0.
	if _is_field_batch(key):
		mm.set_instance_color(ix, Color(1, 1, 1, 1))
	mm.visible_instance_count = ids.size()
	return ix


func _release(id: int) -> void:
	var sl = _slot.get(id)
	if not (sl is Dictionary):
		return
	var key := str((sl as Dictionary).get("key", ""))
	var b = _batches.get(key)
	if not (b is Dictionary):
		_slot.erase(id)
		return
	var ids: Array = (b as Dictionary)["ids"]
	var mm: MultiMesh = (b as Dictionary)["mm"]
	var xforms: Array = (b as Dictionary)["xforms"]
	var ix: int = int((sl as Dictionary).get("index", 0))
	var last: int = ids.size() - 1
	if ix >= 0 and last >= 0:
		if ix != last:
			# swap-remove keeps the instance array dense; O(1) removal.
			# Use the CPU mirror, not MultiMesh.get_instance_transform()
			# (identity under the headless dummy RenderingServer).
			var xf: Transform3D = xforms[last]
			xforms[ix] = xf
			mm.set_instance_transform(ix, xf)
			var moved = ids[last]
			ids[ix] = moved
			if _slot.has(moved):
				(_slot[moved] as Dictionary)["index"] = ix
		ids.pop_back()
		mm.visible_instance_count = ids.size()
		# An empty STATIC batch has no reason to keep a node/draw call alive;
		# free it synchronously so same-frame node counts return to baseline.
		# V7-74: keep EMPTY MORPH batches alive so a unit oscillating between
		# donor frames reuses the node instead of free/create churn; they draw
		# nothing (visible_instance_count == 0) and are bounded by visited frames.
		if ids.is_empty() and not bool((b as Dictionary).get("morph", false)):
			var node = (b as Dictionary).get("node")
			if is_instance_valid(node):
				(node as Node).free()
			_batches.erase(key)
	_slot.erase(id)


# ---------------------------------------------------------------- coordinates
func _world_pos(p: Vector2) -> Vector3:
	var w := MAP_DEFAULT
	var h := MAP_DEFAULT
	if game != null:
		# RefCounted stubs in atomic tests return null for unknown properties;
		# float(null) is an invalid constructor in GDScript 4.7.
		var wv = game.get("MAP_W")
		var hv = game.get("MAP_H")
		if wv != null:
			w = float(wv)
		if hv != null:
			h = float(hv)
	if w <= 0.0:
		w = MAP_DEFAULT
	if h <= 0.0:
		h = MAP_DEFAULT
	var y := 0.0
	if game != null and game.has_method("height_at"):
		y = float(game.call("height_at", p))
	return Vector3(p.x - w * 0.5 * TILE_M, y, p.y - h * 0.5 * TILE_M)


func _is_hidden(e: Dictionary) -> bool:
	if bool(e.get("dead", false)) or bool(e.get("hidden", false)):
		return true
	if str(e.get("kind", "")) == "res":
		# Mirrors world.gd:2712-2713: permanent ore nodes (max_hits == 0)
		# stay visible; exhausted finite nodes do not.
		if int(e.get("hits", 0)) <= 0 and int(e.get("max_hits", 0)) != 0 \
				and str(e.get("type", "")) != "stump" and str(e.get("type", "")) != "food":
			return true
	return false


func _xf(id: int) -> Transform3D:
	var e = _refs.get(id)
	if not (e is Dictionary):
		return Transform3D()
	var ed := e as Dictionary
	var p: Vector2 = ed.get("pos", Vector2.ZERO)
	var yaw := 0.0
	var sl = _slot.get(id)
	if sl is Dictionary and str((sl as Dictionary).get("class", "")) == "unit":
		# FIX-MOVE-VISUAL: the converted donor mesh's FRONT is donor -Y, not
		# +X. Evidence (all read-only): bake_sprites.py:226-238 places camera
		# d at azimuth d*45 deg around the donor Z-up mesh; in the donor-
		# derived sheet assets/models/anim/common/units/peasant_idle.png
		# column 6 (az 270 deg, camera at -Y) shows the FACE/buttons while
		# column 2 (az 90 deg, +Y) shows the back strap (same for musketeer).
		# convert_models.py:43-66 + _bake_mesh map donor (x,y,z) -> (x,z,-y),
		# so donor -Y becomes local +Z in the Y-up mesh. SIM face is
		# (target-pos).angle() (app/scripts/game.gd:4605,5182), i.e. angle
		# from +X toward +Y, and _world_pos maps sim +Y to world +Z.
		# R_y(PI/2-face)*local +Z = (cos face, 0, sin face): face 0 -> world
		# +X, face 90 deg -> world +Z. V7-65's yaw=-face pointed local +X
		# and was 90 deg off -> units looked like they strafed.
		# PORT APPROXIMATION retained: donor yaw itself is a renderer transform
		# (V7-2 3.3.3; V7-1 C4: zero turn actions in 246 .aaf); visual UNVERIFIED.
		# MOTION-ANIM-01: use the once-per-sync clamped face, not the raw SIM
		# face, so a 91/166 deg snap cannot jump the mesh in one capture. Before
		# the first sync (add_unit / stub callers) the raw face is still used.
		var smooth_face: Variant = _face_smooth.get(id, null)
		if smooth_face is float:
			yaw = PI / 2.0 - float(smooth_face)
		else:
			yaw = PI / 2.0 - float(ed.get("face", 0.0))
	# DECOR-01: DECOR tree jitter is per instance, so it lives here rather than
	# in the sid-shared _mesh_cache. Donor trees sit in the "wide" 0.85..1.15
	# band (envscales.cfg:162-164; DEC-03 §4.8); mines stay in "none" 1/1 and
	# are deliberately untouched - no jitter is applied to non-wood res nodes.
	# Resource yaw is intentionally left at 0: no authored per-object rotation
	# reaches this module (see TREE_YAW_STATUS); no rotation is invented.
	var s := HIDDEN_SCALE if _is_hidden(ed) else 1.0
	if str(ed.get("kind", "")) == "res" and str(ed.get("type", "")) == "wood":
		s *= _jitter_factor(TREE_JITTER_BAND, p)
	var basis := Basis().rotated(Vector3.UP, yaw).scaled(Vector3(s, s, s))
	return Transform3D(basis, _world_pos(p))


# ---------------------------------------------------------------- public API
func add_unit(e) -> void:
	if e == null or game == null:
		return
	var ed := e as Dictionary
	var id := int(ed.get("id", -1))
	if id < 0:
		return
	_refs[id] = ed
	# MOTION-ANIM-01: seed the presentation mirrors at spawn so the first sync
	# measures a real interval and a new unit never yaws from 0 to its face.
	_motion_sample[id] = {"pos": ed.get("pos", Vector2.ZERO), "t": _anim_t}
	_face_smooth[id] = float(ed.get("face", 0.0))
	_applied_pose_frame.erase(id)
	if _slot.has(id):
		return
	var base_sid := str(ed.get("sid", ""))
	# NATION-MODEL-01: resolve the mesh sid from the entity's nation before any
	# mesh is loaded. Static-bind and morph paths both see the chosen sid via
	# _refs; no sim field is written. Naval ships are units with def.naval=true
	# and are handled by the "naval" family branch of the same helper.
	var ns := _entity_mesh_sid(ed, base_sid, "unit")
	var sid := str(ns["sid"])
	_record_nation_mesh(ns, base_sid)
	var info := _mesh_info(sid, "unit")
	var player: int = _player_index(ed)
	# Explicit Variant type: `:=` from a Variant-returning helper is an
	# INFERRED_DECLARATION warning, which this project treats as an error.
	var tint: Variant = _player_tint(player)
	var key := "unit|" + sid
	if tint is Color:
		# Internal batch-key extension: one MultiMesh per (sid, player slot).
		# Without this, two players' units would share one material/tint.
		key += "|p" + str(player)
	var ix := _acquire(key, id, info, "unit", tint, player)
	if ix >= 0:
		var b: Dictionary = _batches[key]
		# NATION-MODEL-01: tag the batch with the honest nation status so a
		# structural probe can distinguish exact art from the fallback.
		var bnode = b.get("node")
		if is_instance_valid(bnode):
			(bnode as Node3D).set_meta("nation_mesh_label", str(ns["status"]))
			(bnode as Node3D).set_meta("nation_mesh_exact", bool(ns["exact"]))
			(bnode as Node3D).set_meta("nation", str(ns["nation"]))
		var xf := _xf(id)
		(b["xforms"] as Array)[ix] = xf
		(b["mm"] as MultiMesh).set_instance_transform(ix, xf)


func add_building(e) -> void:
	if e == null or game == null:
		return
	var ed := e as Dictionary
	var id := int(ed.get("id", -1))
	if id < 0 or _nodes.has(id):
		return
	_refs[id] = ed
	var base_sid := str(ed.get("sid", ""))
	# NATION-MODEL-01: donor building art is nation-prefixed ONLY in the 2D
	# bake; no 3D <nat>_<sid>.obj exists, so this probes and falls back to the
	# base donor mesh with an explicit PORT APPROXIMATION label.
	var ns := _entity_mesh_sid(ed, base_sid, "building")
	var sid := str(ns["sid"])
	_record_nation_mesh(ns, base_sid)
	var info := _mesh_info(sid, "building")
	var mi := MeshInstance3D.new()
	mi.name = "Building_" + sid + "_" + str(id) + "_STATIC_POSE"
	mi.mesh = info["mesh"]
	mi.set_meta("anim_status", ANIM_STATUS)
	mi.set_meta("mesh_source", str(info.get("source", "?")))
	mi.set_meta("nation_mesh_label", str(ns["status"]))
	mi.set_meta("nation_mesh_exact", bool(ns["exact"]))
	mi.set_meta("nation", str(ns["nation"]))
	# V7-65: per-building tint (each building owns its own MeshInstance3D, so
	# no batching-key change is needed here; surface overrides keep siblings
	# of other players independent while sharing the baked donor mesh).
	var player: int = _player_index(ed)
	# Explicit Variant type (see add_unit): `:=` here is a treated-as-error warning.
	var tint: Variant = _player_tint(player)
	if tint is Color:
		_apply_tint(mi, info["mesh"], tint, sid, "building")
		mi.set_meta("donor_tint_slot", player)
		mi.set_meta("donor_tint_rgb", [tint.r, tint.g, tint.b])
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	add_child(mi)
	_nodes[id] = mi
	mi.transform = _xf(id)
	# MILLFIX F1: only the mill gets a spinning sail child. The parent stays
	# the exact V7-14 static donor MeshInstance3D — no sim/mesh change.
	if sid == "mil":
		_attach_rotor(id, mi)


# MILLFIX F1 / M03 — donor-derived face-on rotor bake on a FIXED-AXLE cutout quad.
# Superseded 2D-sheet hub (hx=+0.173, hy=+5.235, hz=0) is kept only in the
# MILL_HUB/MILL_TOWER_* constants for the historical M04 atom; M01 §2.2/D1
# showed hz=0 puts the sail plane through the tower mid-depth. M03 reads the
# donor 3-D attach instead: eurmilanim.oss axle tip donor y=-1.897957 maps
# through _bake_mesh() (:1079-1081) to local z=+1.8947 on the +Z tower face;
# disc centre donor (0,-1.469455,5.623430) maps to local x=-0.1764, y=+5.6263.
# Donor front is donor -Y -> local +Z = the default camera side, so NO whole-
# mill yaw is added (M01 §2.4's -90 deg yaw is rejected: bake_mill_rotor.py:8-12
# says the donor +X view is the EDGE-ON view, not the front).
# Quad span = MILL_ROTOR_ORTHO (6.352 m), i.e. the full baked cell, NOT half.
func _rotor_mesh() -> Mesh:
	var half := MILL_ROTOR_ORTHO * 0.5
	var vv := PackedVector3Array()
	vv.append(Vector3(-half, -half, 0.0))
	vv.append(Vector3(half, -half, 0.0))
	vv.append(Vector3(half, half, 0.0))
	vv.append(Vector3(-half, half, 0.0))
	# Godot texture UV (0,0) is top-left; map it to the quad's top-left vertex.
	var uv := PackedVector2Array()
	uv.append(Vector2(0, 1)); uv.append(Vector2(1, 1))
	uv.append(Vector2(1, 0)); uv.append(Vector2(0, 0))
	var nn := PackedVector3Array()
	for i in range(4):
		nn.append(Vector3.BACK)
	var idx := PackedInt32Array()
	idx.append(0); idx.append(1); idx.append(2)
	idx.append(0); idx.append(2); idx.append(3)
	var arr: Array = []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = vv
	arr[Mesh.ARRAY_TEX_UV] = uv
	arr[Mesh.ARRAY_NORMAL] = nn
	arr[Mesh.ARRAY_INDEX] = idx
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	return mesh


func _rotor_material() -> Material:
	var mat := StandardMaterial3D.new()
	var tex: Texture2D = null
	# MOTION-ANIM-01/ROTOR — the owner's live run showed that a .import file is
	# NOT proof that Godot generated its .ctex: ResourceLoader.load() on the
	# missing cache emitted hard engine ERROR lines from this path. Root cause:
	# the original anim/ PNG sits under .gdignore and is never imported. Try the
	# importable port copy in tex/ FIRST, then the original path as a fallback;
	# decode bytes through FileAccess/Image instead of the import pipeline, so a
	# stale/missing cache can never produce engine ERRORs. Both paths are the
	# SAME shipped PNG and no art is invented. Every load result is checked
	# before use; total failure degrades to a plain white quad.
	for rotor_path in [ROTOR_TEX_IMPORT_PATH, ROTOR_TEX_PATH]:
		if tex != null:
			break
		if FileAccess.file_exists(rotor_path):
			var img := Image.new()
			if img.load(rotor_path) == OK and not img.is_empty():
				tex = ImageTexture.create_from_image(img)
	if tex != null:
		mat.albedo_texture = tex
		# Donor bake has transparent corners; scissor keeps a hard sail
		# silhouette (the port's other donor cutouts use the same policy).
		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
		mat.alpha_scissor_threshold = 0.5
	else:
		mat.albedo_texture = null
		mat.albedo_color = Color(1.0, 1.0, 1.0, 1.0)
		mat.transparency = BaseMaterial3D.TRANSPARENCY_DISABLED
		if not _rotor_fallback_warned:
			_rotor_fallback_warned = true
			push_warning("world3d_entities: " + ROTOR_FALLBACK_STATUS)
	mat.set_meta("rotor_texture_status",
		"donor_png_bound" if tex != null else "fallback_white_untextured")
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	# Unshaded mirrors the 2D canvas sprite; lighting parity UNVERIFIED.
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	return mat


func _attach_rotor(id: int, parent: MeshInstance3D) -> void:
	if _rotors.has(id) and is_instance_valid(_rotors[id]):
		return
	var rotor := MeshInstance3D.new()
	rotor.name = "MillRotor_" + str(id)
	rotor.mesh = _rotor_mesh()
	var rotor_mat := _rotor_material()
	rotor.material_override = rotor_mat
	rotor.set_meta("rotor_texture_status", rotor_mat.get_meta("rotor_texture_status", "?"))
	# M03 donor axle tip: disc centre from eurmilanim.oss, axle tip at the
	# slab's donor -Y face so the quad clears the tower (tower face at hub
	# height is donor y~-1.784 -> local z~+1.781; tip local z=+1.8947).
	# _bake_mesh() mapping at :1079-1081, tower bbox at manifest.json:1209-1216.
	var tower_ctr := (MILL_TOWER_BBOX_LO + MILL_TOWER_BBOX_HI) * 0.5
	rotor.position = Vector3(
		MILL_ROTOR_HUB_DONOR.x - tower_ctr.x,
		MILL_ROTOR_HUB_DONOR.z - MILL_TOWER_BBOX_LO.z,
		-(MILL_ROTOR_AXLE_TIP_DONOR_Y - tower_ctr.y))
	rotor.set_meta("hub_source", ROTOR_MOUNT_STATUS)
	rotor.set_meta("hub_local_m", [rotor.position.x, rotor.position.y, rotor.position.z])
	rotor.set_meta("visual_status", ROTOR_STATUS)
	rotor.set_meta("donor_source", ROTOR_TEX_PATH)
	rotor.set_meta("donor_meta", ROTOR_META_PATH)
	rotor.set_meta("spin_rad_per_s", MILL_SPIN)
	parent.add_child(rotor)
	_rotors[id] = rotor


# --- BUILD-STAGES-01: donor construction-stage selector ---------------------
# Presentation-only mirror of the sim; nothing here writes back to `e`.
# PORT1TO1-ENT1TO1 / D10: the donor stage source is hp/maxhp
# (unit.script:6583-6596), NOT progress/build_time. The live site's hp is
# advanced with construction in game.gd:5541 and starts at 25% in
# game.gd:4483, so hp/max_hp is a read-only donor-faithful source here.
# No fallback to build_time: an entity without max_hp yields 0 and is
# recorded as a data gap, never an invented stage.
func _build_progress01(ed: Dictionary) -> float:
	if bool(ed.get("finished", true)):
		return 1.0
	var max_hp := float(ed.get("max_hp", 0.0))
	if max_hp <= 0.0:
		_action_gaps["building|max_hp_missing"] = int(_action_gaps.get("building|max_hp_missing", 0)) + 1
		return 0.0
	return clampf(float(ed.get("hp", 0.0)) / max_hp, 0.0, 1.0)


# Donor mesh-name suffix: "1".."4" for buildings, "1"/"2" for walls.
# The clamp at progress=1 (unfinished) mirrors the donor `case` having no
# stage_4: the previous stage mesh is kept (DBUILD-01 §2.2, derived).
func _build_stage_suffix(ed: Dictionary) -> String:
	var raw := clampi(int(floor(_build_progress01(ed) * float(BUILD_STAGE_STEPS))),
		0, BUILD_STAGE_STEPS - 1)
	var mesh_stage := raw + 1
	if str(ed.get("sid", "")) == "wal":
		mesh_stage = mini(1 + int(raw / 3), BUILD_WALL_MAX_STAGE)
	return str(mesh_stage)


# BLDDEATH-1TO1 — donor stage is floor(hp/maxhp*4), read DIRECTLY from hp/maxhp,
# never `_build_progress01`'s `finished` shortcut and never build_time
# (unit.script:6583-6596, building.inc/ontagstates.inc:240-259). `case iVisual`
# in the death branch covers stage_0 -> _death1 and stage_1 -> _death2; stage_2/3
# have no donor line here, so no mesh is invented for them ([U]-14).
func _donor_raw_stage(ed: Dictionary) -> Dictionary:
	var max_hp := float(ed.get("max_hp", 0.0))
	var wall := str(ed.get("sid", "")) == "wal"
	if max_hp <= 0.0:
		return {"stage": 0, "wall": wall, "gap": true}
	var raw := clampi(int(floor(clampf(float(ed.get("hp", 0.0)) / max_hp,
		0.0, 1.0) * float(BUILD_STAGE_STEPS))), 0, BUILD_STAGE_STEPS - 1)
	var out := {"stage": raw, "wall": wall, "gap": false}
	if wall:
		out["wall_stage"] = mini(1 + int(raw / 3), BUILD_WALL_MAX_STAGE)
	return out


# PORT1TO1-ENT1TO1 / D11 — donor essential `death` selects <sid>_death1 at
# stage_0 and <sid>_death2 from stage_1 (eurmil.actor:20-27,
# ontagstates.inc:264-311). The derived ruin OBJ is probed through
# _death_mesh_info; a missing asset stays an explicit gap, never a fabrication.
func _donor_death_suffix(ed: Dictionary) -> String:
	var st := _donor_raw_stage(ed)
	# No max_hp means no donor stage can be derived: explicit gap, never a
	# silent fallback to a base mesh labelled as a ruin.
	if bool(st.get("gap", false)):
		return ""
	return "_death1" if int(st.get("stage", 0)) == 0 else "_death2"


# Resolve a donor-named converted OBJ. Empty Dictionary means "no art": the
# caller then reuses the base mesh with an explicit PORT APPROXIMATION label.
# BUILD-ART-C-01: centre with the manifest bbox of the resolved art sid
# (<sid><suffix>[a]; suffix "" for the completion scaffold gives <sid>a),
# falling back to the base sid bbox only when no stage entry is in the manifest.
func _stage_mesh_info(sid: String, suffix: String, scaffold: bool) -> Dictionary:
	var key := sid + "|" + suffix + "|" + ("scaffold" if scaffold else "stage")
	if _stage_mesh_cache.has(key):
		var cached = _stage_mesh_cache[key]
		return cached as Dictionary
	var out: Dictionary = {}
	var art_sid := sid + suffix + ("a" if scaffold else "")
	var path := AssetPaths.existing(sid, "obj", suffix + ("a" if scaffold else ""))
	if ResourceLoader.exists(path):
		var src := load(path) as Mesh
		if src != null:
			var has_stage_bbox := _bbox.has(art_sid)
			var bbox: Array = _bbox.get(art_sid, _bbox.get(sid, []))
			var native_h := 1.0
			if bbox.size() >= 6:
				native_h = float(bbox[5]) - float(bbox[4])
			if native_h <= 0.0:
				native_h = 1.0
			out = _bake_mesh(src, bbox, 1.0, native_h, false, sid, "building")
			out["source"] = "obj_scaffold_zup_bbox_normalised" if scaffold else "obj_stage_zup_bbox_normalised"
			out["sid"] = sid
			out["kind"] = "building"
			out["bbox_sid"] = art_sid if has_stage_bbox else sid
			out["bbox_note"] = "per-stage manifest bbox" if has_stage_bbox else "base sid bbox fallback; per-stage bbox absent from manifest"
	_stage_mesh_cache[key] = out
	return out


# BLDDEATH-1TO1 — discover the composed world3d_fx.gd sibling once. No edit to
# world3d.gd is needed (world3d.gd:152-165 add_child's every module under one
# Node3D); a bare stub test without the sibling keeps the labelled no-op path.
func _find_fx():
	if _fx != null and is_instance_valid(_fx):
		return _fx
	if _fx_checked:
		return null
	_fx_checked = true
	var parent := get_parent()
	if parent == null:
		return null
	for child in parent.get_children():
		if child == self:
			continue
		if child.has_method("add_impact_fx") and child.has_method("add_fx"):
			_fx = child
			break
	return _fx


# BLDDEATH-1TO1 — read a derived death OBJ when Godot has no imported .obj
# resource (same no-sidecar situation as assets/fx; see world3d_fx.gd:1256-1308).
# Vertices stay in raw donor Z-up coordinates: _bake_mesh applies the established
# Z-up -> Y-up mapping. This parses derived donor geometry only; nothing is
# generated, retouched or invented here.
func _death_obj_mesh(path: String) -> Mesh:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return null
	var vv: PackedVector3Array = PackedVector3Array()
	var uu: PackedVector2Array = PackedVector2Array()
	var tris: Array = []
	while not f.eof_reached():
		var line := f.get_line().strip_edges()
		if line.begins_with("v "):
			var vp := line.split(" ", false)
			if vp.size() >= 4:
				vv.append(Vector3(float(vp[1]), float(vp[2]), float(vp[3])))
		elif line.begins_with("vt "):
			var vt := line.split(" ", false)
			if vt.size() >= 3:
				uu.append(Vector2(float(vt[1]), float(vt[2])))
		elif line.begins_with("f "):
			var vf := line.split(" ", false)
			var corners: Array = []
			for token in vf.slice(1):
				var sub := token.split("/", false)
				if sub.size() < 2:
					continue
				corners.append([int(sub[0]) - 1, int(sub[1]) - 1])
			for j in range(1, corners.size() - 1):
				tris.append([corners[0], corners[j], corners[j + 1]])
	f.close()
	if vv.is_empty() or tris.is_empty():
		return null
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for tri in tris:
		for corner in tri:
			var vi := int(corner[0])
			var ui := int(corner[1])
			if vi < 0 or vi >= vv.size():
				continue
			if ui >= 0 and ui < uu.size():
				st.set_uv(uu[ui])
			st.add_vertex(vv[vi])
	st.generate_normals()
	return st.commit()


func _death_texture(path: String) -> Texture2D:
	if _death_materials.has(path + "|tex"):
		return _death_materials[path + "|tex"] as Texture2D
	var tex: Texture2D = null
	if ResourceLoader.exists(path):
		tex = load(path) as Texture2D
	if tex == null and FileAccess.file_exists(path):
		var img := Image.new()
		if img.load(ProjectSettings.globalize_path(path)) == OK:
			tex = ImageTexture.create_from_image(img)
	_death_materials[path + "|tex"] = tex
	return tex


func _death_material(path: String) -> Material:
	if _death_materials.has(path + "|mat"):
		return _death_materials[path + "|mat"] as Material
	var mat := StandardMaterial3D.new()
	var tex := _death_texture(path)
	if tex != null:
		mat.albedo_texture = tex
	_death_materials[path + "|mat"] = mat
	return mat


# BLDDEATH-1TO1 / IMPL-DEATH-FAMILIES — resolve a derived death mesh:
# <stem>_death1/2 and the attach child <stem>[a]/_death1a/_death2a, named from
# the port sid through BLD_DEATH_STEMS (all 12 families). Geometry is
# centred/grounded with its OWN donor AABB (from the derived mesh, never an
# invented bbox), then baked with the same Z-up -> Y-up transform as every
# other donor mesh in this module. A degenerate AABB stays an honest labelled
# gap — no 1x1x1 cube is substituted for donor art (DEC_U_death_families §4.3).
func _death_mesh_info(sid: String, suffix: String, scaffold: bool) -> Dictionary:
	var stem := str(BLD_DEATH_STEMS.get(sid, ""))
	if stem == "" or not (suffix in ["_death1", "_death2"]):
		return {}
	var key := sid + "|" + suffix + "|" + ("debris" if scaffold else "death")
	if _death_mesh_cache.has(key):
		return _death_mesh_cache[key] as Dictionary
	var art_sid := stem + suffix + ("a" if scaffold else "")
	var path := BLD_DEATH_DIR + "models/" + art_sid + ".obj"
	var src: Mesh = null
	var source := ""
	if ResourceLoader.exists(path):
		src = load(path) as Mesh
		if src != null:
			source = "derived_obj_imported"
	if src == null and FileAccess.file_exists(path):
		src = _death_obj_mesh(path)
		if src != null:
			source = "derived_obj_runtime_parse"
	var out: Dictionary = {}
	var guard_label := ""
	if src != null:
		var aabb := src.get_aabb()
		if aabb.size.z <= 0.0:
			# IMPL-DEATH-FAMILIES: never fabricate a unit cube for degenerate
			# donor art. _death_obj_mesh already returns null on zero faces;
			# keep the honest AABB and label the gap instead.
			guard_label = "degenerate_z_depth_no_cube_substitution"
		var bbox: Array = [aabb.position.x, aabb.position.x + aabb.size.x,
			aabb.position.y, aabb.position.y + aabb.size.y,
			aabb.position.z, aabb.position.z + aabb.size.z]
		out = _bake_mesh(src, bbox, 1.0, aabb.size.z, false, sid, "building")
		out["source"] = source
		out["sid"] = sid
		out["kind"] = "building"
		out["art_sid"] = art_sid
		out["manifest"] = BLD_DEATH_MANIFEST
		out["visual"] = "UNVERIFIED"
		if guard_label != "":
			out["aabb_guard"] = guard_label
	_death_mesh_cache[key] = out
	return out


# IMPL-DEATH-FAMILIES / DEC-U smoke_burn_ttl B1-B2 — donor transition effects.
# ZERO smoke is attached at death: damage smoke is pre-death, HP/count-driven,
# max 1 per 7th progresstick, roll-gated, parented to misc/'point' and gated
# not bdead (nothing.inc:19,293); stop is event-driven
# (MyGameObjectPFXClear ontagstates.inc:88 + misc-child EffectClear :289-298 +
# stage transitions + holder destroy), never a timed TTL. BLD_DEATH_SMOKE_KEY
# is retained only for a future HP-driven damage-smoke path (needs E-U14-burn).
# The recovered _unit_DoExplosion payload is fired through the FX donor-key
# entry point as 'grenadeexp' + 'expflash' (PUEXPBUILDINGDEATH); no 'explode'
# stand-in and no TTL argument. No stage timer is passed as a life value.
func _fire_donor_death_fx(pos, do_explosion: bool) -> Dictionary:
	var out: Dictionary = {}
	out["smoke_attached"] = 0
	out["smoke_status"] = "cleared_at_death — 0 attaches (MyGameObjectPFXClear ontagstates.inc:88 + misc EffectClear :289-298)"
	var fxm = _find_fx()
	if fxm == null:
		_action_gaps["building|fx_module_missing"] = int(
			_action_gaps.get("building|fx_module_missing", 0)) + 1
		out["fx_module"] = "missing"
		return out
	if do_explosion and fxm.has_method("add_impact_fx"):
		var ex: Dictionary = {}
		for key in BLD_DEATH_EXPLOSION_KEYS:
			ex[key] = fxm.add_impact_fx(key, pos)
		out["explosion"] = ex
		out["explosion_keys"] = BLD_DEATH_EXPLOSION_KEYS.duplicate()
		out["explosion_status"] = BLD_DEATH_EXPLOSION_STATUS
	else:
		out["explosion"] = {}
		out["explosion_status"] = "gate not met on this edge (ontagstates.inc:309-311)"
	return out


# Called once per sync() from the building transform loop. Adds a stage meta
# record on the existing parent MeshInstance3D and attach/removes a scaffold
# child in sync with `finished`. The parent's V7-14 static pose identity,
# tint, rotor child and every public API are untouched.
func _sync_building_stages() -> void:
	var stage_hist: Dictionary = {}
	var scaffold_count := 0
	var stage_art_hits := 0
	var stage_approx := 0
	var scaffold_art_hits := 0
	var death_art_hits := 0
	var death_blocked := 0
	var death_transitions := 0
	var death_smoke_spawns := 0
	var death_smoke_cleared := 0
	var death_explosion_hooks := 0
	var death_child0_hits := 0
	var death_hidden_children := 0
	var death_misc_cleared := 0
	var death_stage2_swaps := 0
	var death_destroyed := 0
	var destroy_ids: Array[int] = []
	# IMPL-DEATH-FAMILIES: the two 30-valued donor constants are STAGE TIMERS
	# (settagstates.inc:32-53), never a visual/smoke TTL. Their wall-clock base
	# stays [U] U14; the port advances them with the already-labelled
	# Data.DEC_U_BUILDING_DEATHTIME_S_SHOWN (shown, not endorsed).
	var stage_timer_label := ("settagstates.inc:32-53 deathtime_0/1=%d — STAGE TIMER, "
		+ "NOT A VISUAL TTL; wall-clock base [U] U14 (E-U14-ttl)") % BLD_DEATH_STAGE_TIMER_UNITS
	# Drop mirrors of removed buildings; no per-remove hook edit is needed.
	for stale in _death_prev.keys():
		if not _nodes.has(stale):
			_death_prev.erase(stale)
	for id in _nodes.keys():
		var mi = _nodes[id]
		if not is_instance_valid(mi):
			continue
		var ed = _refs.get(int(id))
		if not (ed is Dictionary):
			continue
		var e := ed as Dictionary
		var sid := str(e.get("sid", ""))
		var finished := bool(e.get("finished", true))
		var died: bool = bool(e.get("dead", false))
		# The donor building-death stage schedule is building-only. Unit deaths
		# keep the previous explicit-gap path (no ruin stem, no stage timer).
		var is_building := str(e.get("kind", "")) == "building"
		var donor_stage := _donor_raw_stage(e)
		var prev: Dictionary = _death_prev.get(int(id), {
			"dead": false, "finished": finished, "stage": int(donor_stage.get("stage", 0)),
			"dstage": 0, "dstage_t0": _anim_t, "fx_fired": false})
		var base_info: Dictionary = _mesh_info(sid, "building")
		var base_mesh: Mesh = base_info["mesh"] as Mesh
		var suffix := ""
		var source := "finished_base_mesh"
		var chosen: Mesh = base_mesh
		# IMPL-DEATH-FAMILIES — shared donor stage schedule (settagstates.inc:32-53,
		# deathstage1.inc:7-11, deathstage2.inc:8-15). Death entry forces visual
		# stage_0 (_death1) for a completed building (:44-51) and stage_1
		# (_death2) immediately for birth-death (:34-39). DeathStage1 advances
		# stage_0->stage_1 after deathtime_0 (x2 mines, :46-48), DeathStage2
		# destroys after deathtime_1 (x2 mines, no doubling on birth shortcut :39).
		# These are STAGE TIMERS, NOT visual TTLs; base [U] U14.
		var dstage := int(prev.get("dstage", 0))
		var dstage_t0 := float(prev.get("dstage_t0", _anim_t))
		var fx_fired := bool(prev.get("fx_fired", false))
		if died and is_building:
			if dstage == 0:
				dstage = 1 if finished else 2
				dstage_t0 = _anim_t
			var span := float(Data.DEC_U_BUILDING_DEATHTIME_S_SHOWN)
			if finished and sid.begins_with("mine"):
				span *= 2.0
			if dstage == 1 and (_anim_t - dstage_t0) >= span:
				dstage = 2
				dstage_t0 = _anim_t
				death_stage2_swaps += 1
			elif dstage == 2 and (_anim_t - dstage_t0) >= span:
				# DeathStage2 -> GameObjectRequestToDestroyByHandle. Removal is
				# deferred to the existing remove() path after this loop.
				dstage = 3
				destroy_ids.append(int(id))
		# Donor death-state mesh decision: after the death edge the ruin art
		# follows the stage selector, NOT hp. _donor_death_suffix(e) stays as the
		# labelled [U]-14 hp proxy in meta (no parity claim), never a stage pick.
		var death_suffix := ""
		var death_source := "no_derived_death_art"
		var death_mesh: Mesh = null
		if died:
			if is_building:
				if dstage == 1:
					death_suffix = "_death1"
				elif dstage >= 2:
					death_suffix = "_death2"
			else:
				# Non-building deaths keep the prior explicit-gap proxy path;
				# no building ruin stem and no stage timer for units.
				death_suffix = _donor_death_suffix(e)
			if death_suffix != "":
				var dinfo := _death_mesh_info(sid, death_suffix, false)
				if not dinfo.is_empty() and dinfo["mesh"] is Mesh:
					death_mesh = dinfo["mesh"] as Mesh
					death_source = str(dinfo.get("source", "unknown"))
					death_art_hits += 1
				else:
					death_blocked += 1
			else:
				death_blocked += 1
				death_suffix = "DATA_GAP:max_hp_missing"
		if death_mesh != null:
			chosen = death_mesh
			source = "derived_death_obj_" + death_source
		elif not finished:
			suffix = _build_stage_suffix(e)
			var stage_info := _stage_mesh_info(sid, suffix, false)
			if not stage_info.is_empty() and stage_info["mesh"] is Mesh:
				chosen = stage_info["mesh"] as Mesh
				source = str(stage_info.get("source", "stage_obj"))
				stage_art_hits += 1
			else:
				source = "base_mesh_port_approximation"
				stage_approx += 1
		if (mi as MeshInstance3D).mesh != chosen:
			(mi as MeshInstance3D).mesh = chosen
			# BUILD-ART-C-01: _apply_tint() writes surface overrides BY INDEX on
			# the instance. A stage/base swap can change the surface count, so
			# re-apply the donor slot tint on every real mesh change; otherwise
			# the team colour is silently dropped. The base sid keeps the mask.
			var tint: Variant = _player_tint(_player_index(e))
			if tint is Color:
				_apply_tint(mi, chosen, tint, sid, "building")
		var stage_key := suffix if not finished else "finished"
		(mi as MeshInstance3D).set_meta("build_stage_suffix", stage_key)
		(mi as MeshInstance3D).set_meta("build_stage_progress01", _build_progress01(e))
		(mi as MeshInstance3D).set_meta("build_stage_source", source)
		(mi as MeshInstance3D).set_meta("build_stage_label", BUILD_STAGE_LABEL)
		(mi as MeshInstance3D).set_meta("build_stage_visual", "UNVERIFIED")
		(mi as MeshInstance3D).set_meta("donor_death_state", death_suffix)
		(mi as MeshInstance3D).set_meta("donor_death_stage", donor_stage.get("stage", 0))
		(mi as MeshInstance3D).set_meta("donor_death_wall_stage", donor_stage.get("wall_stage", 0))
		(mi as MeshInstance3D).set_meta("donor_death_material", "debris" if died else "")
		# B1: no smoke holder is attached at death. The donor clears it on the
		# transition; "buildingsmoke" is kept only as the future pre-death
		# damage-smoke key (needs E-U14-burn), never as a death-edge attach.
		(mi as MeshInstance3D).set_meta("donor_death_smoke_effect", "cleared_at_death" if died else "")
		(mi as MeshInstance3D).set_meta("donor_death_status", BUILDING_DEATH_STATUS)
		(mi as MeshInstance3D).set_meta("donor_death_dstage", dstage)
		(mi as MeshInstance3D).set_meta("donor_death_stage_timer_units", BLD_DEATH_STAGE_TIMER_UNITS)
		(mi as MeshInstance3D).set_meta("donor_death_stage_timer_label", stage_timer_label)
		(mi as MeshInstance3D).set_meta("donor_death_hp_suffix_proxy",
			_donor_death_suffix(e) if died else "")
		# IMPL-DEATH-FAMILIES — fire the donor :264-311 transition ONCE per death
		# (fx_fired flag also covers a death first seen in remove() by the
		# world3d.gd:362 entity feed). Explosion gate mirrors
		# "switchEssential=death AND iVisual<>hide AND (oldEssential=none OR
		# (oldEssential=birth AND oldVisual in {stage_2,stage_3}))"; the port's
		# finished flag stands in for `none`/`birth` ([U]-14, no state API).
		if died and not fx_fired:
			death_transitions += 1
			var prev_finished := bool(prev.get("finished", true))
			var old_none := prev_finished
			var old_birth_late := (not prev_finished) and int(prev.get("stage", 0)) >= 2
			var do_explosion := old_none or old_birth_late
			var fxout := _fire_donor_death_fx((mi as MeshInstance3D).global_position, do_explosion)
			# Donor truth: 0 smoke attaches on the death edge (B1).
			death_smoke_spawns += int(fxout.get("smoke_attached", 0))
			death_smoke_cleared += 1
			if (fxout.get("explosion") is Dictionary) and not (fxout["explosion"] as Dictionary).is_empty():
				death_explosion_hooks += 1
			(mi as MeshInstance3D).set_meta("donor_death_transition",
				"ontagstates.inc:264-311")
			(mi as MeshInstance3D).set_meta("donor_death_explosion",
				str(fxout.get("explosion_status", BLD_DEATH_EXPLOSION_STATUS)))
			(mi as MeshInstance3D).set_meta("donor_death_explosion_keys", BLD_DEATH_EXPLOSION_KEYS)
			(mi as MeshInstance3D).set_meta("donor_death_smoke_status", BLD_DEATH_BURN_STATUS)
			(mi as MeshInstance3D).set_meta("donor_death_sound", BLD_DEATH_SOUND_KEY)
			(mi as MeshInstance3D).set_meta("donor_death_sound_status", BLD_DEATH_SOUND_STATUS)
			fx_fired = true
		if dstage == 3:
			(mi as MeshInstance3D).set_meta("donor_death_destroyed",
				"DeathStage2 — deathstage2.inc:8-15 (GameObjectRequestToDestroyByHandle)")
			(mi as MeshInstance3D).visible = false
			death_destroyed += 1
		_death_prev[int(id)] = {"dead": died, "finished": finished,
			"stage": int(donor_stage.get("stage", 0)),
			"dstage": dstage, "dstage_t0": dstage_t0, "fx_fired": fx_fired}
		stage_hist[stage_key] = int(stage_hist.get(stage_key, 0)) + 1
		# Donor scaffold auto-child (engcen.prop:72-112, ontagstates.inc:253-259).
		# IMPL-DEATH-FAMILIES essential death (:281-304), re-run on every stage
		# pass (death entry + DeathStage1): child0 -> <actor>a.mesh with the
		# debris material and visible; misc-racetag children destroyed (the port
		# mirror of BehaviourClear/EffectClear, B1); remaining children 1..n-1
		# hidden. No scaffold is freed on death. This runs BEFORE the deferred
		# DeathStage2 destroy below.
		var sc = _build_scaffolds.get(int(id), null)
		if died:
			var children := (mi as Node3D).get_children()
			if children.size() > 0 and not bool(e.get("gate", false)):
				var c0 = children[0]
				if c0 is MeshInstance3D and death_suffix in ["_death1", "_death2"]:
					var dsc := _death_mesh_info(sid, death_suffix, true)
					if not dsc.is_empty() and dsc["mesh"] is Mesh:
						(c0 as MeshInstance3D).mesh = dsc["mesh"] as Mesh
						death_child0_hits += 1
					(c0 as MeshInstance3D).material_override = _death_material(
						BLD_DEATH_DIR + "tex/debris.png")
					(c0 as MeshInstance3D).set_meta("donor_death_child_material", "debris")
					(c0 as MeshInstance3D).set_meta("donor_death_child_mesh",
						sid + death_suffix + "a")
					(c0 as MeshInstance3D).visible = true
			for i in range(children.size() - 1, -1, -1):
				var ch = children[i]
				if not is_instance_valid(ch):
					continue
				if str(ch.get_meta("donor_racetag", "")) == "misc":
					(ch as Node).free()
					death_misc_cleared += 1
				elif i >= 1 and ch is Node3D:
					(ch as Node3D).visible = false
					death_hidden_children += 1
			_build_scaffolds.erase(int(id))
		elif finished:
			if sc is MeshInstance3D and is_instance_valid(sc):
				(sc as MeshInstance3D).free()
			_build_scaffolds.erase(int(id))
		else:
			if not (sc is MeshInstance3D and is_instance_valid(sc)):
				var sc_node := MeshInstance3D.new()
				sc_node.name = "Scaffold_" + sid + "_" + str(id)
				sc_node.set_meta("scaffold_label", BUILD_SCAFFOLD_LABEL)
				sc_node.set_meta("scaffold_donor_source",
					"objects/buildings/engcen.prop:72-112; scripts/units/building.inc/ontagstates.inc:253-259")
				sc_node.set_meta("visual_status", "UNVERIFIED")
				sc_node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
				(mi as MeshInstance3D).add_child(sc_node)
				_build_scaffolds[int(id)] = sc_node
				sc = sc_node
			var sc_info := _stage_mesh_info(sid, suffix, true)
			var sc_art := not sc_info.is_empty() and sc_info["mesh"] is Mesh
			if sc_art:
				(sc as MeshInstance3D).mesh = sc_info["mesh"] as Mesh
				scaffold_art_hits += 1
			else:
				(sc as MeshInstance3D).mesh = base_mesh
			# Hidden placeholder when art is missing: reusing the base mesh
			# would otherwise double-render the parent silhouette. The node is
			# still attached/removed in sync with the donor child's lifecycle.
			(sc as MeshInstance3D).visible = sc_art
			(sc as MeshInstance3D).set_meta("scaffold_source",
				"stage_scaffold_obj" if sc_art else "base_mesh_port_approximation_hidden")
			scaffold_count += 1
	# DeathStage2 destroy (deathstage2.inc:8-15). Removed after the loop so no
	# iteration is mutated mid-pass; remove() already defers a still-staging
	# building, so this is the authoritative end of the donor death schedule.
	for did in destroy_ids:
		if _nodes.has(did):
			_force_remove(did)
	stats["build_stage_counts"] = stage_hist
	stats["build_stage_scaffolds"] = scaffold_count
	stats["build_stage_obj_hits"] = stage_art_hits
	stats["build_stage_approx_nodes"] = stage_approx
	stats["build_scaffold_obj_hits"] = scaffold_art_hits
	stats["build_death_art_hits"] = death_art_hits
	stats["build_death_blocked"] = death_blocked
	stats["build_death_transitions"] = death_transitions
	stats["build_death_smoke_spawns"] = death_smoke_spawns
	stats["build_death_smoke_cleared"] = death_smoke_cleared
	stats["build_death_explosion_hooks"] = death_explosion_hooks
	stats["build_death_child0_hits"] = death_child0_hits
	stats["build_death_hidden_children"] = death_hidden_children
	stats["build_death_misc_cleared"] = death_misc_cleared
	stats["build_death_stage2_swaps"] = death_stage2_swaps
	stats["build_death_destroyed"] = death_destroyed
	stats["build_death_manifest"] = BLD_DEATH_MANIFEST
	stats["build_death_burn_status"] = BLD_DEATH_BURN_STATUS
	stats["build_death_explosion_status"] = BLD_DEATH_EXPLOSION_STATUS
	stats["build_death_status"] = BUILDING_DEATH_STATUS
	stats["build_death_explosion_keys"] = BLD_DEATH_EXPLOSION_KEYS.duplicate()
	stats["build_death_stage_timer_units"] = BLD_DEATH_STAGE_TIMER_UNITS
	stats["build_death_stage_timer_label"] = stage_timer_label
	stats["build_death_sound_key"] = BLD_DEATH_SOUND_KEY
	stats["build_death_sound_status"] = BLD_DEATH_SOUND_STATUS
	stats["build_stage_label"] = BUILD_STAGE_LABEL
	stats["build_stage_visual"] = "UNVERIFIED"


func _resource_sid(ty: String, pos: Vector2) -> String:
	match ty:
		"wood":
			return _pick_sid(POOL_TREE, pos)
		"stone":
			return _pick_sid(POOL_ROCK, pos)
		"gold", "iron", "coal":
			return "mine_" + ty
		"food":
			return "field"
		"bush":
			return _pick_sid(POOL_BUSH, pos)
		"stump":
			return _pick_sid(POOL_STUMP, pos)
	return ""


# Deterministic choice by world position, never RNG (owner: "No RNG").
func _pick_sid(pool: Array, pos: Vector2) -> String:
	if pool.is_empty():
		return ""
	var ix: int = (int(absf(pos.x) * 10.0) * 7 + int(absf(pos.y) * 10.0) * 13) % pool.size()
	return str(pool[ix])


func add_resource(n) -> void:
	if n == null or game == null:
		return
	var nd := n as Dictionary
	var id := int(nd.get("id", -1))
	if id < 0:
		return
	_refs[id] = nd
	if _slot.has(id):
		return
	var ty := str(nd.get("type", ""))
	var sid := _resource_sid(ty, nd.get("pos", Vector2.ZERO))
	if sid == "":
		sid = "__proxy_" + ty           # no donor sid: bbox proxy, tagged in stats
	var info := _mesh_info(sid, "res")
	var key := "res|" + sid
	var field_spec: Dictionary = {}
	if ty == "food":
		field_spec = _field_spec(nd)
		# Shallow copy: never write presentation stage data into the shared
		# _mesh_cache entry used by every field batch.
		info = info.duplicate()
		info["field_spec"] = field_spec
		key = "res|field|" + str(field_spec.get("material", "field7"))
	var ix := _acquire(key, id, info, "res")
	if ix >= 0:
		var b: Dictionary = _batches[key]
		var xf := _xf(id)
		(b["xforms"] as Array)[ix] = xf
		(b["mm"] as MultiMesh).set_instance_transform(ix, xf)
		if ty == "food":
			_sync_field_decal(id, field_spec)


func remove(id) -> void:
	var eid := int(id)
	var ed = _refs.get(eid)
	# IMPL-DEATH-FAMILIES — donor death-schedule ownership
	# (settagstates.inc:32-53, deathstage2.inc:8-15): the building object stays
	# alive through DeathStage1 -> DeathStage2 before destroy. The entity feed
	# (world3d.gd:362) calls remove() as soon as the sim sets dead=true, so
	# defer the PRESENTATION removal while the two stage timers run. No sim
	# state is written here; the authoritative destroy is _force_remove() from
	# the DeathStage2 branch of _sync_building_stages().
	if ed is Dictionary and bool((ed as Dictionary).get("dead", false)) \
			and str((ed as Dictionary).get("kind", "")) == "building":
		var dp: Dictionary = (_death_prev.get(eid, {}) as Dictionary).duplicate(true)
		var ds := int(dp.get("dstage", 0))
		if ds == 0:
			# First sight of death: seed the same stage record the sync pass
			# uses, so the FX edge, mesh swaps and clears still fire next frame.
			var fin := bool((ed as Dictionary).get("finished", true))
			var hp_stage := _donor_raw_stage(ed as Dictionary)
			dp["dead"] = true
			dp["finished"] = fin
			dp["stage"] = int(hp_stage.get("stage", 0))
			dp["dstage"] = 1 if fin else 2
			dp["dstage_t0"] = _anim_t
			dp["fx_fired"] = false
			_death_prev[eid] = dp
			return
		if ds < 3:
			return
	_force_remove(eid)


# Original removal body, shared by remove() and the DeathStage2 transition.
# Behaviour is unchanged for every non-death removal.
func _force_remove(eid: int) -> void:
	if _slot.has(eid):
		_release(eid)
	if _nodes.has(eid):
		var mi = _nodes[eid]
		if is_instance_valid(mi):
			# free(), not queue_free(): callers/tests can count nodes in the
			# same frame as remove(); a deferred free would leave a ghost node.
			mi.free()
		_nodes.erase(eid)
	_rotors.erase(eid)   # child is freed with its parent; drop the mirror
	# BUILD-STAGES-01: the scaffold is a child of the freed parent; drop the
	# presentation mirror without a second free of an invalid instance.
	if _build_scaffolds.has(eid):
		var sc = _build_scaffolds[eid]
		if sc is MeshInstance3D and is_instance_valid(sc):
			(sc as MeshInstance3D).free()
		_build_scaffolds.erase(eid)
	if _field_decals.has(eid):
		var decal = _field_decals[eid]
		if is_instance_valid(decal):
			(decal as Node).free()
		_field_decals.erase(eid)
	_field_visual.erase(eid)
	_motion_sample.erase(eid)
	_face_smooth.erase(eid)
	_applied_pose_frame.erase(eid)
	_refs.erase(eid)


func sync(dt: float) -> void:
	# V7-74: the sim clock drives a deterministic donor AAF frame through
	# anim3d.gd.pose_for() (donor 30 fps, fposmod loop - anim3d.gd:514-520).
	# No RNG, no sprite sheet, no invented keyframe. With no anim module or no
	# registered donor skin this is exactly the V7-14/V7-65 static bind path.
	_anim_t += maxf(dt, 0.0)
	var anim = _find_anim()
	var morph_units := 0
	var static_units := 0
	var frame_changes := 0
	var pose_sources: Dictionary = {}
	var seen_frames: Dictionary = {}
	var morph_rejects: Dictionary = {}
	# MOTION-ANIM-01: presentation telemetry only (no sim write, no parity claim).
	var measured_speeds: Dictionary = {}
	var rendered_actions: Dictionary = {}
	var yaw_clamps := 0
	var frozen_refreshes := 0
	# V7-79: ONE donor sample per (sid, action, frame) per sync(), not per unit.
	# All units in this pass see the same _anim_t, so pose_for() resolves the
	# same donor frame and returns byte-identical verts for a given
	# (sid, action); the cached pose already carries its resolved frame. Cache
	# the whole pose Dictionary (real donor verts + frame + batch fields) and
	# reuse it for later units of that key. The memo is LOCAL to this sync():
	# the next call starts with an empty dict, so a new donor frame is never
	# served stale data. No sprite sheet / RNG / invented value; every label,
	# visual status, tint and auto-loaded skin stays untouched.
	var pose_memo: Dictionary = {}
	# Pass 1: sample the donor pose per unit and migrate it to a frame-keyed
	# (sid, player, action, frame) batch when a real donor morph is available.
	for id in _slot.keys():
		var sl = _slot[id]
		if not (sl is Dictionary):
			continue
		if str((sl as Dictionary).get("class", "")) != "unit":
			continue
		var e = _refs.get(int(id))
		if not (e is Dictionary):
			continue
		var ed := e as Dictionary
		var uid := int(id)
		# WAVE-N/N04 (a): use the nation-resolved sid persisted on the slot by
		# _acquire(); it drives has_skin, pose_for, _mesh_info, _morph_mesh and
		# the batch key. Legacy slots without the field keep base-sid behaviour.
		var sid := str((sl as Dictionary).get("mesh_sid", str(ed.get("sid", ""))))
		var old_key := str((sl as Dictionary).get("key", ""))
		# MOTION-ANIM-01: measure SIM displacement first, then pick the donor
		# action from that measurement. This is the walk-while-stalled fix:
		# `moving:true` at ~0.001 m/s no longer selects the walk cycle.
		var speed := _measure_speed(uid, ed)
		measured_speeds[uid] = speed
		var raw_face := float(ed.get("face", 0.0))
		var smoothed := _smooth_face(uid, raw_face, dt)
		if absf(fposmod(raw_face - smoothed + PI, TAU) - PI) > 0.0001:
			yaw_clamps += 1
		_face_smooth[uid] = smoothed
		var action := _unit_action(ed, speed)
		rendered_actions[action] = int(rendered_actions.get(action, 0)) + 1
		var pose: Dictionary = {}
		var morphed: Dictionary = {}
		if anim != null and anim.has_method("pose_for") \
				and bool(anim.call("has_skin", sid)):
			var memo_key := sid + "|" + action
			if pose_memo.has(memo_key):
				pose = pose_memo[memo_key] as Dictionary
			else:
				# WAVE-N/N04 (a): pose_for() accepts a sid String
				# (anim3d.gd:685-690), so the resolved sid selects that
				# nation's skin and AAF range; the sim entity is untouched.
				var p = anim.call("pose_for", sid, action, _anim_t)
				if p is Dictionary:
					pose = p as Dictionary
				pose_memo[memo_key] = pose
			if not pose.is_empty():
				var verts = pose.get("verts", null)
				if verts is PackedVector3Array and not (verts as PackedVector3Array).is_empty() \
						and str(pose.get("pose_source", "")) == MORPH_POSE_SOURCE:
					var info: Dictionary = _mesh_info(sid, "unit")
					morphed = _morph_mesh(sid, info, int(pose.get("frame", -1)),
						action, verts as PackedVector3Array)
					if morphed["mesh"] == null:
						var why := str(morphed.get("reason", "?"))
						morph_rejects[why] = int(morph_rejects.get(why, 0)) + 1
		if morphed.has("mesh") and morphed["mesh"] != null:
			var tint = (sl as Dictionary).get("tint", null)
			var player := int((sl as Dictionary).get("player", -1))
			var new_key := "unit|" + sid
			if tint is Color:
				new_key += "|p" + str(player)
			var resolved_frame := int(pose.get("frame", -1))
			new_key += "|a" + action + "|f" + str(resolved_frame)
			if new_key != old_key:
				_release(uid)
				var pose_info: Dictionary = {"mesh": morphed["mesh"],
					"source": "donor_flat_root_morph", "sid": sid, "kind": "unit",
					"scale": float((_mesh_info(sid, "unit")).get("scale", 1.0))}
				_acquire(new_key, uid, pose_info, "unit", tint, player, pose)
				frame_changes += 1
			elif resolved_frame != int(_applied_pose_frame.get(uid, -1)):
				# MOTION-ANIM-01 frozen-sim fallback: the slot stayed in the same
				# batch, so the normal release/acquire mesh callback was skipped
				# while the donor pose frame advanced. Rebind the existing batch
				# mesh explicitly (real donor verts only, never a guess). This is
				# a PORT APPROX presentation refresh; whether it is visible at
				# zoom 2.9 / height 20 m is UNVERIFIED (VID-AN-01 §7.4).
				var b = _batches.get(new_key)
				if b is Dictionary:
					var mm: MultiMesh = (b as Dictionary)["mm"]
					if mm != null:
						mm.mesh = morphed["mesh"]
					var node = (b as Dictionary).get("node")
					if is_instance_valid(node):
						(node as Node3D).set_meta("donor_frame", resolved_frame)
				frozen_refreshes += 1
			_applied_pose_frame[uid] = resolved_frame
			pose_sources[MORPH_POSE_SOURCE] = int(pose_sources.get(MORPH_POSE_SOURCE, 0)) + 1
			seen_frames[int(pose.get("frame", -1))] = true
			morph_units += 1
		else:
			static_units += 1
	# Pass 2: unchanged transform contract for morphed, static and resource slots.
	for id in _slot.keys():
		var sl = _slot[id]
		if not (sl is Dictionary):
			continue
		var b = _batches.get(str((sl as Dictionary).get("key", "")))
		if not (b is Dictionary):
			continue
		var mm: MultiMesh = (b as Dictionary)["mm"]
		var xf := _xf(int(id))
		var ix: int = int((sl as Dictionary).get("index", 0))
		var xforms: Array = (b as Dictionary)["xforms"]
		if ix < xforms.size():
			xforms[ix] = xf
		mm.set_instance_transform(ix, xf)
	for id in _nodes.keys():
		var mi = _nodes[id]
		if is_instance_valid(mi):
			mi.transform = _xf(int(id))

	# BUILD-STAGES-01: donor stage selector + stage-synced scaffold child.
	# Runs AFTER the unchanged building transform loop and BEFORE the MILLFIX
	# rotor block, so rotor relocation/fallback stays byte-identical.
	_sync_building_stages()

	# MILLFIX F1: spin the donor-baked sail from the SAME `_anim_t` clock that
	# drives the donor morph pass (no second timer, no RNG). Billboarding uses
	# the node basis rather than material BILLBOARD so the readable local Z
	# rotation stays the authoritative angle: angle = _anim_t * MILL_SPIN,
	# i.e. exactly the donor 0.75 rad/s of world.gd:204/652.
	var rotor_spin := _anim_t * MILL_SPIN
	for id in _rotors.keys():
		var rotor = _rotors[id]
		if not is_instance_valid(rotor):
			_rotors.erase(id)
			continue
	# M03: FIXED AXLE — no camera billboard. The donor attach mesh mounts the
	# sail on donor -Y -> local +Z, which is the default Camera3D side
	# (camera3d.gd:262-282); a camera-following basis would swing the sail
	# through the tower when viewed from behind. Keep body yaw 0 (donor-
	# grounded); do NOT apply M01 §2.4's -90 deg yaw. Spin axis stays local Z
	# (donor slab thin in donor Y -> Godot Z: DONOR-PROVEN axis); the SIGN is
	# PORT APPROX vs the 2D bake proxy. Do NOT flip to Vector3.BACK: M01 D3
	# shows MOTION_ANIM_01.md:240's justification was wrong but the code right.
		rotor.transform = Transform3D(
			Basis().rotated(Vector3.FORWARD, rotor_spin), rotor.position)
		var re = _refs.get(int(id))
		# BLDDEATH-1TO1: donor death hides every child >= 1
		# (ontagstates.inc:299-303); do not re-show the rotor on a dead mill.
		rotor.visible = re is Dictionary and bool((re as Dictionary).get("finished", true)) \
			and not bool((re as Dictionary).get("dead", false))
	stats["mill_rotor_angle_rad"] = rotor_spin
	stats["mill_rotor_count"] = _rotors.size()
	stats["mill_rotor_label"] = ROTOR_STATUS
	stats["mill_rotor_spin_axis_label"] = ROTOR_SPIN_AXIS_STATUS
	stats["mill_rotor_mount_label"] = ROTOR_MOUNT_STATUS
	stats["mill_rotor_hub_local_m"] = [
		MILL_ROTOR_HUB_DONOR.x - (MILL_TOWER_BBOX_LO.x + MILL_TOWER_BBOX_HI.x) * 0.5,
		MILL_ROTOR_HUB_DONOR.z - MILL_TOWER_BBOX_LO.z,
		-(MILL_ROTOR_AXLE_TIP_DONOR_Y - (MILL_TOWER_BBOX_LO.y + MILL_TOWER_BBOX_HI.y) * 0.5)]
	stats["mill_rotor_texture_fallback_used"] = _rotor_fallback_warned

	# FIX-FIELD-DONOR: read-only visual state selection. The sim's field_state()
	# / field_growth01() values and 7x7 positions are unchanged. Donor material
	# names replace the old arbitrary RGB/alpha/pulse/relative-scale table.
	var field_states: Dictionary = {}
	var field_materials: Dictionary = {}
	var field_texture_status: Dictionary = {}
	var field_decal_angles: Dictionary = {}
	var field_total := 0
	var field_skipped := 0
	var field_ripe_mature := 0
	var field_ripe_texture_path := ""
	var field_scale := 1.0
	var fbb: Array = _bbox.get("field", [])
	if fbb.size() >= 6:
		var native_span := maxf(float(fbb[1]) - float(fbb[0]), 0.001)
		# FIX-FIELD-VISIBILITY: cover the donor 1.3x decal footprint with the SAME
		# 49 instances. No instance is added, removed or repositioned; only the
		# uniform scale follows FIELD_DECAL_SIZE_M (the preserved donor multiplier).
		field_scale = FIELD_CROP_FOOTPRINT_M / native_span
	var field_ids: Array = []
	for fid in _slot.keys():
		var sl = _slot[fid]
		if not (sl is Dictionary) or str((sl as Dictionary).get("class", "")) != "res":
			continue
		var fe = _refs.get(int(fid))
		if fe is Dictionary and str((fe as Dictionary).get("type", "")) == "food":
			field_ids.append(int(fid))
	for fid in field_ids:
		var fe = _refs.get(fid)
		if not (fe is Dictionary):
			continue
		var ed := fe as Dictionary
		var spec := _field_spec(ed)
		var desired_key := "res|field|" + str(spec.get("material", "field7"))
		var sl = _slot.get(fid)
		var current_key := str((sl as Dictionary).get("key", "")) if sl is Dictionary else ""
		if current_key != desired_key:
			_release(fid)
			var info := _mesh_info("field", "res")
			info = info.duplicate()
			info["field_spec"] = spec
			var new_ix := _acquire(desired_key, fid, info, "res")
			if new_ix < 0:
				continue
		var bd := _batches[desired_key] as Dictionary
		var mm: MultiMesh = bd["mm"]
		var ix: int = int((_slot[fid] as Dictionary).get("index", 0))
		var xforms: Array = bd["xforms"]
		var st := str(spec.get("state", ""))
		var material_name := str(spec.get("material", ""))
		var texture_status := str(spec.get("texture_status", ""))
		field_states[st] = int(field_states.get(st, 0)) + 1
		field_materials[material_name] = int(field_materials.get(material_name, 0)) + 1
		field_texture_status[texture_status] = int(field_texture_status.get(texture_status, 0)) + 1
		# FIX-FIELD-DECAL-VISUAL: verify a ripe parcel actually binds the mature
		# field/fieldw art, not a growth-stage fallback.
		if st == "ripe":
			var tm := str(spec.get("texture_material", ""))
			if tm == "field" or tm == "fieldw":
				field_ripe_mature += 1
				if field_ripe_texture_path == "":
					field_ripe_texture_path = str(spec.get("texture_path", ""))
		if bool(spec.get("texture_skipped", false)):
			field_skipped += 1
		field_total += 1
		# Donor has no stage scale interpolation: one constant footprint for all
		# stages (now the donor 1.3x quad). Instance alpha stays 1.0 so the
		# scissor cut-out, not gameplay alpha, decides ground-vs-stalk coverage.
		var xf: Transform3D = _xf(fid)
		xf.basis = xf.basis.scaled(Vector3(field_scale, field_scale, field_scale))
		xforms[ix] = xf
		mm.set_instance_transform(ix, xf)
		mm.set_instance_color(ix, Color(1, 1, 1, 1))
		_sync_field_decal(fid, spec)
		var p: Vector2 = ed.get("pos", Vector2.ZERO)
		var decal_angle := 225.0 if _hash01(p) > 0.5 else 45.0
		if _field_decals.has(fid):
			field_decal_angles[str(decal_angle)] = int(field_decal_angles.get(str(decal_angle), 0)) + 1
		_field_visual[fid] = {"state": st, "material": material_name,
			"season": str(spec.get("season", "summer")), "color": Color(1, 1, 1, 1),
			"scale": field_scale, "texture_path": str(spec.get("texture_path", "")),
			"texture_status": texture_status, "decal_angle": decal_angle}
	stats["field_visual_states"] = field_states
	stats["field_visual_materials"] = field_materials
	stats["field_visual_texture_status"] = field_texture_status
	stats["field_visual_skipped_instances"] = field_skipped
	stats["field_visual_ripe_count"] = int(field_states.get("ripe", 0))
	stats["field_visual_ripe_using_mature_texture"] = field_ripe_mature
	# FIX-FIELD-VISIBILITY: decisive static proof for a capture log. A ripe field
	# must bind field/fieldw AND resolve a real converted texture path; 0 means
	# Branch A (no fields in this config) or a missing mature conversion.
	stats["field_visual_ripe_mature_verified"] = field_ripe_mature > 0
	stats["field_visual_ripe_mature_texture_path"] = field_ripe_texture_path
	stats["field_visual_crop_material_state"] = _field_crop_material_state()
	stats["field_visual_decal_material_state"] = _field_decal_material_state()
	stats["field_visual_count"] = field_total
	stats["field_visual_span_scale"] = field_scale
	stats["field_visual_crop_footprint_m"] = FIELD_CROP_FOOTPRINT_M
	stats["field_visual_crop_footprint_status"] = FIELD_CROP_FOOTPRINT_STATUS
	stats["field_visual_target_span_m"] = FIELD_SPAN_M
	stats["field_visual_label"] = FIELD_STATUS
	stats["field_visual_asset_status"] = _field_asset_status
	stats["field_visual_emission_status"] = FIELD_EMISSION_STATUS
	stats["field_visual_emission_rgb"] = {
		"field": [232.0 / 255.0, 218.0 / 255.0, 195.0 / 255.0],
		"field1..7": [200.0 / 255.0, 200.0 / 255.0, 200.0 / 255.0],
	}
	stats["field_visual_decal_status"] = FIELD_DECAL_STATUS
	stats["field_visual_decal_material_status"] = FIELD_DECAL_MATERIAL_STATUS
	stats["field_visual_texture_import_status"] = FIELD_TEXTURE_IMPORT_STATUS
	stats["field_visual_decal_count"] = _field_decals.size()
	stats["field_visual_decal_angles"] = field_decal_angles
	stats["field_visual_decal_size_m"] = FIELD_DECAL_SIZE_M
	stats["field_visual_decal_uv"] = [FIELD_DECAL_UV_SCALE, FIELD_DECAL_UV_OFFSET]
	var units := 0
	var ress := 0
	var tinted_batches := 0
	for key in _batches.keys():
		var bd := _batches[key] as Dictionary
		var cls := str(bd.get("class", ""))
		var n: int = bd["ids"].size()
		if bd.get("tint") is Color:
			tinted_batches += 1
		if cls == "unit":
			units += n
		else:
			ress += n
	var tinted_buildings := 0
	for id in _nodes.keys():
		if (_nodes[id] as Node).has_meta("donor_tint_rgb"):
			tinted_buildings += 1
	stats["tinted_batches"] = tinted_batches
	stats["tinted_buildings"] = tinted_buildings
	stats["batches"] = _batches.size()
	# P11 structural telemetry (NOT a frame-time or draw-call measurement).
	var allocated_slots := 0
	for key in _batches.keys():
		allocated_slots += int((_batches[key] as Dictionary).get("capacity", BATCH_CAPACITY))
	stats["batch_instance_slots_allocated"] = allocated_slots
	stats["batch_instance_slots_ceiling"] = BATCH_CAPACITY * _batches.size()
	stats["tint_materials_shared"] = _tint_material_cache.size()
	stats["batch_optimization_label"] = PORT_LABEL + " — P11 adaptive MultiMesh capacity + shared tint material; frame-time/draw-call gain UNVERIFIED"
	stats["units"] = units
	stats["resources"] = ress
	stats["buildings"] = _nodes.size()
	stats["anim_clock_s"] = _anim_t
	# V7-74 measured morph telemetry (never a visual-parity claim).
	stats["donor_morph_units"] = morph_units
	# V7-79: actual pose_for() calls this frame (one per memo key, not per
	# unit). Structural telemetry, not a visual-parity claim.
	stats["donor_morph_pose_samples"] = pose_memo.size()
	stats["donor_morph_static_units"] = static_units
	stats["donor_morph_frame_changes"] = frame_changes
	stats["donor_morph_meshes_cached"] = _morph_meshes.size()
	stats["donor_morph_frames"] = seen_frames.keys()
	stats["donor_morph_pose_sources"] = pose_sources
	stats["donor_morph_rejects"] = morph_rejects
	stats["donor_morph_anim_available"] = anim != null
	# MOTION-ANIM-01: measured presentation telemetry (structural/numeric only;
	# no sim mutation, no donor-parity or visual claim).
	stats["motion_measured_speeds_m_s"] = measured_speeds
	stats["motion_rendered_actions"] = rendered_actions
	stats["motion_yaw_clamps"] = yaw_clamps
	stats["motion_frozen_pose_refreshes"] = frozen_refreshes
	anim_handoff["applied"] = morph_units > 0
	anim_handoff["morph_units"] = morph_units
	anim_handoff["label"] = PORT_LABEL
	anim_handoff["visual"] = "UNVERIFIED"
