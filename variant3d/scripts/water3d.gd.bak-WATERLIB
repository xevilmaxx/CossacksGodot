			"ReflectionAmount": 1, "WaterAmount": 1,
			"FresnelPower": 1, "FresnelBias": 1,
			"WaveFreq": 0, "WaveAmp": 0, "DistFactor": 1, "BumpFactor": 1,
			"WaveDir0": [-1.0, 0.0], "WaveDir1": [-0.7, 0.7], "Speed": 1.0,
