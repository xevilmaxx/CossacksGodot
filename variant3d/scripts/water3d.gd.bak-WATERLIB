		"field_geometry": {
			"field_size": C3_WATER_FIELD_SIZE,
			"arr_size": C3_WATER_MAP_ARR_SIZE,
			"mapsizemod_formula": "(320/((640/mapheight)*2))*2 (float outer division)",
			"centre": "X=(tz+bz)*0.5, Z=(tx+bx)*0.5, Y=cOffsetY=-0.5",
			"extent": [C3_FIELD_EXTENT * TILE_M, C3_FIELD_EXTENT * TILE_M],
			"x_z_swap": "world X from script z (wmy), world Z from script x (wmx) [D]",
		},
		"collision_spec": {
			"tags": {"none": C_TAG_NONE, "bridge": C_TAG_BRIDGE, "water": C_TAG_WATER,
				"landborder": C_TAG_LANDBORDER, "waterborder": C_TAG_WATERBORDER},
			"rad": C_WATER_BORDER_SIZE,
			"strict_disc": "i1*i1 + j1*j1 < 9 (boundary excluded)",
			"offsets": _strict_disc_offsets(),
			"native_kernel": "[U11] MapDrawCollision radius/shape not decompiled; script is only source",
		},
		"grey_fallback_removed": true,
		"visual_parity_claimed": false,
	}
	return true


# ---- Exact strict radius-3 disc offsets (report §8, misc.script:5186-5190) --
func _strict_disc_offsets() -> Array:
	var out: Array = []
	for i1 in range(-C_WATER_BORDER_SIZE, C_WATER_BORDER_SIZE + 1):
		var rem: int = C_SHORE_DISC_STRICT_R2 - i1 * i1
		if rem < 0:
			continue
		var min_j: int = int(ceilf(sqrt(float(rem))))
		for j1 in range(-min_j, min_j + 1):
			if i1 * i1 + j1 * j1 < C_SHORE_DISC_STRICT_R2:
				out.append([i1, j1])
	return out


# ---- Pure collision tag remap (report §8; application to engine [U11]) ------
# Given a per-cell tag grid (flat, z*gw+x), apply the strict disc border remap:
# tag 0 -> 109 (landborder), tag 87 -> 110 (waterborder). Returns a new grid;
# never writes engine collision (out of this worker's scope).
func remap_shore_collision_tags(tags: PackedByteArray, gw: int, gh: int) -> PackedByteArray:
	var out := PackedByteArray()
	out.resize(tags.size())
	for i in range(tags.size()):
		out[i] = tags[i]
	var offsets: Array = _strict_disc_offsets()
	for z in range(gh):
		for x in range(gw):
			var idx: int = z * gw + x
			var t: int = tags[idx]
			if t != C_TAG_NONE and t != C_TAG_WATER:
				continue
			for d in offsets:
				var nx: int = x + int(d[0])
				var nz: int = z + int(d[1])
				if nx < 0 or nx >= gw or nz < 0 or nz >= gh:
					continue
				var ni: int = nz * gw + nx
				if tags[ni] == C_TAG_NONE:
					out[ni] = C_TAG_LANDBORDER
				elif tags[ni] == C_TAG_WATER:
					out[ni] = C_TAG_WATERBORDER
	return out
