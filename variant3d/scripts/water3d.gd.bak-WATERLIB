		"waveheight_from_plane_y": clampf(C3_OFFSET_Y * 3.0 - 1.5, 0.0, 1.0),
		# With plane Y=-0.5, waveheight=0 so level<=-0.5. Every surviving fragment
		# therefore has height<-0.25 and the shipped PORT GUARD water_cell is
		# provably 1 => alpha = donor coastfade2 exactly (report §9.1).
		"water_alpha_gate": ("DONOR alpha=coastfade2. Shipped PORT GUARD water_cell=1-step(-0.25,height) "
			+ "is PROVABLY INERT under plane Y=-0.5 (level<=-0.5<height threshold). No alpha floor."),
