# Godot 4+ specific ignores
.godot/

# Godot-specific ignores (legacy / Godot 3 compatibility)
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono / C# specific ignores (safe to keep even in GDScript-only projects)
.mono/
data_*/
mono_crash.*.json
*.csproj.user
.vs/
bin/
obj/

# Build / export outputs
builds/
export/
*.exe
*.pck
*.apk
*.aab
*.dmg
*.zip

# OS & editor files
.DS_Store
Thumbs.db
*.swp
*~

# Godot runner queue state and results (generated at runtime)
.godot_queue/

# Python bytecode and tool caches (generated by app/tools/*.py)
__pycache__/
*.py[cod]
.pytest_cache/

# Temporary analysis / scratch files
*.tmp
*.temp
*.part
~$*

# Generated terrain/sample screenshots (including the very large full-map PNGs).
# Keep only the curated images referenced by README / docs.
# Covers all subdirectories (pieces, t6t90, unit_pieces, j1/j2/j3, map_variants, ...).
app/shots/**/*.png
app/shots/**/*.mp4
app/shots/**/*.log
!app/shots/portvis-final.png
!app/shots/g2_final.png
!app/shots/final_nations.png
!app/shots/p35_ghost_recheck.png

# Game-run logs everywhere (self-test logs, Godot stdout logs, video assembly logs)
*.log

# Per-run JSON reports/dumps under shots (harness *configs* like boost.json
# stay tracked; only generated run outputs are ignored here)
app/shots/**/*dump*.json
app/shots/**/selftest*.json
app/shots/**/uitest*.json
app/shots/**/cli*.json
app/shots/**/seq_index.json
app/shots/**/bench*.json
app/shots/**/perf*.json

# Godot import cache for the app project (repo-root .godot/ already covered above)
app/.godot/

# Godot runner queue state under app/ (repo-root rule above covers only top level)
app/.godot_queue/

# Rust build outputs (pure-Rust branch: cargo target dir, incremental caches)
rustport/target/

# --- 3D variant project (variant3d/, wave 7) -------------------------------
# Separate Godot 4 project. Importer cache, FIFO runner state and all generated
# shots/dumps are runtime artifacts - never commit them. The shots directory
# itself is NOT excluded so a future curated !exception can still be added.
variant3d/.godot/
variant3d/.import/
variant3d/.godot_queue/
variant3d/shots/**
variant3d/**/*_dump*.json
variant3d/**/temp_*.json
variant3d/**/*_tmp.json

# 3D-conversion garbage in BOTH projects (app/ and variant3d/): Blender backups,
# half-written glTF/GLB exports, temp dumps. Global patterns cover both trees.
*.blend1
*.blend2
*.glb.tmp
*.glb.part
*.tmp.glb
*.gltf.tmp

# app/assets/models/glb/ is deliberately NOT ignored: V7-2 plans to COMMIT the
# converted .glb meshes (Godot imports them as PackedScene, i.e. real 3D source
# assets, not build artifacts). Ignore only the transient exports above.
#
# The 3D variant does NOT use 2D bake outputs (sprite sheets/atlases): those
# PNGs are hardlinked leftovers from app/assets/models/anim and sprites*/.
# They are ignored here so nobody re-adds them as "3D assets" - but clean_temp
# must NEVER delete them (hardlinks / tracked app copies). Real 3D geometry
# (models/obj, models/glb) and PBR textures (models/tex) stay trackable.
variant3d/assets/models/anim/**/*.png
variant3d/assets/models/anim/**/*.png.import
variant3d/assets/models/sprites/**/*.png
variant3d/assets/models/sprites/**/*.png.import
variant3d/assets/models/sprites_hi/**/*.png
variant3d/assets/models/sprites_hi/**/*.png.import

# The legacy "obj/" rule above (C# build output) also matches real 3D mesh
# folders. Re-include ONLY variant3d geometry; all 2D rules stay unchanged.
!variant3d/assets/models/obj/
!variant3d/assets/models/obj/**

# DONOR ASSETS: C:\Games\Cossacks 3 is private-use - donor meshes/textures/
# binaries must NEVER be committed. variant3d/assets is hardlinked from
# app/assets; do NOT add a broad "variant3d/assets" ignore rule here, because
# tracked source (obj/glb/tex, .import sidecars) must stay visible to git.
# No git tracking changes were made from the hygiene lane (H1).